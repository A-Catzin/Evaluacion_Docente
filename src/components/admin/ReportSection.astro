---
// One instrument of the teacher report: a collapsible sub-card on screen, an open section in the PDF.
export interface Props {
  n: number;
  title: string;
  scale: string;
  score: number | null;
  status: string;
  collapsible?: boolean;
}
const { n, title, scale, score, status, collapsible = true } = Astro.props;
const fmt = (value: number | null) => (value === null ? '—' : value.toLocaleString('es-MX', { maximumFractionDigits: 1 }));
const tone = (value: number | null) =>
  value === null ? 'bg-slate-100 text-slate-500' : value >= 80 ? 'bg-emerald-100 text-emerald-800' : value >= 60 ? 'bg-amber-100 text-amber-800' : 'bg-red-100 text-red-800';
---

{collapsible ? (
  <details class="report-section group/sec overflow-hidden rounded-xl border border-slate-200 border-l-4 border-l-tup bg-white">
    <summary class="flex cursor-pointer list-none [&::-webkit-details-marker]:hidden items-center gap-3 px-4 py-3 hover:bg-tup-50/60">
      <svg class="h-5 w-5 shrink-0 text-tup transition-transform group-open/sec:rotate-90" aria-hidden="true" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 0 1 .02-1.06L11.17 10 7.23 6.29a.75.75 0 1 1 1.04-1.08l4.5 4.25a.75.75 0 0 1 0 1.08l-4.5 4.25a.75.75 0 0 1-1.06-.02Z" clip-rule="evenodd"/></svg>
      <div class="min-w-0 flex-1">
        <p class="text-[10px] font-semibold uppercase tracking-wider text-dorado-700">Instrumento {n} de 5</p>
        <h3 class="font-bold text-tup">{title}</h3>
        <p class="text-xs text-slate-500">{status}</p>
      </div>
      <span class={`rounded-lg px-3 py-1 text-base font-bold tabular-nums ${tone(score)}`}>{fmt(score)}</span>
    </summary>
    <div class="border-t-2 border-dorado px-4 pb-4 pt-2">
      <p class="text-xs text-slate-500">{scale}</p>
      <slot />
    </div>
  </details>
) : (
  <section class="report-section">
    <header class="flex items-start justify-between gap-4 border-b-2 border-dorado pb-2">
      <div class="border-l-4 border-tup pl-3">
        <p class="text-[10px] font-semibold uppercase tracking-wider text-dorado-700">Instrumento {n} de 5</p>
        <h3 class="text-base font-bold text-tup">{title}</h3>
        <p class="text-xs text-slate-500">{scale} · {status}</p>
      </div>
      <span class={`rounded-lg px-3 py-1 text-lg font-bold tabular-nums ${tone(score)}`}>{fmt(score)}</span>
    </header>
    <slot />
  </section>
)}
