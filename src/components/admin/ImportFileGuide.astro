---
import { exampleCsv, IMPORT_EXAMPLES, type ImportExample } from '../../lib/importExamples';

interface Props { example: ImportExample['key'] }
const example = IMPORT_EXAMPLES[Astro.props.example];
const href = `data:text/csv;charset=utf-8,${encodeURIComponent(exampleCsv(example))}`;
---

<section class="bg-white rounded-2xl p-6 shadow-tarjeta mb-6" aria-labelledby={`guia-${example.key}`}>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h2 id={`guia-${example.key}`} class="text-lg font-bold text-slate-800">Cómo debe ser el archivo</h2>
      <p class="mt-1 text-sm text-slate-500">CSV con una fila de encabezados y una fila por registro. Los encabezados no distinguen mayúsculas ni acentos.</p>
    </div>
    <a href={href} download={example.fileName} class="rounded-xl border border-tup px-4 py-2 text-sm font-semibold text-tup hover:bg-tup/5">Descargar ejemplo (.csv)</a>
  </div>

  <div class="mt-4 overflow-x-auto">
    <table class="w-full min-w-[560px] text-sm">
      <thead>
        <tr class="border-b bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
          <th class="px-3 py-2">Columna</th>
          <th class="px-3 py-2">Requerida</th>
          <th class="px-3 py-2">Qué lleva</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {example.columns.map((column) => (
          <tr class="align-top">
            <td class="px-3 py-2 font-mono text-xs text-slate-800">{column.name}</td>
            <td class="px-3 py-2">{column.required
              ? <span class="rounded-full bg-red-50 px-2 py-0.5 text-xs font-semibold text-red-700">Sí</span>
              : <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-500">Opcional</span>}</td>
            <td class="px-3 py-2 text-slate-600">{column.description}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="mt-5 text-xs font-semibold uppercase text-slate-500">Ejemplo</p>
  <div class="mt-2 overflow-x-auto rounded-xl bg-slate-50 p-3">
    <table class="text-xs font-mono text-slate-700">
      <thead>
        <tr>{example.headers.map((header) => <th class="whitespace-nowrap pr-4 pb-1 text-left font-semibold">{header}</th>)}</tr>
      </thead>
      <tbody>
        {example.rows.map((row) => <tr>{row.map((cell) => <td class="whitespace-nowrap pr-4 py-0.5">{cell}</td>)}</tr>)}
      </tbody>
    </table>
  </div>
  <p class="mt-2 text-xs text-slate-400">Los datos del ejemplo son ficticios; reemplazalos por los reales.</p>

  <ul class="mt-4 list-disc space-y-1 pl-5 text-sm text-slate-600">
    {example.notes.map((note) => <li>{note}</li>)}
  </ul>
</section>
