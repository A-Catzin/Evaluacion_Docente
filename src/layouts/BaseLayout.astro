---
/**
 * BaseLayout.astro — Shell HTML base del SED-360 v2
 *
 * Adaptado del Layout v1. Provee el HTML shell, meta tags,
 * fondo con gradientes y formas orgánicas.
 * Las variantes por rol (Admin, Coordinador, Docente, Estudiante)
 * extienden este layout.
 */
export interface Props {
  titulo?: string;
  descripcion?: string;
}

const {
  titulo = 'SED-360 — Sistema de Evaluación Docente',
  descripcion = 'Plataforma integral de evaluación docente 360° — TUP',
} = Astro.props;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo-tup.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#1e3a5f" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
  </head>
  <body class="min-h-screen bg-fondo-dashboard font-sans antialiased text-slate-800">
    <div class="fixed inset-0 overflow-hidden pointer-events-none -z-10" aria-hidden="true">
      <div class="absolute -top-40 -right-40 w-[500px] h-[500px] rounded-full bg-tup opacity-[0.03] blur-3xl"></div>
      <div class="absolute -bottom-32 -left-32 w-[400px] h-[400px] rounded-full bg-dorado opacity-[0.04] blur-3xl"></div>
    </div>
    <slot />
  </body>
</html>

<style is:global>
  html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }
  body { min-height: 100dvh; }
  @media (max-width: 640px) { html { font-size: 15px; } }
  button, a[role='button'] { min-height: 44px; min-width: 44px; }
  ::selection { background-color: rgba(30, 58, 95, 0.2); color: #1e3a5f; }
  /* Opt-in selection cards keep every selected label readable without changing plain form labels. */
  .selection-card {
    position: relative;
    transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease, outline-color 150ms ease;
  }
  .selection-card:not(:has(input:disabled)):not(:has(input:checked)):hover {
    background-color: #e8edf5;
    border-color: #1e3a5f;
  }
  /* White on #1e3a5f is 11.5:1, exceeding WCAG AA for normal text. */
  .selection-card:has(input:checked) {
    background-color: #1e3a5f !important;
    border-color: #1e3a5f !important;
    color: #ffffff !important;
  }
  .selection-card:has(input:checked) :where(*) {
    color: #ffffff !important;
  }
  .selection-card--na:has(input:checked) {
    background-color: #78350f !important;
    border-color: #78350f !important;
  }
  .selection-card:has(input:focus-visible) {
    outline: 3px solid #1e3a5f;
    outline-offset: 3px;
  }
  .selection-card:has(input:checked:focus-visible) { outline-color: #ffffff; }
  .selection-card:has(input:disabled) {
    cursor: not-allowed;
    background-color: #f1f5f9;
    border-color: #cbd5e1;
    color: #475569;
  }
  .selection-card:has(input:disabled) :where(*) { color: #475569 !important; }
  .selection-card:has(input:user-invalid), .selection-card[aria-invalid="true"] { border-color: #b91c1c; }
  .selection-card:has(input:checked:user-invalid) {
    background-color: #991b1b !important;
    border-color: #991b1b !important;
  }
</style>
