---
import BaseLayout from './BaseLayout.astro';
export interface Props { titulo?: string; }
const { titulo = 'Observador — SED-360' } = Astro.props;
---

<BaseLayout titulo={titulo}>
  <div class="min-h-screen bg-slate-50">
    <header class="bg-white border-b border-slate-200 px-6 py-3 flex items-center justify-between">
      <a href="/observador/dashboard" class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-hero-tup flex items-center justify-center">
          <span class="text-white font-bold text-xs">360</span>
        </div>
        <span class="font-semibold text-tup">SED-360 — Observador</span>
      </a>
      <nav class="flex items-center gap-4">
        <a href="/observador/dashboard" class="text-sm text-slate-600 hover:text-tup">Dashboard</a>
        <a href="/api/auth/signout" class="text-sm text-red-500 hover:text-red-700">Salir</a>
      </nav>
    </header>

    <main class="p-6">
      <slot />
    </main>
  </div>
</BaseLayout>
