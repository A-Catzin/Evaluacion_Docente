---
import BaseLayout from './BaseLayout.astro';
export interface Props { titulo?: string; }
const { titulo = 'Observador — SED-360' } = Astro.props;
const cuatrimestreSel = Astro.cookies.get('cuatrimestre_sel')?.value;
const qs = cuatrimestreSel ? `?cuatrimestre=${cuatrimestreSel}` : '';
---
<BaseLayout titulo={titulo}>
  <div class="min-h-screen">
    <header class="sticky top-0 z-40 bg-white dark:bg-gray-900 border-b border-slate-200 dark:border-gray-800 px-6 h-14 flex items-center justify-between">
      <div class="flex items-center gap-6">
        <a href={`/observador/dashboard${qs}`} class="font-semibold text-tup dark:text-blue-300">SED-360 · Observador</a>
        <nav class="flex gap-1">
          <a href={`/observador/dashboard${qs}`} class="px-3 py-1.5 rounded-lg text-sm text-slate-600 dark:text-gray-300 hover:bg-tup/5 dark:hover:bg-gray-800">Dashboard</a>
        </nav>
      </div>
      <a href="/api/auth/signout" class="text-xs text-slate-400 dark:text-gray-500 hover:text-red-500">Salir</a>
    </header>
    <main class="p-6 max-w-5xl mx-auto"><slot /></main>
  </div>
</BaseLayout>
