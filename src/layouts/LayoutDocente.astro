---
import BaseLayout from './BaseLayout.astro';
export interface Props { titulo?: string; }
const { titulo = 'Docente — SED-360' } = Astro.props;
---
<BaseLayout titulo={titulo}>
  <div class="min-h-screen">
    <header class="sticky top-0 z-40 bg-white/80 dark:bg-gray-900/80 backdrop-blur-md border-b border-slate-200/50 dark:border-gray-800 px-6 h-14 flex items-center justify-between">
      <div class="flex items-center gap-6">
        <a href="/docente/dashboard" class="font-semibold text-tup dark:text-blue-300">SED-360 · Docente</a>
        <nav class="hidden sm:flex gap-1">
          <a href="/docente/dashboard" class="px-3 py-1.5 rounded-lg text-sm text-slate-600 dark:text-gray-300 hover:bg-tup/5 dark:hover:bg-gray-800">Mi Evaluación</a>
          <a href="/docente/autodiagnostico" class="px-3 py-1.5 rounded-lg text-sm text-slate-600 dark:text-gray-300 hover:bg-tup/5 dark:hover:bg-gray-800">Autodiagnóstico</a>
          <a href="/docente/planeaciones" class="px-3 py-1.5 rounded-lg text-sm text-slate-600 dark:text-gray-300 hover:bg-tup/5 dark:hover:bg-gray-800">Planeaciones</a>
        </nav>
      </div>
      <a href="/api/auth/signout" class="text-xs text-slate-400 dark:text-gray-500 hover:text-red-500">Salir</a>
    </header>
    <main class="p-6 max-w-4xl mx-auto"><slot /></main>
  </div>
</BaseLayout>
