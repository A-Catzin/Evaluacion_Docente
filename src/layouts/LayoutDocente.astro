---
import BaseLayout from './BaseLayout.astro';
import NotificationBell from '../components/NotificationBell.astro';
import { obtenerCuatrimestreActivo } from '../services/catalogos';
export interface Props { titulo?: string; }
const { titulo = 'Docente — SED-360' } = Astro.props;
const cuatrimestreQuery = Astro.url.searchParams.get('cuatrimestre');
const cuatrimestreCookie = Astro.cookies.get('cuatrimestre_sel')?.value;
const cuatrimestreActivo = await obtenerCuatrimestreActivo();
const cuatrimestreSelId = parseInt(cuatrimestreQuery || '') || cuatrimestreActivo?.id || parseInt(cuatrimestreCookie || '') || 0;
if (!cuatrimestreQuery && cuatrimestreActivo?.id && cuatrimestreCookie !== String(cuatrimestreActivo.id)) {
  Astro.cookies.set('cuatrimestre_sel', String(cuatrimestreActivo.id), { path: '/', maxAge: 60*60*24*30 });
}
const cuatrimestreSel = cuatrimestreSelId ? String(cuatrimestreSelId) : '';
const qs = cuatrimestreSel ? `?cuatrimestre=${cuatrimestreSel}` : '';
const dashLink = `/docente/materias${qs}`;
const evalLink = `/docente/dashboard${qs}`;
const adLink = `/docente/autodiagnostico${qs}`;
const planLink = `/docente/planeaciones${qs}`;
const gruposLink = `/docente/mis-grupos${qs}`;
---
<BaseLayout titulo={titulo}>
  <div class="min-h-screen">
    <header class="sticky top-0 z-40 bg-white/80 backdrop-blur-md border-b border-slate-200/50 px-4 sm:px-6 h-14 flex items-center justify-between">
      <div class="flex items-center gap-4">
        <button id="nav-toggle" class="sm:hidden text-slate-600 p-1" onclick="document.getElementById('nav-menu').classList.toggle('hidden')">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
          <a href={dashLink} class="font-semibold text-tup text-sm sm:text-base">SED-360 · Docente</a>
        <nav class="hidden sm:flex gap-1">
          <a href={dashLink} class="px-3 py-1.5 rounded-lg text-sm text-slate-600 hover:bg-tup/5">Mis Materias</a>
          <a href={evalLink} class="px-3 py-1.5 rounded-lg text-sm text-slate-600 hover:bg-tup/5">Mi Evaluación</a>
          <a href={adLink} class="px-3 py-1.5 rounded-lg text-sm text-slate-600 hover:bg-tup/5">Autodiagnóstico</a>
           <a href={planLink} class="px-3 py-1.5 rounded-lg text-sm text-slate-600 hover:bg-tup/5">Planeaciones</a>
           <a href={`/avisos${qs}`} class="px-3 py-1.5 rounded-lg text-sm text-slate-600 hover:bg-tup/5">Avisos</a>
          <a href="/docente/mi-actividad" class="px-3 py-1.5 rounded-lg text-sm text-slate-600 hover:bg-tup/5">Mi actividad</a>
        </nav>
      </div>
      <div class="flex items-center gap-3">
        <NotificationBell />
      <a href="/api/auth/signout" class="text-xs text-slate-400 hover:text-red-500">Salir</a>
    </header>
    <nav id="nav-menu" class="sm:hidden hidden bg-white border-b border-slate-200 px-4 py-2 space-y-1">
      <a href={dashLink} class="block px-3 py-2 rounded-lg text-sm text-slate-600 hover:bg-slate-50">👥 Mis Materias</a>
      <a href={evalLink} class="block px-3 py-2 rounded-lg text-sm text-slate-600 hover:bg-slate-50">📊 Mi Evaluación</a>
      <a href={adLink} class="block px-3 py-2 rounded-lg text-sm text-slate-600 hover:bg-slate-50">🧪 Autodiagnóstico</a>
        <a href={planLink} class="block px-3 py-2 rounded-lg text-sm text-slate-600 hover:bg-slate-50">📄 Planeaciones</a>
        <a href={`/avisos${qs}`} class="block px-3 py-2 rounded-lg text-sm text-slate-600 hover:bg-slate-50">📢 Avisos</a>
       <a href="/docente/mi-actividad" class="block px-3 py-2 rounded-lg text-sm text-slate-600 hover:bg-slate-50">🧾 Mi actividad</a>
      <a href={gruposLink} class="block px-3 py-2 rounded-lg text-sm text-slate-600 hover:bg-slate-50">👥 Mis Grupos</a>
    </nav>
    <main class="p-4 sm:p-6 max-w-4xl mx-auto"><slot /></main>
  </div>
</BaseLayout>
