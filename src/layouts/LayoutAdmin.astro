---
import BaseLayout from './BaseLayout.astro';
import NotificationBell from '../components/NotificationBell.astro';
import { obtenerCuatrimestreActivo } from '../services/catalogos';
export interface Props { titulo?: string; }
const { titulo = 'Admin — SED-360' } = Astro.props;
const cuatrimestreQuery = Astro.url.searchParams.get('cuatrimestre');
const cuatrimestreCookie = Astro.cookies.get('cuatrimestre_sel')?.value;
const cuatrimestreActivo = await obtenerCuatrimestreActivo();
const cuatrimestreSel = cuatrimestreQuery || (cuatrimestreActivo?.id ? String(cuatrimestreActivo.id) : cuatrimestreCookie || '');
if (!Astro.url.searchParams.has('cuatrimestre') && cuatrimestreActivo?.id && cuatrimestreCookie !== String(cuatrimestreActivo.id)) {
  Astro.cookies.set('cuatrimestre_sel', String(cuatrimestreActivo.id), { path: '/', maxAge: 60*60*24*30 });
}
const qs = cuatrimestreSel ? `?cuatrimestre=${cuatrimestreSel}` : '';
const pathname = Astro.url.pathname;

const secciones = [
  {
    nombre: 'Resultados',
    icono: '📊',
    items: [
      { href: '/admin/dashboard', label: 'Dashboard', icon: '📊', cycleScoped: true },
      { href: '/admin/resultados-docentes', label: 'Docentes 360', icon: '🧑‍🏫', cycleScoped: true },
      { href: '/admin/evaluaciones-estudiantes', label: 'Entregas estudiantiles', icon: '✓', cycleScoped: true },
      { href: '/admin/reporte-anual', label: 'Reporte Anual', icon: '📈', cycleScoped: true },
    ],
  },
  {
    nombre: 'Gestión de Personal',
    icono: '👥',
    items: [
      { href: '/admin/docentes', label: 'Docentes', icon: '👨‍🏫', cycleScoped: true },
      { href: '/admin/coordinadores', label: 'Coordinadores', icon: '📊', cycleScoped: false },
      { href: '/admin/asignaciones', label: 'Asignaciones', icon: '🔗', cycleScoped: true },
      { href: '/admin/evaluar-docentes', label: 'Evaluar Docentes', icon: '⭐', cycleScoped: true },
    ],
  },
  {
    nombre: 'Académico',
    icono: '🎓',
    items: [
      { href: '/admin/cuatrimestres', label: 'Cuatrimestres', icon: '📅', cycleScoped: false },
      { href: '/admin/ofertas', label: 'Ofertas Académicas', icon: '🎓', cycleScoped: false },
      { href: '/admin/grupos-asignados', label: 'Grupos asignados', icon: '📚', cycleScoped: true },
      { href: '/admin/campus', label: 'Campus', icon: '🏫', cycleScoped: false },
      { href: '/admin/turnos', label: 'Turnos', icon: '🕐', cycleScoped: false },
    ],
  },
  {
    nombre: 'Configuración',
    icono: '⚙️',
    items: [
      { href: '/admin/instrumentos', label: 'Instrumentos', icon: '📋', cycleScoped: false },
      { href: '/admin/planeaciones/acceso', label: 'Acceso a planeaciones', icon: '🔒', cycleScoped: true },
      { href: '/admin/roles', label: 'Roles', icon: '🔑', cycleScoped: false },
      { href: '/admin/usuarios', label: 'Usuarios', icon: '👥', cycleScoped: false },
      { href: '/admin/importar', label: 'Importar CSV', icon: '📤', cycleScoped: false },
      { href: '/admin/trazabilidad', label: 'Trazabilidad', icon: '🛡️', cycleScoped: false },
      { href: '/admin/avisos', label: 'Avisos institucionales', icon: '📢', cycleScoped: false },
    ],
  },
];

function isActive(href: string): boolean {
  const clean = href.split('?')[0];
  return pathname === clean || pathname.startsWith(clean + '/');
}
---

<BaseLayout titulo={titulo}>
  <!-- Barra superior móvil -->
  <div class="lg:hidden sticky top-0 z-50 bg-white border-b border-slate-200 px-4 h-14 flex items-center justify-between">
    <button id="menu-toggle" class="text-slate-600 p-2" onclick="document.getElementById('sidebar').classList.toggle('translate-x-0');document.getElementById('overlay').classList.toggle('hidden');">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
    <span class="font-semibold text-tup text-sm">SED-360</span>
    <NotificationBell />
  </div>

  <!-- Overlay oscuro (móvil) -->
  <div id="overlay" class="hidden fixed inset-0 z-40 bg-black/50 lg:hidden" onclick="document.getElementById('sidebar').classList.remove('translate-x-0');this.classList.add('hidden');"></div>

  <div class="flex min-h-screen">
    <!-- Sidebar: móvil (slide-in) + desktop (fixed) -->
    <aside id="sidebar" class="w-64 bg-white border-r border-slate-200 flex-shrink-0 flex flex-col fixed lg:static inset-y-0 left-0 z-50 -translate-x-full lg:translate-x-0 transition-transform duration-300">
      <div class="p-6 border-b border-slate-100 flex items-center justify-between">
        <a href={`/admin/dashboard${qs}`} class="flex flex-col items-center gap-2">
          <img src="/logo-tup.png" alt="TUP" class="w-20 h-20 lg:w-40 lg:h-40 object-contain" />
          <span class="font-semibold text-tup text-sm">SED-360</span>
        </a>
        <button class="lg:hidden text-slate-400" onclick="document.getElementById('sidebar').classList.remove('translate-x-0');document.getElementById('overlay').classList.add('hidden');">✕</button>
      </div>

      <nav class="flex-1 p-3 space-y-3 overflow-y-auto">
        {secciones.map((s, idx) => (
          <details open={idx === 0} class="group rounded-2xl">
            <summary class="flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold text-slate-400 uppercase tracking-wider cursor-pointer list-none hover:text-slate-600">
              <span>{s.icono} {s.nombre}</span>
              <svg class="w-3.5 h-3.5 transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="space-y-0.5 ml-4 mt-1.5">
              {s.items.map(item => (
                <a href={`${item.href}${item.cycleScoped ? qs : ''}`} class={`flex items-center gap-3 px-3 py-2 rounded-xl text-sm transition-colors ${isActive(item.href) ? 'bg-tup/10 text-tup font-medium' : 'text-slate-600 hover:bg-tup/5 hover:text-tup'}`}>
                  <span class="text-xs">{item.icon}</span> {item.label}
                </a>
              ))}
            </div>
          </details>
        ))}
      </nav>
      <div class="p-4 border-t border-slate-100"><a href="/api/auth/signout" class="flex items-center gap-2 text-xs text-slate-400 hover:text-red-500 transition-colors">🚪 Cerrar Sesión</a></div>
    </aside>

    <main class="flex-1 p-6 lg:p-8 overflow-auto"><slot /></main>
  </div>
</BaseLayout>
