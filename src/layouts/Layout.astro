---
export interface Props { titulo?: string; descripcion?: string; modoEnfoque?: boolean; }
const { titulo = 'SED-360', descripcion = 'Plataforma de Evaluacion Docente 360 — TUP', modoEnfoque = false } = Astro.props;
---
<!doctype html>
<html lang="es-MX" class="">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo-tup.png" />
    <title>{titulo}</title><meta name="description" content={descripcion} />
    <meta name="theme-color" content="#1B396A" media="(prefers-color-scheme: light)" />
    <meta property="og:title" content={titulo} /><meta property="og:description" content={descripcion} /><meta property="og:type" content="website" />
  </head>
  <body class="min-h-screen bg-fondo-dashboard dark:bg-gray-700 font-sans antialiased text-slate-800 dark:text-gray-100">
    <div class="fixed inset-0 overflow-hidden pointer-events-none -z-10" aria-hidden="true">
      <div class="absolute -top-40 -right-40 w-[500px] h-[500px] rounded-full bg-tup opacity-[0.03] dark:opacity-[0.06] blur-3xl"></div>
      <div class="absolute -bottom-32 -left-32 w-[400px] h-[400px] rounded-full bg-dorado opacity-[0.04] dark:opacity-[0.06] blur-3xl"></div>
    </div>

    <div class="relative flex flex-col min-h-screen">
      {!modoEnfoque && (
        <header class="sticky top-0 z-40 backdrop-blur-md bg-white/70 dark:bg-gray-700/70 border-b border-slate-200/50 dark:border-gray-700">
          <nav class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <a href="/" class="flex items-center gap-3 group">
              <img src="/logo-tup.png" alt="TUP" class="w-36 h-36 object-contain " />
              <span class="hidden sm:inline font-semibold text-tup dark:text-blue-200 text-lg">SED-360</span>
            </a>
            <div class="flex items-center gap-4"><slot name="acciones-nav" /></div>
          </nav>
        </header>
      )}
      <main class="flex-1 mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 py-6 sm:py-8"><slot /></main>
      {!modoEnfoque && (
        <footer class="border-t border-slate-200/50 dark:border-gray-700 bg-white/50 dark:bg-gray-700/50 backdrop-blur-sm">
          <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-4 text-center text-xs text-slate-400 dark:text-gray-500">
            <p>SED-360 &copy; {new Date().getFullYear()} — Tecnológico Universitario Playacar</p>
          </div>
        </footer>
      )}
    </div>

  </body>
</html>
<script is:inline>
<style is:global>
  html{scroll-behavior:smooth;-webkit-font-smoothing:antialiased}body{min-height:100dvh}@media(max-width:640px){html{font-size:15px}}button,a[role='button']{min-height:44px;min-width:44px}::selection{background-color:rgba(27,57,106,.2);color:#1B396A}
</style>
