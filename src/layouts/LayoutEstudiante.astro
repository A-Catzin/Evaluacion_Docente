---
import BaseLayout from './BaseLayout.astro';

export interface Props { titulo?: string; }
const { titulo = 'Estudiante — SED-360' } = Astro.props;
---
<BaseLayout titulo={titulo}>
  <div class="min-h-screen">
    <header class="sticky top-0 z-40 bg-white/80 backdrop-blur-md border-b border-slate-200/50 px-4 sm:px-6 h-14 flex items-center justify-between">
      <a href="/estudiante/dashboard" class="font-semibold text-tup text-sm sm:text-base">SED-360 · Estudiante</a>
      <div class="flex items-center gap-3"><a href="/avisos" class="text-xs text-slate-600 hover:text-tup">Avisos</a><a href="/api/auth/signout" class="text-xs text-slate-400 hover:text-red-500">Salir</a></div>
    </header>
    <main class="p-4 sm:p-6 max-w-3xl mx-auto"><slot /></main>
  </div>
</BaseLayout>
