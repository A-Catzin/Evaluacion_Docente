---
import LayoutObservador from '../../layouts/LayoutObservador.astro';
import { db } from '../../lib/db';
import { obtenerCuatrimestreActivo, obtenerCuatrimestres } from '../../services/catalogos';
import { getMyAssignedTeacherIds } from '../../lib/teacherAssignments';

const cliente = db();
const cuatrimestreActivo = await obtenerCuatrimestreActivo();
const cuatrimestres = await obtenerCuatrimestres();
const cuatrimestreIdCookie = Astro.cookies.get('cuatrimestre_sel')?.value;
const cuatrimestreIdParam = Astro.url.searchParams.get('cuatrimestre');
const cuatrimestreId = parseInt(cuatrimestreIdParam || '') || cuatrimestreActivo?.id || parseInt(cuatrimestreIdCookie || '') || 0;
const cuatrimestreQuery = cuatrimestreId ? `&cuatrimestre=${cuatrimestreId}` : '';
if (Astro.url.searchParams.has('cuatrimestre')) {
  Astro.cookies.set('cuatrimestre_sel', String(cuatrimestreId), { path: '/', maxAge: 60*60*24*30 });
}
const cuatrimestreSel = cuatrimestres.find(c=>c.id===cuatrimestreId);

// Obtener usuario actual y sus docentes asignados
const token = Astro.cookies.get('sb-access-token')?.value;
const refresh = Astro.cookies.get('sb-refresh-token')?.value;
let docentesAsignados = new Set<number>();
if (token && refresh) {
  const { data: s } = await cliente.auth.setSession({ access_token: token, refresh_token: refresh });
  if (s.user) {
    docentesAsignados = await getMyAssignedTeacherIds(cliente, 'observation', cuatrimestreId);
  }
}

const { data: docentes } = docentesAsignados.size
  ? await cliente.from('docentes').select('id,nombre,apellidos,email,campus,modalidad,visible_dashboard').in('id', [...docentesAsignados]).eq('activo', true).order('apellidos')
  : { data: [] };
const lista = (docentes || []).filter(d => d.visible_dashboard !== false);

const { data: gruposData } = await cliente.from('grupos').select('docente_id,asignatura_id,modalidad,clave').in('docente_id', lista.map(d => d.id));
const matPorDocente = new Map<number, number>();
const grupoPorDocente = new Map<number, string>();
for (const g of (gruposData || [])) {
  if (!matPorDocente.has(g.docente_id)) { matPorDocente.set(g.docente_id, 0); grupoPorDocente.set(g.docente_id, g.clave); }
  matPorDocente.set(g.docente_id, (matPorDocente.get(g.docente_id)||0) + 1);
}
---

<LayoutObservador titulo="Dashboard — Observador">
  <div class="max-w-5xl mx-auto">
    <div class="flex items-center justify-between mb-6">
      <div><h1 class="text-3xl font-bold text-tup">Panel de Observación</h1><p class="text-slate-500">{lista.length} docentes disponibles · {cuatrimestreSel?.clave||''}</p></div>
      <form method="GET" class="flex items-center gap-2">
        <select name="cuatrimestre" class="rounded-xl border border-slate-200 px-3 py-2 text-sm" onchange="this.form.submit()">
          {cuatrimestres.map(c => (<option value={c.id} selected={c.id===cuatrimestreId}>{c.clave}</option>))}
        </select>
      </form>
    </div>

    {lista.length === 0 ? (
      <div class="bg-white rounded-2xl p-12 text-center text-slate-400 shadow-tarjeta">No hay docentes disponibles para observación.</div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {lista.map(d => (
          <div class="bg-white rounded-2xl p-5 shadow-tarjeta hover:shadow-tarjeta-hover transition-shadow">
            <h3 class="font-semibold text-tup mb-1">{d.nombre.toUpperCase()} {d.apellidos.toUpperCase()}</h3>
            <p class="text-xs text-slate-400 mb-3">{d.email}</p>
            <div class="flex items-center gap-2 text-xs text-slate-500 mb-4">
              <span>{d.campus || '—'}</span><span>·</span><span>{d.modalidad || '—'}</span><span>·</span><span>{matPorDocente.get(d.id) || 0} grupos</span>
            </div>
            <a href={`/coordinador/captura/observacion?docente_id=${d.id}${cuatrimestreQuery}`} class="block text-center w-full px-4 py-2 rounded-xl bg-tup text-white text-sm font-medium hover:bg-tup/90 transition-colors">
              Iniciar Observación
            </a>
          </div>
        ))}
      </div>
    )}
  </div>
</LayoutObservador>
