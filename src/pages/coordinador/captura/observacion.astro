---
import LayoutCoordinador from '../../../layouts/LayoutCoordinador.astro';
import { db } from '../../../lib/db';
import { crearClienteConSesion } from '../../../lib/supabaseClient';
import { obtenerCuatrimestreActivo, obtenerCuatrimestres } from '../../../services/catalogos';
import { getInstrumentSubmissionWindow, instrumentSubmissionMessage } from '../../../lib/instrumentSubmissionWindow';
import { resolveCoordinatorCycle } from '../../../lib/coordinatorCycle';
import { newObservationFormats } from '../../../lib/newObservationFormats';

const cuatrimestreParam = Astro.url.searchParams.get('cuatrimestre');
const docenteIdParam = Astro.url.searchParams.get('docente_id');
const token = Astro.cookies.get('sb-access-token')?.value;
const client = token ? crearClienteConSesion(token) : db();
const [activeCycle, cycles] = await Promise.all([
  obtenerCuatrimestreActivo(client),
  obtenerCuatrimestres(client),
]);
const cycleId = resolveCoordinatorCycle({
  query: cuatrimestreParam,
  cookie: Astro.cookies.get('cuatrimestre_sel')?.value,
  active: activeCycle?.id,
  catalog: cycles,
});
if (cycleId > 0) {
  Astro.cookies.set('cuatrimestre_sel', String(cycleId), { path: '/', maxAge: 60 * 60 * 24 * 30 });
}
const params = new URLSearchParams();
if (docenteIdParam) params.set('docente_id', docenteIdParam);
if (cycleId > 0) params.set('cuatrimestre', String(cycleId));
const qs = params.toString() ? `?${params.toString()}` : '';
const window = await getInstrumentSubmissionWindow(client, cycleId, 'observation');
---
<LayoutCoordinador titulo="Observación — Coordinador">
  <div class="animate-flotar-entrada max-w-2xl mx-auto">
    <h1 class="text-3xl font-bold text-tup mb-2">Nueva Observación</h1>
    <p class="text-slate-500 mb-8">Selecciona el tipo de observación que deseas realizar</p>
    {window.state !== 'open' ? <div class="rounded-2xl bg-amber-50 p-6 text-amber-900" role="status">{instrumentSubmissionMessage('observation', window)}</div> : <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <a href={`/coordinador/captura/observacion-escolarizado${qs}`} class="bg-white rounded-2xl p-6 shadow-tarjeta hover:shadow-tarjeta-hover hover:scale-105 transition-all text-center group">
        <div class="w-16 h-16 mx-auto rounded-2xl bg-tup/10 flex items-center justify-center mb-4 group-hover:bg-tup/20 transition-colors"><span class="text-3xl">🏫</span></div>
        <h2 class="text-lg font-bold text-tup mb-2">Escolarizado</h2><p class="text-sm text-slate-500">Versión 1.2 con dimensiones, evidencia por sección y escala 1 a 3.</p>
      </a>
      <a href={`/coordinador/captura/observacion-virtual${qs}`} class="bg-white rounded-2xl p-6 shadow-tarjeta hover:shadow-tarjeta-hover hover:scale-105 transition-all text-center group">
        <div class="w-16 h-16 mx-auto rounded-2xl bg-blue-100 flex items-center justify-center mb-4 group-hover:bg-blue-200 transition-colors"><span class="text-3xl">💻</span></div>
        <h2 class="text-lg font-bold text-tup mb-2">Virtual</h2><p class="text-sm text-slate-500">Versión 1.2 con todos los criterios virtuales, incluido COM5.</p>
      </a>
      <a href={`/coordinador/captura/observacion-ejecutivo${qs}`} class="bg-white rounded-2xl p-6 shadow-tarjeta hover:shadow-tarjeta-hover hover:scale-105 transition-all text-center group">
        <div class="w-16 h-16 mx-auto rounded-2xl bg-amber-100 flex items-center justify-center mb-4 group-hover:bg-amber-200 transition-colors"><span class="text-3xl">💼</span></div>
        <h2 class="text-lg font-bold text-tup mb-2">Ejecutivo</h2><p class="text-sm text-slate-500">Versión 1.2 para sesión sabatina y trabajo autónomo.</p>
      </a>
      {newObservationFormats.map(format => <a href={`/coordinador/captura/observacion/${format.slug}${qs}`} class="bg-white rounded-2xl p-6 shadow-tarjeta hover:shadow-tarjeta-hover hover:scale-105 transition-all text-center group">
        <div class="w-16 h-16 mx-auto rounded-2xl bg-tup/10 flex items-center justify-center mb-4 group-hover:bg-tup/20 transition-colors"><span class="text-3xl">📋</span></div>
        <h2 class="text-lg font-bold text-tup mb-2">{format.title}</h2>
        <p class="text-sm text-slate-500">Instrumento de observación.</p>
      </a>)}
    </div>}
  </div>
</LayoutCoordinador>
