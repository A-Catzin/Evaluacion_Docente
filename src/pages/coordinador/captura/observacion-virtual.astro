---
import LayoutCoordinador from '../../../layouts/LayoutCoordinador.astro';
import VersionedInstrumentCapture from '../../../components/VersionedInstrumentCapture.astro';
import { obtenerCuatrimestreActivo } from '../../../services/catalogos';
import { db } from '../../../lib/db';
import { getMyAssignedTeacherIds } from '../../../lib/teacherAssignments';
import { getActiveInstrumentDefinition } from '../../../lib/versionedInstruments';
const client = db(); const activeCycle = await obtenerCuatrimestreActivo(); const cycleId = Number.parseInt(Astro.url.searchParams.get('cuatrimestre') || '', 10) || activeCycle?.id || 0;
const token = Astro.cookies.get('sb-access-token')?.value; const refresh = Astro.cookies.get('sb-refresh-token')?.value; if (token && refresh) await client.auth.setSession({ access_token: token, refresh_token: refresh });
const ids = await getMyAssignedTeacherIds(client, 'observation', cycleId);
const { data: teachers } = ids.size ? await client.from('docentes').select('id,nombre,apellidos,campus').in('id', [...ids]).eq('activo', true).order('apellidos') : { data: [] };
const { data: groups } = ids.size ? await client.from('grupos').select('clave,docente_id,asignatura_id').in('docente_id', [...ids]).eq('cuatrimestre_id', cycleId) : { data: [] };
const { data: subjects } = await client.from('asignaturas').select('id,nombre').order('nombre'); const definition = await getActiveInstrumentDefinition(client, 'observation_virtual'); const selectedTeacherId = Number.parseInt(Astro.url.searchParams.get('docente_id') || '', 10) || undefined;
---
<LayoutCoordinador titulo="Observación Virtual"><div class="animate-flotar-entrada max-w-4xl mx-auto"><h1 class="text-3xl font-bold text-tup mb-2">Observación de clase virtual</h1><p class="text-slate-500 mb-6">Versión 1.2 · Escala 1 a 3 · incluye los cinco criterios comunicativos.</p>{definition ? <VersionedInstrumentCapture definition={definition} cuatrimestreId={cycleId} teachers={teachers || []} groups={groups || []} subjects={subjects || []} selectedTeacherId={selectedTeacherId} returnUrl={`/coordinador/dashboard?cuatrimestre=${cycleId}`} /> : <div class="rounded-2xl bg-amber-50 p-6 text-amber-900">No hay una versión vigente del instrumento.</div>}</div></LayoutCoordinador>
