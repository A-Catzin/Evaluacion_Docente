---
import LayoutCoordinador from '../../layouts/LayoutCoordinador.astro';
import { db } from '../../lib/db';
import { obtenerCuatrimestreActivo, obtenerCuatrimestres } from '../../services/catalogos';
import { formatScore } from '../../services/scoring';

const cliente = db();
const cuatrimestreActivo = await obtenerCuatrimestreActivo();
const cuatrimestres = await obtenerCuatrimestres();
const cuatrimestreIdCookie = Astro.cookies.get('cuatrimestre_sel')?.value;

const modo = (Astro.url.searchParams.get('modo') || 'individual') as 'individual' | 'general';

const cuatrimestreIdParam = Astro.url.searchParams.get('cuatrimestre');
const cuatrimestreId = parseInt(cuatrimestreIdParam || '') || cuatrimestreActivo?.id || parseInt(cuatrimestreIdCookie || '') || 0;
const cuatrimestreSel = cuatrimestres.find(c => c.id === cuatrimestreId);

const token = Astro.cookies.get('sb-access-token')?.value;
const refresh = Astro.cookies.get('sb-refresh-token')?.value;
let userId = '';
if (token && refresh) {
  const { data: s } = await cliente.auth.setSession({ access_token: token, refresh_token: refresh });
  if (s.user) userId = s.user.id;
}

function fmt(n: any) { return formatScore(n) }
function colorN(n: any) { return !n ? 'text-slate-400' : n >= 80 ? 'text-emerald-600' : n >= 60 ? 'text-amber-600' : 'text-red-600' }

let individualData: any = null;
if (modo === 'individual') {
  const { data: asigs } = userId
    ? await cliente.from('coordinador_docentes').select('docente_id').eq('coordinador_id', userId).eq('cuatrimestre_id', cuatrimestreId)
    : { data: [] };
  const asigIds = new Set((asigs || []).map(a => a.docente_id));
  const ids = [...asigIds];

  // Scores ya calculados; usamos la vista materializada para listados grandes.
  const { data: aggData, error: aggError } = ids.length
    ? await cliente
        .from('resultados_agregados')
        .select('*')
        .eq('cuatrimestre_id', cuatrimestreId)
        .in('docente_id', ids)
    : { data: [], error: null };
  if (aggError) throw aggError;

  const { data: annualData, error: annualError } = ids.length
    ? await cliente
        .from('resultados_agregados')
        .select('docente_id,cuatrimestre_id,calificacion_final,num_instrumentos_completados')
        .in('docente_id', ids)
    : { data: [], error: null };
  if (annualError) throw annualError;

  const anualMap = new Map<number, { sum: number; count: number }>();
  for (const row of (annualData || [])) {
    if (Number(row.num_instrumentos_completados || 0) > 0) {
      const docId = Number(row.docente_id);
      const acc = anualMap.get(docId) || { sum: 0, count: 0 };
      acc.sum += Number(row.calificacion_final);
      acc.count++;
      anualMap.set(docId, acc);
    }
  }

  individualData = {
    docentes: (aggData || [])
      .filter((row: any) => Number(row.num_instrumentos_completados || 0) > 0)
      .map((row: any) => ({
        id: Number(row.docente_id),
        nombre: String(row.docente_nombre ?? ''),
        apellidos: String(row.docente_apellidos ?? ''),
        email: String(row.docente_email ?? ''),
        modalidad: String(row.modalidad_snapshot ?? ''),
        ee: row.score_encuesta_estudiantil != null ? Number(row.score_encuesta_estudiantil) : null,
        coord: row.score_coordinacion != null ? Number(row.score_coordinacion) : null,
        plan: row.score_planeacion != null ? Number(row.score_planeacion) : null,
        obs: row.score_observacion != null ? Number(row.score_observacion) : null,
        auto: row.score_autoevaluacion != null ? Number(row.score_autoevaluacion) : null,
        final: Number(row.calificacion_final),
        category: String(row.categoria_final ?? ''),
        instrumentCount: Number(row.num_instrumentos_completados || 0),
      }))
      .sort((a: any, b: any) => a.apellidos.localeCompare(b.apellidos)),
    anualMap,
  };
}

let generalData: any = null;
if (modo === 'general') {
  const cicloIdsParam = Astro.url.searchParams.get('ciclos') || '';
  const cicloIds = cicloIdsParam
    .split(',')
    .map((id: string) => parseInt(id.trim()))
    .filter((id: number) => !isNaN(id) && id > 0)
    .slice(0, 3);

  if (cicloIds.length) {
    const { data: asigs } = userId
      ? await cliente.from('coordinador_docentes').select('docente_id').eq('coordinador_id', userId).in('cuatrimestre_id', cicloIds)
      : { data: [] };
    const allDocIds = [...new Set((asigs || []).map(a => a.docente_id))];

    // Scores ya calculados; usamos la vista materializada para listados grandes.
    const { data: aggData, error: aggError } = allDocIds.length
      ? await cliente
          .from('resultados_agregados')
          .select('*')
          .in('docente_id', allDocIds)
          .in('cuatrimestre_id', cicloIds)
      : { data: [], error: null };
    if (aggError) throw aggError;

    const docenteMap = new Map<number, any>();
    for (const row of (aggData || [])) {
      const id = Number(row.docente_id);
      if (!docenteMap.has(id)) {
        docenteMap.set(id, {
          id,
          nombre: String(row.docente_nombre ?? ''),
          apellidos: String(row.docente_apellidos ?? ''),
          email: String(row.docente_email ?? ''),
          campus: String(row.docente_campus ?? ''),
          modalidad: String(row.modalidad_snapshot ?? ''),
          puntajes: {},
        });
      }
      const doc = docenteMap.get(id)!;
      const cid = Number(row.cuatrimestre_id);
      doc.puntajes[cid] = Number(row.num_instrumentos_completados || 0) > 0
        ? Number(row.calificacion_final)
        : null;
    }

    generalData = {
      cicloIds,
      cuatrisSeleccionados: cuatrimestres.filter(c => cicloIds.includes(c.id)),
      docentes: [...docenteMap.values()]
        .map((d: any) => {
          const vals = cicloIds.map(cid => d.puntajes[cid]).filter((v: any) => v != null) as number[];
          return {
            ...d,
            promedioAnual: vals.length ? Math.round(vals.reduce((a: number, b: number) => a + b, 0) / vals.length) : null,
          };
        })
        .sort((a: any, b: any) => a.apellidos.localeCompare(b.apellidos)),
    };
  }
}
---

<LayoutCoordinador titulo="Reportes — Coordinador">
  <div class="animate-flotar-entrada max-w-6xl mx-auto">
    <div class="flex items-center justify-between mb-6 flex-wrap gap-4">
      <div>
        <h1 class="text-3xl font-bold text-tup">Reportes de Desempeño</h1>
        <p class="text-slate-500">{modo === 'individual' ? `${individualData?.docentes?.length || 0} docentes asignados · ${cuatrimestreSel?.clave || ''}` : 'Reporte general comparativo'}</p>
      </div>
    </div>

    <div class="bg-white rounded-2xl p-4 shadow-tarjeta mb-6">
      <form method="GET" class="flex flex-wrap gap-4 items-center">
        <div class="flex items-center gap-2">
          <label class="text-sm font-medium text-slate-700">Modo:</label>
          <select name="modo" class="rounded-xl border border-slate-200 px-3 py-2 text-sm" onchange="this.form.submit()">
            <option value="individual" selected={modo === 'individual'}>Reporte individual</option>
            <option value="general" selected={modo === 'general'}>Reporte general</option>
          </select>
        </div>

        {modo === 'individual' ? (
          <div class="flex items-center gap-2 ml-auto">
            <select name="cuatrimestre" class="rounded-xl border border-slate-200 px-3 py-2 text-sm" onchange="this.form.submit()">
              {cuatrimestres.map(c => (<option value={c.id} selected={c.id === cuatrimestreId}>{c.clave}</option>))}
            </select>
            <a href={`/api/coordinador/reporte-cuatrimestre?cuatrimestre_id=${cuatrimestreId}`} class="px-4 py-2 rounded-xl bg-emerald-600 text-white text-xs font-medium">Descargar CSV</a>
          </div>
        ) : (
          <div class="flex items-center gap-2 ml-auto">
            <label class="text-sm font-medium text-slate-700">Ciclos:</label>
            <select name="ciclos" class="rounded-xl border border-slate-200 px-3 py-2 text-sm" onchange="this.form.submit()" multiple>
              {cuatrimestres.map(c => {
                const selected = generalData ? generalData.cicloIds.includes(c.id) : false;
                return <option value={c.id} selected={selected}>{c.clave}</option>;
              })}
            </select>
            <button type="submit" class="px-4 py-2 rounded-xl bg-tup text-white text-xs font-medium">Aplicar</button>
            {generalData && generalData.docentes.length > 0 && (
              <a href={`/api/coordinador/reporte-general?ciclos=${(generalData.cicloIds as number[]).join(',')}&format=csv`} class="px-4 py-2 rounded-xl bg-emerald-600 text-white text-xs font-medium">Descargar CSV</a>
            )}
          </div>
        )}
      </form>
    </div>

    {modo === 'individual' && (
      (individualData?.docentes || []).length === 0 ? (
        <div class="bg-white rounded-2xl p-12 text-center text-slate-400 shadow-tarjeta">No tienes docentes asignados en este cuatrimestre.</div>
      ) : (
        <div class="bg-white rounded-2xl shadow-tarjeta overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead><tr class="bg-slate-50 border-b">
                <th class="text-left px-3 py-3 text-xs uppercase">Docente</th>
                <th class="text-center px-2 py-3 text-xs uppercase">EE</th>
                <th class="text-center px-2 py-3 text-xs uppercase">Coord</th>
                <th class="text-center px-2 py-3 text-xs uppercase">Plan</th>
                <th class="text-center px-2 py-3 text-xs uppercase">Obs</th>
                <th class="text-center px-2 py-3 text-xs uppercase">Auto</th>
                <th class="text-center px-2 py-3 text-xs uppercase">Final</th>
                <th class="text-center px-2 py-3 text-xs uppercase">Cat</th>
                <th class="text-center px-2 py-3 text-xs uppercase bg-tup/10 text-tup">Prom. anual</th>
              </tr></thead>
              <tbody class="divide-y">
{individualData?.docentes?.map((d: any) => {
                  const anual = individualData.anualMap.get(d.id);
                  const anualAvg = anual && anual.count > 0 ? Math.round(anual.sum / anual.count) : null;
                  return (
                    <tr class="hover:bg-slate-50">
                      <td class="px-3 py-2"><p class="font-medium text-xs">{d.nombre.toUpperCase()} {d.apellidos.toUpperCase()}</p><p class="text-[10px] text-slate-400">{d.email}</p></td>
                      <td class={"px-2 py-2 text-center font-medium " + colorN(d.ee)}>{fmt(d.ee)}</td>
                      <td class={"px-2 py-2 text-center font-medium " + colorN(d.coord)}>{fmt(d.coord)}</td>
                      <td class={"px-2 py-2 text-center font-medium " + colorN(d.plan)}>{fmt(d.plan)}</td>
                      <td class={"px-2 py-2 text-center font-medium " + colorN(d.obs)}>{fmt(d.obs)}</td>
                      <td class={"px-2 py-2 text-center font-medium " + colorN(d.auto)}>{fmt(d.auto)}</td>
                      <td class={"px-2 py-2 text-center font-bold " + colorN(d.final)}>{d.instrumentCount > 0 ? fmt(d.final) : '—'}</td>
                      <td class="px-2 py-2 text-center"><span class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-slate-100">{d.category}</span></td>
                      <td class={"px-2 py-2 text-center font-bold bg-tup/5 " + colorN(anualAvg)}>{fmt(anualAvg)}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
      )
    )}

    {modo === 'general' && (
      !generalData || generalData.docentes.length === 0 ? (
        <div class="bg-white rounded-2xl p-12 text-center text-slate-400 shadow-tarjeta">
          {generalData && !generalData.cuatrisSeleccionados.length
            ? 'Selecciona 1 a 3 cuatrimestres para ver el reporte comparativo.'
            : 'No tienes docentes asignados en los cuatrimestres seleccionados.'}
        </div>
      ) : (
        <div class="bg-white rounded-2xl shadow-tarjeta overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead><tr class="bg-slate-50 border-b">
                <th class="text-left px-3 py-3 text-xs uppercase">Nombre</th>
                <th class="text-left px-3 py-3 text-xs uppercase">Email</th>
                <th class="text-left px-3 py-3 text-xs uppercase">Campus</th>
                {generalData.cuatrisSeleccionados.map((c: any) => (
                  <th class="text-center px-2 py-3 text-xs uppercase">{c.clave}</th>
                ))}
                <th class="text-center px-2 py-3 text-xs uppercase bg-tup/10 text-tup">Prom. anual</th>
              </tr></thead>
              <tbody class="divide-y">
                {generalData.docentes.map((d: any) => (
                  <tr class="hover:bg-slate-50">
                    <td class="px-3 py-2"><p class="font-medium text-xs">{d.nombre.toUpperCase()} {d.apellidos.toUpperCase()}</p></td>
                    <td class="px-3 py-2 text-xs text-slate-500">{d.email}</td>
                    <td class="px-3 py-2 text-xs text-slate-500">{d.campus || '—'}</td>
                    {generalData.cuatrisSeleccionados.map((c: any) => {
                      const val = d.puntajes[c.id];
                      return <td class={"px-2 py-2 text-center font-bold " + colorN(val)}>{fmt(val)}</td>;
                    })}
                    <td class={"px-2 py-2 text-center font-bold bg-tup/5 " + colorN(d.promedioAnual)}>{fmt(d.promedioAnual)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )
    )}
  </div>
</LayoutCoordinador>
