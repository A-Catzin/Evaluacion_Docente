---
import LayoutCoordinador from '../../layouts/LayoutCoordinador.astro';
import { obtenerCuatrimestreActivo, obtenerCuatrimestres } from '../../services/catalogos';
import { db, dbAdmin } from '../../lib/db';
import { crearClienteConSesion } from '../../lib/supabaseClient';
import { formatPersonName } from '../../lib/personName';
import { resolveCoordinatorCycle } from '../../lib/coordinatorCycle';
    import { formatScore } from '../../services/scoring';
import {
  buildCoordinatedPortfolio,
  buildObservationPortfolio,
  coordinatedPortfolioLinks,
  observationPortfolioLinks,
  summarizeObserverObservations,
  summarizeVersionedCoordination,
  type PortfolioTeacher,
} from '../../lib/coordinatorDashboardPortfolio';

const token = Astro.cookies.get('sb-access-token')?.value;
    const cliente = token ? crearClienteConSesion(token) : db();
    const clienteAdmin = dbAdmin();
    const userId = token || '';
    let actorId = '';
    if (token) {
      try {
        const { data } = await cliente.auth.getUser();
        actorId = data.user?.id || '';
      } catch (error) {
        console.warn('No se pudo identificar al coordinador actual', error);
      }
    }
let cuatrimestres = [] as Awaited<ReturnType<typeof obtenerCuatrimestres>>;
let cuatrimestreActivo: Awaited<ReturnType<typeof obtenerCuatrimestreActivo>> = null;

try {
  cuatrimestres = await obtenerCuatrimestres(cliente);
} catch (error) {
  console.error('No se pudo cargar el catálogo de ciclos para el dashboard coordinador', error);
}

try {
  cuatrimestreActivo = await obtenerCuatrimestreActivo(cliente);
} catch (error) {
  console.error('No se pudo cargar el ciclo activo para el dashboard coordinador', error);
}

const cuatrimestreQuery = Astro.url.searchParams.get('cuatrimestre');
const cuatrimestreCookie = Astro.cookies.get('cuatrimestre_sel')?.value;
const cuatrimestreId = resolveCoordinatorCycle({
  query: cuatrimestreQuery,
  cookie: cuatrimestreCookie,
  active: cuatrimestreActivo?.id,
  catalog: cuatrimestres,
});
const cuatrimestreSel = cuatrimestres.find((cuatrimestre) => cuatrimestre.id === cuatrimestreId);

if (cuatrimestreId > 0) {
  Astro.cookies.set('cuatrimestre_sel', String(cuatrimestreId), { path: '/', maxAge: 60 * 60 * 24 * 30 });
}

const busqueda = Astro.url.searchParams.get('q') || '';
    const assignmentLoadErrors: string[] = [];
    if (token && !actorId) assignmentLoadErrors.push('No se pudo identificar la sesión del coordinador.');

async function getPortfolioTeachers(ids: Set<number>): Promise<PortfolioTeacher[]> {
  if (!ids.size) return [];
  const { data } = await clienteAdmin
    .from('docentes')
    .select('id,nombre,apellidos,modalidad')
    .in('id', [...ids])
    .eq('activo', true)
    .order('apellidos');
  return (data || []).map((teacher) => ({
    id: teacher.id,
    nombre: teacher.nombre,
    apellidos: teacher.apellidos,
    modalidad: teacher.modalidad,
  }));
}

async function getAssignedTeacherIds(purpose: 'coordinated' | 'observation'): Promise<Set<number>> {
  if (!actorId || !Number.isSafeInteger(cuatrimestreId) || cuatrimestreId <= 0) return new Set();
  const table = purpose === 'coordinated' ? 'coordinated_teacher_assignments' : 'observation_teacher_assignments';
  const actorColumn = purpose === 'coordinated' ? 'coordinador_id' : 'evaluator_id';
  try {
    const { data, error } = await clienteAdmin
      .from(table)
      .select('docente_id')
      .eq(actorColumn, actorId)
      .eq('cuatrimestre_id', cuatrimestreId)
      .is('revoked_at', null);
        if (error) {
          assignmentLoadErrors.push(`No se pudieron cargar las asignaciones de ${purpose}.`);
          console.warn(`No se pudieron cargar asignaciones de ${purpose}`, error);
          return new Set();
        }
    return new Set((data || []).map((row) => Number(row.docente_id)).filter(Number.isSafeInteger));
  } catch (error) {
    assignmentLoadErrors.push(`No se pudieron cargar las asignaciones de ${purpose}.`);
    console.warn(`No se pudieron cargar asignaciones de ${purpose}`, error);
    return new Set();
  }
}

const [docentesCoordinadosIds, docentesObservacionIds] = userId
  ? await Promise.all([getAssignedTeacherIds('coordinated'), getAssignedTeacherIds('observation')])
  : [new Set<number>(), new Set<number>()];


    type CoordinatorSchedule = { dia_semana: number; hora_inicio: string; hora_fin: string; aula: string | null; activo: boolean };
    type CoordinatorGroup = {
      id: number;
      docente_id: number;
      clave: string | null;
      grupo_normalizado: string | null;
      asignaturas: { nombre?: string | null } | { nombre?: string | null }[] | null;
      horarios_grupo: CoordinatorSchedule[] | null;
    };
    type CoordinatorPlanning = {
      id: number;
      docente_id: number;
      grupo: string | null;
      url_pdf: string | null;
      pdfUrl: string | null;
      estado: string | null;
      asignaturas: { nombre?: string | null } | { nombre?: string | null }[] | null;
        };
        async function safeQuery<T>(query: PromiseLike<T>, fallback: T): Promise<T> {
          try {
            return await query;
          } catch (error) {
            console.warn('No se pudo cargar un bloque del panel de coordinación', error);
            return fallback;
          }
        }

const [docentesCoordinados, docentesObservacion, coordinacionData, versionedCoordinationData, planeacionData, observacionData, versionedObservationData, calificaciones, observationPlanningData] = await Promise.all([
  getPortfolioTeachers(docentesCoordinadosIds),
  getPortfolioTeachers(docentesObservacionIds),
  docentesCoordinadosIds.size
    ? cliente.from('evaluacion_coordinacion').select('docente_id').eq('cuatrimestre_id', cuatrimestreId).in('docente_id', [...docentesCoordinadosIds])
    : Promise.resolve({ data: [] as { docente_id: number }[] }),
  docentesCoordinadosIds.size
    ? clienteAdmin.from('instrument_submissions').select('docente_id,normalized_score,validity_status').eq('cuatrimestre_id', cuatrimestreId).eq('purpose', 'coordination').in('docente_id', [...docentesCoordinadosIds]).order('submitted_at', { ascending: false })
    : Promise.resolve({ data: [] as { docente_id: number; normalized_score: number | null; validity_status: string | null }[] }),
  docentesCoordinadosIds.size
    ? cliente.from('planeaciones').select('docente_id,estado').eq('cuatrimestre_id', cuatrimestreId).in('docente_id', [...docentesCoordinadosIds])
    : Promise.resolve({ data: [] as { docente_id: number; estado: string }[] }),
  docentesObservacionIds.size
    ? cliente.from('observaciones').select('docente_id,evaluador_id,score_normalizado,fecha_observacion,id').eq('evaluador_id', actorId).eq('cuatrimestre_id', cuatrimestreId).in('docente_id', [...docentesObservacionIds]).order('fecha_observacion', { ascending: false }).order('id', { ascending: false })
    : Promise.resolve({ data: [] as { docente_id: number }[] }),
  docentesObservacionIds.size
    ? clienteAdmin.from('instrument_submissions').select('id,docente_id,normalized_score,submitted_at,submitted_by,validity_status').eq('cuatrimestre_id', cuatrimestreId).eq('purpose', 'observation').in('docente_id', [...docentesObservacionIds]).order('submitted_at', { ascending: false }).order('id', { ascending: false })
    : Promise.resolve({ data: [] as { docente_id: number }[] }),
  docentesCoordinadosIds.size
? clienteAdmin.from('calificaciones_finales').select('docente_id').eq('cuatrimestre_id', cuatrimestreId).gt('num_instrumentos_completados', 0).in('docente_id', [...docentesCoordinadosIds])
: Promise.resolve({ data: [] as { docente_id: number }[] }),

  docentesObservacionIds.size
? safeQuery(
clienteAdmin.from('planeaciones').select('id,docente_id,grupo,url_pdf,estado,asignaturas(nombre)').eq('cuatrimestre_id', cuatrimestreId).in('docente_id', [...docentesObservacionIds]),
{ data: [], error: null } as { data: CoordinatorPlanning[]; error: null },
  )
: Promise.resolve({ data: [] as CoordinatorPlanning[] }),
]);

    const observationGroupsResult = docentesObservacionIds.size
      ? await safeQuery(
          clienteAdmin
            .from('grupos')
            .select('id,docente_id,clave,grupo_normalizado,asignaturas(nombre),horarios_grupo(dia_semana,hora_inicio,hora_fin,aula,activo)')
            .eq('cuatrimestre_id', cuatrimestreId)
            .eq('activo', true)
            .in('docente_id', [...docentesObservacionIds])
            .order('grupo_normalizado'),
          { data: [], error: null } as { data: CoordinatorGroup[]; error: null },
        )
      : { data: [], error: null };

const planningRows = (observationPlanningData.data || []) as Omit<CoordinatorPlanning, 'pdfUrl'>[];
const { obtenerUrlFirmadaDesdeUrlAlmacenada } = await import('../../lib/storage');
const observationPlannings = await Promise.all(planningRows.map(async (planning) => {
  let pdfUrl = planning.url_pdf;
  try {
    const signed = await obtenerUrlFirmadaDesdeUrlAlmacenada(planning.url_pdf || '', 3600);
    if (signed) pdfUrl = signed;
  } catch {}
  return { ...planning, pdfUrl };
}));
const observationGroups = (observationGroupsResult.data || []) as CoordinatorGroup[];
const groupsByTeacher = new Map<number, CoordinatorGroup[]>();
const planningByTeacher = new Map<number, CoordinatorPlanning[]>();
for (const group of observationGroups) groupsByTeacher.set(group.docente_id, [...(groupsByTeacher.get(group.docente_id) || []), group]);
for (const planning of observationPlannings) planningByTeacher.set(planning.docente_id, [...(planningByTeacher.get(planning.docente_id) || []), planning]);
const relationName = (relation: CoordinatorGroup['asignaturas'] | CoordinatorPlanning['asignaturas']) => {
  const value = Array.isArray(relation) ? relation[0] : relation;
  return value?.nombre || '';
};
const diasSemana = ['', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'];
const formatearHora = (hora: string) => hora.slice(0, 5);
const observationCards = docentesObservacion.map((teacher) => ({
  teacher,
  teacherName: formatPersonName(`${teacher.nombre || ''} ${teacher.apellidos || ''}`.trim()) || `Docente #${teacher.id}`,
  groups: groupsByTeacher.get(teacher.id) || [],
  plannings: planningByTeacher.get(teacher.id) || [],
}));

const coordinatedPortfolio = buildCoordinatedPortfolio(
  docentesCoordinados,
  new Set((coordinacionData.data || []).map((evaluation) => evaluation.docente_id)),
  (planeacionData.data || []).map((planning) => ({ docenteId: planning.docente_id, estado: planning.estado })),

  new Set((calificaciones.data || []).map((score) => score.docente_id)),
  summarizeVersionedCoordination(versionedCoordinationData.data || []),
);
const summary = summarizeObserverObservations(
  versionedObservationData.data || [],
  observacionData.data || [],
  actorId,
);
const completedObservationTeacherIds = summary.completedTeacherIds;
const observationScores = summary.ownLatestScores;
const observationPortfolio = buildObservationPortfolio(
  docentesObservacion,
  completedObservationTeacherIds,
  observationScores,
  summary.registeredByOthers,
);


function matchesSearch(teacher: PortfolioTeacher) {
  const normalized = busqueda.trim().toLocaleLowerCase();
  return !normalized || `${teacher.nombre} ${teacher.apellidos}`.toLocaleLowerCase().includes(normalized);
}

const coordinatedRows = coordinatedPortfolio.filter((row) => matchesSearch(row.teacher));
const observationRows = observationPortfolio.filter((row) => matchesSearch(row.teacher));
const observationCardRows = observationCards.filter((row) => matchesSearch(row.teacher));
const coordinationPending = coordinatedPortfolio.filter((row) => !row.coordinationCompleted).length;
const planningPending = coordinatedPortfolio.reduce((total, row) => total + row.planningPending, 0);
const observationPending = observationPortfolio.filter((row) => !row.observationCompleted && !row.observationRegisteredByOther).length;
const resultsAvailable = coordinatedPortfolio.filter((row) => row.resultsAvailable).length;
const qs = cuatrimestreId ? `?cuatrimestre=${cuatrimestreId}` : '';
---

<LayoutCoordinador titulo="Panel de coordinación">
  <div class="animate-flotar-entrada space-y-8">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-sm font-medium text-tup">Ciclo seleccionado: {cuatrimestreSel?.clave || cuatrimestreSel?.nombre || 'Sin ciclo'}</p>
        <h1 class="mt-1 text-3xl font-bold text-tup">Portafolios de coordinación</h1>
        <p class="mt-2 max-w-3xl text-sm text-slate-500">Las asignaciones de coordinación y de observación se gestionan por separado. Una no concede acceso a la otra.</p>
      </div>
      <form method="GET" action="/coordinador/dashboard" class="flex items-center gap-2">
        <label for="cuatrimestre" class="text-sm font-medium text-slate-700">Ciclo</label>
        <select id="cuatrimestre" name="cuatrimestre" class="rounded-xl border border-slate-200 px-3 py-2 text-sm" onchange="this.form.submit()">
          {cuatrimestres.map((cuatrimestre) => (<option value={cuatrimestre.id} selected={cuatrimestre.id === cuatrimestreId}>{cuatrimestre.clave || cuatrimestre.nombre || ''}</option>))}
        </select>
      </form>
    </div>

    {assignmentLoadErrors.length > 0 && <div role="alert" class="rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900"><p class="font-semibold">No se pudieron verificar todas las asignaciones.</p><p class="mt-1">{assignmentLoadErrors.join(' ') } Actualizá la página o solicitá soporte; no se mostrará una lista vacía como si no hubiera asignaciones.</p></div>}

    <form method="GET" class="flex flex-wrap gap-3 rounded-2xl bg-white p-4 shadow-tarjeta">
      <input type="hidden" name="cuatrimestre" value={cuatrimestreId} />
      <label for="buscar-docente" class="sr-only">Buscar en ambos portafolios</label>
      <input id="buscar-docente" type="search" name="q" value={busqueda} placeholder="Buscar docente por nombre o apellidos" class="min-w-0 flex-1 rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-tup" />
      <button type="submit" class="rounded-xl bg-tup px-4 py-2.5 text-sm font-medium text-white">Buscar</button>
      {busqueda && <a href={`/coordinador/dashboard${qs}`} class="rounded-xl border border-slate-200 px-4 py-2.5 text-sm text-slate-600">Limpiar</a>}
    </form>

    <section aria-labelledby="coordinados-title" class="rounded-2xl border border-tup/15 bg-white shadow-tarjeta">
      <div class="flex flex-wrap items-start justify-between gap-4 border-b border-slate-100 p-5 sm:p-6">
        <div>
          <h2 id="coordinados-title" class="text-xl font-bold text-tup">Docentes coordinados</h2>
          <p class="mt-1 text-sm text-slate-500">Evaluación de coordinación, planeaciones, desempeño y reportes del ciclo.</p>
        </div>
        <span class="rounded-full bg-tup/10 px-3 py-1 text-sm font-semibold text-tup">{coordinatedPortfolio.length} asignados</span>
      </div>
      <div class="grid grid-cols-2 gap-px border-b border-slate-100 bg-slate-100 sm:grid-cols-4">
        <div class="bg-white p-4"><p class="text-xs font-medium uppercase tracking-wide text-slate-500">Coordinación pendiente</p><p class="mt-1 text-2xl font-bold text-amber-600">{coordinationPending}</p></div>
        <div class="bg-white p-4"><p class="text-xs font-medium uppercase tracking-wide text-slate-500">Planeaciones pendientes</p><p class="mt-1 text-2xl font-bold text-amber-600">{planningPending}</p></div>
        <div class="bg-white p-4"><p class="text-xs font-medium uppercase tracking-wide text-slate-500">Con resultados</p><p class="mt-1 text-2xl font-bold text-emerald-600">{resultsAvailable}</p></div>
        <div class="bg-white p-4"><p class="text-xs font-medium uppercase tracking-wide text-slate-500">Sin resultados aún</p><p class="mt-1 text-2xl font-bold text-slate-700">{coordinatedPortfolio.length - resultsAvailable}</p></div>
      </div>
      {coordinatedRows.length === 0 ? (
        <div class="p-10 text-center text-sm text-slate-500">{busqueda ? 'No hay docentes coordinados que coincidan con la búsqueda.' : 'No tienes docentes coordinados asignados en este ciclo.'}</div>
          ) : (
            <div class="overflow-x-auto">
              <table class="w-full min-w-[760px] text-sm">
                <caption class="sr-only">Docentes con asignación activa de coordinación</caption>
                <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500"><tr><th class="px-5 py-3">Docente</th><th class="px-4 py-3">Coordinación</th><th class="px-4 py-3">Planeaciones</th><th class="px-4 py-3">Resultados</th><th class="px-5 py-3 text-right">Acciones</th></tr></thead>
                <tbody class="divide-y divide-slate-100">
                  {coordinatedRows.map((row) => {
                    const links = coordinatedPortfolioLinks(cuatrimestreId, row.teacher.id);
                    return <tr class="align-top hover:bg-slate-50/70">
                      <td class="px-5 py-4"><p class="font-semibold text-slate-800">{formatPersonName(`${row.teacher.nombre} ${row.teacher.apellidos}`)}</p><p class="mt-1 text-xs text-slate-500">{row.teacher.modalidad || 'Modalidad no registrada'}</p></td>
                      <td class="px-4 py-4"><span class={`rounded-full px-2.5 py-1 text-xs font-medium ${row.coordinationCompleted ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700'}`}>{row.coordinationCompleted ? (row.coordinationScore !== null ? `Registrada · ${formatScore(row.coordinationScore)}` : 'Registrada') : 'Pendiente'}</span></td>
                      <td class="px-4 py-4"><p class="font-medium text-slate-700">{row.planningSubmitted} entregada{row.planningSubmitted === 1 ? '' : 's'}</p><p class="mt-1 text-xs text-slate-500">{row.planningPending} pendiente{row.planningPending === 1 ? '' : 's'} · {row.planningReviewed} evaluada{row.planningReviewed === 1 ? '' : 's'}</p></td>
                      <td class="px-4 py-4"><span class={`rounded-full px-2.5 py-1 text-xs font-medium ${row.resultsAvailable ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-600'}`}>{row.resultsAvailable ? 'Disponibles' : 'Sin consolidar'}</span></td>
                      <td class="px-5 py-4"><div class="flex flex-wrap justify-end gap-2">
                        {!row.coordinationCompleted && <a href={links.coordination} aria-label={`Evaluar coordinación de ${formatPersonName(`${row.teacher.nombre} ${row.teacher.apellidos}`)}`} class="rounded-lg bg-tup px-3 py-1.5 text-xs font-medium text-white">Evaluar coordinación</a>}
                        <a href={links.results} aria-label={`Ver resultados de ${formatPersonName(`${row.teacher.nombre} ${row.teacher.apellidos}`)}`} class="rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-medium text-slate-700">Resultados</a>
                      </div></td>
                    </tr>;
                  })}
                </tbody>
              </table>
            </div>
          )}
    </section>

    <section aria-labelledby="observacion-title" class="rounded-2xl border border-sky-200 bg-white shadow-tarjeta">
      <div class="flex flex-wrap items-start justify-between gap-4 border-b border-slate-100 p-5 sm:p-6">
        <div>
          <h2 id="observacion-title" class="text-xl font-bold text-sky-800">Docentes para observar</h2>
          <p class="mt-1 text-sm text-slate-500">Sólo para la captura de observación de clase en este ciclo.</p>
        </div>
        <span class="rounded-full bg-sky-100 px-3 py-1 text-sm font-semibold text-sky-800">{observationPortfolio.length} asignados · {observationPending} pendientes</span>
      </div>
      {observationRows.length === 0 ? (
        <div class="p-10 text-center text-sm text-slate-500">{busqueda ? 'No hay docentes para observar que coincidan con la búsqueda.' : 'No tienes docentes asignados para observación en este ciclo.'}</div>
          ) : (
            <div class="space-y-4 p-5 sm:p-6">
              {observationCardRows.map((card) => {
                const portfolioRow = observationPortfolio.find((row) => row.teacher.id === card.teacher.id);
                const links = observationPortfolioLinks(cuatrimestreId, card.teacher.id);
                return (
                  <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                    <header class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 bg-slate-50/70 px-5 py-4">
                      <div>
                        <h3 class="text-lg font-bold text-slate-800">{card.teacherName}</h3>
                        <p class="text-xs text-slate-500">{card.teacher.modalidad || 'Modalidad no registrada'}</p>
                      </div>
                      <span class={`rounded-full px-2.5 py-1 text-xs font-medium ${portfolioRow?.observationCompleted || portfolioRow?.observationRegisteredByOther ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700'}`}>{portfolioRow?.observationCompleted ? `Observación realizada por ti${summary.supersededTeacherIds.has(card.teacher.id) ? ' · histórica' : ''} · ${formatScore(portfolioRow.observationScore)}` : portfolioRow?.observationRegisteredByOther ? `Observación realizada · ${formatScore(portfolioRow.observationOtherScore)}` : 'Observación pendiente'}</span>
                    </header>
                        <div class="space-y-4 p-5">
                          {summary.supersededTeacherIds.has(card.teacher.id) && <p class="text-sm text-amber-800">Tu observación es histórica; una revisión posterior puede mostrar una calificación institucional diferente.</p>}
                      <div class="rounded-xl border border-tup/15 bg-tup/5 p-4">
                        <p class="text-[11px] font-semibold uppercase tracking-wide text-tup">Planeaciones</p>
                        {card.plannings.length > 0 ? (
                          <ul class="mt-2 space-y-2">
                            {card.plannings.map((planning) => {
                              const subject = relationName(planning.asignaturas) || 'Materia no disponible';
                              const groupName = planning.grupo || 'Grupo no disponible';
                              return <li class="flex flex-wrap items-center justify-between gap-2 text-sm">
                                <span class="text-slate-700"><strong>Planeación de:</strong> {card.teacherName} / {subject} / {groupName}</span>
                                {planning.pdfUrl ? <a href={planning.pdfUrl} target="_blank" rel="noreferrer" class="whitespace-nowrap font-medium text-tup hover:underline">Ver PDF</a> : <span class="whitespace-nowrap text-slate-400">PDF no disponible</span>}
                              </li>;
                            })}
                          </ul>
                        ) : <p class="mt-2 text-sm text-slate-500">No hay planeaciones registradas para este docente en el ciclo.</p>}
                      </div>

                      {card.groups.length > 0 ? card.groups.map((group) => {
                        const subject = relationName(group.asignaturas) || 'Materia no disponible';
                        const groupName = group.grupo_normalizado || group.clave || `Grupo ${group.id}`;
                        const schedules = (group.horarios_grupo || []).filter((schedule) => schedule.activo);
                        return <div class="rounded-xl border border-slate-200 p-4">
                          <div class="grid gap-3 md:grid-cols-3">
                            <div><p class="text-[11px] font-semibold uppercase tracking-wide text-slate-400">Materia</p><p class="mt-1 text-sm font-medium text-slate-700">{subject}</p></div>
                            <div><p class="text-[11px] font-semibold uppercase tracking-wide text-slate-400">Grupo</p><p class="mt-1 text-sm font-medium text-slate-700">{groupName}</p></div>
                            <div><p class="text-[11px] font-semibold uppercase tracking-wide text-slate-400">Mtro.</p><p class="mt-1 text-sm font-medium text-slate-700">{card.teacherName}</p></div>
                          </div>
                          <div class="mt-4 border-t border-slate-100 pt-3">
                            <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-400">Horario</p>
                            {schedules.length > 0 ? <ul class="mt-1 space-y-1 text-sm text-slate-600">{schedules.map((schedule) => <li>{diasSemana[schedule.dia_semana] || 'Día no disponible'} · {formatearHora(schedule.hora_inicio)}–{formatearHora(schedule.hora_fin)}{schedule.aula ? ` · Aula ${schedule.aula}` : ''}</li>)}</ul> : <p class="mt-1 text-sm text-slate-400">Horario no disponible.</p>}
                          </div>
                        </div>;
                      }) : <p class="rounded-xl bg-slate-50 p-4 text-sm text-slate-500">No hay grupos activos asociados en este ciclo.</p>}

                      <div class="flex justify-end border-t border-slate-100 pt-3">
                        {!summary.supersededTeacherIds.has(card.teacher.id) && <a href={links.observation} class={`inline-flex rounded-lg px-3 py-1.5 text-xs font-medium text-white ${portfolioRow?.observationCompleted ? 'bg-emerald-700' : 'bg-sky-700'}`}>{portfolioRow?.observationCompleted || portfolioRow?.observationRegisteredByOther ? 'Reevaluar' : 'Iniciar observación'}</a>}
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>
          )}
    </section>
  </div>
</LayoutCoordinador>
