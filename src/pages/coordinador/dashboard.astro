---
import LayoutCoordinador from '../../layouts/LayoutCoordinador.astro';
import { obtenerCuatrimestreActivo, obtenerCuatrimestres } from '../../services/catalogos';
import { obtenerDocentes } from '../../services/docentes';
import { db } from '../../lib/db';
import { fetchNativeStudentEvaluationScores } from '../../services/scoring';

const cuatrimestreActivo = await obtenerCuatrimestreActivo();
const cuatrimestres = await obtenerCuatrimestres();
const cuatrimestreIdCookie = Astro.cookies.get('cuatrimestre_sel')?.value;
const cuatrimestreId = parseInt(Astro.url.searchParams.get('cuatrimestre') || '') || cuatrimestreActivo?.id || parseInt(cuatrimestreIdCookie || '') || 0;
const qs = cuatrimestreId ? `?cuatrimestre=${cuatrimestreId}` : '';
const cuatrimestreQuery = cuatrimestreId ? `&cuatrimestre=${cuatrimestreId}` : '';
if (Astro.url.searchParams.has('cuatrimestre')) {
  Astro.cookies.set('cuatrimestre_sel', String(cuatrimestreId), { path: '/', maxAge: 60*60*24*30 });
}
const busqueda = Astro.url.searchParams.get('q') || '';
const todos = await obtenerDocentes();
const cliente = db();

// Obtener usuario actual para filtrar docentes asignados
const token = Astro.cookies.get('sb-access-token')?.value;
const refresh = Astro.cookies.get('sb-refresh-token')?.value;
let userId = '';
if (token && refresh) {
  const { data: s } = await cliente.auth.setSession({ access_token: token, refresh_token: refresh });
  if (s.user) userId = s.user.id;
}

// Docentes asignados al coordinador/observador
let docentesAsignados = new Set<number>();
if (userId) {
  const { data: asigs } = await cliente.from('coordinador_docentes').select('docente_id').eq('coordinador_id', userId).eq('cuatrimestre_id', cuatrimestreId);
  docentesAsignados = new Set((asigs||[]).map(a=>a.docente_id));
}

// Filtrar solo docentes con evaluaciones (mismo filtro que /admin/docentes)
const [nativeScoreRows, { data: adIds }, { data: obsIds }, { data: coordIds }, { data: planIds }] = await Promise.all([fetchNativeStudentEvaluationScores(cliente, cuatrimestreId), cliente.from('autodiagnosticos').select('docente_id').limit(10000).eq('cuatrimestre_id', cuatrimestreId), cliente.from('observaciones').select('docente_id').limit(10000).eq('cuatrimestre_id', cuatrimestreId), cliente.from('evaluacion_coordinacion').select('docente_id').limit(10000).eq('cuatrimestre_id', cuatrimestreId), cliente.from('planeaciones').select('docente_id').limit(10000).eq('cuatrimestre_id', cuatrimestreId)]);
const docsEvaluados = new Set([...nativeScoreRows,...(adIds||[]),...(obsIds||[]),...(coordIds||[]),...(planIds||[])].map(e=>e.docente_id));
const docentes = todos.filter(d => docsEvaluados.has(d.id) && docentesAsignados.has(d.id));

// Obtener observaciones, planeaciones y evaluaciones de coordinación para este cuatrimestre
const { data: obsData } = await cliente.from('observaciones').select('docente_id').eq('cuatrimestre_id', cuatrimestreId);
const { data: planData } = await cliente.from('planeaciones').select('docente_id,estado').eq('cuatrimestre_id', cuatrimestreId);
const { data: coordData } = await cliente.from('evaluacion_coordinacion').select('docente_id').eq('cuatrimestre_id', cuatrimestreId);

const obsSet = new Set((obsData || []).map(o => o.docente_id));
const planPendiente = new Set((planData || []).filter(p => p.estado === 'Pendiente').map(p => p.docente_id));
const planEvaluada = new Set((planData || []).filter(p => p.estado !== 'Pendiente').map(p => p.docente_id));
const coordSet = new Set((coordData || []).map(c => c.docente_id));
const totalDocs = docentes.length;

interface EstadoDocente {
  docente: { id: number; nombre: string; apellidos: string; email: string; modalidad: string };
  observacion: 'pendiente' | 'completada';
  planeacion: 'pendiente' | 'completada' | 'no_aplica';
  coordinacion: 'pendiente' | 'completada';
  completo: boolean;
}

const estados: EstadoDocente[] = docentes.map(d => ({
  docente: { id: d.id, nombre: d.nombre, apellidos: d.apellidos, email: d.email, modalidad: d.modalidad || 'Escolarizado' },
  observacion: obsSet.has(d.id) ? 'completada' : 'pendiente',
  planeacion: planEvaluada.has(d.id) ? 'completada' : planPendiente.has(d.id) ? 'pendiente' : 'no_aplica',
  coordinacion: coordSet.has(d.id) ? 'completada' : 'pendiente',
  completo: obsSet.has(d.id) && (planEvaluada.has(d.id) || planPendiente.has(d.id)) && coordSet.has(d.id),
}));

const pendientesObs = estados.filter(e => e.observacion === 'pendiente').length;
const pendientesPlan = estados.filter(e => e.planeacion === 'pendiente').length;
const pendientesCoord = estados.filter(e => e.coordinacion === 'pendiente').length;
const completadosObs = estados.filter(e => e.observacion === 'completada').length;
const completadosPlan = estados.filter(e => e.planeacion === 'completada').length;
const faltantes = estados.filter(e => !e.completo);
const completados = estados.filter(e => e.completo);

// Filtrar por busqueda si aplica
let estadosMostrar = estados;
if (busqueda) {
  const t = busqueda.toLowerCase();
  estadosMostrar = estados.filter(e => `${e.docente.nombre} ${e.docente.apellidos}`.toLowerCase().includes(t) || e.docente.apellidos.toLowerCase().includes(t) || e.docente.email.toLowerCase().includes(t));
}
const faltantesF = estadosMostrar.filter(e => !e.completo);
const completadosF = estadosMostrar.filter(e => e.completo);

// Paginación
const page = parseInt(Astro.url.searchParams.get('page')||'1');
const limit = 12;
const totalEstados = estadosMostrar.length;
const totalPages = Math.ceil(totalEstados / limit);
const estadosPag = estadosMostrar.slice((page - 1) * limit, page * limit);
const faltantesPag = estadosPag.filter(e => !e.completo);
const completadosPag = estadosPag.filter(e => e.completo);
function buildPageUrl(p:number) {
  const params = new URLSearchParams(Astro.url.searchParams.toString());
  params.set('page', String(p));
  return `?${params.toString()}`;
}
---

<LayoutCoordinador titulo="Dashboard — Coordinador">
  <div class="animate-flotar-entrada">
    <div class="flex items-center justify-between mb-4">
      <div><h1 class="text-3xl font-bold text-tup mb-2">Panel de Coordinación</h1></div>
      <form method="GET" class="flex items-center gap-2">
        <select name="cuatrimestre" class="rounded-xl border border-slate-200 px-3 py-2 text-sm" onchange="this.form.submit()">
          {cuatrimestres.map(c => (<option value={c.id} selected={c.id === cuatrimestreId}>{c.clave} {c.nombre||''}</option>))}
        </select>
      </form>
    </div>

    <!-- Buscador -->
    <div class="bg-white rounded-2xl p-4 shadow-tarjeta mb-6">
      <form method="GET" class="flex gap-3">
        <input type="hidden" name="cuatrimestre" value={cuatrimestreId} />
        <input type="text" name="q" value={busqueda} placeholder="🔍 Buscar docente por nombre, apellidos o email..." class="flex-1 rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:ring-2 focus:ring-tup focus:outline-none" />
        <button type="submit" class="px-4 py-2.5 rounded-xl bg-tup text-white text-sm font-medium">Buscar</button>
        {busqueda && (<a href={`/coordinador/dashboard${qs}`} class="px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-500">Limpiar</a>)}
      </form>
    </div>

    <!-- KPIs -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mb-8">
      <div class="bg-white rounded-2xl p-4 shadow-tarjeta text-center">
        <p class="text-[10px] text-slate-400 uppercase">CA Pend.</p>
        <p class="text-xl font-bold text-amber-600">{pendientesCoord}</p>
      </div>
      <div class="bg-white rounded-2xl p-4 shadow-tarjeta text-center">
        <p class="text-[10px] text-slate-400 uppercase">Obs. Pend.</p>
        <p class="text-xl font-bold text-amber-600">{pendientesObs}</p>
      </div>
      <div class="bg-white rounded-2xl p-4 shadow-tarjeta text-center">
        <p class="text-[10px] text-slate-400 uppercase">Plan. Pend.</p>
        <p class="text-xl font-bold text-amber-600">{pendientesPlan}</p>
      </div>
      <div class="bg-white rounded-2xl p-4 shadow-tarjeta text-center">
        <p class="text-[10px] text-slate-400 uppercase">CA Lista</p>
        <p class="text-xl font-bold text-emerald-600">{estados.filter(e => e.coordinacion === 'completada').length}</p>
      </div>
      <div class="bg-white rounded-2xl p-4 shadow-tarjeta text-center">
        <p class="text-[10px] text-slate-400 uppercase">Obs. Lista</p>
        <p class="text-xl font-bold text-emerald-600">{estados.filter(e => e.observacion === 'completada').length}</p>
      </div>
      <div class="bg-white rounded-2xl p-4 shadow-tarjeta text-center">
        <p class="text-[10px] text-slate-400 uppercase">Plan. Lista</p>
        <p class="text-xl font-bold text-emerald-600">{estados.filter(e => e.planeacion === 'completada').length}</p>
      </div>
    </div>

    <!-- Pendientes de evaluar -->
    <div class="mb-8">
      <div class="flex items-center gap-2 mb-4">
        <span class="w-3 h-3 rounded-full bg-amber-500"></span>
        <h2 class="text-lg font-bold text-slate-700">Pendientes de Evaluar ({faltantesF.length})</h2>
      </div>
      {faltantesPag.length === 0 ? (
        <div class="bg-white rounded-2xl p-8 text-center text-slate-400 shadow-tarjeta">¡Todos evaluados!</div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {faltantesPag.map(e => (
            <div class="bg-white rounded-xl p-4 shadow-tarjeta border border-amber-100">
              <div class="flex items-center gap-3 mb-3">
                <div class="w-10 h-10 rounded-lg bg-hero-tup flex items-center justify-center text-white font-bold">{e.docente.nombre.charAt(0)}</div>
                <div class="flex-1 min-w-0">
                  <p class="font-medium text-slate-800 text-sm truncate">{e.docente.nombre.toUpperCase()} {e.docente.apellidos.toUpperCase()}</p>
                  <p class="text-xs text-slate-400 truncate">{e.docente.email}</p>
                </div>
              </div>
              <div class="flex gap-1.5">
                {e.coordinacion === 'pendiente' ? (
                  <a href={`/coordinador/captura/coordinacion?docente_id=${e.docente.id}${cuatrimestreQuery}`} class="flex-1 text-center px-2 py-1.5 rounded-lg bg-purple-600 text-white text-[10px] font-medium hover:bg-purple-700">CA</a>
                ) : (
                  <span class="flex-1 text-center px-2 py-1.5 rounded-lg bg-emerald-50 text-emerald-700 text-[10px] font-medium">✅ CA</span>
                )}
                {e.observacion === 'pendiente' ? (
                  <a href={`/coordinador/captura/observacion?docente_id=${e.docente.id}${cuatrimestreQuery}`} class="flex-1 text-center px-2 py-1.5 rounded-lg bg-tup text-white text-[10px] font-medium hover:bg-tup/90">Obs.</a>
                ) : (
                  <span class="flex-1 text-center px-2 py-1.5 rounded-lg bg-emerald-50 text-emerald-700 text-[10px] font-medium">✅ Obs.</span>
                )}
                {e.planeacion === 'pendiente' ? (
                  <a href={`/coordinador/planeaciones${qs}`} class="flex-1 text-center px-2 py-1.5 rounded-lg bg-dorado text-white text-[10px] font-medium hover:bg-dorado/90">Plan.</a>
                ) : e.planeacion === 'no_aplica' ? (
                  <span class="flex-1 text-center px-2 py-1.5 rounded-lg bg-slate-100 text-slate-400 text-[10px] font-medium">—</span>
                ) : (
                  <span class="flex-1 text-center px-2 py-1.5 rounded-lg bg-emerald-50 text-emerald-700 text-[10px] font-medium">✅ Plan.</span>
                )}
              </div>
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- Ya evaluados -->
          {completadosPag.length > 0 && (
      <div>
        <div class="flex items-center gap-2 mb-4">
          <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
          <h2 class="text-lg font-bold text-slate-700">Ya Evaluados ({completadosPag.length})</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {completadosPag.map(e => (
            <div class="bg-emerald-50/50 rounded-xl p-4 border border-emerald-100 opacity-80">
              <div class="flex items-center gap-3 mb-3">
                <div class="w-10 h-10 rounded-lg bg-emerald-100 flex items-center justify-center text-emerald-700 font-bold">{e.docente.nombre.charAt(0)}</div>
                <div class="flex-1 min-w-0">
                  <p class="font-medium text-slate-700 text-sm truncate">{e.docente.nombre.toUpperCase()} {e.docente.apellidos.toUpperCase()}</p>
                  <p class="text-xs ">Completado</p>
                </div>
              </div>
              <div class="flex gap-2">
                <a href={`/coordinador/captura/observacion?docente_id=${e.docente.id}${cuatrimestreQuery}`} class="flex-1 text-center px-3 py-2 rounded-lg border border-emerald-200 text-emerald-700 text-xs font-medium hover:bg-emerald-100" onclick="return confirm('¿Querés editar la observación de este docente?')">✏️ Editar Obs.</a>
                <a href={`/coordinador/planeaciones${qs}`} class="flex-1 text-center px-3 py-2 rounded-lg border border-emerald-200 text-emerald-700 text-xs font-medium hover:bg-emerald-100">📋 Ver Plan.</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
    {totalPages > 1 && (
      <div class="flex items-center justify-center gap-3 mt-8">
        {page > 1 && <a href={buildPageUrl(page-1)} class="px-4 py-2 rounded-xl border border-slate-200 text-sm text-slate-600 hover:bg-slate-50">← Anterior</a>}
        <span class="text-sm text-slate-400">Página {page} de {totalPages}</span>
        {page < totalPages && <a href={buildPageUrl(page+1)} class="px-4 py-2 rounded-xl border border-slate-200 text-sm text-slate-600 hover:bg-slate-50">Siguiente →</a>}
      </div>
    )}
  </div>
</LayoutCoordinador>
