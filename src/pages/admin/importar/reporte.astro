---
import LayoutAdmin from '/src/layouts/LayoutAdmin.astro';

const runIdParam = Astro.url.searchParams.get('run_id');
const runId = runIdParam ? parseInt(runIdParam, 10) : NaN;
const apiUrl = `/api/admin/import-report-json${runIdParam ? `?run_id=${runIdParam}` : ''}`;

let payload: { run?: any; issues?: any[] } | null = null;
let errorMsg = '';

if (!runIdParam || Number.isNaN(runId)) {
  errorMsg = 'Falta el parámetro run_id.';
} else {
  try {
    const cookieHeader = Astro.request.headers.get('cookie') || '';
    const response = await fetch(new URL(apiUrl, Astro.url), {
      headers: cookieHeader ? { cookie: cookieHeader } : undefined,
    });
    if (!response.ok) {
      const data = await response.json().catch(() => ({ error: 'Error desconocido' }));
      errorMsg = data.error || `Error ${response.status}`;
    } else {
      payload = await response.json();
    }
  } catch (e) {
    errorMsg = e instanceof Error ? e.message : 'No se pudo cargar el reporte';
  }
}

const run = payload?.run;
const issues = payload?.issues || [];
const resumen = run?.resumen || {};
const cuatrimestre = run?.cuatrimestres?.clave || 'No aplica';
const pdfUrl = run ? `/api/admin/import-report-pdf?run_id=${run.id}` : '#';
const backUrl = '/admin/importar-docentes';

function formatDate(value: string | null | undefined): string {
  if (!value) return '—';
  try {
    return new Date(value).toLocaleString('es-MX', { dateStyle: 'medium', timeStyle: 'short' });
  } catch {
    return String(value);
  }
}

const labels: Record<string, string> = {
  rowsRead: 'Filas leídas',
  matched: 'Coincidentes',
  created: 'Creados',
  updated: 'Actualizados',
  skipped: 'Omitidos',
  issues: 'Incidencias',
};
---

<LayoutAdmin titulo="Reporte de importación — Admin">
  <div class="animate-flotar-entrada max-w-6xl mx-auto">
    <a href={backUrl} class="text-sm text-slate-400 hover:text-tup">← Importar docentes</a>

    <div class="mb-6 mt-6">
      <p class="text-sm font-medium text-amber-700 mb-2">Reporte de importación</p>
      <h1 class="text-3xl font-bold text-slate-800 mb-2">Importación de docentes</h1>
      {run && (
        <p class="text-slate-500">
          Run #{run.id} · Archivo: <span class="font-medium text-slate-700">{run.archivo_nombre || '—'}</span> · Ciclo: <span class="font-medium text-slate-700">{cuatrimestre}</span>
        </p>
      )}
    </div>

    {errorMsg && (
      <div class="bg-red-50 border border-red-200 rounded-xl p-4 text-red-700 text-sm mb-6">
        {errorMsg}
      </div>
    )}

    {run && (
      <>
        <div class="bg-white rounded-2xl p-5 shadow-tarjeta mb-6">
          <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
            <div>
              <p class="text-xs text-slate-400 uppercase tracking-wide">Estado</p>
              <p class="text-sm font-semibold text-emerald-700 capitalize">{run.estado || '—'}</p>
            </div>
            <div>
              <p class="text-xs text-slate-400 uppercase tracking-wide">Iniciado</p>
              <p class="text-sm font-medium text-slate-700">{formatDate(run.created_at)}</p>
            </div>
            <div>
              <p class="text-xs text-slate-400 uppercase tracking-wide">Finalizado</p>
              <p class="text-sm font-medium text-slate-700">{formatDate(run.finished_at)}</p>
            </div>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
            {Object.entries(resumen).map(([key, value]) => (
              <div class="rounded-xl bg-slate-50 p-3">
                <p class="text-[11px] text-slate-500">{labels[key] || key}</p>
                <p class="text-xl font-bold text-slate-800 mt-1">{String(value)}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-3 mb-6">
          <a href={pdfUrl} class="inline-flex items-center gap-2 rounded-xl bg-tup text-white px-4 py-2.5 text-sm font-semibold hover:bg-tup/90">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            Descargar PDF
          </a>
          <a href={`/api/admin/import-report?run_id=${run.id}`} target="_blank" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-600 hover:border-tup hover:text-tup">
            Ver reporte HTML
          </a>
        </div>

        <div class="bg-white rounded-2xl p-5 shadow-tarjeta">
          <h2 class="text-lg font-bold text-slate-800 mb-4">Incidencias para revisión ({issues.length})</h2>
          {issues.length === 0 ? (
            <p class="text-sm text-slate-500">No hay incidencias registradas.</p>
          ) : (
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead><tr class="bg-slate-50 border-b">
                  <th class="px-3 py-2 text-left text-xs uppercase text-slate-600">Fila</th>
                  <th class="px-3 py-2 text-left text-xs uppercase text-slate-600">Categoría</th>
                  <th class="px-3 py-2 text-left text-xs uppercase text-slate-600">Razón</th>
                  <th class="px-3 py-2 text-left text-xs uppercase text-slate-600">Docente</th>
                  <th class="px-3 py-2 text-left text-xs uppercase text-slate-600">Original</th>
                  <th class="px-3 py-2 text-left text-xs uppercase text-slate-600">Normalizado</th>
                </tr></thead>
                <tbody class="divide-y">
                  {issues.map((item) => (
                    <tr class="hover:bg-slate-50">
                      <td class="px-3 py-2">{item.fila ?? '—'}</td>
                      <td class="px-3 py-2">{item.categoria ?? '—'}</td>
                      <td class="px-3 py-2">{item.razon ?? '—'}</td>
                      <td class="px-3 py-2">{item.docente ?? '—'}</td>
                      <td class="px-3 py-2 text-slate-500">{item.valor_original ?? '—'}</td>
                      <td class="px-3 py-2 text-slate-500">{item.valor_normalizado ?? '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      </>
    )}
  </div>
</LayoutAdmin>
