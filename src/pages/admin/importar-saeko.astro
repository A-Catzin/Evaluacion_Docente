---
import LayoutAdmin from '../../layouts/LayoutAdmin.astro';

const cuatrimestre = Astro.url.searchParams.get('cuatrimestre');
const importUrl = `/admin/importar${cuatrimestre ? `?cuatrimestre=${encodeURIComponent(cuatrimestre)}` : ''}`;
---

<LayoutAdmin titulo="Importación Saeko retirada — Admin">
  <div class="animate-flotar-entrada max-w-2xl mx-auto">
    <div class="bg-white rounded-2xl p-8 shadow-tarjeta border border-amber-200">
      <p class="text-sm font-semibold text-amber-700 mb-2">Flujo retirado</p>
      <h1 class="text-3xl font-bold text-tup mb-3">La importación de evaluaciones Saeko ya no está disponible</h1>
      <p class="text-slate-600">Las evaluaciones estudiantiles se capturan y califican únicamente con las respuestas nativas de 19 reactivos. Los datos históricos de Saeko se conservan solo como archivo de auditoría.</p>
      <a href={importUrl} class="inline-flex mt-6 px-4 py-2 rounded-xl bg-tup text-white text-sm font-medium">Volver a importaciones</a>
    </div>
  </div>
</LayoutAdmin>
