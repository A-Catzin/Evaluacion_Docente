---
import LayoutAdmin from '../../layouts/LayoutAdmin.astro';
import { db } from '../../lib/db';
import type { RolUsuario } from '../../types/supabase';
import { obtenerCuatrimestreActivo } from '../../services/catalogos';
import { obtenerCalificacionesPorCuatrimestre } from '../../services/calificaciones';


type FiltroRol = RolUsuario | 'estudiante';

const rolFiltro = (Astro.url.searchParams.get('rol') as FiltroRol) || undefined;
const busqueda = Astro.url.searchParams.get('q') || '';
const cliente = db();
const token = Astro.cookies.get('sb-access-token')?.value;
const refresh = Astro.cookies.get('sb-refresh-token')?.value;
if (token && refresh) await cliente.auth.setSession({ access_token: token, refresh_token: refresh });
const cuatrimestreActivo = await obtenerCuatrimestreActivo();
const cuatrimestreQuery = parseInt(Astro.url.searchParams.get('cuatrimestre') || '') || 0;
const cuatrimestreCookie = parseInt(Astro.cookies.get('cuatrimestre_sel')?.value || '') || 0;
const cuatrimestreId = cuatrimestreQuery || cuatrimestreActivo?.id || cuatrimestreCookie || 0;
const cycleQuery = cuatrimestreId ? `&cuatrimestre=${cuatrimestreId}` : '';

interface FilaUsuario {
  id: string; email: string; rol: string;
  nombre: string; apellidos: string;
  campus?: string; materias?: string; plan?: string; coordinador?: string;
  modalidad?: string;
  categoria_360?: string; final_360?: number;
  prom_estudiantil?: number; prom_observacion?: number;
  prom_coordinador?: number; prom_planeacion?: number; prom_autodiagnostico?: number;
  turno?: string;
  maestros_evaluados?: number;
  rol_solicitado?: string;
}

let filas: FilaUsuario[] = [];
let errorMsg = '';

try {
  if (rolFiltro === 'docente') {
    const { data: docs, error } = await cliente.from('docentes').select('*').order('apellidos');
    if (error) throw error;
    for (const doc of (docs || [])) {
      filas.push({
        id: doc.email, email: doc.email, rol: 'docente',
        nombre: doc.nombre, apellidos: doc.apellidos,
        campus: doc.campus || '—', turno: doc.turno || '—',
        modalidad: doc.modalidad || '—', materias: doc.oferta_academica || '—',
      });
    }
  } else if (rolFiltro === 'observador') {
    const { data: usuarios, error } = await cliente.from('usuarios').select('id, email, rol').eq('rol', 'observador').order('email');
    if (error) throw error;
    for (const u of (usuarios || [])) {
      filas.push({
        id: u.id, email: u.email, rol: 'observador',
        nombre: u.email.split('@')[0].replace(/[._]/g, ' '), apellidos: '',
      });
    }
  } else if (rolFiltro === 'estudiante') {
    const pageSize = 500;
    const estudiantes: Array<{ id: number; nombre: string; apellidos: string; email: string }> = [];

    for (let offset = 0; ; offset += pageSize) {
      const { data, error } = await cliente
        .from('estudiantes')
        .select('id,nombre,apellidos,email,matricula')
        .eq('activo', true)
        .order('apellidos')
        .order('id')
        .range(offset, offset + pageSize - 1);
      if (error) throw error;
      estudiantes.push(...(data || []));
      if (!data || data.length < pageSize) break;
    }

    const studentIds = new Set(estudiantes.map((student) => student.id));
    const inscripciones: Array<{ estudiante_id: number; grupo_id: number }> = [];

    if (cuatrimestreId && studentIds.size) {
      for (let offset = 0; ; offset += pageSize) {
        const { data, error } = await cliente
          .from('inscripciones')
          .select('estudiante_id,grupo_id')
          .eq('cuatrimestre_id', cuatrimestreId)
          .order('id')
          .range(offset, offset + pageSize - 1);
        if (error) throw error;
        for (const inscripcion of data || []) {
          if (studentIds.has(inscripcion.estudiante_id)) inscripciones.push(inscripcion);
        }
        if (!data || data.length < pageSize) break;
      }
    }

    const groupIds = [...new Set(inscripciones.map((inscripcion) => inscripcion.grupo_id))];
    const grupos: Array<{ id: number; plan_normalizado: string | null }> = [];

    for (let offset = 0; offset < groupIds.length; offset += pageSize) {
      const { data, error } = await cliente
        .from('grupos')
        .select('id,plan_normalizado')
        .in('id', groupIds.slice(offset, offset + pageSize))
        .order('id');
      if (error) throw error;
      grupos.push(...(data || []));
    }
    const planPorEstudiante = new Map<number, Set<string>>();
    const gruposPorId = new Map(grupos.map((grupo) => [grupo.id, grupo]));

    for (const inscripcion of inscripciones) {
      const grupo = gruposPorId.get(inscripcion.grupo_id);
      const plan = grupo?.plan_normalizado?.trim() || 'Plan no identificado';
      if (!planPorEstudiante.has(inscripcion.estudiante_id)) planPorEstudiante.set(inscripcion.estudiante_id, new Set());
      planPorEstudiante.get(inscripcion.estudiante_id)!.add(plan);
    }

    for (const estudiante of estudiantes) {
      filas.push({
        id: String(estudiante.id), email: estudiante.email, rol: 'estudiante',
        nombre: estudiante.nombre, apellidos: estudiante.apellidos,
        plan: [...(planPorEstudiante.get(estudiante.id) || new Set(['Sin inscripción en este ciclo']))].join(' · '),
      });
    }
  } else {
    let query = cliente.from('usuarios').select('id, email, rol, entidad_id, rol_solicitado');
    if (rolFiltro) query = query.eq('rol', rolFiltro as RolUsuario);
        const { data: usuarios, error } = await query.order('email');
        if (error) throw error;

            // Precargar calificaciones finales de docentes para evitar N+1.
            const docenteEntidadIds = (usuarios || [])
              .filter((u: any) => u.rol === 'docente' && u.entidad_id)
              .map((u: any) => Number(u.entidad_id));
            const entidadIdSet = new Set(docenteEntidadIds);
            const calData = cuatrimestreId
              ? await obtenerCalificacionesPorCuatrimestre(cliente, cuatrimestreId)
              : [];
            const calMap = new Map<number, any>();
            for (const row of calData) {
              if (entidadIdSet.has(row.docente_id)) {
                calMap.set(row.docente_id, row);
              }
            }
    
        for (const u of (usuarios || [])) {
      const fila: FilaUsuario = { id: u.id, email: u.email, rol: u.rol, nombre: '', apellidos: '', rol_solicitado: u.rol_solicitado };

      if (u.entidad_id && u.rol === 'docente') {
        const { data: doc } = await cliente.from('docentes').select('nombre,apellidos,campus,turno,oferta_academica,num_empleado,modalidad').eq('id', u.entidad_id).maybeSingle();
        if (doc) {
          fila.nombre = doc.nombre;
          fila.apellidos = doc.apellidos;
          fila.campus = doc.campus || '—';
          fila.turno = doc.turno || '—';
          fila.modalidad = doc.modalidad || '—';
          fila.materias = doc.oferta_academica || '—';
        }
      }

      if (u.rol === 'docente' && u.entidad_id) {
        const cal = calMap.get(Number(u.entidad_id));
        const instrumentCount = cal ? Number(cal.num_instrumentos_completados || 0) : 0;
        if (cal && instrumentCount > 0) {
          fila.categoria_360 = String(cal.categoria_final ?? 'No iniciado');
          fila.final_360 = Number(cal.calificacion_final);
        }
        fila.prom_estudiantil = cal?.score_encuesta_estudiantil != null ? Number(cal.score_encuesta_estudiantil) : undefined;
        fila.prom_coordinador = cal?.score_coordinacion != null ? Number(cal.score_coordinacion) : undefined;
        fila.prom_planeacion = cal?.score_planeacion != null ? Number(cal.score_planeacion) : undefined;
        fila.prom_observacion = cal?.score_observacion != null ? Number(cal.score_observacion) : undefined;
        fila.prom_autodiagnostico = cal?.score_autoevaluacion != null ? Number(cal.score_autoevaluacion) : undefined;
        if (!fila.campus) fila.campus = '—';
        if (!fila.turno) fila.turno = '—';
        fila.coordinador = '—';
      }

      if (u.rol === 'coordinador') {
        fila.maestros_evaluados = 0;
      }

      if (!fila.nombre) fila.nombre = u.email.split('@')[0].replace(/[._]/g, ' ');
      filas.push(fila);
    }
  }

  if (busqueda) {
    const t = busqueda.toLowerCase();
    filas = filas.filter(f => `${f.nombre} ${f.apellidos} ${f.email} ${f.plan || ''}`.toLowerCase().includes(t));
  }
} catch (e) {
  errorMsg = e instanceof Error ? e.message : 'Error al cargar usuarios';
}

const ROLES: FiltroRol[] = ['superadmin', 'coordinador', 'docente', 'estudiante', 'observador', 'pendiente'];
const ETIQUETAS_ROL: Record<string, string> = {
  superadmin: 'Administrador', coordinador: 'Coordinador', docente: 'Docente', estudiante: 'Alumnos', observador: 'Observador', pendiente: 'Pendiente'
};
const COLOR_ROL: Record<string, string> = {
  superadmin: 'bg-purple-50 text-purple-700', coordinador: 'bg-blue-50 text-blue-700',
  docente: 'bg-emerald-50 text-emerald-700', estudiante: 'bg-cyan-50 text-cyan-700', observador: 'bg-amber-50 text-amber-700', pendiente: 'bg-orange-50 text-orange-700'
};

// Última importación de docentes
const { data: ultimoRunDocentes } = await cliente
  .from('import_runs')
  .select('id,resumen,archivo_nombre,created_at,finished_at,estado')
  .eq('tipo', 'docentes')
  .eq('estado', 'completed')
  .order('created_at', { ascending: false })
  .limit(1)
  .maybeSingle();

const ultimoRunResumen = (ultimoRunDocentes?.resumen ?? {}) as Record<string, unknown>;
const runLabels: Record<string, string> = {
  rowsRead: 'Filas leídas',
  matched: 'Coincidentes',
  created: 'Creados',
  updated: 'Actualizados',
  skipped: 'Omitidos',
  issues: 'Incidencias',
};

// Conteos
const { count: totalDocs } = await cliente.from('docentes').select('*', { count: 'exact', head: true }).eq('activo', true);
const { count: totalCoord } = await cliente.from('usuarios').select('*', { count: 'exact', head: true }).eq('rol', 'coordinador');
const { count: totalAdmin } = await cliente.from('usuarios').select('*', { count: 'exact', head: true }).eq('rol', 'superadmin');
const { count: totalObs } = await cliente.from('usuarios').select('*', { count: 'exact', head: true }).eq('rol', 'observador');
const { count: totalPend } = await cliente.from('usuarios').select('*', { count: 'exact', head: true }).eq('rol', 'pendiente');
const { count: totalEstudiantes } = await cliente.from('estudiantes').select('*', { count: 'exact', head: true }).eq('activo', true);
const conteos: Record<string, number> = { superadmin: totalAdmin || 0, coordinador: totalCoord || 0, docente: totalDocs || 0, estudiante: totalEstudiantes || 0, observador: totalObs || 0, pendiente: totalPend || 0 };

// Paginación
const page = parseInt(Astro.url.searchParams.get('page')||'1');
const limit = 20;
const totalFilas = filas.length;
const totalPages = Math.ceil(totalFilas / limit);
const filasPag = filas.slice((page - 1) * limit, page * limit);
function buildPageUrl(p:number) {
  const params = new URLSearchParams(Astro.url.searchParams.toString());
  params.set('page', String(p));
  return `?${params.toString()}`;
}
---

<LayoutAdmin titulo="Usuarios — Admin">
  <div class="animate-flotar-entrada">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-3xl font-bold text-tup">Gestión de Usuarios</h1>
      <button id="btn-agregar" class="px-4 py-2 rounded-xl bg-emerald-600 text-white text-sm font-medium hover:bg-emerald-700">+ Agregar Usuario</button>
      <span class="text-sm ">{totalFilas} usuarios</span>
    </div>

    {!rolFiltro && !busqueda && (
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 mb-6">
        {ROLES.map(r => (
          <a href={`?rol=${r}${cycleQuery}`} class="bg-white rounded-2xl p-5 shadow-tarjeta hover:shadow-tarjeta-hover hover:scale-105 transition-all text-center block">
            <p class="text-2xl mb-1">{r==='superadmin'?'🔑':r==='coordinador'?'📋':r==='docente'?'👨‍🏫':r==='estudiante'?'👥':r==='observador'?'🔍':'⏳'}</p>
            <p class="text-lg font-bold text-tup">{ETIQUETAS_ROL[r]}</p>
            <p class="text-3xl font-bold text-slate-600 mt-2">{conteos[r]}</p>
            <p class="text-xs text-slate-400 mt-1">usuarios</p>
          </a>
        ))}
      </div>
        )}

        {ultimoRunDocentes && (
          <div class="bg-white rounded-2xl p-5 shadow-tarjeta mb-6">
            <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
              <div>
                <p class="text-xs text-slate-400 uppercase tracking-wide">Última importación de docentes</p>
                <p class="text-sm font-medium text-slate-700 mt-0.5">
                  {ultimoRunDocentes.archivo_nombre || 'Archivo sin nombre'} · Run #{ultimoRunDocentes.id}
                </p>
              </div>
              <div class="flex flex-wrap gap-2">
                <a href={`/admin/importar/reporte?run_id=${ultimoRunDocentes.id}`} class="inline-flex items-center rounded-xl bg-tup/10 text-tup px-3 py-2 text-xs font-semibold hover:bg-tup/20">
                  Ver reporte
                </a>
                <a href={`/api/admin/import-report-pdf?run_id=${ultimoRunDocentes.id}`} class="inline-flex items-center rounded-xl border border-slate-200 text-slate-600 px-3 py-2 text-xs font-semibold hover:border-tup hover:text-tup">
                  Descargar PDF
                </a>
              </div>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
              {Object.entries(ultimoRunResumen).map(([key, value]) => (
                <div class="rounded-xl bg-slate-50 p-3">
                  <p class="text-[11px] text-slate-500">{runLabels[key] || key}</p>
                  <p class="text-xl font-bold text-slate-800 mt-1">{String(value)}</p>
                </div>
              ))}
            </div>
          </div>
        )}

        <div class="bg-white rounded-2xl p-4 shadow-tarjeta mb-6">
      <form method="GET" class="flex flex-wrap gap-3 items-center">
        {cuatrimestreId > 0 && <input type="hidden" name="cuatrimestre" value={cuatrimestreId} />}
        <input type="text" name="q" value={busqueda} placeholder="Buscar por nombre o email..." class="flex-1 min-w-[200px] rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-tup" />
          <select name="rol" class="rounded-xl border border-slate-200 px-3 py-2.5 text-sm" onchange="this.form.submit()">
            <option value="" selected={!rolFiltro}>Seleccionar rol...</option>
            {ROLES.map(r => (<option value={r} selected={rolFiltro === r}>{ETIQUETAS_ROL[r]}</option>))}
          </select>
        <button type="submit" class="px-4 py-2.5 rounded-xl bg-tup text-white text-sm font-medium">Buscar</button>
        {(busqueda || rolFiltro) && (<a href={`/admin/usuarios${cuatrimestreId ? `?cuatrimestre=${cuatrimestreId}` : ''}`} class="px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-500">Limpiar</a>)}
      </form>
    </div>

    {errorMsg && (<div class="bg-red-50 border border-red-200 rounded-xl p-4 text-red-700 text-sm mb-6">{errorMsg}</div>)}

    {filasPag.length === 0 ? (
      <div class="bg-white rounded-2xl p-12 text-center text-slate-400 shadow-tarjeta">No se encontraron usuarios.</div>
    ) : (
      <div class="bg-white rounded-2xl shadow-tarjeta overflow-hidden">
        <div class="overflow-x-auto">
           {rolFiltro === 'docente' && (
            <table class="w-full text-sm">
              <thead><tr class="bg-slate-50 border-b">
                <th class="px-3 py-2 text-center text-xs uppercase text-slate-600">Nombre</th>
                <th class="px-3 py-2 text-center text-xs uppercase text-slate-600">Ap. Paterno</th>
                <th class="px-3 py-2 text-center text-xs uppercase text-slate-600">Ap. Materno</th>
                <th class="px-3 py-2 text-center text-xs uppercase text-slate-600">Correo</th>
                <th class="px-3 py-2 text-center text-xs uppercase text-slate-600">Campus</th>
                <th class="px-3 py-2 text-center text-xs uppercase text-slate-600">Turno</th>
                <th class="px-3 py-2 text-center text-xs uppercase text-slate-600">Modalidad</th>
                <th class="px-3 py-2 text-center text-xs uppercase text-slate-600">Materias</th>
              </tr></thead>
              <tbody class="divide-y">{filasPag.map(f => {
                const [paterno, materno] = f.apellidos ? [f.apellidos.split(' ')[0] || '', f.apellidos.split(' ').slice(1).join(' ')] : ['',''];
                return (<tr class="hover:bg-slate-50"><td class="px-3 py-2 text-center font-medium">{f.nombre}</td><td class="px-3 py-2 text-center">{paterno}</td><td class="px-3 py-2 text-center">{materno || '—'}</td><td class="px-3 py-2 text-center text-xs">{f.email}</td><td class="px-3 py-2 text-center">{f.campus}</td><td class="px-3 py-2 text-center">{f.turno}</td><td class="px-3 py-2 text-center">{f.modalidad || '—'}</td><td class="px-3 py-2 text-center text-xs">{f.materias}</td></tr>);
              })}</tbody>
             </table>
           )}

           {rolFiltro === 'estudiante' && (
             <table class="w-full text-sm">
               <thead><tr class="bg-slate-50 border-b">
                 <th class="px-4 py-3 text-center text-xs uppercase text-slate-600">Nombre completo</th>
                 <th class="px-4 py-3 text-center text-xs uppercase text-slate-600">Correo</th>
                 <th class="px-4 py-3 text-center text-xs uppercase text-slate-600">Plan</th>
               </tr></thead>
               <tbody class="divide-y">{filasPag.map(f => (
                 <tr class="hover:bg-slate-50">
                   <td class="px-4 py-3 text-center font-medium">{f.nombre} {f.apellidos}</td>
                   <td class="px-4 py-3 text-center text-slate-600">{f.email}</td>
                   <td class="px-4 py-3 text-center text-slate-600">{f.plan || '—'}</td>
                 </tr>
               ))}</tbody>
             </table>
           )}

           {rolFiltro === 'coordinador' && (
            <table class="w-full text-sm">
              <thead><tr class="bg-slate-50 border-b">
                <th class="px-3 py-2 text-center text-xs uppercase text-slate-600">Nombre</th>
                <th class="px-3 py-2 text-center text-xs uppercase text-slate-600">Email</th>
                <th class="px-3 py-2 text-center text-xs uppercase text-slate-600">Rol</th>
              </tr></thead>
              <tbody class="divide-y">{filasPag.map(f => (
                <tr class="hover:bg-slate-50"><td class="px-3 py-2 text-center font-medium">{f.nombre}</td><td class="px-3 py-2 text-center text-xs">{f.email}</td><td class="px-3 py-2 text-center"><span class={`px-2 py-0.5 rounded-lg text-xs font-medium ${COLOR_ROL[f.rol]}`}>{ETIQUETAS_ROL[f.rol]}</span></td></tr>
              ))}</tbody>
            </table>
          )}

          {rolFiltro === 'superadmin' && (
            <table class="w-full text-sm">
              <thead><tr class="bg-slate-50 border-b"><th class="px-4 py-3 text-xs uppercase text-slate-600">Nombre</th><th class="px-4 py-3 text-xs uppercase text-slate-600">Email</th></tr></thead>
              <tbody class="divide-y">{filasPag.map(f => (<tr class="hover:bg-slate-50"><td class="px-4 py-3 text-center font-medium">{f.nombre}</td><td class="px-4 py-3 text-center text-slate-600">{f.email}</td></tr>))}</tbody>
            </table>
          )}

          {rolFiltro === 'observador' && (
            <table class="w-full text-sm">
              <thead><tr class="bg-slate-50 border-b"><th class="px-4 py-3 text-xs uppercase text-slate-600">Nombre</th><th class="px-4 py-3 text-xs uppercase text-slate-600">Email</th><th class="px-4 py-3 text-xs uppercase text-slate-600 text-center">Rol</th></tr></thead>
              <tbody class="divide-y">{filasPag.map(f => (<tr class="hover:bg-slate-50"><td class="px-4 py-3 text-center font-medium">{f.nombre}</td><td class="px-4 py-3 text-center text-slate-600">{f.email}</td><td class="px-4 py-3 text-center"><span class={`px-2 py-0.5 rounded-lg text-xs font-medium ${COLOR_ROL[f.rol]}`}>{ETIQUETAS_ROL[f.rol]}</span></td></tr>))}</tbody>
            </table>
          )}
          {rolFiltro === 'pendiente' && (
            <table class="w-full text-sm">
              <thead><tr class="bg-slate-50 border-b"><th class="px-4 py-3 text-xs uppercase text-slate-600">Nombre</th><th class="px-4 py-3 text-xs uppercase text-slate-600">Email</th><th class="px-4 py-3 text-xs uppercase text-slate-600 text-center">Rol Solicitado</th><th class="px-4 py-3 text-xs uppercase text-slate-600 text-center">Acción</th></tr></thead>
              <tbody class="divide-y">{filasPag.map(f => (<tr class="hover:bg-slate-50"><td class="px-4 py-3 text-center font-medium">{f.nombre}</td><td class="px-4 py-3 text-center text-slate-600">{f.email}</td><td class="px-4 py-3 text-center"><span class="px-2 py-0.5 rounded-lg text-xs font-medium bg-slate-100">{f.rol_solicitado || '—'}</span></td><td class="px-4 py-3 text-center"><a href={`/admin/roles?q=${f.email}`} class="text-xs text-tup hover:underline">Asignar Rol</a></td></tr>))}</tbody>
            </table>
          )}
          {totalPages > 1 && (
            <div class="flex items-center justify-center gap-3 pt-4">
              {page > 1 && <a href={buildPageUrl(page-1)} class="px-4 py-2 rounded-xl border border-slate-200 text-sm text-slate-600 hover:bg-slate-50">← Anterior</a>}
              <span class="text-sm text-slate-400">Página {page} de {totalPages}</span>
              {page < totalPages && <a href={buildPageUrl(page+1)} class="px-4 py-2 rounded-xl border border-slate-200 text-sm text-slate-600 hover:bg-slate-50">Siguiente →</a>}
            </div>
          )}
        </div>
      </div>
    )}
  </div>

  <!-- Modal Agregar Usuario -->
  <div id="modal-agregar" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 backdrop-blur-sm">
    <div class="bg-white rounded-3xl p-6 shadow-modal max-w-lg w-full mx-4 max-h-[80vh] overflow-auto">
      <div class="flex items-center justify-between mb-4"><h3 class="text-lg font-bold text-tup">Agregar Usuario</h3><button onclick="cerrarModal()" class="text-slate-400 hover:text-slate-600 text-xl">&times;</button></div>
      <form id="form-agregar" class="space-y-4">
        <div><label class="block text-sm font-medium mb-1">Nombre completo</label><input type="text" id="ag-nombre" class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm" placeholder="Ej: Juan Pérez" /></div>
        <div><label class="block text-sm font-medium mb-1">Email *</label><input type="email" id="ag-email" required class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm" placeholder="@tecplayacar.edu.mx" /></div>
        <div><label class="block text-sm font-medium mb-1">Rol *</label><select id="ag-rol" required class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm" onchange="toggleCoord()"><option value="">Seleccionar...</option><option value="superadmin">Superadmin</option><option value="coordinador">Coordinador</option><option value="docente">Docente</option><option value="observador">Observador</option></select></div>
        <div id="coord-section" class="hidden"><label class="block text-sm font-medium mb-1">Docentes a supervisar</label><input type="text" id="filtro-docs" placeholder="Buscar docente..." class="w-full rounded-xl border border-slate-200 px-3 py-2 text-xs mb-2" oninput="filtrarDocs()" /><div id="lista-docs" class="max-h-40 overflow-auto border border-slate-200 rounded-xl p-3 space-y-1 text-sm"></div></div>
        <button type="submit" class="w-full bg-emerald-600 text-white font-semibold py-3 rounded-xl hover:bg-emerald-700">Crear Usuario</button>
      </form>
    </div>
  </div>
</LayoutAdmin>

<script is:inline>
  var docentesList = [];
  function cerrarModal(){document.getElementById('modal-agregar').classList.add('hidden')}
  function toggleCoord(){
    var s=document.getElementById('coord-section');
    s.classList.toggle('hidden', document.getElementById('ag-rol').value !== 'coordinador');
    if(!s.classList.contains('hidden') && docentesList.length===0) cargarDocentes();
  }
  async function cargarDocentes(){
    try{var r=await fetch('/api/admin/docentes-evaluados?all=1');docentesList=await r.json();renderDocs()}
    catch(e){}
  }
  function renderDocs(q){
    var filtro = (q || '').toLowerCase();
    var filtered = docentesList.filter(function(d){
      return !filtro || (d.nombre+' '+d.apellidos).toLowerCase().includes(filtro);
    });
    document.getElementById('lista-docs').innerHTML=filtered.map(function(d){return'<label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" name="docente_id" value="'+d.id+'" class="accent-tup" /><span>'+d.nombre+' '+d.apellidos+'</span></label>'}).join('')||'<span class="text-slate-400 text-xs">Sin resultados</span>';
  }
  function filtrarDocs(){ renderDocs(document.getElementById('filtro-docs').value); }
  document.getElementById('btn-agregar').addEventListener('click',function(){document.getElementById('modal-agregar').classList.remove('hidden');document.getElementById('modal-agregar').classList.add('flex')});
  document.getElementById('form-agregar').addEventListener('submit',async function(e){
    e.preventDefault();var btn=this.querySelector('button[type="submit"]');btn.disabled=true;btn.textContent='Creando...';
    var email=document.getElementById('ag-email').value.trim();
    if(!email.endsWith('@tecplayacar.edu.mx')){alert('Email debe ser @tecplayacar.edu.mx');btn.disabled=false;btn.textContent='Crear Usuario';return}
    var data={email,rol:document.getElementById('ag-rol').value,nombre_completo:document.getElementById('ag-nombre').value.trim()||null};
    if(data.rol==='coordinador'){data.docente_ids=Array.from(document.querySelectorAll('input[name="docente_id"]:checked')).map(function(c){return parseInt(c.value)})}
    try{var res=await fetch('/api/admin/crear-usuario',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});
    if(res.ok){alert('Usuario creado');location.reload()}else{var d=await res.json();alert(d.error||'Error');btn.disabled=false;btn.textContent='Crear Usuario'}}catch(err){alert('Error');btn.disabled=false;btn.textContent='Crear Usuario'}
  });
</script>
