---
import LayoutAdmin from '../../layouts/LayoutAdmin.astro';
import { obtenerClienteSuperbase } from '../../lib/supabaseClient';
import type { RolUsuario } from '../../types/supabase';

const rolFiltro = (Astro.url.searchParams.get('rol') as RolUsuario) || undefined;
const busqueda = Astro.url.searchParams.get('q') || '';
const cliente = obtenerClienteSuperbase();

interface FilaUsuario {
  id: string; email: string; rol: string;
  nombre: string; apellidos: string;
  campus?: string; materias?: string; coordinador?: string;
  modalidad?: string;
  nivel_desempeno?: string; categoria_360?: string; final_360?: number;
  prom_estudiantil?: number; prom_observacion?: number;
  prom_coordinador?: number; prom_planeacion?: number; prom_autodiagnostico?: number;
  turno?: string;
  maestros_evaluados?: number;
}

let filas: FilaUsuario[] = [];
let errorMsg = '';

try {
  if (rolFiltro === 'docente') {
    const { data: docs, error } = await cliente.from('docentes').select('*').order('apellidos');
    if (error) throw error;
    for (const doc of (docs || [])) {
      filas.push({
        id: doc.email, email: doc.email, rol: 'docente',
        nombre: doc.nombre, apellidos: doc.apellidos,
        campus: doc.campus || '—', turno: doc.turno || '—',
        modalidad: doc.modalidad || '—', materias: doc.oferta_academica || '—',
      });
    }
  } else if (rolFiltro === 'observador') {
    const { data: usuarios, error } = await cliente.from('usuarios').select('id, email, rol').eq('rol', 'observador').order('email');
    if (error) throw error;
    for (const u of (usuarios || [])) {
      filas.push({
        id: u.id, email: u.email, rol: 'observador',
        nombre: u.email.split('@')[0].replace(/[._]/g, ' '), apellidos: '',
      });
    }
  } else {
    let query = cliente.from('usuarios').select('id, email, rol, entidad_id');
    if (rolFiltro) query = query.eq('rol', rolFiltro);
    const { data: usuarios, error } = await query.order('email');
    if (error) throw error;

    for (const u of (usuarios || [])) {
      const fila: FilaUsuario = { id: u.id, email: u.email, rol: u.rol, nombre: '', apellidos: '' };

      if (u.entidad_id && u.rol === 'docente') {
        const { data: doc } = await cliente.from('docentes').select('nombre,apellidos,campus,turno,oferta_academica,num_empleado,modalidad').eq('id', u.entidad_id).maybeSingle();
        if (doc) {
          fila.nombre = doc.nombre;
          fila.apellidos = doc.apellidos;
          fila.campus = doc.campus || '—';
          fila.turno = doc.turno || '—';
          fila.modalidad = doc.modalidad || '—';
          fila.materias = doc.oferta_academica || '—';
        }
      }

      if (u.rol === 'docente' && u.entidad_id) {
        const { data: cal } = await cliente.from('calificacion_final_docente').select('*').eq('docente_id', u.entidad_id).order('id', { ascending: false }).limit(1).maybeSingle();
        if (cal) {
          fila.categoria_360 = cal.categoria_final || '—';
          fila.final_360 = cal.calificacion_final;
          fila.prom_estudiantil = cal.score_encuesta_estudiantil || undefined;
        }
        const { data: planData } = await cliente.from('planeaciones').select('puntaje_promedio').eq('docente_id', u.entidad_id).eq('estado','Aprobado').order('fecha_evaluacion', { ascending: false }).limit(1).maybeSingle();
        if (planData?.puntaje_promedio) fila.prom_planeacion = planData.puntaje_promedio;
        const { data: obsData } = await cliente.from('observaciones').select('*').eq('docente_id', u.entidad_id).order('id', { ascending: false }).limit(1).maybeSingle();
        if (obsData) {
          const r = [obsData.cco1,obsData.cco2,obsData.cco3,obsData.cco4,obsData.cco5,obsData.cco6,obsData.cco7,obsData.cme1,obsData.cme2,obsData.cme3,obsData.cme4,obsData.cme5,obsData.cme6,obsData.cme7,obsData.cme8,obsData.cme9,obsData.ccom1,obsData.ccom2,obsData.ccom3,obsData.ccom4,obsData.cso1,obsData.cso2,obsData.cso3,obsData.cso4,obsData.cge1,obsData.cge2,obsData.cge3,obsData.cge4,obsData.cge5,obsData.cge6,obsData.cge7,obsData.caf1,obsData.caf2,obsData.ctepe1,obsData.ctepe2,obsData.ctepe3,obsData.ctepe4,obsData.ctepe5,obsData.ctepe6,obsData.ctepe7,obsData.cno1,obsData.cno2,obsData.cno3,obsData.cno4,obsData.cno5].filter(v => v);
          if (r.length > 0) fila.prom_observacion = Math.round((r.reduce((a,b) => a+b, 0) / (r.length * 5)) * 100);
        }
        const { data: coordData } = await cliente.from('evaluacion_coordinacion').select('score_normalizado').eq('docente_id', u.entidad_id).order('id', { ascending: false }).limit(1).maybeSingle();
        if (coordData?.score_normalizado) fila.prom_coordinador = Math.round(coordData.score_normalizado);
        const { data: diag } = await cliente.from('autodiagnosticos').select('puntaje_total,nivel_desempeno').eq('docente_id', u.entidad_id).order('id', { ascending: false }).limit(1).maybeSingle();
        if (diag) {
          fila.prom_autodiagnostico = Math.round((diag.puntaje_total / 120) * 100);
          fila.nivel_desempeno = diag.nivel_desempeno || '—';
        }
        if (!fila.campus) fila.campus = '—';
        if (!fila.turno) fila.turno = '—';
        fila.coordinador = '—';
      }

      if (u.rol === 'coordinador') {
        fila.maestros_evaluados = 0;
      }

      if (!fila.nombre) fila.nombre = u.email.split('@')[0].replace(/[._]/g, ' ');
      filas.push(fila);
    }
  }

  if (busqueda) {
    const t = busqueda.toLowerCase();
    filas = filas.filter(f => f.nombre.toLowerCase().includes(t) || f.email.toLowerCase().includes(t));
  }
} catch (e) {
  errorMsg = e instanceof Error ? e.message : 'Error al cargar usuarios';
}

const ROLES: RolUsuario[] = ['superadmin', 'coordinador', 'docente', 'observador'];
const ETIQUETAS_ROL: Record<string, string> = {
  superadmin: 'Administrador', coordinador: 'Coordinador', docente: 'Docente', observador: 'Observador'
};
const COLOR_ROL: Record<string, string> = {
  superadmin: 'bg-purple-50 text-purple-700', coordinador: 'bg-blue-50 text-blue-700',
  docente: 'bg-emerald-50 text-emerald-700', observador: 'bg-amber-50 text-amber-700'
};

// Conteos
const { count: totalDocs } = await cliente.from('docentes').select('*', { count: 'exact', head: true }).eq('activo', true);
const { count: totalCoord } = await cliente.from('usuarios').select('*', { count: 'exact', head: true }).eq('rol', 'coordinador');
const { count: totalAdmin } = await cliente.from('usuarios').select('*', { count: 'exact', head: true }).eq('rol', 'superadmin');
const { count: totalObs } = await cliente.from('usuarios').select('*', { count: 'exact', head: true }).eq('rol', 'observador');
const conteos: Record<string, number> = { superadmin: totalAdmin || 0, coordinador: totalCoord || 0, docente: totalDocs || 0, observador: totalObs || 0 };

function formatear(n: number | undefined): string {
  return n !== undefined && n !== null ? Math.round(n).toString() : '—';
}
---

<LayoutAdmin titulo="Usuarios — Admin">
  <div class="animate-flotar-entrada">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-3xl font-bold text-tup">Gestión de Usuarios</h1>
      <button id="btn-agregar" class="px-4 py-2 rounded-xl bg-emerald-600 text-white text-sm font-medium hover:bg-emerald-700">+ Agregar Usuario</button>
      <span class="text-sm text-slate-400">{filas.length} usuarios</span>
    </div>

    {!rolFiltro && !busqueda && (
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
        {ROLES.map(r => (
          <a href={`?rol=${r}`} class="bg-white rounded-2xl p-5 shadow-tarjeta hover:shadow-tarjeta-hover hover:scale-105 transition-all text-center block">
            <p class="text-2xl mb-1">{r==='superadmin'?'🔑':r==='coordinador'?'📋':r==='docente'?'👨‍🏫':'🔍'}</p>
            <p class="text-lg font-bold text-tup">{ETIQUETAS_ROL[r]}</p>
            <p class="text-3xl font-bold text-slate-600 mt-2">{conteos[r]}</p>
            <p class="text-xs text-slate-400 mt-1">usuarios</p>
          </a>
        ))}
      </div>
    )}

    <div class="bg-white rounded-2xl p-4 shadow-tarjeta mb-6">
      <form method="GET" class="flex flex-wrap gap-3 items-center">
        <input type="text" name="q" value={busqueda} placeholder="Buscar por nombre o email..." class="flex-1 min-w-[200px] rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-tup" />
          <select name="rol" class="rounded-xl border border-slate-200 px-3 py-2.5 text-sm" onchange="this.form.submit()">
            <option value="" selected={!rolFiltro}>Seleccionar rol...</option>
            {ROLES.map(r => (<option value={r} selected={rolFiltro === r}>{ETIQUETAS_ROL[r]}</option>))}
          </select>
        <button type="submit" class="px-4 py-2.5 rounded-xl bg-tup text-white text-sm font-medium">Buscar</button>
        {(busqueda || rolFiltro) && (<a href="/admin/usuarios" class="px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-500">Limpiar</a>)}
      </form>
    </div>

    {errorMsg && (<div class="bg-red-50 border border-red-200 rounded-xl p-4 text-red-700 text-sm mb-6">{errorMsg}</div>)}

    {filas.length === 0 ? (
      <div class="bg-white rounded-2xl p-12 text-center text-slate-400 shadow-tarjeta">No se encontraron usuarios.</div>
    ) : (
      <div class="bg-white rounded-2xl shadow-tarjeta overflow-hidden">
        <div class="overflow-x-auto">
          {rolFiltro === 'docente' && (
            <table class="w-full text-sm">
              <thead><tr class="bg-slate-50 border-b">
                <th class="px-3 py-2 text-center text-xs uppercase text-slate-600">Nombre</th>
                <th class="px-3 py-2 text-center text-xs uppercase text-slate-600">Ap. Paterno</th>
                <th class="px-3 py-2 text-center text-xs uppercase text-slate-600">Ap. Materno</th>
                <th class="px-3 py-2 text-center text-xs uppercase text-slate-600">Correo</th>
                <th class="px-3 py-2 text-center text-xs uppercase text-slate-600">Campus</th>
                <th class="px-3 py-2 text-center text-xs uppercase text-slate-600">Turno</th>
                <th class="px-3 py-2 text-center text-xs uppercase text-slate-600">Modalidad</th>
                <th class="px-3 py-2 text-center text-xs uppercase text-slate-600">Materias</th>
              </tr></thead>
              <tbody class="divide-y">{filas.map(f => {
                const [paterno, materno] = f.apellidos ? [f.apellidos.split(' ')[0] || '', f.apellidos.split(' ').slice(1).join(' ')] : ['',''];
                return (<tr class="hover:bg-slate-50"><td class="px-3 py-2 text-center font-medium">{f.nombre}</td><td class="px-3 py-2 text-center">{paterno}</td><td class="px-3 py-2 text-center">{materno || '—'}</td><td class="px-3 py-2 text-center text-xs">{f.email}</td><td class="px-3 py-2 text-center">{f.campus}</td><td class="px-3 py-2 text-center">{f.turno}</td><td class="px-3 py-2 text-center">{f.modalidad || '—'}</td><td class="px-3 py-2 text-center text-xs">{f.materias}</td></tr>);
              })}</tbody>
            </table>
          )}

          {rolFiltro === 'coordinador' && (
            <table class="w-full text-sm">
              <thead><tr class="bg-slate-50 border-b">
                <th class="px-3 py-2 text-center text-xs uppercase text-slate-600">Nombre</th>
                <th class="px-3 py-2 text-center text-xs uppercase text-slate-600">Email</th>
                <th class="px-3 py-2 text-center text-xs uppercase text-slate-600">Rol</th>
              </tr></thead>
              <tbody class="divide-y">{filas.map(f => (
                <tr class="hover:bg-slate-50"><td class="px-3 py-2 text-center font-medium">{f.nombre}</td><td class="px-3 py-2 text-center text-xs">{f.email}</td><td class="px-3 py-2 text-center"><span class={`px-2 py-0.5 rounded-lg text-xs font-medium ${COLOR_ROL[f.rol]}`}>{ETIQUETAS_ROL[f.rol]}</span></td></tr>
              ))}</tbody>
            </table>
          )}

          {rolFiltro === 'superadmin' && (
            <table class="w-full text-sm">
              <thead><tr class="bg-slate-50 border-b"><th class="px-4 py-3 text-xs uppercase text-slate-600">Nombre</th><th class="px-4 py-3 text-xs uppercase text-slate-600">Email</th></tr></thead>
              <tbody class="divide-y">{filas.map(f => (<tr class="hover:bg-slate-50"><td class="px-4 py-3 text-center font-medium">{f.nombre}</td><td class="px-4 py-3 text-center text-slate-600">{f.email}</td></tr>))}</tbody>
            </table>
          )}

          {rolFiltro === 'observador' && (
            <table class="w-full text-sm">
              <thead><tr class="bg-slate-50 border-b"><th class="px-4 py-3 text-xs uppercase text-slate-600">Nombre</th><th class="px-4 py-3 text-xs uppercase text-slate-600">Email</th><th class="px-4 py-3 text-xs uppercase text-slate-600 text-center">Rol</th></tr></thead>
              <tbody class="divide-y">{filas.map(f => (<tr class="hover:bg-slate-50"><td class="px-4 py-3 text-center font-medium">{f.nombre}</td><td class="px-4 py-3 text-center text-slate-600">{f.email}</td><td class="px-4 py-3 text-center"><span class={`px-2 py-0.5 rounded-lg text-xs font-medium ${COLOR_ROL[f.rol]}`}>{ETIQUETAS_ROL[f.rol]}</span></td></tr>))}</tbody>
            </table>
          )}
        </div>
      </div>
    )}
  </div>

  <!-- Modal Agregar Usuario -->
  <div id="modal-agregar" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 backdrop-blur-sm">
    <div class="bg-white rounded-3xl p-6 shadow-modal max-w-lg w-full mx-4 max-h-[80vh] overflow-auto">
      <div class="flex items-center justify-between mb-4"><h3 class="text-lg font-bold text-tup">Agregar Usuario</h3><button onclick="cerrarModal()" class="text-slate-400 hover:text-slate-600 text-xl">&times;</button></div>
      <form id="form-agregar" class="space-y-4">
        <div><label class="block text-sm font-medium mb-1">Nombre completo</label><input type="text" id="ag-nombre" class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm" placeholder="Ej: Juan Pérez" /></div>
        <div><label class="block text-sm font-medium mb-1">Email *</label><input type="email" id="ag-email" required class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm" placeholder="@tecplayacar.edu.mx" /></div>
        <div><label class="block text-sm font-medium mb-1">Rol *</label><select id="ag-rol" required class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm" onchange="toggleCoord()"><option value="">Seleccionar...</option><option value="superadmin">Superadmin</option><option value="coordinador">Coordinador</option><option value="docente">Docente</option><option value="observador">Observador</option></select></div>
        <div id="coord-section" class="hidden"><label class="block text-sm font-medium mb-1">Docentes a supervisar</label><div id="lista-docs" class="max-h-40 overflow-auto border border-slate-200 rounded-xl p-3 space-y-1 text-sm"></div></div>
        <button type="submit" class="w-full bg-emerald-600 text-white font-semibold py-3 rounded-xl hover:bg-emerald-700">Crear Usuario</button>
      </form>
    </div>
  </div>
</LayoutAdmin>

<script is:inline>
  var docentesList = [];
  function cerrarModal(){document.getElementById('modal-agregar').classList.add('hidden')}
  function toggleCoord(){
    var s=document.getElementById('coord-section');
    s.classList.toggle('hidden', document.getElementById('ag-rol').value !== 'coordinador');
    if(!s.classList.contains('hidden') && docentesList.length===0) cargarDocentes();
  }
  async function cargarDocentes(){
    try{var r=await fetch('/api/admin/docentes-evaluados?all=1');docentesList=await r.json();
    document.getElementById('lista-docs').innerHTML=docentesList.map(function(d,i){return'<label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" name="docente_id" value="'+d.id+'" class="accent-tup" /><span>'+d.nombre+' '+d.apellidos+'</span></label>'}).join('')}catch(e){}
  }
  document.getElementById('btn-agregar').addEventListener('click',function(){document.getElementById('modal-agregar').classList.remove('hidden');document.getElementById('modal-agregar').classList.add('flex')});
  document.getElementById('form-agregar').addEventListener('submit',async function(e){
    e.preventDefault();var btn=this.querySelector('button[type="submit"]');btn.disabled=true;btn.textContent='Creando...';
    var email=document.getElementById('ag-email').value.trim();
    if(!email.endsWith('@tecplayacar.edu.mx')){alert('Email debe ser @tecplayacar.edu.mx');btn.disabled=false;btn.textContent='Crear Usuario';return}
    var data={email,rol:document.getElementById('ag-rol').value,nombre_completo:document.getElementById('ag-nombre').value.trim()||null};
    if(data.rol==='coordinador'){data.docente_ids=Array.from(document.querySelectorAll('input[name="docente_id"]:checked')).map(function(c){return parseInt(c.value)})}
    try{var res=await fetch('/api/admin/crear-usuario',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});
    if(res.ok){alert('Usuario creado');location.reload()}else{var d=await res.json();alert(d.error||'Error');btn.disabled=false;btn.textContent='Crear Usuario'}}catch(err){alert('Error');btn.disabled=false;btn.textContent='Crear Usuario'}
  });
</script>
