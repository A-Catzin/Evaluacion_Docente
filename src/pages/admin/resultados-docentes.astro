---
import LayoutAdmin from '../../layouts/LayoutAdmin.astro';
import { dbAdmin } from '../../lib/db';
import { formatScore } from '../../services/scoring';

const cl = dbAdmin();
const { data: cuatrisData, error: cuatrisError } = await cl
  .from('cuatrimestres')
  .select('id,clave,nombre,activo,cerrado')
  .order('id', { ascending: true });
if (cuatrisError) throw cuatrisError;
const cuatrisRes = { data: cuatrisData };

const cuatrimestres = (cuatrisRes.data || []).sort((a, b) => a.id - b.id);
const activeCuatriId = cuatrimestres.find((c: any) => c.activo)?.id ?? cuatrimestres[cuatrimestres.length - 1]?.id ?? 0;
const queryCuatriId = parseInt(Astro.url.searchParams.get('cuatrimestre') || '') || 0;
const cookieCuatriId = parseInt(Astro.cookies.get('cuatrimestre_sel')?.value || '') || 0;
const cuatrimestreId = queryCuatriId || activeCuatriId || cookieCuatriId || 0;
const qs = cuatrimestreId ? `?cuatrimestre=${cuatrimestreId}` : '';

if (Astro.url.searchParams.has('cuatrimestre') && cuatrimestreId) {
  Astro.cookies.set('cuatrimestre_sel', String(cuatrimestreId), { path: '/', maxAge: 60 * 60 * 24 * 30 });
}

const busqueda = (Astro.url.searchParams.get('q') || '').trim().toLowerCase();

// Scores ya calculados; usamos la vista materializada para listados grandes.
const { data: aggData, error: aggError } = await cl
  .from('resultados_agregados')
  .select('*')
  .eq('cuatrimestre_id', cuatrimestreId);
if (aggError) throw aggError;

const cardsConResultados = (aggData || [])
  .filter((row: any) => Number(row.num_instrumentos_completados || 0) > 0)
  .map((row: any) => ({
    id: Number(row.docente_id),
    nombre: String(row.docente_nombre ?? ''),
    apellidos: String(row.docente_apellidos ?? ''),
    email: String(row.docente_email ?? ''),
    campus: row.docente_campus,
    modalidad: row.modalidad_snapshot,
    ee: row.score_encuesta_estudiantil != null ? Number(row.score_encuesta_estudiantil) : null,
    coord: row.score_coordinacion != null ? Number(row.score_coordinacion) : null,
    plan: row.score_planeacion != null ? Number(row.score_planeacion) : null,
    obs: row.score_observacion != null ? Number(row.score_observacion) : null,
    auto: row.score_autoevaluacion != null ? Number(row.score_autoevaluacion) : null,
    final: Number(row.calificacion_final),
    category: String(row.categoria_final ?? 'No iniciado'),
    instruments: Number(row.num_instrumentos_completados || 0),
    expected: Number(row.num_instrumentos_esperados || 0),
  }))
  .sort((a: any, b: any) => (b.final || 0) - (a.final || 0) || a.apellidos.localeCompare(b.apellidos));

const cards = busqueda
  ? cardsConResultados.filter((d) => `${d.nombre} ${d.apellidos} ${d.email} ${d.campus || ''} ${d.modalidad || ''}`.toLowerCase().includes(busqueda))
  : cardsConResultados;
const sobresalientes = cards.filter((c) => c.category === 'Sobresaliente');
const promedioGeneral = cards.length ? Math.round(cards.reduce((sum, c) => sum + (c.final || 0), 0) / cards.length) : null;
const mejorDocente = cards[0] || null;

function scoreClass(n: number | null | undefined): string {
  if (!n) return 'text-slate-300';
  if (n >= 80) return 'text-emerald-600';
  if (n >= 60) return 'text-amber-600';
  return 'text-red-600';
}

function badgeClass(cat: string): string {
  if (cat === 'Sobresaliente') return 'bg-emerald-100 text-emerald-700';
  if (cat === 'Distinguido') return 'bg-blue-100 text-blue-700';
  if (cat === 'Bueno') return 'bg-purple-100 text-purple-700';
  if (cat === 'Aprobado') return 'bg-amber-100 text-amber-700';
  if (cat === 'A mejorar') return 'bg-orange-100 text-orange-700';
  if (cat === 'Insuficiente') return 'bg-red-100 text-red-700';
  if (cat === 'Parcial') return 'bg-slate-100 text-slate-600';
  return 'bg-slate-100 text-slate-600';
}

function miniClass(n: number | null | undefined): string {
  if (!n) return 'text-slate-300';
  if (n >= 80) return 'text-emerald-600';
  if (n >= 60) return 'text-amber-600';
  return 'text-red-600';
}

function fmt(n: number | null | undefined): string {
  return formatScore(n);
}
---

<LayoutAdmin titulo="Docentes 360 — Admin">
  <div class="animate-flotar-entrada max-w-7xl mx-auto">
    <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
      <div>
        <h1 class="text-3xl font-bold text-tup">Docentes 360</h1>
        <p class="text-sm text-slate-500 mt-1">Acceso rápido a los resultados y al análisis detallado por docente.</p>
      </div>
      <form method="GET" class="flex flex-wrap gap-3 items-end bg-white rounded-2xl border border-slate-200 p-4 shadow-sm">
        <div>
          <label class="block text-xs font-semibold text-slate-500 mb-1">Ciclo</label>
          <select name="cuatrimestre" class="rounded-xl border border-slate-200 px-3 py-2 text-sm" onchange="this.form.submit()">
            {cuatrimestres.map((c: any) => (<option value={c.id} selected={c.id === cuatrimestreId}>{c.clave}</option>))}
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-500 mb-1">Buscar</label>
          <input type="text" name="q" value={busqueda} placeholder="Nombre, email, campus..." class="rounded-xl border border-slate-200 px-3 py-2 text-sm w-72 max-w-full" />
        </div>
        <button type="submit" class="px-4 py-2 rounded-xl bg-tup text-white text-sm font-medium">Filtrar</button>
        {busqueda && <a href={`/admin/resultados-docentes${qs}`} class="px-4 py-2 rounded-xl border border-slate-200 text-sm text-slate-600">Limpiar</a>}
      </form>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
      <div class="bg-white rounded-2xl p-5 shadow-tarjeta">
        <p class="text-xs uppercase tracking-wider text-slate-400">Docentes superiores a distinguido</p>
        <p class="text-3xl font-bold text-tup mt-1">{sobresalientes.length}</p>
      </div>
      <div class="bg-white rounded-2xl p-5 shadow-tarjeta">
        <p class="text-xs uppercase tracking-wider text-slate-400">Resultados mostrados</p>
        <p class="text-3xl font-bold text-tup mt-1">{cards.length}</p>
      </div>
      <div class="bg-white rounded-2xl p-5 shadow-tarjeta">
        <p class="text-xs uppercase tracking-wider text-slate-400">Promedio 360</p>
        <p class={`text-3xl font-bold mt-1 ${scoreClass(promedioGeneral)}`}>{fmt(promedioGeneral)}</p>
      </div>
      <div class="bg-white rounded-2xl p-5 shadow-tarjeta">
        <p class="text-xs uppercase tracking-wider text-slate-400">Mejor resultado</p>
        <p class={`text-3xl font-bold mt-1 ${scoreClass(mejorDocente?.final)}`}>{fmt(mejorDocente?.final)}</p>
        <p class="text-xs text-slate-400 mt-1">{mejorDocente ? `${mejorDocente.nombre} ${mejorDocente.apellidos}` : 'Sin datos'}</p>
      </div>
    </div>

    {cards.length === 0 ? (
      <div class="bg-white rounded-2xl p-12 text-center text-slate-400 shadow-tarjeta">No se encontraron docentes con resultados.</div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
        {cards.map((d) => (
          <a href={`/admin/docentes/${d.id}${qs}`} class="group bg-white rounded-3xl p-5 shadow-tarjeta hover:shadow-tarjeta-hover hover:-translate-y-0.5 transition-all border border-slate-100">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-[11px] uppercase tracking-wider text-slate-400">Docente</p>
                <h2 class="text-lg font-bold text-slate-800 group-hover:text-tup">{d.nombre.toUpperCase()} {d.apellidos.toUpperCase()}</h2>
                <p class="text-sm text-slate-500">{d.email}</p>
                <p class="text-xs text-slate-400 mt-1">{d.campus || 'Sin campus'} · {d.modalidad || 'Sin modalidad'}</p>
              </div>
              <div class="text-right">
                <p class={`text-4xl font-bold ${scoreClass(d.final)}`}>{fmt(d.final)}</p>
                <span class={`inline-flex mt-1 px-2 py-0.5 rounded-full text-[10px] font-medium ${badgeClass(d.category)}`}>{d.category}</span>
              </div>
            </div>

            <div class="mt-4 grid grid-cols-5 gap-2 text-center text-[10px]">
              <div><span class="text-slate-400">EE</span><br /><span class={`font-bold ${miniClass(d.ee)}`}>{fmt(d.ee)}</span></div>
              <div><span class="text-slate-400">Coord</span><br /><span class={`font-bold ${miniClass(d.coord)}`}>{fmt(d.coord)}</span></div>
              <div><span class="text-slate-400">Plan</span><br /><span class={`font-bold ${miniClass(d.plan)}`}>{fmt(d.plan)}</span></div>
              <div><span class="text-slate-400">Obs</span><br /><span class={`font-bold ${miniClass(d.obs)}`}>{fmt(d.obs)}</span></div>
              <div><span class="text-slate-400">Auto</span><br /><span class={`font-bold ${miniClass(d.auto)}`}>{fmt(d.auto)}</span></div>
            </div>

            <div class="mt-4 flex items-center justify-between text-xs text-slate-400">
              <span>{d.instruments}/{d.expected} instrumentos</span>
              <span class="text-tup font-medium group-hover:translate-x-0.5 transition-transform">Ver detalle →</span>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</LayoutAdmin>
