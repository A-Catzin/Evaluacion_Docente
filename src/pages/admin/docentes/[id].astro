---
import LayoutAdmin from '../../../layouts/LayoutAdmin.astro';
import { dbAdmin } from '../../../lib/db';
import { fetchCuatrimestreScores, fetchNativeStudentEvaluationScores, calcFinalScore, formatScore, OBSERVATION_SELECT } from '../../../services/scoring';
import { OBSERVATION_INSTRUMENT_DEFINITIONS, OBSERVATION_STORAGE_SECTIONS, getObservationQuestion, isObservationInstrumentVersion, type ObservationInstrumentVersion } from '../../../lib/observationDefinitions';

const COORD_SECTION_DEFS = [
  { code: 'A', title: 'Cumplimiento Académico', fields: ['a1', 'a2', 'a3'] },
  { code: 'B', title: 'Gestión y Organización', fields: ['b1', 'b2', 'b3'] },
  { code: 'C', title: 'Desempeño Profesional', fields: ['c1', 'c2', 'c3'] },
  { code: 'D', title: 'Innovación y Mejora', fields: ['d1', 'd2', 'd3'] },
  { code: 'E', title: 'Compromiso y Ética', fields: ['e1', 'e2', 'e3'] },
] as const;

const PLAN_CRITERIA = [
  { field: 'criterio_alineacion', label: 'Alineación curricular' },
  { field: 'criterio_secuencia', label: 'Secuencia didáctica' },
  { field: 'criterio_recursos', label: 'Recursos y materiales' },
  { field: 'criterio_evaluacion', label: 'Sistema de evaluación' },
] as const;

const AUTO_FIELDS = Array.from({ length: 24 }, (_, i) => `r${i + 1}`);

const currentSearch = Astro.url.search || '';
const docenteId = parseInt(Astro.params.id || '');
if (!docenteId) return Astro.redirect(`/admin/resultados-docentes${currentSearch}`);

const cl = dbAdmin();
const [docenteRes, cuatrisRes] = await Promise.all([
  cl.from('docentes').select('id,nombre,apellidos,email,campus,modalidad,visible_dashboard,activo').eq('id', docenteId).maybeSingle(),
  cl.from('cuatrimestres').select('id,clave,nombre,activo,cerrado').order('id', { ascending: true }),
]);

const docente = docenteRes.data as any;
if (!docente) return Astro.redirect(`/admin/resultados-docentes${currentSearch}`);

const cuatrimestres = ((cuatrisRes.data || []) as any[]).sort((a, b) => a.id - b.id);
const activeCuatriId = cuatrimestres.find((c) => c.activo)?.id ?? cuatrimestres[cuatrimestres.length - 1]?.id ?? 0;
const queryCuatriId = parseInt(Astro.url.searchParams.get('cuatrimestre') || '') || 0;
const cookieCuatriId = parseInt(Astro.cookies.get('cuatrimestre_sel')?.value || '') || 0;
const cuatrimestreId = queryCuatriId || activeCuatriId || cookieCuatriId || 0;
const qs = cuatrimestreId ? `?cuatrimestre=${cuatrimestreId}` : '';
const cuatrimestreQuery = cuatrimestreId ? `&cuatrimestre=${cuatrimestreId}` : '';
const selectedCuatrimestre = cuatrimestres.find((c) => c.id === cuatrimestreId) || null;
const feedbackStatus = Astro.url.searchParams.get('feedback') || '';

if (Astro.url.searchParams.has('cuatrimestre') && cuatrimestreId) {
  Astro.cookies.set('cuatrimestre_sel', String(cuatrimestreId), { path: '/', maxAge: 60 * 60 * 24 * 30 });
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const submittedCuatriId = parseInt(String(form.get('cuatrimestre_id') || '')) || cuatrimestreId;
  const feedbackText = String(form.get('feedback_text') || '').trim() || null;
  const improvementAreas = String(form.get('improvement_areas') || '').trim() || null;

  if (submittedCuatriId) {
    const { error: saveError } = await cl.from('docente_360_feedback').upsert(
      {
        docente_id: docenteId,
        cuatrimestre_id: submittedCuatriId,
        feedback_text: feedbackText,
        improvement_areas: improvementAreas,
      },
      { onConflict: 'docente_id,cuatrimestre_id' }
    );

    if (saveError) return Astro.redirect(`/admin/docentes/${docenteId}?cuatrimestre=${submittedCuatriId}&feedback=error`);
    return Astro.redirect(`/admin/docentes/${docenteId}?cuatrimestre=${submittedCuatriId}&feedback=saved`);
  }

  return Astro.redirect(`/admin/docentes/${docenteId}?feedback=error`);
}

const [feedbackRes, eeRes, coordRes, planRes, obsRes, autoRes, preguntasRes] = await Promise.all([
  cuatrimestreId
    ? cl.from('docente_360_feedback').select('id,docente_id,cuatrimestre_id,feedback_text,improvement_areas,created_at,updated_at').eq('docente_id', docenteId).eq('cuatrimestre_id', cuatrimestreId).maybeSingle()
    : Promise.resolve({ data: null }),
  cuatrimestreId
    ? fetchNativeStudentEvaluationScores(cl, cuatrimestreId)
    : Promise.resolve([]),
  cuatrimestreId
    ? cl.from('evaluacion_coordinacion').select('id,docente_id,asignatura_id,campus,ciclo,a1,a2,a3,b1,b2,b3,c1,c2,c3,d1,d2,d3,e1,e2,e3,puntos_obtenidos,score_normalizado,categoria,comentarios,fecha_evaluacion').eq('docente_id', docenteId).eq('cuatrimestre_id', cuatrimestreId).order('id', { ascending: false })
    : Promise.resolve({ data: [] }),
  cuatrimestreId
    ? cl.from('planeaciones').select('id,docente_id,asignatura_id,grupo,campus,turno,modalidad,proyecto,laboratorio,visitas,estado,criterio_alineacion,criterio_secuencia,criterio_recursos,criterio_evaluacion,evaluacion_detalle,no_aplica_count,observaciones_generales,puntaje_promedio,comentario_retroalimentacion,comentario_interno,fecha_subida,fecha_evaluacion').eq('docente_id', docenteId).eq('cuatrimestre_id', cuatrimestreId).order('fecha_evaluacion', { ascending: false })
    : Promise.resolve({ data: [] }),
  cuatrimestreId
    ? cl.from('observaciones').select(`id,docente_id,asignatura_id,grupo_id_fk,oferta_academica,cuatrimestre_grupo,ciclo,campus,instrument_version,${OBSERVATION_SELECT},ccom5,obs_cognitivas,obs_metacognitivas,obs_comunicativas,obs_sociales,obs_gestion,obs_afectivas,obs_tecno,obs_normativa,comentario_docente,comentario_evaluador,fecha_observacion`).eq('docente_id', docenteId).eq('cuatrimestre_id', cuatrimestreId).order('id', { ascending: false })
    : Promise.resolve({ data: [] }),
  cuatrimestreId
    ? cl.from('autodiagnosticos').select('id,docente_id,cuatrimestre_id,r1,r2,r3,r4,r5,r6,r7,r8,r9,r10,r11,r12,r13,r14,r15,r16,r17,r18,r19,r20,r21,r22,r23,r24,puntaje_total,nivel_desempeno,comentarios,fecha_respuesta').eq('docente_id', docenteId).eq('cuatrimestre_id', cuatrimestreId).order('id', { ascending: false })
    : Promise.resolve({ data: [] }),
  cl.from('instrumento_preguntas').select('instrumento,seccion,orden,texto').in('instrumento', ['coordinacion', 'planeacion', 'observacion', 'autodiagnostico']).order('instrumento', { ascending: true }).order('orden', { ascending: true }),
]);

const feedback = feedbackRes.data as any;
const eeRows = (eeRes || []).filter((row) => row.docente_id === docenteId) as any[];
const coordRows = (coordRes.data || []) as any[];
const planRows = (planRes.data || []) as any[];
const obsRows = (obsRes.data || []) as any[];
const autoRows = (autoRes.data || []) as any[];
const preguntaRows = (preguntasRes.data || []) as any[];

const asigIds = new Set<number>();
const grupoIds = new Set<number>();
for (const row of [...eeRows, ...coordRows, ...planRows, ...obsRows]) {
  if (row.asignatura_id) asigIds.add(row.asignatura_id);
  if (row.grupo_id) grupoIds.add(row.grupo_id);
  if (row.grupo_id_fk) grupoIds.add(row.grupo_id_fk);
}

const asigIdsArray = [...asigIds];
const grupoIdsArray = [...grupoIds];
const [asigLookupRes, grupoLookupRes] = await Promise.all([
  cl.from('asignaturas').select('id,clave,nombre').in('id', asigIdsArray.length ? asigIdsArray : [-1]),
  cl.from('grupos').select('id,clave').in('id', grupoIdsArray.length ? grupoIdsArray : [-1]),
]);

const asigMap = new Map<number, any>();
for (const item of (asigLookupRes.data || []) as any[]) asigMap.set(item.id, item);
const grupoMap = new Map<number, any>();
for (const item of (grupoLookupRes.data || []) as any[]) grupoMap.set(item.id, item);

const preguntaMap = new Map<string, any[]>();
for (const p of preguntaRows) {
  if (!preguntaMap.has(p.instrumento)) preguntaMap.set(p.instrumento, []);
  preguntaMap.get(p.instrumento)!.push(p);
}
for (const arr of preguntaMap.values()) arr.sort((a, b) => a.orden - b.orden);

const planCategoryLabels = new Map(
  preguntaRows
    .filter((p) => typeof p.seccion === 'string' && p.seccion.startsWith('cat_'))
    .map((p) => [p.seccion, p.texto] as const)
);

function fmt(n: number | null | undefined): string {
  return formatScore(n);
}

function fmtDate(value: string | null | undefined): string {
  if (!value) return '—';
  return new Intl.DateTimeFormat('es-MX', { dateStyle: 'medium' }).format(new Date(value));
}

function scoreClass(n: number | null | undefined): string {
  if (!n) return 'text-slate-300';
  if (n >= 80) return 'text-emerald-600';
  if (n >= 60) return 'text-amber-600';
  return 'text-red-600';
}

function badgeClass(cat: string): string {
  if (cat === 'Sobresaliente') return 'bg-emerald-100 text-emerald-700';
  if (cat === 'Distinguido') return 'bg-blue-100 text-blue-700';
  if (cat === 'Bueno') return 'bg-purple-100 text-purple-700';
  if (cat === 'Aprobado') return 'bg-amber-100 text-amber-700';
  if (cat === 'A mejorar') return 'bg-orange-100 text-orange-700';
  if (cat === 'Insuficiente') return 'bg-red-100 text-red-700';
  if (cat === 'Parcial') return 'bg-slate-100 text-slate-600';
  return 'bg-slate-100 text-slate-600';
}

function toPct(value: number | null | undefined, max = 5): number | null {
  if (value == null || value <= 0) return null;
  return Math.round((value / max) * 100);
}

function avgPctRaw(row: any, fields: readonly string[]): number | null {
  const values = fields.map((field) => row[field]).filter((value): value is number => value != null && value > 0);
  if (!values.length) return null;
  return Math.round((values.reduce((sum, value) => sum + value, 0) / values.length) * 20);
}

function buildItems(instrument: string, fields: readonly string[], row: any) {
  const preguntas = preguntaMap.get(instrument) || [];
  return fields.map((field, index) => ({
    field,
    label: preguntas[index]?.texto || `Item ${index + 1}`,
    section: preguntas[index]?.seccion || '',
    value: row[field],
    score: toPct(row[field]),
  }));
}

function planningState(value: unknown): { label: string; className: string } {
  const score = value && typeof value === 'object' && 'score' in value ? (value as { score?: unknown }).score : value;
  if (score === 2 || score === '2') return { label: '2 / 2', className: 'bg-emerald-100 text-emerald-700' };
  if (score === 1 || score === '1') return { label: '1 / 2', className: 'bg-amber-100 text-amber-700' };
  if (score === 0 || score === '0') return { label: '0 / 2', className: 'bg-red-50 text-red-700' };
  if (score === 'na') return { label: 'No aplica', className: 'bg-slate-100 text-slate-600' };
  if (score == null) return { label: 'Sin registro', className: 'bg-slate-100 text-slate-500' };
  return { label: `Valor registrado: ${String(score)}`, className: 'bg-slate-100 text-slate-600' };
}

function buildPlanningRubric(row: any) {
  const detail = row.evaluacion_detalle;
  if (detail !== null && typeof detail === 'object' && !Array.isArray(detail)) {
    const values = detail as Record<string, unknown>;
    const keys = [...new Set([...planCategoryLabels.keys(), ...Object.keys(values)])];
    return {
      current: true,
      items: keys.map((key) => ({ key, label: planCategoryLabels.get(key) || key, state: planningState(values[key]) })),
    };
  }

  return {
    current: false,
    items: PLAN_CRITERIA.map((criterion) => ({ key: criterion.field, label: criterion.label, state: planningState(row[criterion.field]) })),
  };
}

function observationState(value: unknown): { label: string; className: string; kind: 'scored' | 'na' | 'missing' | 'other' } {
  if (value === 0 || value === '0') return { label: 'No aplica', className: 'bg-slate-100 text-slate-600', kind: 'na' };
  if (value == null) return { label: 'Sin registro', className: 'bg-slate-100 text-slate-500', kind: 'missing' };
  const numeric = Number(value);
  if (Number.isInteger(numeric) && numeric >= 1 && numeric <= 5) {
    return { label: `${numeric} / 5`, className: 'bg-blue-50 text-blue-700', kind: 'scored' };
  }
  return { label: `Valor registrado: ${String(value)}`, className: 'bg-slate-100 text-slate-600', kind: 'other' };
}

function buildObservationSections(row: any) {
  const storedVersion: ObservationInstrumentVersion | null = isObservationInstrumentVersion(row.instrument_version)
    ? row.instrument_version
    : null;
  const sections = storedVersion
    ? OBSERVATION_INSTRUMENT_DEFINITIONS[storedVersion].sections.map((section) => ({
      code: section.code,
      title: section.title,
      fields: section.fields,
    }))
    // Historical records did not persist their instrument version. Use the
    // canonical school rubric as a reference without inferring a modality.
    : OBSERVATION_STORAGE_SECTIONS.map((section) => ({
      code: section.code,
      title: section.title,
      fields: section.fields.map((key) => ({
        key,
        text: getObservationQuestion('escolarizado-v1', key) || 'Texto de pregunta no disponible para esta versión.',
      })),
    }));

  return sections.map((section) => {
    const items = section.fields.map((field) => {
      const state = observationState(row[field.key]);
      return {
        field: field.key,
        state,
        question: field.text,
      };
    });
    return {
      code: section.code,
      title: section.title,
      items,
      counts: {
        scored: items.filter((item) => item.state.kind === 'scored').length,
        na: items.filter((item) => item.state.kind === 'na').length,
        missing: items.filter((item) => item.state.kind === 'missing').length,
      },
    };
  });
}

function seriesLabel(series: any): string {
  const asig = series.asignatura_id ? asigMap.get(series.asignatura_id) : null;
  const clave = asig?.clave || '';
  const nombre = asig?.nombre || '';
  return [clave, nombre].filter(Boolean).join(' · ') || 'Sin materia';
}

function groupLabel(id: number | null | undefined): string {
  if (!id) return '—';
  return grupoMap.get(id)?.clave || `Grupo ${id}`;
}

const eeRecords = eeRows.map((row) => ({
  ...row,
  title: seriesLabel(row),
  meta: [row.grupo_id ? `Grupo ${groupLabel(row.grupo_id)}` : null, row.version_calculo].filter(Boolean).join(' · '),
  score: row.score_normalizado != null ? Number(row.score_normalizado) : null,
}));

const coordRecords = coordRows.map((row) => ({
  ...row,
  title: seriesLabel(row),
  meta: [row.campus || null, row.ciclo || null, row.fecha_evaluacion ? fmtDate(row.fecha_evaluacion) : null].filter(Boolean).join(' · '),
  score: row.score_normalizado != null ? Number(row.score_normalizado) : null,
  category: row.categoria || '—',
  sections: COORD_SECTION_DEFS.map((section) => ({
    code: section.code,
    title: section.title,
    score: avgPctRaw(row, section.fields),
  })),
  items: buildItems('coordinacion', COORD_SECTION_DEFS.flatMap((section) => section.fields), row),
  comments: row.comentarios || null,
}));

const planRecords = planRows.map((row) => ({
  ...row,
  title: seriesLabel(row),
  meta: [row.grupo ? `Grupo ${row.grupo}` : null, row.modalidad || null, row.estado || null, row.fecha_evaluacion ? fmtDate(row.fecha_evaluacion) : null].filter(Boolean).join(' · '),
  score: row.puntaje_promedio != null ? Number(row.puntaje_promedio) : null,
  rubric: buildPlanningRubric(row),
  noAplicaCount: Number(row.no_aplica_count || 0),
  generalObservations: row.observaciones_generales || null,
  feedback: row.comentario_retroalimentacion || null,
  internal: row.comentario_interno || null,
}));

const obsRecords = obsRows.map((row) => ({
  ...row,
  title: seriesLabel(row),
  meta: [row.grupo_id_fk ? `Grupo ${groupLabel(row.grupo_id_fk)}` : null, row.campus || null, row.ciclo || null, row.fecha_observacion ? fmtDate(row.fecha_observacion) : null].filter(Boolean).join(' · '),
  score: row.score_normalizado != null ? Number(row.score_normalizado) : null,
  instrumentVersion: isObservationInstrumentVersion(row.instrument_version)
    ? row.instrument_version
    : 'escolarizado-v1 · referencia histórica',
  sections: buildObservationSections(row),
  comments: [row.comentario_docente, row.comentario_evaluador].filter(Boolean).join(' · ') || null,
}));

const autoRecords = autoRows.map((row) => ({
  ...row,
  score: row.puntaje_total != null ? (Number(row.puntaje_total) / 120) * 100 : null,
  level: row.nivel_desempeno || '—',
  meta: row.fecha_respuesta ? fmtDate(row.fecha_respuesta) : '—',
  items: buildItems('autodiagnostico', AUTO_FIELDS, row),
  comments: row.comentarios || null,
}));

const currentScores = await fetchCuatrimestreScores(cl, docenteId, cuatrimestreId);
const currentFinal = calcFinalScore(currentScores, docente.modalidad);

const historial: { clave: string; final: number; cat: string; inst: number; expected: number; ee: number | null; coord?: number; plan?: number; obs?: number; auto?: number }[] = [];
let sumFinals = 0;
let bestCycle = { clave: '', final: 0 };

for (const ciclo of cuatrimestres) {
  const scores = await fetchCuatrimestreScores(cl, docenteId, ciclo.id);
  const fin = calcFinalScore(scores, docente.modalidad);
  if (fin.instrumentCount > 0) {
    historial.push({
      clave: ciclo.clave,
      final: fin.final,
      cat: fin.category,
      inst: fin.instrumentCount,
      expected: fin.expectedInstrumentCount,
      ee: scores.ee ?? null,
      coord: scores.coord,
      plan: scores.plan,
      obs: scores.obs,
      auto: scores.auto,
    });
    sumFinals += fin.final;
    if (fin.final > bestCycle.final) bestCycle = { clave: ciclo.clave, final: fin.final };
  }
}

const cyclesEvaluated = historial.length;
const historicalAvg = cyclesEvaluated > 0 ? Math.round(sumFinals / cyclesEvaluated) : 0;
---

<LayoutAdmin titulo={`Docente 360 — ${docente.nombre} ${docente.apellidos}`}>
  <div class="animate-flotar-entrada max-w-7xl mx-auto">
    <div class="flex items-center gap-2 text-sm text-slate-400 mb-6 flex-wrap">
      <a href={`/admin/resultados-docentes${qs}`} class="hover:text-tup">Resultados 360</a>
      <span>/</span>
      <a href={`/admin/reporte-anual${qs}`} class="hover:text-tup">Reporte Anual</a>
      <span>/</span>
      <span class="text-slate-600 font-medium">Docente</span>
    </div>

    <div class="bg-white rounded-3xl p-6 shadow-tarjeta mb-6">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h1 class="text-3xl font-bold text-tup">{docente.nombre.toUpperCase()} {docente.apellidos.toUpperCase()}</h1>
          <p class="text-sm text-slate-500 mt-1">{docente.email}</p>
          <p class="text-xs text-slate-400 mt-1">{docente.campus || 'Sin campus'} · {docente.modalidad || 'Sin modalidad'} · {selectedCuatrimestre?.clave || 'Sin ciclo'}</p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href={`/admin/resultados-docentes${qs}`} class="px-4 py-2 rounded-xl border border-slate-200 text-sm text-slate-600 hover:bg-slate-50">← Volver a tarjetas</a>
          <a href={`/admin/reporte-anual?modo=individual&docente_id=${docenteId}${cuatrimestreQuery}`} class="px-4 py-2 rounded-xl border border-slate-200 text-sm text-slate-600 hover:bg-slate-50">📈 Reporte anual</a>
          <a href={`/api/admin/historial-docente?docente_id=${docenteId}&format=csv`} class="px-4 py-2 rounded-xl bg-emerald-600 text-white text-sm font-medium">⬇ CSV</a>
        </div>
      </div>
    </div>

    {feedbackStatus === 'saved' && <div class="mb-6 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">La retroalimentación se guardó.</div>}
    {feedbackStatus === 'error' && <div class="mb-6 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">No se pudo guardar la retroalimentación.</div>}

    <div class="grid grid-cols-2 xl:grid-cols-5 gap-4 mb-6">
      <div class="bg-white rounded-2xl p-5 shadow-tarjeta text-center">
        <p class="text-xs uppercase tracking-wider text-slate-400 mb-1">360 actual</p>
        <p class={`text-4xl font-bold ${scoreClass(currentFinal.final)}`}>{fmt(currentFinal.final)}</p>
      </div>
      <div class="bg-white rounded-2xl p-5 shadow-tarjeta text-center">
        <p class="text-xs uppercase tracking-wider text-slate-400 mb-1">Categoría</p>
        <p class="text-xl font-bold text-tup">{currentFinal.category}</p>
      </div>
      <div class="bg-white rounded-2xl p-5 shadow-tarjeta text-center">
        <p class="text-xs uppercase tracking-wider text-slate-400 mb-1">Instrumentos</p>
        <p class="text-3xl font-bold text-tup">{currentFinal.instrumentCount}/{currentFinal.expectedInstrumentCount}</p>
      </div>
      <div class="bg-white rounded-2xl p-5 shadow-tarjeta text-center">
        <p class="text-xs uppercase tracking-wider text-slate-400 mb-1">Promedio histórico</p>
        <p class={`text-3xl font-bold ${scoreClass(historicalAvg)}`}>{fmt(historicalAvg)}</p>
      </div>
      <div class="bg-white rounded-2xl p-5 shadow-tarjeta text-center">
        <p class="text-xs uppercase tracking-wider text-slate-400 mb-1">Mejor ciclo</p>
        <p class="text-2xl font-bold text-tup">{bestCycle.clave || '—'}</p>
        <p class={`text-lg font-semibold ${scoreClass(bestCycle.final)}`}>{fmt(bestCycle.final)}</p>
      </div>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-2 gap-6 mb-6">
      <div class="bg-white rounded-3xl p-6 shadow-tarjeta">
        <h2 class="text-lg font-bold text-tup mb-4">Scores por instrumento</h2>
        <div class="h-[260px]"><canvas id="chart-barras" class="max-h-[260px]" data-labels={JSON.stringify(['Estudiantil', 'Coordinación', 'Planeación', 'Observación', 'Autodiagnóstico'])} data-scores={JSON.stringify([currentScores.ee || 0, currentScores.coord || 0, currentScores.plan || 0, currentScores.obs || 0, currentScores.auto || 0])}></canvas></div>
      </div>
      <div class="bg-white rounded-3xl p-6 shadow-tarjeta">
        <h2 class="text-lg font-bold text-tup mb-4">Radar 360</h2>
        <div class="h-[260px]"><canvas id="chart-radar" class="max-h-[260px]" data-labels={JSON.stringify(['Estudiantil', 'Coordinación', 'Planeación', 'Observación', 'Autodiagnóstico'])} data-scores={JSON.stringify([currentScores.ee || 0, currentScores.coord || 0, currentScores.plan || 0, currentScores.obs || 0, currentScores.auto || 0])}></canvas></div>
      </div>
    </div>

    <div class="grid grid-cols-2 xl:grid-cols-5 gap-4 mb-8">
      <div class="bg-white rounded-2xl p-4 shadow-tarjeta text-center">
        <p class="text-xs uppercase text-slate-400">Estudiantil</p>
        <p class={`text-2xl font-bold mt-1 ${scoreClass(currentScores.ee)}`}>{fmt(currentScores.ee)}</p>
      </div>
      <div class="bg-white rounded-2xl p-4 shadow-tarjeta text-center">
        <p class="text-xs uppercase text-slate-400">Coordinación</p>
        <p class={`text-2xl font-bold mt-1 ${scoreClass(currentScores.coord)}`}>{fmt(currentScores.coord)}</p>
      </div>
      <div class="bg-white rounded-2xl p-4 shadow-tarjeta text-center">
        <p class="text-xs uppercase text-slate-400">Planeación</p>
        <p class={`text-2xl font-bold mt-1 ${scoreClass(currentScores.plan)}`}>{fmt(currentScores.plan)}</p>
      </div>
      <div class="bg-white rounded-2xl p-4 shadow-tarjeta text-center">
        <p class="text-xs uppercase text-slate-400">Observación</p>
        <p class={`text-2xl font-bold mt-1 ${scoreClass(currentScores.obs)}`}>{fmt(currentScores.obs)}</p>
      </div>
      <div class="bg-white rounded-2xl p-4 shadow-tarjeta text-center">
        <p class="text-xs uppercase text-slate-400">Autodiagnóstico</p>
        <p class={`text-2xl font-bold mt-1 ${scoreClass(currentScores.auto)}`}>{fmt(currentScores.auto)}</p>
      </div>
    </div>

    <div class="bg-white rounded-3xl p-6 shadow-tarjeta mb-8">
      <div class="flex items-center justify-between gap-4 flex-wrap mb-4">
        <div>
          <h2 class="text-lg font-bold text-tup">Retroalimentación persistente</h2>
          <p class="text-sm text-slate-500">Se guarda por docente y cuatrimestre en la base de datos.</p>
        </div>
        {feedback?.updated_at && <p class="text-xs text-slate-400">Actualizado: {fmtDate(feedback.updated_at)}</p>}
      </div>

      <form method="POST" class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <input type="hidden" name="cuatrimestre_id" value={cuatrimestreId} />
        <label class="block">
          <span class="block text-sm font-medium text-slate-700 mb-2">Retroalimentación general</span>
          <textarea name="feedback_text" rows="6" class="w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm focus:ring-2 focus:ring-tup focus:outline-none" placeholder="Escribe aquí la retroalimentación global para este docente...">{feedback?.feedback_text || ''}</textarea>
        </label>
        <label class="block">
          <span class="block text-sm font-medium text-slate-700 mb-2">Áreas a mejorar</span>
          <textarea name="improvement_areas" rows="6" class="w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm focus:ring-2 focus:ring-tup focus:outline-none" placeholder="Lista las áreas de oportunidad priorizadas...">{feedback?.improvement_areas || ''}</textarea>
        </label>
        <div class="lg:col-span-2 flex items-center justify-end gap-3">
          <a href={`/admin/resultados-docentes${qs}`} class="px-4 py-2 rounded-xl border border-slate-200 text-sm text-slate-600 hover:bg-slate-50">Cancelar</a>
          <button type="submit" class="px-5 py-2 rounded-xl bg-tup text-white text-sm font-medium">Guardar feedback</button>
        </div>
      </form>
    </div>

    <div class="space-y-6 mb-8">
      <details open class="bg-white rounded-3xl shadow-tarjeta overflow-hidden">
        <summary class="px-6 py-4 border-b border-slate-100 cursor-pointer list-none flex items-center justify-between">
          <span class="text-lg font-bold text-tup">Encuesta estudiantil</span>
          <span class="text-sm text-slate-400">{eeRecords.length} registros</span>
        </summary>
        <div class="p-6 space-y-4">
          {eeRecords.length === 0 ? (
            <div class="rounded-2xl border border-dashed border-slate-200 p-8 text-center text-slate-400">No hay registros de encuesta para este ciclo.</div>
          ) : (
            eeRecords.map((record) => (
              <article class="rounded-3xl border border-slate-100 p-5">
                <div class="flex flex-wrap items-start justify-between gap-4">
                  <div>
                    <p class="text-xs uppercase tracking-wider text-slate-400">{record.title}</p>
                    <h3 class="text-lg font-semibold text-slate-800 mt-1">{record.meta || 'Sin metadatos'}</h3>
                  </div>
                  <div class="text-right">
                    <p class={`text-3xl font-bold ${scoreClass(record.score)}`}>{fmt(record.score)}</p>
                    <p class="text-xs text-slate-400">{record.respuestas_validas || 0} respuestas válidas</p>
                  </div>
                </div>
              </article>
            ))
          )}
        </div>
      </details>

      <details class="bg-white rounded-3xl shadow-tarjeta overflow-hidden">
        <summary class="px-6 py-4 border-b border-slate-100 cursor-pointer list-none flex items-center justify-between">
          <span class="text-lg font-bold text-tup">Coordinación</span>
          <span class="text-sm text-slate-400">{coordRecords.length} registros</span>
        </summary>
        <div class="p-6 space-y-6">
          {coordRecords.length === 0 ? (
            <div class="rounded-2xl border border-dashed border-slate-200 p-8 text-center text-slate-400">No hay evaluaciones de coordinación para este ciclo.</div>
          ) : (
            coordRecords.map((record) => (
              <article class="rounded-3xl border border-slate-100 p-5">
                <div class="flex flex-wrap items-start justify-between gap-4">
                  <div>
                    <p class="text-xs uppercase tracking-wider text-slate-400">{record.title}</p>
                    <h3 class="text-lg font-semibold text-slate-800 mt-1">{record.meta || 'Sin metadatos'}</h3>
                  </div>
                  <div class="text-right">
                    <p class={`text-3xl font-bold ${scoreClass(record.score)}`}>{fmt(record.score)}</p>
                    <span class={`inline-flex mt-1 px-2 py-0.5 rounded-full text-[10px] font-medium ${badgeClass(record.category)}`}>{record.category}</span>
                  </div>
                </div>
                <div class="grid grid-cols-2 md:grid-cols-5 gap-3 mt-4">
                  {record.sections.map((section: any) => (
                    <div class="rounded-2xl bg-slate-50 p-3 text-center">
                      <p class="text-[11px] uppercase tracking-wider text-slate-400">{section.code}</p>
                      <p class={`text-xl font-bold mt-1 ${scoreClass(section.score)}`}>{fmt(section.score)}</p>
                      <p class="text-[11px] text-slate-500 mt-1">{section.title}</p>
                    </div>
                  ))}
                </div>
                <div class="mt-5 overflow-x-auto">
                  <table class="w-full text-sm">
                    <thead>
                      <tr class="bg-slate-50 text-slate-500">
                        <th class="px-3 py-2 text-left text-xs uppercase">Sección</th>
                        <th class="px-3 py-2 text-left text-xs uppercase">Pregunta</th>
                        <th class="px-3 py-2 text-center text-xs uppercase">Score</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y">
                      {record.items.map((item: any) => (
                        <tr>
                          <td class="px-3 py-2 text-xs text-slate-400">{item.section || '—'}</td>
                          <td class="px-3 py-2 text-slate-700">{item.label}</td>
                          <td class={`px-3 py-2 text-center font-semibold ${scoreClass(item.score)}`}>{fmt(item.score)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                {record.comments && <p class="mt-4 text-sm text-slate-600 italic">“{record.comments}”</p>}
              </article>
            ))
          )}
        </div>
      </details>

      <details class="bg-white rounded-3xl shadow-tarjeta overflow-hidden">
        <summary class="px-6 py-4 border-b border-slate-100 cursor-pointer list-none flex items-center justify-between">
          <span class="text-lg font-bold text-tup">Planeación</span>
          <span class="text-sm text-slate-400">{planRecords.length} registros</span>
        </summary>
        <div class="p-6 space-y-6">
          {planRecords.length === 0 ? (
            <div class="rounded-2xl border border-dashed border-slate-200 p-8 text-center text-slate-400">No hay planeaciones aprobadas para este ciclo.</div>
          ) : (
            planRecords.map((record) => (
              <article class="rounded-3xl border border-slate-100 p-5">
                <div class="flex flex-wrap items-start justify-between gap-4">
                  <div>
                    <p class="text-xs uppercase tracking-wider text-slate-400">{record.title}</p>
                    <h3 class="text-lg font-semibold text-slate-800 mt-1">{record.meta || 'Sin metadatos'}</h3>
                  </div>
                  <div class="text-right">
                    <p class={`text-3xl font-bold ${scoreClass(record.score)}`}>{fmt(record.score)}</p>
                    <span class={`inline-flex mt-1 px-2 py-0.5 rounded-full text-[10px] font-medium ${badgeClass(record.estado)}`}>{record.estado}</span>
                  </div>
                </div>
                <details class="mt-5 rounded-2xl border border-slate-200 overflow-hidden">
                  <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-tup bg-slate-50">
                    Detalles de rúbrica <span class="text-slate-400 font-normal">({record.rubric.current ? 'instrumento actual' : 'criterios heredados'})</span>
                  </summary>
                  <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                      <thead>
                        <tr class="bg-slate-50 text-slate-500">
                          <th class="px-3 py-2 text-left text-xs uppercase">Criterio</th>
                          <th class="px-3 py-2 text-center text-xs uppercase">Estado</th>
                        </tr>
                      </thead>
                      <tbody class="divide-y">
                        {record.rubric.items.map((item: any) => (
                          <tr>
                            <td class="px-3 py-2 text-slate-700"><span class="text-xs text-slate-400 mr-2">{item.key}</span>{item.label}</td>
                            <td class="px-3 py-2 text-center"><span class={`inline-flex rounded-full px-2 py-0.5 text-xs font-semibold ${item.state.className}`}>{item.state.label}</span></td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </details>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4 text-sm">
                  {record.rubric.current && <div class="rounded-2xl bg-slate-50 p-4"><p class="text-xs uppercase tracking-wider text-slate-400 mb-2">No aplica</p><p class="text-slate-600">{record.noAplicaCount} criterios registrados como no aplicables.</p></div>}
                  {record.generalObservations && <div class="rounded-2xl bg-slate-50 p-4"><p class="text-xs uppercase tracking-wider text-slate-400 mb-2">Observaciones generales</p><p class="text-slate-600 italic">“{record.generalObservations}”</p></div>}
                  {record.feedback && <div class="rounded-2xl bg-slate-50 p-4"><p class="text-xs uppercase tracking-wider text-slate-400 mb-2">Retroalimentación</p><p class="text-slate-600 italic">“{record.feedback}”</p></div>}
                  {record.internal && <div class="rounded-2xl bg-slate-50 p-4"><p class="text-xs uppercase tracking-wider text-slate-400 mb-2">Comentario interno</p><p class="text-slate-600 italic">“{record.internal}”</p></div>}
                </div>
              </article>
            ))
          )}
        </div>
      </details>

      <details class="bg-white rounded-3xl shadow-tarjeta overflow-hidden">
        <summary class="px-6 py-4 border-b border-slate-100 cursor-pointer list-none flex items-center justify-between">
          <span class="text-lg font-bold text-tup">Observación de clase</span>
          <span class="text-sm text-slate-400">{obsRecords.length} registros</span>
        </summary>
        <div class="p-6 space-y-6">
          {obsRecords.length === 0 ? (
            <div class="rounded-2xl border border-dashed border-slate-200 p-8 text-center text-slate-400">No hay observaciones para este ciclo.</div>
          ) : (
            obsRecords.map((record) => (
              <article class="rounded-3xl border border-slate-100 p-5">
                <div class="flex flex-wrap items-start justify-between gap-4">
                  <div>
                    <p class="text-xs uppercase tracking-wider text-slate-400">{record.title}</p>
                    <h3 class="text-lg font-semibold text-slate-800 mt-1">{record.meta || 'Sin metadatos'}</h3>
                  </div>
                  <div class="text-right">
                    <p class={`text-3xl font-bold ${scoreClass(record.score)}`}>{fmt(record.score)}</p>
                    <p class="text-xs text-slate-400">Observación</p>
                  </div>
                </div>
                <details class="mt-5 rounded-2xl border border-slate-200 overflow-hidden">
                  <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-tup bg-slate-50">
                    Detalles de rúbrica <span class="text-slate-400 font-normal">({record.instrumentVersion || 'registro histórico sin versión'})</span>
                  </summary>
                  <div class="p-4 space-y-4">
                    {record.sections.map((section: any) => (
                      <section class="rounded-2xl border border-slate-100 overflow-hidden">
                        <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-3 bg-slate-50">
                          <h4 class="font-semibold text-slate-700">{section.code}. {section.title}</h4>
                          <p class="text-xs text-slate-500">{section.counts.scored} calificados · {section.counts.na} no aplica · {section.counts.missing} sin registro</p>
                        </div>
                        <div class="overflow-x-auto">
                          <table class="w-full text-sm">
                            <thead>
                              <tr class="text-slate-500">
                                <th class="px-3 py-2 text-left text-xs uppercase">Campo</th>
                                <th class="px-3 py-2 text-left text-xs uppercase">Reactivo</th>
                                <th class="px-3 py-2 text-center text-xs uppercase">Estado</th>
                              </tr>
                            </thead>
                            <tbody class="divide-y">
                              {section.items.map((item: any) => (
                                <tr>
                                  <td class="px-3 py-2 font-mono text-xs text-slate-500">{item.field}</td>
                                  <td class="px-3 py-2 text-slate-700">{item.question}</td>
                                  <td class="px-3 py-2 text-center"><span class={`inline-flex rounded-full px-2 py-0.5 text-xs font-semibold ${item.state.className}`}>{item.state.label}</span></td>
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        </div>
                      </section>
                    ))}
                  </div>
                </details>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4 text-sm">
                  {record.comments && <div class="rounded-2xl bg-slate-50 p-4"><p class="text-xs uppercase tracking-wider text-slate-400 mb-2">Comentarios</p><p class="text-slate-600 italic">“{record.comments}”</p></div>}
                </div>
              </article>
            ))
          )}
        </div>
      </details>

      <details class="bg-white rounded-3xl shadow-tarjeta overflow-hidden">
        <summary class="px-6 py-4 border-b border-slate-100 cursor-pointer list-none flex items-center justify-between">
          <span class="text-lg font-bold text-tup">Autodiagnóstico</span>
          <span class="text-sm text-slate-400">{autoRecords.length} registros</span>
        </summary>
        <div class="p-6 space-y-6">
          {autoRecords.length === 0 ? (
            <div class="rounded-2xl border border-dashed border-slate-200 p-8 text-center text-slate-400">No hay autodiagnósticos para este ciclo.</div>
          ) : (
            autoRecords.map((record) => (
              <article class="rounded-3xl border border-slate-100 p-5">
                <div class="flex flex-wrap items-start justify-between gap-4">
                  <div>
                    <p class="text-xs uppercase tracking-wider text-slate-400">Autodiagnóstico docente</p>
                    <h3 class="text-lg font-semibold text-slate-800 mt-1">{record.meta}</h3>
                  </div>
                  <div class="text-right">
                    <p class={`text-3xl font-bold ${scoreClass(record.score)}`}>{fmt(record.score)}</p>
                    <p class="text-xs text-slate-400">{record.level}</p>
                  </div>
                </div>
                <div class="mt-5 overflow-x-auto">
                  <table class="w-full text-sm">
                    <thead>
                      <tr class="bg-slate-50 text-slate-500">
                        <th class="px-3 py-2 text-left text-xs uppercase">Reactivo</th>
                        <th class="px-3 py-2 text-center text-xs uppercase">Score</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y">
                      {record.items.map((item: any) => (
                        <tr>
                          <td class="px-3 py-2 text-slate-700">{item.label}</td>
                          <td class={`px-3 py-2 text-center font-semibold ${scoreClass(item.score)}`}>{fmt(item.score)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                {record.comments && <p class="mt-4 text-sm text-slate-600 italic">“{record.comments}”</p>}
              </article>
            ))
          )}
        </div>
      </details>
    </div>

    <details class="bg-white rounded-3xl shadow-tarjeta overflow-hidden">
      <summary class="px-6 py-4 border-b border-slate-100 cursor-pointer list-none flex items-center justify-between">
        <span class="text-lg font-bold text-tup">Historial por cuatrimestre</span>
        <span class="text-sm text-slate-400">{cyclesEvaluated} ciclos</span>
      </summary>
      <div class="p-6">
        {historial.length === 0 ? (
          <div class="rounded-2xl border border-dashed border-slate-200 p-8 text-center text-slate-400">No hay historial disponible.</div>
        ) : (
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="bg-slate-50 border-b text-slate-500">
                  <th class="text-left px-4 py-3 text-xs uppercase">Cuatrimestre</th>
                  <th class="text-center px-3 py-3 text-xs uppercase">EE</th>
                  <th class="text-center px-3 py-3 text-xs uppercase">Coord</th>
                  <th class="text-center px-3 py-3 text-xs uppercase">Plan</th>
                  <th class="text-center px-3 py-3 text-xs uppercase">Obs</th>
                  <th class="text-center px-3 py-3 text-xs uppercase">Auto</th>
                  <th class="text-center px-3 py-3 text-xs uppercase">Final</th>
                  <th class="text-center px-3 py-3 text-xs uppercase">Categoría</th>
                  <th class="text-center px-3 py-3 text-xs uppercase">Instr.</th>
                </tr>
              </thead>
              <tbody class="divide-y">
                {historial.map((h) => (
                  <tr class="hover:bg-slate-50">
                    <td class="px-4 py-3 font-medium text-slate-700">{h.clave}</td>
                    <td class={`px-3 py-3 text-center font-medium ${scoreClass(h.ee)}`}>{fmt(h.ee)}</td>
                    <td class={`px-3 py-3 text-center font-medium ${scoreClass(h.coord)}`}>{fmt(h.coord)}</td>
                    <td class={`px-3 py-3 text-center font-medium ${scoreClass(h.plan)}`}>{fmt(h.plan)}</td>
                    <td class={`px-3 py-3 text-center font-medium ${scoreClass(h.obs)}`}>{fmt(h.obs)}</td>
                    <td class={`px-3 py-3 text-center font-medium ${scoreClass(h.auto)}`}>{fmt(h.auto)}</td>
                    <td class={`px-3 py-3 text-center font-bold ${scoreClass(h.final)}`}>{fmt(h.final)}</td>
                    <td class="px-3 py-3 text-center"><span class={`px-2 py-0.5 rounded-full text-[10px] font-medium ${badgeClass(h.cat)}`}>{h.cat}</span></td>
                    <td class="px-3 py-3 text-center text-xs text-slate-400">{h.inst}/{h.expected}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </details>
  </div>
</LayoutAdmin>

<script>
  import Chart from 'chart.js/auto';
  document.addEventListener('DOMContentLoaded', () => {
    const ctxBar = document.getElementById('chart-barras');
    const ctxRadar = document.getElementById('chart-radar');
    const labels = JSON.parse(ctxBar?.dataset.labels || '[]');
    const scores = JSON.parse(ctxBar?.dataset.scores || '[]');

    if (ctxBar) {
      new Chart(ctxBar, {
        type: 'bar',
        data: {
          labels: labels,
          datasets: [{ data: scores, backgroundColor: ['#22c55e', '#3b82f6', '#a855f7', '#f59e0b', '#f97316'], borderRadius: 8, borderWidth: 0 }],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
           plugins: { legend: { display: false }, tooltip: { callbacks: { label: function(context) { return Number(context.raw).toFixed(1); } } } },
          scales: {
            y: { beginAtZero: true, max: 100, ticks: { font: { size: 10 } }, grid: { color: 'rgba(148,163,184,0.12)' } },
            x: { ticks: { font: { size: 10 } }, grid: { display: false } },
          },
        },
      });
    }

    if (ctxRadar) {
      new Chart(ctxRadar, {
        type: 'radar',
        data: {
          labels: labels,
          datasets: [{ data: scores, fill: true, backgroundColor: 'rgba(14,165,233,0.12)', borderColor: '#0ea5e9', pointBackgroundColor: '#0ea5e9', pointBorderColor: '#fff', pointHoverBackgroundColor: '#fff', pointHoverBorderColor: '#0ea5e9' }],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: { r: { beginAtZero: true, suggestedMax: 100, ticks: { backdropColor: 'transparent', font: { size: 9 } } } },
           plugins: { legend: { display: false }, tooltip: { callbacks: { label: function(context) { return Number(context.raw).toFixed(1); } } } },
        },
      });
    }
  });
</script>
