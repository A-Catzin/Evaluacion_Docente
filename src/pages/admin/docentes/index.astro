---
import LayoutAdmin from '../../../layouts/LayoutAdmin.astro';
import { obtenerDocentes } from '../../../services/docentes';
import { db } from '../../../lib/db';
import { obtenerCuatrimestreActivo, obtenerCuatrimestres } from '../../../services/catalogos';
import { aggregateNativeScoresByTeacher, fetchNativeStudentEvaluationScores, calcFinalScore, formatScore } from '../../../services/scoring';

const busqueda = Astro.url.searchParams.get('q') || '';
const page = parseInt(Astro.url.searchParams.get('page')||'1');
const limit = 20;
const cliente = db();
const cuatrimestreActivo = await obtenerCuatrimestreActivo();
const cuatrimestres = await obtenerCuatrimestres();
const cuatrimestreIdParam = Astro.url.searchParams.get('cuatrimestre');
const cuatrimestreIdCookie = Astro.cookies.get('cuatrimestre_sel')?.value;
const cuatrimestreId = parseInt(cuatrimestreIdParam || '') || cuatrimestreActivo?.id || parseInt(cuatrimestreIdCookie || '') || 0;
const qs = cuatrimestreId ? `?cuatrimestre=${cuatrimestreId}` : '';
if (Astro.url.searchParams.has('cuatrimestre')) {
  Astro.cookies.set('cuatrimestre_sel', String(cuatrimestreId), { path: '/', maxAge: 60*60*24*30 });
}
const cuatrimestreSel = cuatrimestres.find(c=>c.id===cuatrimestreId);

const token = Astro.cookies.get('sb-access-token')?.value;
const refresh = Astro.cookies.get('sb-refresh-token')?.value;
if (token && refresh) {
  await cliente.auth.setSession({ access_token: token, refresh_token: refresh });
}

interface ProgresoEENativa {
  docente_id: number;
  inscripciones_elegibles: number;
  controles_enviados: number;
  respuestas_nativas: number;
}

const { data: progresoEENativaData, error: progresoEENativaError } = await cliente.rpc('obtener_progreso_encuesta_estudiantil_nativa', { p_cuatrimestre_id: cuatrimestreId });
if (progresoEENativaError) throw progresoEENativaError;
const progresoEENativa = (progresoEENativaData || []) as ProgresoEENativa[];
const nativeScoreRows = await fetchNativeStudentEvaluationScores(cliente, cuatrimestreId);
const nativeScoresByTeacher = aggregateNativeScoresByTeacher(nativeScoreRows);

const todos = await obtenerDocentes();
const [{ data: adIds }, { data: obsIds }, { data: coordIds }, { data: planIds }] = await Promise.all([cliente.from('autodiagnosticos').select('docente_id').limit(10000).eq('cuatrimestre_id', cuatrimestreId), cliente.from('observaciones').select('docente_id').limit(10000).eq('cuatrimestre_id', cuatrimestreId), cliente.from('evaluacion_coordinacion').select('docente_id').limit(10000).eq('cuatrimestre_id', cuatrimestreId), cliente.from('planeaciones').select('docente_id').limit(10000).eq('cuatrimestre_id', cuatrimestreId)]);
const docsEvaluados = new Set([...nativeScoreRows,...(adIds||[]),...(obsIds||[]),...(coordIds||[]),...(planIds||[])].map(e=>e.docente_id));
for (const p of progresoEENativa) if (p.controles_enviados > 0 || p.respuestas_nativas > 0) docsEvaluados.add(p.docente_id);
const docentes = todos.filter(d => docsEvaluados.has(d.id));
const docentesFiltrados = busqueda
  ? docentes.filter(d => `${d.nombre} ${d.apellidos}`.toLowerCase().includes(busqueda.toLowerCase()) || d.apellidos.toLowerCase().includes(busqueda.toLowerCase()) || d.email.toLowerCase().includes(busqueda.toLowerCase()))
  : docentes;

const ids = docentesFiltrados.map(d => d.id);

// Batch queries — generales
const [{ data: coordData }, { data: diagData }] = await Promise.all([
  cliente.from('evaluacion_coordinacion').select('docente_id,score_normalizado').in('docente_id', ids).eq('cuatrimestre_id', cuatrimestreId).order('id', { ascending: false }),
  cliente.from('autodiagnosticos').select('docente_id,puntaje_total').in('docente_id', ids).eq('cuatrimestre_id', cuatrimestreId).order('id', { ascending: false }),
]);

const coordMap = new Map<number, number>(); for (const c of (coordData || [])) if (!coordMap.has(c.docente_id) && c.score_normalizado != null) coordMap.set(c.docente_id, Number(c.score_normalizado));
const diagMap = new Map<number, number>(); for (const d of (diagData || [])) if (!diagMap.has(d.docente_id) && d.puntaje_total != null) diagMap.set(d.docente_id, (Number(d.puntaje_total) / 120) * 100);

// Observaciones por docente+asignatura
const { data: obsData } = await cliente.from('observaciones').select('docente_id,cco1,cco2,cco3,cco4,cco5,cco6,cco7,cme1,cme2,cme3,cme4,cme5,cme6,cme7,cme8,cme9,ccom1,ccom2,ccom3,ccom4,cso1,cso2,cso3,cso4,cge1,cge2,cge3,cge4,cge5,cge6,cge7,caf1,caf2,ctepe1,ctepe2,ctepe3,ctepe4,ctepe5,ctepe6,ctepe7,cno1,cno2,cno3,cno4,cno5').in('docente_id', ids).eq('cuatrimestre_id', cuatrimestreId);
// Observaciones por docente (general, no por materia)
const obsPorDocente = new Map<number, number>();
for (const o of (obsData || [])) {
  const r = [o.cco1,o.cco2,o.cco3,o.cco4,o.cco5,o.cco6,o.cco7,o.cme1,o.cme2,o.cme3,o.cme4,o.cme5,o.cme6,o.cme7,o.cme8,o.cme9,o.ccom1,o.ccom2,o.ccom3,o.ccom4,o.cso1,o.cso2,o.cso3,o.cso4,o.cge1,o.cge2,o.cge3,o.cge4,o.cge5,o.cge6,o.cge7,o.caf1,o.caf2,o.ctepe1,o.ctepe2,o.ctepe3,o.ctepe4,o.ctepe5,o.ctepe6,o.ctepe7,o.cno1,o.cno2,o.cno3,o.cno4,o.cno5].filter(v=>v);
  const prom = r.length ? Math.round((r.reduce((a,b)=>a+b,0)/(r.length*5))*100) : 0;
  if (!obsPorDocente.has(o.docente_id)) obsPorDocente.set(o.docente_id, prom);
}

// Grupos deduplicados por docente+asignatura+clave (colapsa inserts repetidos, preserva grupos distintos)
const { data: gruposData } = await cliente.from('grupos').select('docente_id,asignatura_id,clave').in('docente_id', ids).eq('cuatrimestre_id', cuatrimestreId);
const grupoMap = new Map<number, { asignatura_id: number; clave_grupo: string }[]>();
const seenGrupos = new Set<string>();
for (const g of (gruposData || [])) {
  const key = `${g.docente_id}|${g.asignatura_id}|${g.clave}`;
  if (seenGrupos.has(key)) continue;
  seenGrupos.add(key);
  if (!grupoMap.has(g.docente_id)) grupoMap.set(g.docente_id, []);
  grupoMap.get(g.docente_id)!.push({ asignatura_id: g.asignatura_id, clave_grupo: g.clave || '—' });
}

// Planeaciones por docente+asignatura
const { data: planData } = await cliente.from('planeaciones').select('docente_id,asignatura_id,puntaje_promedio').in('docente_id', ids).eq('cuatrimestre_id', cuatrimestreId).eq('estado', 'Aprobado').order('fecha_evaluacion', { ascending: false });
const planPorDocente = new Map<number, Map<number, number>>();
for (const p of (planData || [])) {
  if (!planPorDocente.has(p.docente_id)) planPorDocente.set(p.docente_id, new Map());
  if (!planPorDocente.get(p.docente_id)!.has(p.asignatura_id)) planPorDocente.get(p.docente_id)!.set(p.asignatura_id, p.puntaje_promedio);
}

function colorScore(n: number|null|undefined): string { if (n == null) return ''; if (n >= 80) return 'text-emerald-600'; if (n >= 60) return 'text-amber-600'; return 'text-red-600'; }

// Fila principal — promedio general de todas las materias
const filas = docentesFiltrados.map(d => {
  const obsDoc = obsPorDocente.get(d.id);
  const planMap2 = planPorDocente.get(d.id);
  
  // Promedios generales de todas las materias
  let sumPlan = 0, count = 0;
  const grupos = grupoMap.get(d.id) || [];
  for (const g of grupos) {
    const plan = planMap2?.get(g.asignatura_id);
    if (plan != null) count++;
    if (plan != null) sumPlan += plan;
  }
  const promEst = nativeScoresByTeacher.get(d.id);
  const promObs = obsDoc;
  const promPlan = count > 0 ? sumPlan / count : undefined;
  const promCoord = coordMap.get(d.id);
  const promAuto = diagMap.get(d.id);
  const fin = calcFinalScore({ ee: promEst, coord: promCoord, plan: promPlan, obs: promObs, auto: promAuto }, d.modalidad);
  const instrumentos = [promEst, promCoord, promPlan, promObs, promAuto].filter((score) => score != null).length;
  return { ...d, promObs, promCoord, promPlan, promAuto, promEst, final360: fin.instrumentCount > 0 ? fin.final : null, cat360: fin.category, instrumentos };
});

// Paginación
const totalFilas = filas.length;
const totalPages = Math.ceil(totalFilas / limit);
const filasPag = filas.slice((page - 1) * limit, page * limit);
function buildPageUrl(p:number) {
  const params = new URLSearchParams(Astro.url.searchParams.toString());
  params.set('page', String(p));
  return `?${params.toString()}`;
}
---

<LayoutAdmin titulo="Docentes — Admin">
  <div class="animate-flotar-entrada">
    <div class="flex items-center justify-between mb-6">
      <div><h1 class="text-3xl font-bold text-tup">Docentes</h1><span class="text-sm text-slate-400">{totalFilas} docentes · {cuatrimestreSel?.clave || ''}</span></div>
      <form method="GET" class="flex items-center gap-2">
        <select name="cuatrimestre" class="rounded-xl border border-slate-200 px-3 py-2 text-sm" onchange="this.form.submit()">
          {cuatrimestres.map(c => (<option value={c.id} selected={c.id===cuatrimestreId}>{c.clave}</option>))}
        </select>
      </form>
    </div>
    <div class="bg-white rounded-2xl p-4 shadow-tarjeta mb-6">
      <form method="GET" class="flex gap-3">
        <input type="hidden" name="cuatrimestre" value={cuatrimestreId} />
        <input type="text" name="q" value={busqueda} placeholder="Buscar por nombre o email..." class="flex-1 rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:ring-2 focus:ring-tup focus:outline-none" />
        <button type="submit" class="px-4 py-2.5 rounded-xl bg-tup text-white text-sm font-medium">Buscar</button>
        {busqueda && (<a href={`/admin/docentes${qs}`} class="px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-500">Limpiar</a>)}
      </form>
    </div>
    <div class="bg-white rounded-2xl shadow-tarjeta overflow-hidden overflow-x-auto">
      {filasPag.length === 0 ? (<div class="p-12 text-center ">No se encontraron docentes.</div>) : (
        <table class="w-full text-[11px] whitespace-nowrap">
          <thead><tr class="bg-slate-50 border-b">
            <th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Docente</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Email</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Prog.</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Est.</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Coord.</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Plan.</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Obs.</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Auto.</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Final</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Cat.</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Ver</th>
          </tr></thead>
          <tbody class="divide-y">{filasPag.map(f => {
            return (
              <tr class="hover:bg-slate-50">
                <td class="px-2 py-2 text-center font-medium">{f.nombre.toUpperCase()} {f.apellidos.toUpperCase()}</td>
                <td class="px-2 py-2 text-center text-slate-600 text-[10px]">{f.email}</td>
                <td class="px-2 py-2 text-center">{f.instrumentos}/5</td>
                <td class={`px-2 py-2 text-center ${colorScore(f.promEst)}`}>{formatScore(f.promEst)}</td>
                <td class={`px-2 py-2 text-center ${colorScore(f.promCoord)}`}>{formatScore(f.promCoord)}</td>
                <td class={`px-2 py-2 text-center ${colorScore(f.promPlan)}`}>{formatScore(f.promPlan)}</td>
                <td class={`px-2 py-2 text-center ${colorScore(f.promObs)}`}>{formatScore(f.promObs)}</td>
                <td class={`px-2 py-2 text-center ${colorScore(f.promAuto)}`}>{formatScore(f.promAuto)}</td>
                <td class={`px-2 py-2 text-center font-bold ${colorScore(f.final360)}`}>{formatScore(f.final360)}</td>
                <td class="px-2 py-2 text-center"><span class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-slate-100">{f.cat360}</span></td>
                <td class="px-2 py-2 text-center"><a href={`/admin/docentes/${f.id}${qs}`} class="px-2 py-0.5 rounded-lg bg-tup/10 text-tup text-[10px] font-medium hover:bg-tup/20 whitespace-nowrap">Ver</a></td>
              </tr>
            );
          })}</tbody>
        </table>
      )}
        {totalPages > 1 && (
      <div class="flex items-center justify-center gap-3 mt-4 pb-4">
        {page > 1 && <a href={buildPageUrl(page-1)} class="px-4 py-2 rounded-xl border border-slate-200 text-sm text-slate-600 hover:bg-slate-50">← Anterior</a>}
        <span class="text-sm text-slate-400">Página {page} de {totalPages}</span>
        {page < totalPages && <a href={buildPageUrl(page+1)} class="px-4 py-2 rounded-xl border border-slate-200 text-sm text-slate-600 hover:bg-slate-50">Siguiente →</a>}
      </div>
    )}
     </div>
  </div>

</LayoutAdmin>
