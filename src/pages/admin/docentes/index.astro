---
import LayoutAdmin from '../../../layouts/LayoutAdmin.astro';
import { db } from '../../../lib/db';
import { obtenerCuatrimestreActivo, obtenerCuatrimestres } from '../../../services/catalogos';
import { formatScore } from '../../../services/scoring';
import { obtenerCalificacionesPorCuatrimestre } from '../../../services/calificaciones';

const busqueda = Astro.url.searchParams.get('q') || '';
const page = parseInt(Astro.url.searchParams.get('page')||'1');
const limit = 20;
const cliente = db();
const cuatrimestreActivo = await obtenerCuatrimestreActivo();
const cuatrimestres = await obtenerCuatrimestres();
const cuatrimestreIdParam = Astro.url.searchParams.get('cuatrimestre');
const cuatrimestreIdCookie = Astro.cookies.get('cuatrimestre_sel')?.value;
const cuatrimestreId = parseInt(cuatrimestreIdParam || '') || cuatrimestreActivo?.id || parseInt(cuatrimestreIdCookie || '') || 0;
const qs = cuatrimestreId ? `?cuatrimestre=${cuatrimestreId}` : '';
if (Astro.url.searchParams.has('cuatrimestre')) {
  Astro.cookies.set('cuatrimestre_sel', String(cuatrimestreId), { path: '/', maxAge: 60*60*24*30 });
}
const cuatrimestreSel = cuatrimestres.find(c=>c.id===cuatrimestreId);

const token = Astro.cookies.get('sb-access-token')?.value;
const refresh = Astro.cookies.get('sb-refresh-token')?.value;
if (token && refresh) {
  await cliente.auth.setSession({ access_token: token, refresh_token: refresh });
}

function colorScore(n: number|null|undefined): string { if (n == null) return ''; if (n >= 80) return 'text-emerald-600'; if (n >= 60) return 'text-amber-600'; return 'text-red-600'; }

// Scores: preferimos filas precalculadas y caemos de vuelta a cálculo inline.
const aggData = await obtenerCalificacionesPorCuatrimestre(cliente, cuatrimestreId);

const filasBase = aggData
  .filter((row) => row.num_instrumentos_completados > 0)
  .map((row) => ({
    id: row.docente_id,
    nombre: String(row.docente_nombre ?? ''),
    apellidos: String(row.docente_apellidos ?? ''),
    email: String(row.docente_email ?? ''),
    promEst: row.score_encuesta_estudiantil,
    promCoord: row.score_coordinacion,
    promPlan: row.score_planeacion,
    promObs: row.score_observacion,
    promAuto: row.score_autoevaluacion,
    final360: row.calificacion_final,
    cat360: String(row.categoria_final ?? 'No iniciado'),
    instrumentos: row.num_instrumentos_completados,
  }));

const filas = busqueda
  ? filasBase.filter(f => `${f.nombre} ${f.apellidos}`.toLowerCase().includes(busqueda.toLowerCase()) || f.apellidos.toLowerCase().includes(busqueda.toLowerCase()) || f.email.toLowerCase().includes(busqueda.toLowerCase()))
  : filasBase;

// Paginación
const totalFilas = filas.length;
const totalPages = Math.ceil(totalFilas / limit);
const filasPag = filas.slice((page - 1) * limit, page * limit);
function buildPageUrl(p:number) {
  const params = new URLSearchParams(Astro.url.searchParams.toString());
  params.set('page', String(p));
  return `?${params.toString()}`;
}
---

<LayoutAdmin titulo="Docentes — Admin">
  <div class="animate-flotar-entrada">
    <div class="flex items-center justify-between mb-6">
      <div><h1 class="text-3xl font-bold text-tup">Docentes</h1><span class="text-sm text-slate-400">{totalFilas} docentes · {cuatrimestreSel?.clave || ''}</span></div>
      <form method="GET" class="flex items-center gap-2">
        <select name="cuatrimestre" class="rounded-xl border border-slate-200 px-3 py-2 text-sm" onchange="this.form.submit()">
          {cuatrimestres.map(c => (<option value={c.id} selected={c.id===cuatrimestreId}>{c.clave}</option>))}
        </select>
      </form>
    </div>
    <div class="bg-white rounded-2xl p-4 shadow-tarjeta mb-6">
      <form method="GET" class="flex gap-3">
        <input type="hidden" name="cuatrimestre" value={cuatrimestreId} />
        <input type="text" name="q" value={busqueda} placeholder="Buscar por nombre o email..." class="flex-1 rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:ring-2 focus:ring-tup focus:outline-none" />
        <button type="submit" class="px-4 py-2.5 rounded-xl bg-tup text-white text-sm font-medium">Buscar</button>
        {busqueda && (<a href={`/admin/docentes${qs}`} class="px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-500">Limpiar</a>)}
      </form>
    </div>
    <div class="bg-white rounded-2xl shadow-tarjeta overflow-hidden overflow-x-auto">
      {filasPag.length === 0 ? (<div class="p-12 text-center ">No se encontraron docentes.</div>) : (
        <table class="w-full text-[11px] whitespace-nowrap">
          <thead><tr class="bg-slate-50 border-b">
            <th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Docente</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Email</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Prog.</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Est.</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Coord.</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Plan.</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Obs.</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Auto.</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Final</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Cat.</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Ver</th>
          </tr></thead>
          <tbody class="divide-y">{filasPag.map(f => {
            return (
              <tr class="hover:bg-slate-50">
                <td class="px-2 py-2 text-center font-medium">{f.nombre.toUpperCase()} {f.apellidos.toUpperCase()}</td>
                <td class="px-2 py-2 text-center text-slate-600 text-[10px]">{f.email}</td>
                <td class="px-2 py-2 text-center">{f.instrumentos}/5</td>
                <td class={`px-2 py-2 text-center ${colorScore(f.promEst)}`}>{formatScore(f.promEst)}</td>
                <td class={`px-2 py-2 text-center ${colorScore(f.promCoord)}`}>{formatScore(f.promCoord)}</td>
                <td class={`px-2 py-2 text-center ${colorScore(f.promPlan)}`}>{formatScore(f.promPlan)}</td>
                <td class={`px-2 py-2 text-center ${colorScore(f.promObs)}`}>{formatScore(f.promObs)}</td>
                <td class={`px-2 py-2 text-center ${colorScore(f.promAuto)}`}>{formatScore(f.promAuto)}</td>
                <td class={`px-2 py-2 text-center font-bold ${colorScore(f.final360)}`}>{formatScore(f.final360)}</td>
                <td class="px-2 py-2 text-center"><span class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-slate-100">{f.cat360}</span></td>
                <td class="px-2 py-2 text-center"><a href={`/admin/docentes/${f.id}${qs}`} class="px-2 py-0.5 rounded-lg bg-tup/10 text-tup text-[10px] font-medium hover:bg-tup/20 whitespace-nowrap">Ver</a></td>
              </tr>
            );
          })}</tbody>
        </table>
      )}
        {totalPages > 1 && (
      <div class="flex items-center justify-center gap-3 mt-4 pb-4">
        {page > 1 && <a href={buildPageUrl(page-1)} class="px-4 py-2 rounded-xl border border-slate-200 text-sm text-slate-600 hover:bg-slate-50">← Anterior</a>}
        <span class="text-sm text-slate-400">Página {page} de {totalPages}</span>
        {page < totalPages && <a href={buildPageUrl(page+1)} class="px-4 py-2 rounded-xl border border-slate-200 text-sm text-slate-600 hover:bg-slate-50">Siguiente →</a>}
      </div>
    )}
     </div>
  </div>

</LayoutAdmin>
