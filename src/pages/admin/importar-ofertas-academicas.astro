---
import LayoutAdmin from '../../layouts/LayoutAdmin.astro';
import { dbAdmin } from '../../lib/db';
import { obtenerCuatrimestreActivo, obtenerCuatrimestres } from '../../services/catalogos';

const cuatrimestres = await obtenerCuatrimestres(dbAdmin());
const activo = await obtenerCuatrimestreActivo(dbAdmin());
const queryId = Number(Astro.url.searchParams.get('cuatrimestre'));
const cookieId = Number(Astro.cookies.get('cuatrimestre_sel')?.value);
const cicloPorQuery = cuatrimestres.find(c => c.id === queryId);
const cicloPorCookie = cuatrimestres.find(c => c.id === cookieId);
const cicloActivo = cuatrimestres.find(c => c.id === activo?.id);
const cuatrimestreId = (cicloPorQuery || cicloPorCookie || cicloActivo || cuatrimestres[0])?.id || 0;
---

<LayoutAdmin titulo="Conciliar ofertas académicas — Admin">
  <div class="animate-flotar-entrada max-w-5xl mx-auto">
    <a href={`/admin/importar${cuatrimestreId ? `?cuatrimestre=${cuatrimestreId}` : ''}`} class="text-sm text-slate-400 hover:text-tup">← Importaciones</a>
    <div class="mb-6 mt-6"><p class="text-sm font-medium text-violet-700 mb-2">Catálogo académico</p><h1 class="text-3xl font-bold text-slate-800 mb-2">Conciliar ofertas académicas</h1><p class="text-slate-500">Relaciona las asignaturas de los grupos ya asignados con su oferta académica. La vista previa no escribe datos.</p></div>
    <div class="bg-white rounded-2xl p-6 shadow-tarjeta mb-6">
      <form id="form-importar" class="space-y-5">
        <div><label for="cuatrimestre" class="block text-sm font-medium text-slate-700 mb-1">Ciclo de destino *</label><select id="cuatrimestre" required class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm"><option value="">Seleccionar ciclo...</option>{cuatrimestres.map(c => <option value={c.id} selected={c.id === cuatrimestreId}>{c.clave}{c.nombre ? ` · ${c.nombre}` : ''}</option>)}</select></div>
        <div><label for="archivo" class="block text-sm font-medium text-slate-700 mb-1">Reporte_clases.csv *</label><input id="archivo" type="file" accept=".csv,text/csv" required class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-tup file:text-white" /><p class="text-xs text-slate-400 mt-2">Se usan únicamente <strong>Plan de Estudios</strong> y <strong>Grupo</strong>. Las demás columnas del reporte se ignoran.</p></div>
        <div class="rounded-xl bg-slate-50 border border-slate-200 p-4 text-sm text-slate-600"><p class="font-semibold text-slate-700 mb-1">Alcance seguro</p><p>Puede crear ofertas faltantes y enlazar asignaturas sin tocar grupos, inscripciones, docentes, planeaciones, evaluaciones ni historial. Las filas con conflictos se reportan y no se aplican; las filas seguras sí pueden confirmarse.</p></div>
        <button id="btn-preview" type="submit" class="w-full bg-tup text-white font-semibold py-4 rounded-xl hover:bg-tup/90 disabled:opacity-60">Generar vista previa</button>
      </form>
    </div>
    <section id="resultado" class="hidden bg-white rounded-2xl p-6 shadow-tarjeta"><p class="text-sm font-medium text-violet-700">Vista previa</p><h2 id="titulo" class="text-xl font-bold text-slate-800 mt-1"></h2><div id="metricas" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 mt-5"></div><div id="blockers-wrap" class="hidden mt-6"><h3 class="font-semibold text-amber-700">Filas con conflicto (no se aplicarán)</h3><ul id="blockers" class="mt-2 text-sm text-amber-700 space-y-1"></ul></div><div id="warnings-wrap" class="hidden mt-6"><h3 class="font-semibold text-slate-600">Filas incompletas (omitidas)</h3><ul id="warnings" class="mt-2 text-sm text-slate-600 space-y-1"></ul></div><div id="actions-wrap" class="hidden mt-6"><h3 class="font-semibold text-slate-800">Enlaces seguros</h3><div class="overflow-x-auto mt-2"><table class="w-full text-sm"><thead class="text-left text-slate-500"><tr><th class="p-2">Fila</th><th class="p-2">Oferta</th><th class="p-2">Asignatura</th><th class="p-2">Acción</th></tr></thead><tbody id="actions"></tbody></table></div></div><div class="flex flex-wrap gap-3 mt-6"><button id="btn-apply" type="button" disabled class="bg-emerald-600 text-white font-semibold py-3 px-5 rounded-xl hover:bg-emerald-700 disabled:opacity-50">Confirmar enlaces seguros</button></div><p id="apply-note" class="text-xs text-slate-500 mt-3">La confirmación vuelve a validar este archivo, el catálogo y los grupos antes de aplicar una transacción atómica.</p></section>
    <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 hidden px-6 py-3 rounded-xl text-sm font-medium shadow-modal"></div>
  </div>
</LayoutAdmin>

<script is:inline>
  var preview=null;
  function toast(message,error){var element=document.getElementById('toast');element.textContent=message;element.className='fixed bottom-6 left-1/2 -translate-x-1/2 z-50 px-6 py-3 rounded-xl text-sm font-medium shadow-modal '+(error?'bg-red-600 text-white':'bg-emerald-600 text-white');element.classList.remove('hidden');setTimeout(function(){element.classList.add('hidden')},5000)}
  function metric(label,value){return '<div class="rounded-xl bg-slate-50 p-3"><p class="text-[11px] text-slate-500">'+label+'</p><p class="text-xl font-bold text-slate-800 mt-1">'+value+'</p></div>'}
  function escapeHtml(value){var node=document.createElement('span');node.textContent=String(value||'');return node.innerHTML}
  function render(data){var summary=data.summary||{};document.getElementById('resultado').classList.remove('hidden');document.getElementById('titulo').textContent=data.mode==='apply'?'Conciliación completada':'Revisá los enlaces seguros antes de confirmarlos';document.getElementById('metricas').innerHTML=metric('Filas',data.rowsRead||0)+metric('Crear ofertas',summary.offersToCreate||0)+metric('Reutilizar ofertas',summary.offersReused||0)+metric('Enlazar asignaturas',summary.links||0)+metric('Sin cambio',summary.noOp||0);var blockers=data.blockers||[];document.getElementById('blockers-wrap').classList.toggle('hidden',!blockers.length);document.getElementById('blockers').innerHTML=blockers.map(function(item){return '<li>Fila '+escapeHtml(item.row)+': '+escapeHtml(item.reason)+'</li>'}).join('');var warnings=data.warnings||[];document.getElementById('warnings-wrap').classList.toggle('hidden',!warnings.length);document.getElementById('warnings').innerHTML=warnings.map(function(item){var missing=item.details&&item.details.missingFields?': faltan '+item.details.missingFields.join(', '):'';return '<li>Fila '+escapeHtml(item.row)+missing+'</li>'}).join('');var actions=data.actions||[];document.getElementById('actions-wrap').classList.toggle('hidden',!actions.length);document.getElementById('actions').innerHTML=actions.map(function(item){return '<tr class="border-t border-slate-100"><td class="p-2">'+escapeHtml(item.rows.join(', '))+'</td><td class="p-2">'+escapeHtml(item.offerName)+'</td><td class="p-2">#'+escapeHtml(item.subjectId)+'</td><td class="p-2 font-medium">'+escapeHtml(item.kind)+'</td></tr>'}).join('');document.getElementById('btn-apply').disabled=!actions.length||data.mode==='apply';if(blockers.length&&actions.length)document.getElementById('apply-note').textContent='Las filas con conflicto no se aplicarán. Solo se confirmarán los enlaces seguros mostrados arriba.'}
  function formData(){var file=document.getElementById('archivo').files[0],cycle=document.getElementById('cuatrimestre').value;if(!cycle||!file){toast(!cycle?'Selecciona el ciclo de destino':'Selecciona un archivo CSV',true);return null}var fd=new FormData();fd.append('file',file);fd.append('cuatrimestre_id',cycle);return fd}
  document.getElementById('form-importar').addEventListener('submit',async function(event){event.preventDefault();var fd=formData();if(!fd)return;var button=document.getElementById('btn-preview');button.disabled=true;button.textContent='Generando vista previa...';try{var response=await fetch('/api/admin/importar-ofertas-academicas?mode=preview',{method:'POST',body:fd});var data=await response.json();if(!response.ok)throw new Error(data.error||'No se pudo generar la vista previa');preview=data;render(data);toast(data.blockers&&data.blockers.length?'Hay filas con conflicto; revisá los enlaces seguros': 'Vista previa lista para confirmar',Boolean(data.blockers&&data.blockers.length))}catch(error){toast(error.message||'Error de conexión',true)}finally{button.disabled=false;button.textContent='Generar vista previa'}});
  document.getElementById('btn-apply').addEventListener('click',async function(){if(!preview)return;var fd=formData();if(!fd)return;fd.append('file_hash',preview.fileHash);fd.append('preview_signature',preview.previewSignature);var button=document.getElementById('btn-apply');button.disabled=true;button.textContent='Aplicando enlaces seguros...';try{var response=await fetch('/api/admin/importar-ofertas-academicas?mode=apply',{method:'POST',body:fd});var data=await response.json();if(!response.ok)throw new Error(data.error||'No se pudo aplicar la propuesta');render(data);toast('Conciliación completada',false)}catch(error){toast(error.message||'Error de conexión',true);button.disabled=false;button.textContent='Confirmar enlaces seguros'}});
</script>
