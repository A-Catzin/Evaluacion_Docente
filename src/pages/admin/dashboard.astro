---
import LayoutAdmin from '../../layouts/LayoutAdmin.astro';
import { obtenerCuatrimestres, obtenerCuatrimestreActivo } from '../../services/catalogos';
import { db, dbAdmin } from '../../lib/db';
import { formatScore, roundTo2 } from '../../services/scoring';
import { parsePlanningStatusSummary, planningCellLabel } from '../../lib/planningStatusSummary';
import { obtenerCalificacionesPorCuatrimestre } from '../../services/calificaciones';
import { formatPersonName } from '../../lib/personName';

    const busqueda = Astro.url.searchParams.get('q') || '';
    const pathname = Astro.url.pathname;
    const dashboardWarnings: string[] = [];
    function reportDashboardFailure(operation: string, error: unknown): void {
      console.error(`[admin/dashboard] ${operation} failed`, error);
      dashboardWarnings.push(operation);
    }

    let cuatrimestre: Awaited<ReturnType<typeof obtenerCuatrimestreActivo>> = null;
    let cuatrimestres: Awaited<ReturnType<typeof obtenerCuatrimestres>> = [];
    try {
      cuatrimestre = await obtenerCuatrimestreActivo(dbAdmin());
    } catch (error) {
      reportDashboardFailure('active cycle query', error);
    }
    try {
      cuatrimestres = await obtenerCuatrimestres(dbAdmin());
    } catch (error) {
      reportDashboardFailure('cycle list query', error);
    }

    const idSeleccionado = Number(Astro.url.searchParams.get('cuatrimestre'));
    const cuatrimestreIdCookie = Number(Astro.cookies.get('cuatrimestre_sel')?.value);
    const cicloPorQuery = cuatrimestres.find(c => c.id === idSeleccionado);
    const cicloPorCookie = cuatrimestres.find(c => c.id === cuatrimestreIdCookie);
    const cicloActivo = cuatrimestres.find(c => c.id === cuatrimestre?.id);
    const cuatrimestreId = (cicloPorQuery || cicloPorCookie || cicloActivo || cuatrimestres[0])?.id || 0;
    const navigationParams = new URLSearchParams(Astro.url.searchParams);
    if (cuatrimestreId) navigationParams.set('cuatrimestre', String(cuatrimestreId));
    else navigationParams.delete('cuatrimestre');
    const qs = navigationParams.size ? `?${navigationParams.toString()}` : '';
    const clearSearchParams = new URLSearchParams(navigationParams);
    clearSearchParams.delete('q');
    const qsWithoutSearch = clearSearchParams.size ? `?${clearSearchParams.toString()}` : '';
    // Persistir en cookie
    if (Astro.url.searchParams.has('cuatrimestre')) {
      Astro.cookies.set('cuatrimestre_sel', String(cuatrimestreId), { path: '/', maxAge: 60*60*24*30 });
    }
    const cliente = db();
    const token = Astro.cookies.get('sb-access-token')?.value;
    const refresh = Astro.cookies.get('sb-refresh-token')?.value;
    let adminNombre = 'Administrador';
    if (token && refresh) {
      try {
        const { data: sesion, error: sessionError } = await cliente.auth.setSession({ access_token: token, refresh_token: refresh });
        if (sessionError) {
          reportDashboardFailure('admin session query', sessionError);
        }
        if (sesion?.user) {
          const { data: u, error: profileError } = await cliente.from('usuarios').select('email').eq('id', sesion.user.id).maybeSingle();
          if (profileError) {
            reportDashboardFailure('admin profile query', profileError);
          }
          adminNombre = u?.email?.split('@')[0] || adminNombre;
        }
      } catch (error) {
        reportDashboardFailure('admin session query', error);
      }
    }

    interface ProgresoEENativa {
      docente_id: number;
      inscripciones_elegibles: number;
      controles_enviados: number;
      respuestas_nativas: number;
    }

    let progresoEENativa: ProgresoEENativa[] = [];
    if (cuatrimestreId > 0) {
      try {
        const { data: progresoEENativaData, error: progresoEENativaError } = await cliente.rpc('obtener_progreso_encuesta_estudiantil_nativa', { p_cuatrimestre_id: cuatrimestreId });
        if (progresoEENativaError) {
          reportDashboardFailure('student survey progress query', progresoEENativaError);
        } else {
          progresoEENativa = (progresoEENativaData || []) as ProgresoEENativa[];
        }
      } catch (error) {
        reportDashboardFailure('student survey progress query', error);
      }
    }

    // Usuarios pendientes de aprobacion
    let pendientes = 0;
    try {
      const { count, error: pendientesError } = await cliente.from('usuarios').select('*', { count: 'exact', head: true }).eq('rol', 'pendiente');
      if (pendientesError) {
        reportDashboardFailure('pending users query', pendientesError);
      } else {
        pendientes = count ?? 0;
      }
    } catch (error) {
      reportDashboardFailure('pending users query', error);
    }

    // El dashboard lee sólo filas precalculadas para evitar cálculos masivos bajo demanda.
    let aggData: Awaited<ReturnType<typeof obtenerCalificacionesPorCuatrimestre>> = [];
    if (cuatrimestreId > 0) {
      try {
        // Score rows depend on tables protected by RLS. The admin results page
        // uses the service-role read path; keep the dashboard in sync with it.
        aggData = await obtenerCalificacionesPorCuatrimestre(dbAdmin(), cuatrimestreId, {
          incluirFallbackInline: false,
        });
      } catch (error) {
        reportDashboardFailure('dashboard scores query', error);
      }
    }

interface FilaDashboard {
  id: number; nombre: string; apellidos: string; email: string;
  promEst: number | null; promObs: number | null; promCoord: number | null; promPlan: number | null; promAuto: number | null; autoNoRealizado: boolean;
  respuestasNativas: number;
  final360: number | null; cat360: string;
  instrumentos: number;
  esperados: number;
  planCell: string;
}

const filasTodas: FilaDashboard[] = aggData
  .filter((row) => row.num_instrumentos_completados > 0)
  .map((row) => {
    const progresoNativo = progresoEENativa.find((p) => p.docente_id === row.docente_id);
    return {
      id: row.docente_id,
      nombre: String(row.docente_nombre ?? ''),
      apellidos: String(row.docente_apellidos ?? ''),
      email: String(row.docente_email ?? ''),
      promEst: row.score_encuesta_estudiantil,
      promCoord: row.score_coordinacion,
      promPlan: row.score_planeacion,
      promObs: row.score_observacion,
      promAuto: row.score_autoevaluacion,
      autoNoRealizado: row.instrument_validity?.autodiagnostico === 'not_done',
      respuestasNativas: progresoNativo?.respuestas_nativas || 0,
      final360: row.calificacion_final,
      cat360: String(row.categoria_final ?? 'No iniciado'),
      instrumentos: row.num_instrumentos_completados,
      esperados: Number(row.num_instrumentos_esperados) || 5,
      planCell: planningCellLabel(row.score_planeacion, parsePlanningStatusSummary(row.instrument_validity?.planning_subject_status), formatScore),
    };
  });

// Filtro por búsqueda (server-side GET)
const filas = busqueda
  ? filasTodas.filter(f => `${f.nombre} ${f.apellidos}`.toLowerCase().includes(busqueda.toLowerCase()) || f.apellidos.toLowerCase().includes(busqueda.toLowerCase()) || f.email.toLowerCase().includes(busqueda.toLowerCase()))
  : filasTodas;

const totalEvaluados = filas.length;
const docentesConEENativaIniciada = filasTodas.filter(f => f.respuestasNativas > 0).length;
const conFinal = filasTodas.filter(f => (f.final360 || 0) > 0);
const promInstitucional = conFinal.length > 0 ? roundTo2(conFinal.reduce((s,f) => s + (f.final360 || 0), 0) / conFinal.length) : null;
const sobresalientes = conFinal.filter(f => (f.final360 || 0) >= 80).length;
const pctSobresaliente = conFinal.length > 0 ? Math.round((sobresalientes / conFinal.length) * 100) : 0;

function avgInstrumento(vals: Array<number | null>): number {
  const f = vals.filter((v): v is number => v != null && Number.isFinite(v));
  return f.length > 0 ? Math.round(f.reduce((a,b) => a + b, 0) / f.length) : 0;
}
const avgEst = avgInstrumento(filasTodas.map(f => f.promEst));
const avgCoord = avgInstrumento(filasTodas.map(f => f.promCoord));
const avgPlan = avgInstrumento(filasTodas.map(f => f.promPlan));
const avgObs = avgInstrumento(filasTodas.map(f => f.promObs));
const avgAuto = avgInstrumento(filasTodas.map(f => f.promAuto));

const catCounts: Record<string,number> = {'Sobresaliente':0,'Distinguido':0,'Bueno':0,'Aprobado':0,'A mejorar':0,'Insuficiente':0,'Parcial':0,'No iniciado':0};
filasTodas.forEach(f => { catCounts[f.cat360] = (catCounts[f.cat360] || 0) + 1; });

function colorN(n: number|null|undefined): string { if (n == null) return ''; if (n>=80) return 'text-emerald-600'; if (n>=60) return 'text-amber-600'; return 'text-red-600'; }

const cuatrimestreSel = cuatrimestres.find(c => c.id === cuatrimestreId) || cuatrimestre;

const accesosRapidos = [
  { href: '/admin/dashboard', titulo: 'Resultados', desc: 'Resumen general, indicadores y docentes evaluados.', icono: '📊', cycleScoped: true },
  { href: '/admin/reporte-anual', titulo: 'Reporte Anual', desc: 'Comparativas por ciclo y análisis histórico.', icono: '📈', cycleScoped: true },
  { href: '/admin/docentes', titulo: 'Docentes', desc: 'Consulta y control del personal docente.', icono: '👨‍🏫', cycleScoped: true },
  { href: '/admin/cuatrimestres', titulo: 'Cuatrimestres', desc: 'Activa, abre o cierra ciclos académicos.', icono: '📅', cycleScoped: false },
  { href: '/admin/asignaciones', titulo: 'Asignaciones', desc: 'Gestiona coordinadores y evaluadores.', icono: '🔗', cycleScoped: true },
  { href: '/admin/usuarios', titulo: 'Usuarios', desc: 'Administra accesos, roles y cuentas.', icono: '👥', cycleScoped: false },
  { href: '/admin/evaluar-docentes', titulo: 'Evaluaciones', desc: 'Captura y revisión de docentes.', icono: '⭐', cycleScoped: true },
  { href: '/admin/planeaciones/no-presentadas', titulo: 'Planeaciones NP', desc: 'Marca o reactiva excepciones por asignatura.', icono: '📝', cycleScoped: true },
  { href: '/admin/instrumentos', titulo: 'Instrumentos', desc: 'Configura reactivos, módulos y escalas.', icono: '🧩', cycleScoped: false },
];
---

<LayoutAdmin titulo="Dashboard — Admin">
  <div class="animate-flotar-entrada">
    <div class="mb-6">
      <p class="text-slate-500 text-sm">Hola, {formatPersonName(adminNombre)}</p>
      <h1 class="text-3xl font-bold text-tup">Dashboard Administrativo</h1>
      <p class="text-slate-500 mt-1">Atajos rápidos para navegar el panel SED-360.</p>
    </div>

    {dashboardWarnings.length > 0 && (
      <div class="mb-6 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800" role="status">
No se pudieron cargar algunos datos del dashboard. La página sigue disponible; intentá recargar en unos minutos.
      </div>
    )}

    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-8">
      {accesosRapidos.map(card => (
        <a href={`${card.href}${card.cycleScoped ? qs : ''}`} class={`bg-white rounded-2xl p-5 shadow-tarjeta hover:shadow-tarjeta-hover hover:-translate-y-0.5 transition-all border ${pathname === card.href ? 'border-tup/30' : 'border-slate-100'}`}>
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-xs uppercase tracking-wider text-slate-400 font-semibold">{card.titulo}</p>
              <p class="text-sm text-slate-600 mt-2">{card.desc}</p>
            </div>
            <span class="text-2xl">{card.icono}</span>
          </div>
        </a>
      ))}
    </div>

    <div class="flex items-center justify-between mb-6">
      <div><p class="text-sm text-slate-400">Ciclo activo</p><p class="text-slate-500">{cuatrimestreSel?.clave || 'Sin cuatrimestre activo'}</p></div>
      <form method="GET" class="flex items-center gap-2">
        {busqueda && <input type="hidden" name="q" value={busqueda} />}
        <select name="cuatrimestre" class="rounded-xl border border-slate-200 px-3 py-2 text-sm" onchange="this.form.submit()">{cuatrimestres.map(c => (<option value={c.id} selected={c.id === cuatrimestreId}>{c.clave}</option>))}</select>
      </form>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4 mb-8">
      <div class="bg-white rounded-2xl p-5 shadow-tarjeta"><p class="text-xs text-slate-400 uppercase">Docentes Evaluados</p><p class="text-3xl font-bold text-tup mt-1">{totalEvaluados}</p><p class="text-xs text-slate-400 mt-1">de {filasTodas.length} con actividad puntuable</p></div>
      <div class="bg-white rounded-2xl p-5 shadow-tarjeta"><p class="text-xs text-slate-400 uppercase">EE nativa iniciada</p><p class="text-3xl font-bold text-tup mt-1">{docentesConEENativaIniciada}</p><p class="text-xs text-slate-400 mt-1">docentes con respuestas</p></div>
      <div class="bg-white rounded-2xl p-5 shadow-tarjeta"><p class="text-xs text-slate-400 uppercase">Promedio Inst.</p><p class="text-3xl font-bold text-tup mt-1">{formatScore(promInstitucional)}</p><p class="text-xs text-slate-400 mt-1">escala 0-100</p></div>
      <div class="bg-white rounded-2xl p-5 shadow-tarjeta"><p class="text-xs text-slate-400 uppercase">Distinguidos</p><p class="text-3xl font-bold text-emerald-600 mt-1">{pctSobresaliente}%</p><p class="text-xs text-slate-400 mt-1">≥80 puntos</p></div>
      <div class="bg-white rounded-2xl p-5 shadow-tarjeta"><p class="text-xs text-slate-400 uppercase">A Mejorar</p><p class="text-3xl font-bold text-red-500 mt-1">{catCounts['A mejorar'] + catCounts['Insuficiente']}</p><p class="text-xs text-slate-400 mt-1">&lt;60 puntos</p></div>
      <div class="bg-white rounded-2xl p-5 shadow-tarjeta"><p class="text-xs text-slate-400 uppercase">Pendientes</p><a href="/admin/usuarios?rol=pendiente" class="block"><p class="text-3xl font-bold text-amber-500 mt-1">{pendientes || 0}</p><p class="text-xs text-slate-400 mt-1">por aprobar</p></a></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
      <div class="bg-white rounded-2xl p-6 shadow-tarjeta">
        <h3 class="text-sm font-semibold text-slate-700 mb-4">Distribución por Categoría</h3>
        <div class="flex justify-center" style="max-height:280px"><canvas id="chart-cat" data-chart={JSON.stringify(catCounts)} style="max-height:280px"></canvas></div>
      </div>
      <div class="bg-white rounded-2xl p-6 shadow-tarjeta">
        <h3 class="text-sm font-semibold text-slate-700 mb-4">Promedio por Instrumento</h3>
        <div class="flex justify-center" style="max-height:280px"><canvas id="chart-barras" data-chart={JSON.stringify([avgEst, avgCoord, avgPlan, avgObs, avgAuto])} style="max-height:280px"></canvas></div>
      </div>
    </div>

    <div class="bg-white rounded-2xl p-4 shadow-tarjeta mb-6">
      <form method="GET" class="flex gap-3">
        <input type="hidden" name="cuatrimestre" value={cuatrimestreId} />
        <input type="text" name="q" value={busqueda} placeholder="Buscar docente por nombre, apellidos o email..." class="flex-1 rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:ring-2 focus:ring-tup focus:outline-none" />
        <button type="submit" class="px-4 py-2.5 rounded-xl bg-tup text-white text-sm font-medium">Buscar</button>
        {busqueda && (<a href={`/admin/dashboard${qsWithoutSearch}`} class="px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-500">Limpiar</a>)}
      </form>
    </div>

    <div class="bg-white rounded-2xl shadow-tarjeta overflow-hidden">
      <div class="px-6 py-4 border-b flex items-center justify-between">
        <h2 class="font-semibold text-slate-700">Docentes con actividad ({filas.length})</h2>
        {busqueda && (<span class="text-xs ">Filtrado: "{busqueda}"</span>)}
      </div>
      {filas.length === 0 ? (<div class="p-12 text-center ">No se encontraron docentes.</div>) : (
        <div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="bg-slate-50 border-b">
          <th class="text-center px-3 py-3 text-xs uppercase">Docente</th>
          <th class="text-center px-3 py-3 text-xs uppercase">Email</th>
          <th class="text-center px-2 py-3 text-xs uppercase">Prog.</th>
          <th class="text-center px-2 py-3 text-xs uppercase">Est.</th>
          <th class="text-center px-2 py-3 text-xs uppercase">Coord.</th>
          <th class="text-center px-2 py-3 text-xs uppercase">Plan.</th>
          <th class="text-center px-2 py-3 text-xs uppercase">Obs.</th>
          <th class="text-center px-2 py-3 text-xs uppercase">Auto.</th>
          <th class="text-center px-2 py-3 text-xs uppercase">Final</th>
          <th class="text-center px-2 py-3 text-xs uppercase">Cat.</th>
          <th class="text-center px-2 py-3 text-xs uppercase">Ver</th>
        </tr></thead>
        <tbody class="divide-y">{filas.map(d => (
          <tr class="hover:bg-slate-50">
            <td class="px-3 py-2 text-center font-medium">{formatPersonName(`${d.nombre} ${d.apellidos}`.trim())}</td>
            <td class="px-3 py-2 text-center text-slate-600 text-xs">{d.email}</td>
            <td class="px-2 py-2 text-center"><span class="text-xs font-medium text-slate-600">{d.instrumentos}/{d.esperados}</span></td>
            <td class={`px-2 py-2 text-center ${colorN(d.promEst)}`}>{formatScore(d.promEst)}</td>
            <td class={`px-2 py-2 text-center ${colorN(d.promCoord)}`}>{formatScore(d.promCoord)}</td>
            <td class={`px-2 py-2 text-center ${colorN(d.promPlan)}`}>{d.planCell}</td>
            <td class={`px-2 py-2 text-center ${colorN(d.promObs)}`}>{formatScore(d.promObs)}</td>
            <td class={`px-2 py-2 text-center ${colorN(d.promAuto)}`}>{d.autoNoRealizado ? 'No realizado' : formatScore(d.promAuto)}</td>
            <td class={`px-2 py-2 text-center font-bold ${colorN(d.final360)}`}>{formatScore(d.final360)}</td>
            <td class="px-2 py-2 text-center"><span class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-slate-100">{d.cat360}</span></td>
            <td class="px-2 py-2 text-center">
              <a href={`/admin/docentes/${d.id}${qs}`} class="px-2 py-0.5 rounded-lg bg-tup/10 text-tup text-[10px] font-medium hover:bg-tup/20">Ver</a>
            </td>
          </tr>
        ))}</tbody></table></div>
      )}
    </div>
  </div>

</LayoutAdmin>

<script>
  import Chart from 'chart.js/auto';
  document.addEventListener('DOMContentLoaded', () => {
    const ctxCat = document.getElementById('chart-cat');
    if (ctxCat) {
      const catData = JSON.parse(ctxCat.dataset.chart || '{}');
      const labels = Object.keys(catData);
      const values = Object.values(catData);
      const bgColors = ['#22c55e','#3b82f6','#a855f7','#f59e0b','#f97316','#ef4444','#fbbf24','#94a3b8'];
      new Chart(ctxCat, {
        type: 'bar',
        data: { labels: labels, datasets: [{ data: values, backgroundColor: bgColors, borderRadius: 6, borderWidth: 0 }] },
        options: {
          indexAxis: 'y',
          responsive: true, maintainAspectRatio: true,
          scales: { x: { beginAtZero: true, grid: { color: 'rgba(148,163,184,0.1)' }, ticks: { font: { size: 10 }, stepSize: Math.max(1, Math.ceil(Math.max(...values, 1) / 5)) } }, y: { ticks: { font: { size: 10 } } } },
          plugins: { legend: { display: false } }
        }
      });
    }

    const ctxBarras = document.getElementById('chart-barras');
    if (ctxBarras) {
      const avgData = JSON.parse(ctxBarras.dataset.chart || '[]');
      new Chart(ctxBarras, {
        type: 'bar',
        data: {
          labels: ['Estudiante','Coordinación','Planeación','Observación','Autodiagnóstico'],
          datasets: [{ data: avgData, backgroundColor: ['#22c55e','#3b82f6','#a855f7','#f59e0b','#f97316'], borderRadius: 6, borderWidth: 0 }]
        },
        options: {
          responsive: true, maintainAspectRatio: true,
          scales: { y: { beginAtZero: true, max: 100, grid: { color: 'rgba(148,163,184,0.1)' }, ticks: { font: { size: 10 } } }, x: { ticks: { font: { size: 9 } } } },
          plugins: { legend: { display: false } }
        }
      });
    }
  });
</script>
