---
import LayoutAdmin from '../../layouts/LayoutAdmin.astro';
import { obtenerCuatrimestreActivo, obtenerCuatrimestres } from '../../services/catalogos';

const cuatrimestres = await obtenerCuatrimestres();
const activo = await obtenerCuatrimestreActivo();
const queryId = Number(Astro.url.searchParams.get('cuatrimestre'));
const cookieId = Number(Astro.cookies.get('cuatrimestre_sel')?.value);
const cuatrimestreId = cuatrimestres.some(c => c.id === queryId) ? queryId : activo?.id || cookieId || cuatrimestres[0]?.id || 0;
---

<LayoutAdmin titulo="Sincronizar asignaciones — Admin">
  <div class="animate-flotar-entrada max-w-5xl mx-auto">
    <a href={`/admin/importar${cuatrimestreId ? `?cuatrimestre=${cuatrimestreId}` : ''}`} class="text-sm text-slate-400 hover:text-tup">← Importaciones</a>
    <div class="mb-6 mt-6"><p class="text-sm font-medium text-violet-700 mb-2">Reporte académico</p><h1 class="text-3xl font-bold text-slate-800 mb-2">Sincronizar grupos, materias y docentes</h1><p class="text-slate-500">El CSV es la fuente actual de docente. Primero se genera una vista previa sin modificar datos; después se confirma la propuesta completa.</p></div>
    <div class="bg-white rounded-2xl p-6 shadow-tarjeta mb-6"><form id="form-importar" class="space-y-5"><div><label for="cuatrimestre" class="block text-sm font-medium text-slate-700 mb-1">Ciclo de destino *</label><select id="cuatrimestre" required class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm"><option value="">Seleccionar ciclo...</option>{cuatrimestres.map(c => <option value={c.id} selected={c.id === cuatrimestreId}>{c.clave}{c.nombre ? ` · ${c.nombre}` : ''}</option>)}</select></div><div><label for="archivo" class="block text-sm font-medium text-slate-700 mb-1">Reporte_clases.csv *</label><input id="archivo" type="file" accept=".csv,text/csv" required class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-tup file:text-white" /><p class="text-xs text-slate-400 mt-2">Columnas: Plan de Estudios, Grupo, ID del grupo, Clave, Clase, Aula, Docente, Alumnos Inscritos, ID de la clase.</p></div><div class="rounded-xl bg-slate-50 border border-slate-200 p-4 text-sm text-slate-600"><p class="font-semibold text-slate-700 mb-1">Conciliación segura y no destructiva</p><p>Las materias faltantes, docentes/grupos ambiguos y duplicados bloquean toda la aplicación. Un cambio de docente conserva la planeación, evaluaciones, observaciones e historial del grupo asignado.</p></div><button id="btn-preview" type="submit" class="w-full bg-tup text-white font-semibold py-4 rounded-xl hover:bg-tup/90 disabled:opacity-60">Generar vista previa</button></form></div>
    <section id="resultado" class="hidden bg-white rounded-2xl p-6 shadow-tarjeta"><p class="text-sm font-medium text-violet-700">Vista previa</p><h2 id="titulo" class="text-xl font-bold text-slate-800 mt-1"></h2><div id="metricas" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 mt-5"></div><div id="blockers-wrap" class="hidden mt-6"><h3 class="font-semibold text-red-700">Bloqueadores (no se aplicará nada)</h3><ul id="blockers" class="mt-2 text-sm text-red-700 space-y-1"></ul></div><div id="actions-wrap" class="hidden mt-6"><h3 class="font-semibold text-slate-800">Filas conciliadas</h3><div class="overflow-x-auto mt-2"><table class="w-full text-sm"><thead class="text-left text-slate-500"><tr><th class="p-2">Fila</th><th class="p-2">Acción</th><th class="p-2">Grupo / materia</th><th class="p-2">Docente</th><th class="p-2">Incidencias</th></tr></thead><tbody id="actions"></tbody></table></div></div><div class="flex flex-wrap gap-3 mt-6"><button id="btn-apply" type="button" disabled class="bg-emerald-600 text-white font-semibold py-3 px-5 rounded-xl hover:bg-emerald-700 disabled:opacity-50">Confirmar y aplicar propuesta completa</button><a id="reporte" class="hidden inline-flex items-center text-sm font-semibold text-tup hover:underline" target="_blank">Abrir reporte histórico</a></div><p id="apply-note" class="text-xs text-slate-500 mt-3">La confirmación reutiliza este mismo archivo y verifica su huella y la propuesta.</p></section>
    <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 hidden px-6 py-3 rounded-xl text-sm font-medium shadow-modal"></div>
  </div>
</LayoutAdmin>

<script is:inline>
  var preview=null;
  function toast(message,error){var element=document.getElementById('toast');element.textContent=message;element.className='fixed bottom-6 left-1/2 -translate-x-1/2 z-50 px-6 py-3 rounded-xl text-sm font-medium shadow-modal '+(error?'bg-red-600 text-white':'bg-emerald-600 text-white');element.classList.remove('hidden');setTimeout(function(){element.classList.add('hidden')},5000)}
  function metric(label,value){return '<div class="rounded-xl bg-slate-50 p-3"><p class="text-[11px] text-slate-500">'+label+'</p><p class="text-xl font-bold text-slate-800 mt-1">'+value+'</p></div>'}
  function escapeHtml(value){var node=document.createElement('span');node.textContent=String(value||'');return node.innerHTML}
  function render(data){var summary=data.summary||data;document.getElementById('resultado').classList.remove('hidden');document.getElementById('titulo').textContent=data.mode==='apply'?'Sincronización completada':'Revisá la propuesta antes de confirmarla';document.getElementById('metricas').innerHTML=metric('Filas',data.rowsRead||0)+metric('Crear',summary.create||0)+metric('Actualizar docente',summary.update||0)+metric('Sin cambio',summary.noOp||0)+metric('Incidencias a resolver',summary.issuesToResolve||data.issuesResolved||0);var blockers=data.blockers||[];document.getElementById('blockers-wrap').classList.toggle('hidden',!blockers.length);document.getElementById('blockers').innerHTML=blockers.map(function(item){return '<li>Fila '+escapeHtml(item.row)+': '+escapeHtml(item.reason)+'</li>'}).join('');var actions=data.actions||[];document.getElementById('actions-wrap').classList.toggle('hidden',!actions.length);document.getElementById('actions').innerHTML=actions.map(function(item){var teacher=item.previousTeacherId?'#'+item.previousTeacherId+' → '+item.teacher:item.teacher;return '<tr class="border-t border-slate-100"><td class="p-2">'+escapeHtml(item.rows.join(', '))+'</td><td class="p-2 font-medium">'+escapeHtml(item.kind)+'</td><td class="p-2">'+escapeHtml(item.group)+' · '+escapeHtml(item.subjectKey)+'</td><td class="p-2">'+escapeHtml(teacher)+'</td><td class="p-2">'+escapeHtml(item.issueCount)+'</td></tr>'}).join('');document.getElementById('btn-apply').disabled=Boolean(blockers.length)||data.mode==='apply';if(data.reportUrl){var report=document.getElementById('reporte');report.href=data.reportUrl;report.classList.remove('hidden')}if(data.recalculationErrors&&data.recalculationErrors.length)document.getElementById('apply-note').textContent='Aplicado, pero hubo errores exactos al recalcular: '+data.recalculationErrors.join('; ')}
  function formData(){var file=document.getElementById('archivo').files[0],cycle=document.getElementById('cuatrimestre').value;if(!cycle||!file){toast(!cycle?'Selecciona el ciclo de destino':'Selecciona un archivo CSV',true);return null}var fd=new FormData();fd.append('file',file);fd.append('cuatrimestre_id',cycle);return fd}
  document.getElementById('form-importar').addEventListener('submit',async function(event){event.preventDefault();var fd=formData();if(!fd)return;var button=document.getElementById('btn-preview');button.disabled=true;button.textContent='Generando vista previa...';try{var response=await fetch('/api/admin/importar-asignaciones?mode=preview',{method:'POST',body:fd});var data=await response.json();if(!response.ok)throw new Error(data.error||'No se pudo generar la vista previa');preview=data;render(data);toast(data.blockers&&data.blockers.length?'Corregí los bloqueadores antes de aplicar':'Vista previa lista para confirmar',Boolean(data.blockers&&data.blockers.length))}catch(error){toast(error.message||'Error de conexión',true)}finally{button.disabled=false;button.textContent='Generar vista previa'}});
  document.getElementById('btn-apply').addEventListener('click',async function(){if(!preview)return;var fd=formData();if(!fd)return;fd.append('file_hash',preview.fileHash);fd.append('preview_signature',preview.previewSignature);var button=document.getElementById('btn-apply');button.disabled=true;button.textContent='Aplicando propuesta completa...';try{var response=await fetch('/api/admin/importar-asignaciones?mode=apply',{method:'POST',body:fd});var data=await response.json();if(!response.ok)throw new Error(data.error||'No se pudo aplicar la propuesta');render(data);toast('Sincronización completada',false)}catch(error){toast(error.message||'Error de conexión',true);button.disabled=false;button.textContent='Confirmar y aplicar propuesta completa'}});
</script>
