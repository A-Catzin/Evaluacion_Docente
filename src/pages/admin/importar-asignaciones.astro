---
import LayoutAdmin from '../../layouts/LayoutAdmin.astro';
import { obtenerCuatrimestreActivo, obtenerCuatrimestres } from '../../services/catalogos';

const cuatrimestres = await obtenerCuatrimestres();
const activo = await obtenerCuatrimestreActivo();
const queryId = Number(Astro.url.searchParams.get('cuatrimestre'));
const cookieId = Number(Astro.cookies.get('cuatrimestre_sel')?.value);
const cuatrimestreId = cuatrimestres.some(c => c.id === queryId) ? queryId : activo?.id || cookieId || cuatrimestres[0]?.id || 0;
---

<LayoutAdmin titulo="Asignar grupos, materias y docentes — Admin">
  <div class="animate-flotar-entrada max-w-4xl mx-auto">
    <a href={`/admin/importar${cuatrimestreId ? `?cuatrimestre=${cuatrimestreId}` : ''}`} class="text-sm text-slate-400 hover:text-tup">← Importaciones</a>
    <div class="mb-6 mt-6"><p class="text-sm font-medium text-violet-700 mb-2">Reporte académico</p><h1 class="text-3xl font-bold text-slate-800 mb-2">Asignar grupos, materias y docentes</h1><p class="text-slate-500">El ciclo seleccionado es obligatorio y es la única fuente de alcance. El sufijo del grupo después de <code> - </code> se elimina antes de conciliar.</p></div>
    <div class="bg-white rounded-2xl p-6 shadow-tarjeta mb-6"><form id="form-importar" class="space-y-5"><div><label for="cuatrimestre" class="block text-sm font-medium text-slate-700 mb-1">Ciclo de destino *</label><select id="cuatrimestre" required class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm"><option value="">Seleccionar ciclo...</option>{cuatrimestres.map(c => <option value={c.id} selected={c.id === cuatrimestreId}>{c.clave}{c.nombre ? ` · ${c.nombre}` : ''}</option>)}</select></div><div><label for="archivo" class="block text-sm font-medium text-slate-700 mb-1">Reporte_clases.csv *</label><input id="archivo" type="file" accept=".csv,text/csv" required class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-tup file:text-white" /><p class="text-xs text-slate-400 mt-2">Columnas: Plan de Estudios, Grupo, ID del grupo, Clave, Clase, Aula, Docente, Alumnos Inscritos, ID de la clase. Se procesa el archivo completo.</p></div><div class="rounded-xl bg-slate-50 border border-slate-200 p-4 text-sm text-slate-600"><p class="font-semibold text-slate-700 mb-1">Conciliación no destructiva</p><p>Las materias se identifican por Clave, los docentes por correo/número de empleado cuando están disponibles o por nombre exacto único, y los grupos por ciclo + plan + grado + grupo. Las coincidencias ambiguas quedan en revisión.</p></div><button id="btn-importar" type="submit" class="w-full bg-tup text-white font-semibold py-4 rounded-xl hover:bg-tup/90 disabled:opacity-60">Subir y procesar reporte</button></form></div>
    <div id="resultado" class="hidden bg-white rounded-2xl p-6 shadow-tarjeta"><p class="text-sm font-medium text-violet-700">Resultado</p><h2 id="titulo" class="text-xl font-bold text-slate-800 mt-1"></h2><div id="metricas" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 mt-5"></div><p class="text-xs text-slate-500 mt-5">El reporte de revisión se genera como HTML imprimible. Usá “Imprimir / Guardar como PDF” en el navegador para obtener un PDF.</p><a id="reporte" class="hidden inline-flex mt-3 text-sm font-semibold text-tup hover:underline" target="_blank">Abrir reporte de revisión</a></div>
    <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 hidden px-6 py-3 rounded-xl text-sm font-medium shadow-modal"></div>
  </div>
</LayoutAdmin>

<script is:inline>
  function toast(message,error){var element=document.getElementById('toast');element.textContent=message;element.className='fixed bottom-6 left-1/2 -translate-x-1/2 z-50 px-6 py-3 rounded-xl text-sm font-medium shadow-modal '+(error?'bg-red-600 text-white':'bg-emerald-600 text-white');element.classList.remove('hidden');setTimeout(function(){element.classList.add('hidden')},5000)}
  function metric(label,value){return '<div class="rounded-xl bg-slate-50 p-3"><p class="text-[11px] text-slate-500">'+label+'</p><p class="text-xl font-bold text-slate-800 mt-1">'+value+'</p></div>'}
  document.getElementById('form-importar').addEventListener('submit',async function(event){event.preventDefault();var file=document.getElementById('archivo').files[0];var cycle=document.getElementById('cuatrimestre').value;if(!cycle||!file){toast(!cycle?'Selecciona el ciclo de destino':'Selecciona un archivo CSV',true);return}var button=document.getElementById('btn-importar');button.disabled=true;button.textContent='Procesando archivo completo...';var fd=new FormData();fd.append('file',file);fd.append('cuatrimestre_id',cycle);try{var response=await fetch('/api/admin/importar-asignaciones',{method:'POST',body:fd});var data=await response.json();if(!response.ok){toast(data.error||'No se pudo procesar el reporte',true);button.disabled=false;button.textContent='Subir y procesar reporte';return}document.getElementById('resultado').classList.remove('hidden');document.getElementById('titulo').textContent=data.issues?'Procesado con incidencias':'Procesado correctamente';document.getElementById('metricas').innerHTML=metric('Filas',data.rowsRead)+metric('Docentes resueltos',data.teacherResolved)+metric('Asignaturas resueltas',data.subjectResolved)+metric('Grupos resueltos',data.groupResolved)+metric('Asignaciones creadas',data.assignmentCreated)+metric('Asignaciones actualizadas',data.assignmentUpdated)+metric('Incidencias',data.issues);var link=document.getElementById('reporte');link.href=data.reportUrl;link.classList.remove('hidden');toast('Reporte procesado',false);button.disabled=false;button.textContent='Procesar otro archivo'}catch(error){toast('Error de conexión',true);button.disabled=false;button.textContent='Subir y procesar reporte'}});
</script>
