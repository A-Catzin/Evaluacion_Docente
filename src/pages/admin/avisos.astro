---
import LayoutAdmin from '../../layouts/LayoutAdmin.astro';
import { requireRole } from '../../lib/auth';
import { estaHabilitadoR2, obtenerUrlPublica } from '../../lib/storage';

const auth = await requireRole(Astro.cookies, ['superadmin']);
const { data: noticesData, error: noticesError } = await auth.client.rpc('institutional_notice_admin_list');
if (noticesError) throw noticesError;
const { data: cycles, error: cyclesError } = await auth.client.from('cuatrimestres').select('id,clave').order('id', { ascending: false });
if (cyclesError) throw cyclesError;
const notices = noticesData || [];
const editId = Number.parseInt(Astro.url.searchParams.get('editar') || '', 10);
const editing = notices.find((notice: any) => Number(notice.id) === editId) as any;
const roles = [
  ['superadmin', 'Superadministración'], ['coordinador', 'Coordinación'], ['docente', 'Docentes'], ['estudiante', 'Estudiantes'], ['observador', 'Observación'],
];
const selectedRoles = new Set(editing?.target_roles || []);
const imageUrl = editing?.image_path && estaHabilitadoR2() ? obtenerUrlPublica('avisos', editing.image_path) : null;
const expiresAtValue = editing?.expires_at ? new Date(editing.expires_at).toISOString().slice(0, 16) : '';
---

<LayoutAdmin titulo="Avisos institucionales — Admin">
  <section class="animate-flotar-entrada mx-auto max-w-6xl">
    <div class="mb-6"><h1 class="text-3xl font-bold text-tup">Avisos institucionales</h1><p class="mt-1 text-sm text-slate-500">Publica avisos por rol y ciclo sin mezclar esta información con las notificaciones personales.</p></div>
    <div class="mb-6 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900"><strong>Visibilidad de imágenes:</strong> {estaHabilitadoR2() ? 'las imágenes se publican mediante la URL pública configurada de R2; no cargues información sensible.' : 'el almacenamiento R2 no está habilitado, por lo que no es posible adjuntar imágenes.'}</div>
    <form id="notice-form" class="rounded-2xl bg-white p-6 shadow-tarjeta space-y-4" enctype="multipart/form-data">
      <input type="hidden" name="action" value="save" /><input type="hidden" name="id" value={editing?.id || ''} />
      <div class="flex items-center justify-between gap-3"><h2 class="text-lg font-semibold text-slate-800">{editing ? 'Editar aviso' : 'Nuevo aviso'}</h2>{editing && <a href="/admin/avisos" class="text-sm text-tup hover:underline">Cancelar edición</a>}</div>
      <label class="block text-sm font-medium text-slate-700">Título<input name="title" required maxlength="160" value={editing?.title || ''} class="mt-1 w-full rounded-xl border border-slate-200 px-3 py-2" /></label>
      <label class="block text-sm font-medium text-slate-700">Contenido<textarea name="body" required maxlength="4000" rows="5" class="mt-1 w-full rounded-xl border border-slate-200 px-3 py-2">{editing?.body || ''}</textarea></label>
      <div class="grid gap-4 md:grid-cols-2"><label class="text-sm font-medium text-slate-700">Ciclo (opcional)<select name="cuatrimestre_id" class="mt-1 w-full rounded-xl border border-slate-200 px-3 py-2"><option value="">Todos los ciclos</option>{(cycles || []).map((cycle) => <option value={cycle.id} selected={cycle.id === editing?.cuatrimestre_id}>{cycle.clave}</option>)}</select></label><label class="text-sm font-medium text-slate-700">Vence el (opcional)<input name="expires_at" type="datetime-local" value={expiresAtValue} class="mt-1 w-full rounded-xl border border-slate-200 px-3 py-2" /></label></div>
      <fieldset><legend class="text-sm font-medium text-slate-700">Destinatarios (sin selección: todos los roles institucionales)</legend><div class="mt-2 flex flex-wrap gap-3">{roles.map(([value, label]) => <label class="inline-flex items-center gap-2 text-sm text-slate-700"><input type="checkbox" name="target_roles" value={value} checked={selectedRoles.has(value)} />{label}</label>)}</div></fieldset>
      <div class="grid gap-4 md:grid-cols-2"><label class="text-sm font-medium text-slate-700">Estado<select name="status" class="mt-1 w-full rounded-xl border border-slate-200 px-3 py-2"><option value="draft" selected={editing?.status === 'draft' || !editing}>Borrador</option><option value="published" selected={editing?.status === 'published'}>Publicado</option><option value="archived" selected={editing?.status === 'archived'}>Archivado</option></select></label><label class="mt-7 inline-flex items-center gap-2 text-sm text-slate-700"><input type="checkbox" name="is_active" value="true" checked={editing ? editing.is_active : true} />Activo</label></div>
      <div class="rounded-xl border border-slate-200 p-4"><label class="block text-sm font-medium text-slate-700">Imagen (JPG, PNG o WebP; máximo 5 MB)<input name="image" type="file" accept="image/jpeg,image/png,image/webp" class="mt-1 block w-full text-sm" /></label><label class="mt-3 block text-sm font-medium text-slate-700">Texto alternativo de la imagen<input name="image_alt_text" maxlength="240" value={editing?.image_alt_text || ''} class="mt-1 w-full rounded-xl border border-slate-200 px-3 py-2" /></label>{imageUrl && <div class="mt-3"><img src={imageUrl} alt={editing.image_alt_text} class="max-h-32 rounded-lg" /><label class="mt-2 inline-flex items-center gap-2 text-sm text-red-700"><input name="remove_image" value="true" type="checkbox" />Quitar imagen actual</label></div>}</div>
      <p id="notice-error" class="hidden rounded-xl border border-red-200 bg-red-50 p-3 text-sm text-red-800" role="alert"></p><button class="rounded-xl bg-tup px-5 py-2.5 text-sm font-semibold text-white">{editing ? 'Guardar cambios' : 'Guardar aviso'}</button>
    </form>
    <div class="mt-8 overflow-x-auto rounded-2xl bg-white shadow-tarjeta"><table class="w-full min-w-[800px] text-sm"><thead><tr class="border-b bg-slate-50 text-left text-xs uppercase text-slate-500"><th class="px-4 py-3">Título</th><th class="px-4 py-3">Estado</th><th class="px-4 py-3">Ciclo</th><th class="px-4 py-3">Destinatarios</th><th class="px-4 py-3">Acciones</th></tr></thead><tbody class="divide-y">{notices.length === 0 ? <tr><td colspan="5" class="px-4 py-10 text-center text-slate-500">No hay avisos institucionales.</td></tr> : notices.map((notice: any) => <tr><td class="px-4 py-3 font-medium text-slate-800">{notice.title}</td><td class="px-4 py-3">{notice.status}{notice.is_active ? '' : ' · inactivo'}</td><td class="px-4 py-3">{(cycles || []).find((cycle) => cycle.id === notice.cuatrimestre_id)?.clave || 'Todos'}</td><td class="px-4 py-3">{notice.target_roles?.length ? notice.target_roles.join(', ') : 'Todos'}</td><td class="px-4 py-3"><a class="text-tup hover:underline" href={`/admin/avisos?editar=${notice.id}`}>Editar</a><button class="delete-notice ml-3 text-red-600 hover:underline" data-id={notice.id}>Eliminar</button></td></tr>)}</tbody></table></div>
  </section>
</LayoutAdmin>

<script is:inline>
  var form = document.getElementById('notice-form');
  var error = document.getElementById('notice-error');
  form.addEventListener('submit', async function(event) { event.preventDefault(); error.classList.add('hidden'); var response = await fetch('/api/admin/avisos', { method: 'POST', body: new FormData(form) }); var data = await response.json().catch(function() { return {}; }); if (!response.ok) { error.textContent = data.error || 'No fue posible guardar el aviso.'; error.classList.remove('hidden'); return; } window.location.href = '/admin/avisos'; });
  document.querySelectorAll('.delete-notice').forEach(function(button) { button.addEventListener('click', async function() { if (!confirm('¿Eliminar este aviso institucional?')) return; var formData = new FormData(); formData.set('action', 'delete'); formData.set('id', button.dataset.id); var response = await fetch('/api/admin/avisos', { method: 'POST', body: formData }); if (response.ok) window.location.href = '/admin/avisos'; }); });
</script>
