---
import LayoutAdmin from '../../../layouts/LayoutAdmin.astro';
import { db, dbAdmin } from '../../../lib/db';
import { obtenerCuatrimestreActivo, obtenerCuatrimestres } from '../../../services/catalogos';
import { GROUP_NP_FILTER_TOKENS, groupPlanningAssignmentsBySubjectName, hasStandaloneGroupNumericToken, normalizePlanningSubjectName } from '../../../lib/planningSubjectScope';
import { getPlanningSubjectStatus } from '../../../lib/planningSubjectStatus';
import { formatPersonName } from '../../../lib/personName';

const client = db();
const token = Astro.cookies.get('sb-access-token')?.value;
const refresh = Astro.cookies.get('sb-refresh-token')?.value;
if (!token || !refresh) return Astro.redirect('/auth');
const { data: session } = await client.auth.setSession({ access_token: token, refresh_token: refresh });
const { data: actor } = session.user ? await client.from('usuarios').select('rol').eq('id', session.user.id).maybeSingle() : { data: null };
if (actor?.rol !== 'superadmin') return Astro.redirect('/admin/dashboard');

const active = await obtenerCuatrimestreActivo(dbAdmin());
const cycles = await obtenerCuatrimestres(dbAdmin());
const requested = Number.parseInt(Astro.url.searchParams.get('cuatrimestre') || '', 10);
const cookieId = Number.parseInt(Astro.cookies.get('cuatrimestre_sel')?.value || '', 10);
const cicloPorQuery = cycles.find(cycle => cycle.id === requested);
const cicloPorCookie = cycles.find(cycle => cycle.id === cookieId);
const cicloActivo = cycles.find(cycle => cycle.id === active?.id);
const cycleId = (cicloPorQuery || cicloPorCookie || cicloActivo || cycles[0])?.id || 0;
const qs = cycleId ? `?cuatrimestre=${cycleId}` : '';
if (Astro.url.searchParams.has('cuatrimestre')) Astro.cookies.set('cuatrimestre_sel', String(cycleId), { path: '/', maxAge: 60 * 60 * 24 * 30 });

const [{ data: groups }, { data: plans }, { data: npRecords }, { data: groupNpRecords }] = await Promise.all([
  client.from('grupos').select('id,clave,asignatura_id,docente_id,docentes!inner(nombre,apellidos,email),asignaturas!inner(nombre)').eq('cuatrimestre_id', cycleId).eq('activo', true).eq('modalidad', 'Escolarizado').not('docente_id', 'is', null),
  client.from('planeaciones').select('docente_id,estado,asignaturas!inner(nombre)').eq('cuatrimestre_id', cycleId),
  client.from('planning_subject_np').select('docente_id,subject_key,estado,motivo,marked_at').eq('cuatrimestre_id', cycleId),
  client.from('planning_group_np').select('grupo_id,estado,motivo,marked_at').eq('cuatrimestre_id', cycleId),
]);

const groupNpByGroupId = new Map((groupNpRecords || []).map((record: any) => [record.grupo_id, record]));
const groupRows = (groups || []).map((group: any) => ({
  ...group,
  npStatus: groupNpByGroupId.get(group.id),
  filterTokens: GROUP_NP_FILTER_TOKENS.filter((token) => hasStandaloneGroupNumericToken(group.clave, token)),
})).sort((left: any, right: any) => `${left.clave} ${left.docentes?.apellidos || ''} ${left.docentes?.nombre || ''}`.localeCompare(`${right.clave} ${right.docentes?.apellidos || ''} ${right.docentes?.nombre || ''}`, 'es-MX'));
const rows = [...new Map((groups || []).map((group: any) => [group.docente_id, group.docentes])).entries()].flatMap(([docenteId, docente]: any) => {
  const assignments = (groups || []).filter((group: any) => group.docente_id === docenteId).flatMap((group: any) => group.asignaturas?.nombre ? [{ asignaturaId: group.asignatura_id, asignaturaNombre: group.asignaturas.nombre, grupo: group.clave }] : []);
  const teacherPlans = (plans || []).filter((plan: any) => plan.docente_id === docenteId).map((plan: any) => ({ asignaturaNombre: plan.asignaturas?.nombre || '', estado: plan.estado }));
  const teacherNp = (npRecords || []).filter((record: any) => record.docente_id === docenteId);
  return groupPlanningAssignmentsBySubjectName(assignments).map((scope) => {
    const status = getPlanningSubjectStatus(scope, teacherPlans, teacherNp);
    const np = teacherNp.find((record: any) => normalizePlanningSubjectName(record.subject_key) === scope.key);
    return { docenteId, docente, scope, status, np };
  });
}).sort((left: any, right: any) => `${left.docente?.apellidos} ${left.docente?.nombre} ${left.scope.nombre}`.localeCompare(`${right.docente?.apellidos} ${right.docente?.nombre} ${right.scope.nombre}`, 'es-MX'));
---
<LayoutAdmin titulo="Planeaciones no presentadas">
  <div class="animate-flotar-entrada max-w-7xl mx-auto">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
      <div><h1 class="text-3xl font-bold text-tup">Planeaciones no presentadas (NP)</h1><p class="mt-1 text-sm text-slate-500">La opción heredada NP por asignatura permanece separada del nuevo NP administrativo por grupo.</p></div>
      <div class="flex items-center gap-3"><a href={`/admin/planeaciones${qs}`} class="rounded-xl border border-tup px-3 py-2 text-sm font-medium text-tup">Planeaciones</a><form method="GET"><select name="cuatrimestre" class="rounded-xl border border-slate-200 px-3 py-2 text-sm" onchange="this.form.submit()">{cycles.map((cycle) => <option value={cycle.id} selected={cycle.id === cycleId}>{cycle.clave}</option>)}</select></form></div>
    </div>
    {rows.length === 0 ? <div class="overflow-hidden rounded-2xl bg-white shadow-tarjeta"><p class="p-10 text-center text-slate-400">No hay asignaturas activas para este ciclo.</p></div> : <><div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_20rem]">
      <section class="overflow-hidden rounded-2xl bg-white shadow-tarjeta" aria-label="NP por asignatura heredado">
        <div class="border-b p-4">
          <p class="text-sm font-semibold text-tup">NP por asignatura (opción heredada)</p><label for="np-search" class="mt-3 block text-sm font-medium text-slate-700">Buscar asignatura</label>
          <input id="np-search" type="search" class="mt-1 w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" placeholder="Docente, correo o asignatura" autocomplete="off" />
          <p class="mt-1 text-xs text-slate-500">Las asignaturas aprobadas no pueden seleccionarse ni marcarse como NP.</p>
        </div>
        <div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="border-b bg-slate-50"><th class="w-10 px-3 py-3 text-center text-xs uppercase"><span class="sr-only">Seleccionar</span></th><th class="px-3 py-3 text-left text-xs uppercase">Docente</th><th class="px-3 py-3 text-left text-xs uppercase">Asignatura / grupos</th><th class="px-3 py-3 text-center text-xs uppercase">Estado</th><th class="px-3 py-3 text-left text-xs uppercase">Motivo NP</th><th class="px-3 py-3 text-right text-xs uppercase">Acción</th></tr></thead><tbody class="divide-y">{rows.map((row: any) => <tr data-search={`${row.docente?.nombre || ''} ${row.docente?.apellidos || ''} ${row.docente?.email || ''} ${row.scope.nombre}`.toLocaleLowerCase('es-MX')}><td class="px-3 py-3 text-center">{row.status === 'approved' ? <span class="text-xs text-slate-400" aria-label="Asignatura aprobada, no seleccionable">—</span> : <input class="np-select h-4 w-4 rounded border-slate-300 text-tup focus:ring-tup" type="checkbox" data-docente={row.docenteId} data-subject={row.scope.key} data-status={row.status} data-teacher={formatPersonName(`${row.docente?.nombre || ''} ${row.docente?.apellidos || ''}`.trim())} data-subject-name={row.scope.nombre} data-groups={JSON.stringify(row.scope.grupos)} aria-label={`Seleccionar ${row.scope.nombre} de ${formatPersonName(`${row.docente?.nombre || ''} ${row.docente?.apellidos || ''}`.trim())}`} />}</td><td class="px-3 py-3"><p class="font-medium">{formatPersonName(`${row.docente?.nombre || ''} ${row.docente?.apellidos || ''}`.trim())}</p><p class="text-xs text-slate-400">{row.docente?.email}</p></td><td class="px-3 py-3"><p>{row.scope.nombre}</p><p class="text-xs text-slate-500">Grupos: {row.scope.grupos.join(', ')}</p></td><td class="px-3 py-3 text-center"><span class={`rounded px-2 py-1 text-xs font-medium ${row.status === 'approved' ? 'bg-emerald-50 text-emerald-700' : row.status === 'np' ? 'bg-slate-200 text-slate-700' : 'bg-amber-50 text-amber-700'}`}>{row.status === 'approved' ? 'Aprobada' : row.status === 'np' ? 'NP' : 'Sin aprobar'}</span></td><td class="px-3 py-3 text-xs text-slate-600">{row.np?.motivo || '—'}</td><td class="px-3 py-3 text-right">{row.status === 'approved' ? <span class="text-xs text-slate-400">No disponible</span> : <button class={`np-action rounded-lg px-3 py-1.5 text-xs font-medium ${row.status === 'np' ? 'border border-slate-300 text-slate-700' : 'bg-tup text-white'}`} data-docente={row.docenteId} data-subject={row.scope.key} data-action={row.status === 'np' ? 'reactivate' : 'mark_np'}>{row.status === 'np' ? 'Reactivar' : 'Marcar NP'}</button>}</td></tr>)}</tbody></table></div>
      </section>
      <aside class="h-fit rounded-2xl bg-white p-4 shadow-tarjeta lg:sticky lg:top-4" aria-labelledby="np-selection-title">
        <div class="flex items-start justify-between gap-3"><div><h2 id="np-selection-title" class="font-semibold text-tup">Selección para acción masiva</h2><p id="np-selection-count" class="mt-1 text-sm text-slate-500" aria-live="polite">0 asignaturas seleccionadas</p></div><button id="np-clear-selection" type="button" class="text-xs font-medium text-tup disabled:text-slate-400" disabled>Limpiar</button></div>
        <p id="np-selection-help" class="mt-3 text-xs text-slate-500">Seleccione asignaturas pendientes para marcarlas como NP o asignaturas NP para reactivarlas. No se pueden mezclar ambas acciones.</p>
        <ul id="np-selected-items" class="mt-3 max-h-64 space-y-2 overflow-y-auto" aria-live="polite"></ul>
        <div id="np-bulk-reason-wrap" class="mt-4" hidden><label for="np-bulk-reason" class="text-sm font-medium text-slate-700">Motivo administrativo <span class="font-normal text-slate-400">(opcional)</span></label><textarea id="np-bulk-reason" maxlength="500" rows="3" class="mt-1 w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" placeholder="Se aplicará a toda la selección"></textarea></div>
        <p id="np-selection-error" class="mt-3 text-xs text-rose-700" role="alert" hidden></p>
        <button id="np-bulk-action" type="button" class="mt-4 w-full rounded-xl bg-tup px-3 py-2 text-sm font-medium text-white disabled:cursor-not-allowed disabled:bg-slate-300" disabled>Marcar selección como NP</button>
      </aside>
        </div>
        <section class="mt-8 overflow-hidden rounded-2xl bg-white shadow-tarjeta" aria-labelledby="group-np-title">
          <div class="border-b p-4"><h2 id="group-np-title" class="font-semibold text-tup">NP por grupo</h2><p class="mt-1 text-sm text-slate-500">NP se aplica solo a esta asignación de grupo. No modifica ni elimina planeaciones, incluso si están aprobadas.</p><div class="mt-4 flex flex-wrap items-end gap-3"><div><label for="group-np-filter" class="block text-sm font-medium text-slate-700">Filtrar por token de grupo</label><select id="group-np-filter" class="mt-1 rounded-xl border border-slate-200 px-3 py-2 text-sm"><option value="">Todos los grupos</option>{GROUP_NP_FILTER_TOKENS.map((token) => <option value={token}>{token}</option>)}</select></div><div class="flex-1"><label for="group-np-search" class="block text-sm font-medium text-slate-700">Buscar grupo</label><input id="group-np-search" type="search" class="mt-1 w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" placeholder="Ej. 27-1 LPIE 11 01B" autocomplete="off" /></div><button id="group-np-select-visible" type="button" class="rounded-xl border border-tup px-3 py-2 text-sm font-medium text-tup">Seleccionar todos los grupos visibles</button></div><p class="mt-2 text-xs text-slate-500">El filtro reconoce solo tokens numéricos independientes; por ejemplo, 23 no coincide con 123.</p></div>
          <div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="border-b bg-slate-50"><th class="w-10 px-3 py-3 text-center text-xs uppercase"><span class="sr-only">Seleccionar</span></th><th class="px-3 py-3 text-left text-xs uppercase">Grupo</th><th class="px-3 py-3 text-left text-xs uppercase">Docente</th><th class="px-3 py-3 text-left text-xs uppercase">Asignatura</th><th class="px-3 py-3 text-center text-xs uppercase">Estado NP</th><th class="px-3 py-3 text-left text-xs uppercase">Motivo</th><th class="px-3 py-3 text-right text-xs uppercase">Acción</th></tr></thead><tbody class="divide-y">{groupRows.map((group: any) => <tr data-group-search={String(group.clave || '').toLocaleLowerCase('es-MX')} data-group-tokens={group.filterTokens.join(' ')}><td class="px-3 py-3 text-center"><input class="group-np-select h-4 w-4 rounded border-slate-300 text-tup focus:ring-tup" type="checkbox" data-group-id={group.id} aria-label={`Seleccionar grupo ${group.clave}`} /></td><td class="px-3 py-3 font-medium">{group.clave}</td><td class="px-3 py-3"><p>{formatPersonName(`${group.docentes?.nombre || ''} ${group.docentes?.apellidos || ''}`.trim())}</p><p class="text-xs text-slate-400">{group.docentes?.email}</p></td><td class="px-3 py-3">{group.asignaturas?.nombre}</td><td class="px-3 py-3 text-center"><span class={`rounded px-2 py-1 text-xs font-medium ${group.npStatus?.estado === 'NP' ? 'bg-slate-200 text-slate-700' : 'bg-emerald-50 text-emerald-700'}`}>{group.npStatus?.estado === 'NP' ? 'NP' : 'Elegible'}</span></td><td class="px-3 py-3 text-xs text-slate-600">{group.npStatus?.motivo || '—'}</td><td class="px-3 py-3 text-right"><button class={`group-np-action rounded-lg px-3 py-1.5 text-xs font-medium ${group.npStatus?.estado === 'NP' ? 'border border-slate-300 text-slate-700' : 'bg-tup text-white'}`} data-group-id={group.id} data-action={group.npStatus?.estado === 'NP' ? 'reactivate_group_np' : 'mark_group_np'}>{group.npStatus?.estado === 'NP' ? 'Reactivar grupo' : 'Marcar NP'}</button></td></tr>)}</tbody></table></div>
          <div class="border-t p-4"><div class="flex flex-wrap items-center justify-between gap-3"><p id="group-np-selection-count" class="text-sm text-slate-500" aria-live="polite">0 grupos seleccionados</p><button id="group-np-clear-selection" type="button" class="text-xs font-medium text-tup disabled:text-slate-400" disabled>Limpiar</button></div><div class="mt-3"><label for="group-np-reason" class="text-sm font-medium text-slate-700">Motivo administrativo <span class="font-normal text-slate-400">(opcional)</span></label><textarea id="group-np-reason" maxlength="500" rows="3" class="mt-1 w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" placeholder="Se aplicará a toda la selección"></textarea></div><p id="group-np-selection-error" class="mt-3 text-xs text-rose-700" role="alert" hidden></p><button id="group-np-bulk-action" type="button" class="mt-4 rounded-xl bg-tup px-4 py-2 text-sm font-medium text-white disabled:cursor-not-allowed disabled:bg-slate-300" disabled>Marcar grupos seleccionados como NP</button></div>
        </section></>
      </div>
    </LayoutAdmin>
<script is:inline define:vars={{ cycleId }}>
  (function () {
    var search = document.getElementById('np-search');
    var checkboxes = Array.prototype.slice.call(document.querySelectorAll('.np-select'));
    var selected = new Map();
    var count = document.getElementById('np-selection-count');
    var list = document.getElementById('np-selected-items');
    var clear = document.getElementById('np-clear-selection');
    var actionButton = document.getElementById('np-bulk-action');
    var reasonWrap = document.getElementById('np-bulk-reason-wrap');
    var reason = document.getElementById('np-bulk-reason');
    var error = document.getElementById('np-selection-error');

    function selectionAction() {
      var first = selected.values().next();
      return first.done ? null : first.value.status === 'np' ? 'reactivate' : 'mark_np';
    }
    function showError(message) {
      error.textContent = message || '';
      error.hidden = !message;
    }
    function renderSelection() {
      var action = selectionAction();
      count.textContent = selected.size + (selected.size === 1 ? ' asignatura seleccionada' : ' asignaturas seleccionadas');
      clear.disabled = selected.size === 0;
      actionButton.disabled = selected.size === 0;
      actionButton.textContent = action === 'reactivate' ? 'Reactivar selección' : 'Marcar selección como NP';
      reasonWrap.hidden = action !== 'mark_np';
      list.replaceChildren();
      selected.forEach(function (item) {
        var row = document.createElement('li');
        row.className = 'rounded-lg bg-slate-50 p-2 text-xs text-slate-700';
        var title = document.createElement('p');
        title.className = 'font-medium';
        title.textContent = item.teacher + ' · ' + item.subjectName;
        var groups = document.createElement('p');
        groups.className = 'mt-1 text-slate-500';
        groups.textContent = 'Grupos: ' + item.groups.join(', ');
        row.append(title, groups);
        list.appendChild(row);
      });
    }
    checkboxes.forEach(function (checkbox) {
      checkbox.addEventListener('change', function () {
        var key = this.dataset.docente + ':' + this.dataset.subject;
        var action = this.dataset.status === 'np' ? 'reactivate' : 'mark_np';
        var currentAction = selectionAction();
        if (this.checked && currentAction && currentAction !== action) {
          this.checked = false;
          showError('Seleccione solo asignaturas para una misma acción masiva. Limpie la selección para cambiar de acción.');
          return;
        }
        if (this.checked) {
          var groups = [];
          try { groups = JSON.parse(this.dataset.groups || '[]'); } catch (_) { groups = []; }
          selected.set(key, { docenteId: Number(this.dataset.docente), subjectKey: this.dataset.subject, status: this.dataset.status, teacher: this.dataset.teacher || '', subjectName: this.dataset.subjectName || '', groups: groups });
        } else selected.delete(key);
        showError('');
        renderSelection();
      });
    });
    clear.addEventListener('click', function () {
      selected.clear();
      checkboxes.forEach(function (checkbox) { checkbox.checked = false; });
      showError('');
      renderSelection();
    });
    search.addEventListener('input', function () {
      var term = this.value.trim().toLocaleLowerCase('es-MX');
      document.querySelectorAll('tbody tr[data-search]').forEach(function (row) { row.hidden = !!term && !row.dataset.search.includes(term); });
    });
    actionButton.addEventListener('click', async function () {
      var action = selectionAction();
      if (!action || !selected.size) return;
      var motivo = reason.value.trim();
      if (motivo.length > 500) return showError('El motivo no puede superar 500 caracteres.');
      this.disabled = true;
      showError('');
      try {
        var response = await fetch('/api/admin/planeacion-status', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: action, cuatrimestre_id: cycleId, items: Array.from(selected.values()).map(function (item) { return { docente_id: item.docenteId, subject_key: item.subjectKey }; }), motivo: motivo }) });
        var result = await response.json().catch(function () { return {}; });
        if (!response.ok) { this.disabled = false; return showError(result.error || 'No fue posible actualizar la selección.'); }
        window.location.reload();
      } catch (_) { this.disabled = false; showError('No fue posible conectar con el servidor.'); }
    });
    document.querySelectorAll('.np-action').forEach(function (button) { button.addEventListener('click', async function () {
      var action = this.dataset.action;
      var motivo = '';
      if (action === 'mark_np') { motivo = window.prompt('Motivo administrativo (opcional, máximo 500 caracteres):', '') || ''; if (motivo.length > 500) return window.alert('El motivo no puede superar 500 caracteres.'); }
      this.disabled = true;
      try {
        var response = await fetch('/api/admin/planeacion-status', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: action, docente_id: Number(this.dataset.docente), cuatrimestre_id: cycleId, subject_key: this.dataset.subject, motivo: motivo }) });
        var result = await response.json().catch(function () { return {}; });
        if (!response.ok) { this.disabled = false; return window.alert(result.error || 'No fue posible actualizar el estado.'); }
        window.location.reload();
      } catch (_) { this.disabled = false; window.alert('No fue posible conectar con el servidor.'); }
    }); });
    renderSelection();
  }());
    </script>
    <script is:inline define:vars={{ cycleId }}>
      (function () {
        var filter = document.getElementById('group-np-filter');
        var search = document.getElementById('group-np-search');
        var selectVisible = document.getElementById('group-np-select-visible');
        var checkboxes = Array.prototype.slice.call(document.querySelectorAll('.group-np-select'));
        var selected = new Map();
        var count = document.getElementById('group-np-selection-count');
        var clear = document.getElementById('group-np-clear-selection');
        var actionButton = document.getElementById('group-np-bulk-action');
        var reason = document.getElementById('group-np-reason');
        var error = document.getElementById('group-np-selection-error');

        function showError(message) {
          error.textContent = message || '';
          error.hidden = !message;
        }
        function renderSelection() {
          count.textContent = selected.size + (selected.size === 1 ? ' grupo seleccionado' : ' grupos seleccionados');
          clear.disabled = selected.size === 0;
          actionButton.disabled = selected.size === 0;
        }
        function filterRows() {
          var term = search.value.trim().toLocaleLowerCase('es-MX');
          var token = filter.value;
          document.querySelectorAll('tbody tr[data-group-search]').forEach(function (row) {
            var hasToken = !token || (row.dataset.groupTokens || '').split(' ').includes(token);
            row.hidden = !hasToken || (!!term && !row.dataset.groupSearch.includes(term));
          });
        }
        async function submit(action, items, motivo, onError) {
          var response = await fetch('/api/admin/planeacion-status', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: action, cuatrimestre_id: cycleId, items: items, motivo: motivo }) });
          var result = await response.json().catch(function () { return {}; });
          if (!response.ok) return onError(result.error || 'No fue posible actualizar el estado NP del grupo.');
          window.location.reload();
        }
        checkboxes.forEach(function (checkbox) {
          checkbox.addEventListener('change', function () {
            if (this.checked) selected.set(this.dataset.groupId, { grupo_id: Number(this.dataset.groupId) });
            else selected.delete(this.dataset.groupId);
            showError('');
            renderSelection();
          });
        });
        selectVisible.addEventListener('click', function () {
          checkboxes.forEach(function (checkbox) {
            if (!checkbox.closest('tr').hidden) {
              checkbox.checked = true;
              selected.set(checkbox.dataset.groupId, { grupo_id: Number(checkbox.dataset.groupId) });
            }
          });
          showError('');
          renderSelection();
        });
        clear.addEventListener('click', function () {
          selected.clear();
          checkboxes.forEach(function (checkbox) { checkbox.checked = false; });
          showError('');
          renderSelection();
        });
        filter.addEventListener('change', filterRows);
        search.addEventListener('input', filterRows);
        actionButton.addEventListener('click', async function () {
          var motivo = reason.value.trim();
          if (!selected.size) return;
          if (motivo.length > 500) return showError('El motivo no puede superar 500 caracteres.');
          this.disabled = true;
          showError('');
          try { await submit('mark_group_np', Array.from(selected.values()), motivo, function (message) { actionButton.disabled = false; showError(message); }); }
          catch (_) { this.disabled = false; showError('No fue posible conectar con el servidor.'); }
        });
        document.querySelectorAll('.group-np-action').forEach(function (button) { button.addEventListener('click', async function () {
          var action = this.dataset.action;
          var motivo = '';
          if (action === 'mark_group_np') { motivo = window.prompt('Motivo administrativo (opcional, máximo 500 caracteres):', '') || ''; if (motivo.length > 500) return window.alert('El motivo no puede superar 500 caracteres.'); }
          this.disabled = true;
          try { await submit(action, [{ grupo_id: Number(this.dataset.groupId) }], motivo, function (message) { button.disabled = false; window.alert(message); }); }
          catch (_) { this.disabled = false; window.alert('No fue posible conectar con el servidor.'); }
        }); });
        filterRows();
        renderSelection();
      }());
    </script>
