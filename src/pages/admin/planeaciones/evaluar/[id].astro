---
import LayoutAdmin from '../../../../layouts/LayoutAdmin.astro';
import { db } from '../../../../lib/db';
import { obtenerUrlFirmadaDesdeUrlAlmacenada } from '../../../../lib/storage';
import { obtenerPlaneacion } from '../../../../services/planeaciones';

const id = parseInt(Astro.params.id || '0');
const backSearch = Astro.url.search || '';
const cliente = db();
const plan = await obtenerPlaneacion(id);
if (!plan) return Astro.redirect(`/admin/planeaciones${backSearch}`);

let urlFirmada = plan.url_pdf;
try {
  const signed = await obtenerUrlFirmadaDesdeUrlAlmacenada(plan.url_pdf, 3600);
  if (signed !== plan.url_pdf) urlFirmada = signed;
} catch {}

const { data: docente } = await cliente.from('docentes').select('nombre,apellidos').eq('id', plan.docente_id).maybeSingle();
const { data: asignatura } = await cliente.from('asignaturas').select('nombre').eq('id', plan.asignatura_id).maybeSingle();

const { data: cats } = await cliente.from('instrumento_preguntas').select('*').eq('instrumento', 'planeacion').eq('tipo_respuesta', 'categoria').eq('activa', true).order('orden');
const categorias = (cats || []).map(c => {
  const ops = (c.opciones || {}) as Record<string, any>;
  return { id: c.seccion, label: `${c.orden}. ${c.texto}`, desc2: ops.desc2 || '', desc1: ops.desc1 || '', desc0: ops.desc0 || '', obs2: ops.obs2 || [], obs1: ops.obs1 || [], obs0: ops.obs0 || [] };
});

---

<LayoutAdmin titulo="Evaluar Planeación — Admin">
  <div class="animate-flotar-entrada max-w-3xl mx-auto">
    <a href={`/admin/planeaciones${backSearch}`} class="text-sm text-tup hover:underline mb-4 inline-block">← Volver</a>
    <h1 class="text-3xl font-bold text-tup mb-2">Evaluar Planeación Docente (Admin)</h1>
    <p class="text-slate-500 mb-1">{docente?.nombre} {docente?.apellidos} · {asignatura?.nombre || ''} · Grupo {plan.grupo}</p>
    <a href={urlFirmada} target="_blank" class="text-sm text-tup hover:underline mb-6 inline-block">📄 Ver PDF de la planeación</a>

    <form id="form-eval" class="space-y-4">
      <input type="hidden" id="plan_id" value={plan.id} />

      {categorias.map((c, ci) => (
        <div class="bg-white rounded-2xl p-5 shadow-tarjeta">
          <p class="font-semibold text-slate-800 mb-2">{c.label}</p>
          {c.desc2 && (<p class="text-xs text-slate-500 mb-1"><b>(2) Satisfactorio:</b> {c.desc2}</p>)}
          {c.desc1 && (<p class="text-xs text-slate-500 mb-1"><b>(1) Suficiente:</b> {c.desc1}</p>)}
          {c.desc0 && (<p class="text-xs text-slate-500 mb-1"><b>(0) Insuficiente:</b> {c.desc0}</p>)}
          <div class="flex flex-wrap gap-2 mt-3 mb-3">
            {[2,1,0].map(v => (
              <label class="selection-card flex items-center gap-2 px-4 py-2 rounded-xl border border-slate-200 cursor-pointer">
                <input type="radio" name={`score_${c.id}`} value={v} required class="sr-only peer" />
                <span class="text-sm font-bold">{v}</span>
                <span class="text-[10px] text-slate-400">{v===2?'Satisfactorio':v===1?'Suficiente':'Insuficiente'}</span>
              </label>
            ))}
            <label class="selection-card selection-card--na flex items-center gap-2 px-4 py-2 rounded-xl border border-amber-300 cursor-pointer text-amber-800">
              <input type="radio" name={`score_${c.id}`} value="na" class="sr-only peer" />
              <span class="text-sm font-bold">N/A</span>
            </label>
          </div>
          <div id={`obs_${c.id}`} class="hidden space-y-4">
            <div id={`obs_items_${c.id}`} class="space-y-1.5 max-h-60 overflow-y-auto border border-slate-100 rounded-xl p-3"></div>
            <textarea name={`otros_${c.id}`} placeholder="Otros (opcional)..." rows={1} class="w-full rounded-xl border border-slate-200 px-3 py-2 text-xs resize-none"></textarea>
          </div>
        </div>
      ))}

      <div class="bg-white rounded-2xl p-5 shadow-tarjeta space-y-4">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Observaciones Generales (opcional)</label>
          <textarea id="obs_generales" rows={3} placeholder="Comentarios generales sobre la planeación..." class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm resize-none"></textarea>
        </div>
        <div class="min-w-0">
          <label id="estado-label" class="mb-1 block text-sm font-medium text-slate-700">Estado *</label>
          <input id="estado" name="estado" type="hidden" value="" />
          <button id="estado-trigger" type="button" aria-haspopup="listbox" aria-expanded="false" aria-controls="estado-listbox" aria-labelledby="estado-label estado-trigger-value" aria-describedby="estado-error" aria-invalid="false" class="w-full min-w-0 max-w-full inline-flex items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-left text-sm text-slate-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-tup focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-500">
            <span id="estado-trigger-value">Seleccionar...</span>
            <svg aria-hidden="true" class="h-4 w-4 shrink-0 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9 6 6 6-6" /></svg>
          </button>
          <p id="estado-error" class="mt-1 hidden text-xs font-medium text-red-700">Selecciona un estado.</p>
          <div id="estado-listbox" role="listbox" tabindex="-1" aria-labelledby="estado-label" aria-activedescendant="estado-option-empty" hidden class="fixed z-[70] max-h-[min(20rem,calc(100vh-1rem))] overflow-y-auto overscroll-contain rounded-xl border border-slate-200 bg-white p-1 text-sm shadow-modal focus:outline-none focus-visible:ring-2 focus-visible:ring-tup focus-visible:ring-offset-2">
            <div id="estado-option-empty" role="option" aria-selected="true" data-status-option data-value="" class="cursor-pointer rounded-lg px-3 py-3 text-slate-700 hover:bg-slate-100">Seleccionar...</div>
            <div id="estado-option-approved" role="option" aria-selected="false" data-status-option data-value="Aprobado" class="cursor-pointer rounded-lg px-3 py-3 text-slate-700 hover:bg-slate-100">Aprobado</div>
            <div id="estado-option-correction" role="option" aria-selected="false" data-status-option data-value="Corrección" class="cursor-pointer rounded-lg px-3 py-3 text-slate-700 hover:bg-slate-100">Corrección</div>
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Motivo de corrección / retroalimentación para el docente <span class="text-slate-400 font-normal">(obligatorio al enviar a corrección)</span></label>
          <textarea id="retro" rows={3} maxlength="500" placeholder="Explica los cambios que debe realizar el docente..." class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm resize-none"></textarea>
        </div>
        <button type="submit" class="w-full bg-tup text-white font-semibold py-4 rounded-xl hover:bg-tup/90">Enviar Evaluación</button>
      </div>
    </form>
    <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 hidden px-6 py-3 rounded-xl text-sm font-medium shadow-modal"></div>
  </div>
</LayoutAdmin>

<script>
  import { autoUpdate, computePosition, flip, offset, shift, size } from '@floating-ui/dom';

  const form = document.getElementById('form-eval') as HTMLFormElement;
  const input = document.getElementById('estado') as HTMLInputElement;
  const trigger = document.getElementById('estado-trigger') as HTMLButtonElement;
  const triggerValue = document.getElementById('estado-trigger-value') as HTMLElement;
  const errorMessage = document.getElementById('estado-error') as HTMLElement;
  const listbox = document.getElementById('estado-listbox') as HTMLElement;

  if (form && input && trigger && triggerValue && errorMessage && listbox) {
    const pageWindow = window as Window & { __planningEvaluationStatusControlCleanup?: () => void };
    pageWindow.__planningEvaluationStatusControlCleanup?.();

    const options = Array.from(listbox.querySelectorAll<HTMLElement>('[data-status-option]'));
    let activeIndex = 0;
    let isOpen = false;
    let cleanupAutoUpdate: (() => void) | undefined;

    // The form scroll container clips descendants; a body portal avoids that stacking context.
    document.body.appendChild(listbox);

    function selectedIndex() {
      const index = options.findIndex((option) => option.dataset.value === input.value);
      return index >= 0 ? index : 0;
    }

    function setError(hasError: boolean) {
      trigger.setAttribute('aria-invalid', String(hasError));
      trigger.classList.toggle('border-red-700', hasError);
      trigger.classList.toggle('text-red-900', hasError);
      errorMessage.classList.toggle('hidden', !hasError);
    }

    function setActive(index: number) {
      activeIndex = Math.max(0, Math.min(index, options.length - 1));
      options.forEach((option, optionIndex) => {
        const isActive = optionIndex === activeIndex;
        option.classList.toggle('ring-2', isActive);
        option.classList.toggle('ring-inset', isActive);
        option.classList.toggle('ring-tup', isActive);
      });
      listbox.setAttribute('aria-activedescendant', options[activeIndex].id);
      options[activeIndex].scrollIntoView({ block: 'nearest' });
    }

    function syncSelection() {
      const selected = selectedIndex();
      options.forEach((option, optionIndex) => {
        const isSelected = optionIndex === selected;
        option.setAttribute('aria-selected', String(isSelected));
        option.classList.toggle('bg-tup', isSelected);
        option.classList.toggle('text-white', isSelected);
        option.classList.toggle('text-slate-700', !isSelected);
      });
      triggerValue.textContent = options[selected].textContent;
      setActive(selected);
    }

    function updatePosition() {
      const viewportGutter = 8;
      const triggerWidth = trigger.getBoundingClientRect().width;
      listbox.style.width = `${Math.max(0, Math.min(triggerWidth, window.innerWidth - viewportGutter * 2))}px`;

      computePosition(trigger, listbox, {
        placement: 'bottom-start',
        strategy: 'fixed',
        middleware: [
          offset(6),
          flip({ padding: viewportGutter }),
          shift({ padding: viewportGutter }),
          size({
            padding: viewportGutter,
            apply({ availableWidth, availableHeight, elements }) {
              Object.assign(elements.floating.style, {
                maxWidth: `${Math.max(0, availableWidth)}px`,
                maxHeight: `${Math.max(0, availableHeight)}px`,
              });
            },
          }),
        ],
      }).then(({ x, y, strategy }) => {
        Object.assign(listbox.style, { left: `${x}px`, position: strategy, top: `${y}px` });
      });
    }

    function close(returnFocus: boolean) {
      if (!isOpen) return;
      isOpen = false;
      cleanupAutoUpdate?.();
      cleanupAutoUpdate = undefined;
      document.removeEventListener('pointerdown', onDocumentPointerDown);
      trigger.setAttribute('aria-expanded', 'false');
      listbox.hidden = true;
      if (returnFocus) trigger.focus();
    }

    function open(index = selectedIndex(), moveFocus = false) {
      if (!isOpen) {
        isOpen = true;
        listbox.hidden = false;
        trigger.setAttribute('aria-expanded', 'true');
        cleanupAutoUpdate = autoUpdate(trigger, listbox, updatePosition);
        document.addEventListener('pointerdown', onDocumentPointerDown);
      }
      setActive(index);
      if (moveFocus) listbox.focus();
    }

    function selectActiveOption() {
      const option = options[activeIndex];
      input.value = option.dataset.value || '';
      syncSelection();
      setError(false);
      input.dispatchEvent(new Event('change', { bubbles: true }));
      close(true);
    }

    function onDocumentPointerDown(event: PointerEvent) {
      const target = event.target;
      if (target instanceof Node && (trigger.contains(target) || listbox.contains(target))) return;
      close(false);
    }

    function onTriggerClick() { open(); }

    function onTriggerKeydown(event: KeyboardEvent) {
      if (event.key === 'Escape' && isOpen) {
        event.preventDefault();
        close(true);
        return;
      }
      if (event.key === 'Tab' && isOpen) {
        close(false);
        return;
      }
      const indexByKey: Record<string, number> = { ArrowDown: activeIndex + 1, ArrowUp: activeIndex - 1, Home: 0, End: options.length - 1 };
      if (event.key in indexByKey) {
        event.preventDefault();
        open(indexByKey[event.key], true);
        return;
      }
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        open(selectedIndex(), true);
      }
    }

    function onListboxKeydown(event: KeyboardEvent) {
      const indexByKey: Record<string, number> = { ArrowDown: activeIndex + 1, ArrowUp: activeIndex - 1, Home: 0, End: options.length - 1 };
      if (event.key in indexByKey) {
        event.preventDefault();
        setActive(indexByKey[event.key]);
        return;
      }
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        selectActiveOption();
        return;
      }
      if (event.key === 'Escape') {
        event.preventDefault();
        close(true);
        return;
      }
      if (event.key === 'Tab') {
        close(false);
      }
    }

    function onListboxClick(event: MouseEvent) {
      if (!(event.target instanceof Element)) return;
      const option = event.target.closest<HTMLElement>('[data-status-option]');
      if (!option) return;
      setActive(options.indexOf(option));
      selectActiveOption();
    }

    function onFormValidation() {
      close(false);
      setError(!input.value);
    }

    function onFormReset() {
      input.value = '';
      syncSelection();
      setError(false);
      close(false);
    }

    function teardown() {
      close(false);
      form.removeEventListener('submit', onFormValidation);
      form.removeEventListener('reset', onFormReset);
      trigger.removeEventListener('click', onTriggerClick);
      trigger.removeEventListener('keydown', onTriggerKeydown);
      listbox.removeEventListener('keydown', onListboxKeydown);
      listbox.removeEventListener('click', onListboxClick);
      window.removeEventListener('pagehide', teardown);
      document.removeEventListener('astro:before-swap', teardown);
      listbox.remove();
      if (pageWindow.__planningEvaluationStatusControlCleanup === teardown) delete pageWindow.__planningEvaluationStatusControlCleanup;
    }

    syncSelection();
    trigger.addEventListener('click', onTriggerClick);
    trigger.addEventListener('keydown', onTriggerKeydown);
    listbox.addEventListener('keydown', onListboxKeydown);
    listbox.addEventListener('click', onListboxClick);
    form.addEventListener('submit', onFormValidation);
    form.addEventListener('reset', onFormReset);
    window.addEventListener('pagehide', teardown, { once: true });
    document.addEventListener('astro:before-swap', teardown, { once: true });
    pageWindow.__planningEvaluationStatusControlCleanup = teardown;
  }
</script>

<script is:inline define:vars={{ obsData: JSON.stringify(categorias), returnUrl: `/admin/planeaciones${backSearch}` }}>
  var catData = JSON.parse(obsData);
  var scores = {};

  document.addEventListener('change', function(e) {
    var target = e.target;
    if (!target || !target.name || !target.name.startsWith('score_')) return;
    var catId = target.name.replace('score_', '');
    toggleObs(catId, target.value);
  });

  function toggleObs(catId, val) {
    var obsDiv = document.getElementById('obs_' + catId);
    var itemsDiv = document.getElementById('obs_items_' + catId);
    scores[catId] = val;
    if (val === 'na') {
      obsDiv.classList.add('hidden');
      return;
    }
    obsDiv.classList.remove('hidden');
    var cat = catData.find(function(c) { return c.id === catId; });
    if (!cat) return;
    var items = val === '2' ? cat.obs2 : val === '1' ? cat.obs1 : cat.obs0;
    itemsDiv.innerHTML = items.map(function(item, i) {
      return '<label class="selection-card flex items-start gap-2 rounded-lg border border-transparent p-2 cursor-pointer text-xs"><input type="checkbox" name="obs_' + catId + '" value="' + i + '" class="mt-0.5 accent-tup" /><span>' + item + '</span></label>';
    }).join('');
  }

  function toast(m,e){var t=document.getElementById('toast');t.textContent=m;t.className='fixed bottom-6 left-1/2 -translate-x-1/2 z-50 px-6 py-3 rounded-xl text-sm font-medium shadow-modal '+(e?'bg-red-600 text-white':'bg-emerald-600 text-white');t.classList.remove('hidden');setTimeout(function(){t.classList.add('hidden')},4000)}

  document.getElementById('form-eval').addEventListener('submit', async function(e) {
    e.preventDefault(); var btn = this.querySelector('button[type="submit"]'); btn.disabled = true; btn.textContent = 'Enviando...';
    
    var allScored = true;
    catData.forEach(function(c) {
      if (!scores[c.id]) { allScored = false; }
    });
    if (!allScored) { toast('Asigna puntuación a todas las categorías', true); btn.disabled = false; btn.textContent = 'Enviar Evaluación'; return; }
    var estado = document.getElementById('estado').value;
    var motivoCorreccion = document.getElementById('retro').value.trim();
    if (!estado) { toast('Selecciona el estado', true); btn.disabled = false; btn.textContent = 'Enviar Evaluación'; return; }
    if (estado === 'Corrección' && !motivoCorreccion) { toast('El motivo de corrección es obligatorio', true); btn.disabled = false; btn.textContent = 'Enviar Evaluación'; return; }

    var sum = 0, naCount = 0;
    catData.forEach(function(c) {
      if (scores[c.id] === 'na') { naCount++; return; }
      sum += parseInt(scores[c.id]);
    });
    var denom = 2 * (12 - naCount);
    var puntaje = denom > 0 ? Math.round((sum / denom) * 100) : 0;

    var detalle = {};
    catData.forEach(function(c) {
      detalle[c.id] = { score: scores[c.id], obs: [], otros: '' };
      var checkboxes = document.querySelectorAll('input[name="obs_' + c.id + '"]:checked');
      checkboxes.forEach(function(cb) { detalle[c.id].obs.push(parseInt(cb.value)); });
      var otrosEl = document.querySelector('textarea[name="otros_' + c.id + '"]');
      if (otrosEl && otrosEl.value.trim()) detalle[c.id].otros = otrosEl.value.trim();
    });

    var data = {
      id: parseInt(document.getElementById('plan_id').value),
      puntaje: puntaje,
      estado: estado,
      comentario_retroalimentacion: motivoCorreccion || null,
      evaluacion_detalle: detalle,
      observaciones_generales: document.getElementById('obs_generales').value.trim() || null,
      no_aplica_count: naCount
    };

    try {
      var res = await fetch('/api/coordinador/planeacion', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
      if (res.ok) { toast('Evaluación guardada — Puntaje: ' + puntaje + '%', false); setTimeout(function() { location.href = returnUrl; }, 1500); }
      else { var j = await res.json(); toast(j.error || 'Error', true); btn.disabled = false; btn.textContent = 'Enviar Evaluación'; }
    } catch(err) { toast('Error de conexión', true); btn.disabled = false; btn.textContent = 'Enviar Evaluación'; }
  });
</script>
