---
import LayoutAdmin from '../../../layouts/LayoutAdmin.astro';
import { requireRole } from '../../../lib/auth';
import { formatCancunDateTimeLocal } from '../../../lib/planningSubmissionWindow';
import { obtenerCuatrimestreActivo, obtenerCuatrimestres } from '../../../services/catalogos';

const auth = await requireRole(Astro.cookies, ['superadmin']);
const cycles = await obtenerCuatrimestres();
const activeCycle = await obtenerCuatrimestreActivo();
const requestedCycleId = Number.parseInt(Astro.url.searchParams.get('cuatrimestre') || '', 10);
const cuatrimestreId = cycles.some((cycle) => cycle.id === requestedCycleId) ? requestedCycleId : activeCycle?.id || cycles[0]?.id || 0;
const { data: windows, error } = await auth.client.rpc('planning_submission_window_admin_list');
if (error) throw error;
const window = (windows || []).find((item: any) => Number(item.cuatrimestre_id) === cuatrimestreId) as any;
const mode = window?.mode || 'manual_closed';
const qs = cuatrimestreId ? `?cuatrimestre=${cuatrimestreId}` : '';
---

<LayoutAdmin titulo="Acceso a planeaciones — Admin">
  <section class="animate-flotar-entrada mx-auto max-w-3xl">
    <a href={`/admin/planeaciones${qs}`} class="text-sm text-tup hover:underline">← Volver a evaluación de planeaciones</a>
    <div class="mt-4 mb-6"><h1 class="text-3xl font-bold text-tup">Acceso de docentes a planeaciones</h1><p class="mt-1 text-sm text-slate-500">La configuración aplica únicamente al cuatrimestre seleccionado. Sin configuración, las entregas permanecen cerradas.</p></div>
    <form method="GET" class="mb-6 flex items-center gap-3"><label class="text-sm font-medium text-slate-700" for="cycle">Cuatrimestre</label><select id="cycle" name="cuatrimestre" class="rounded-xl border border-slate-200 px-3 py-2 text-sm" onchange="this.form.submit()">{cycles.map((cycle) => <option value={cycle.id} selected={cycle.id === cuatrimestreId}>{cycle.clave}</option>)}</select></form>
    {cuatrimestreId ? <form id="planning-window-form" class="space-y-5 rounded-2xl bg-white p-6 shadow-tarjeta">
      <input type="hidden" name="cuatrimestre_id" value={cuatrimestreId} />
      <fieldset><legend class="text-sm font-semibold text-slate-800">Modalidad de recepción</legend><div class="mt-3 space-y-3 text-sm text-slate-700">
        <label class="flex items-start gap-3"><input type="radio" name="mode" value="manual_open" checked={mode === 'manual_open'} /><span><strong>Apertura manual</strong><br /><span class="text-slate-500">Los docentes pueden enviar y reenviar planeaciones.</span></span></label>
        <label class="flex items-start gap-3"><input type="radio" name="mode" value="manual_closed" checked={mode === 'manual_closed'} /><span><strong>Cierre manual</strong><br /><span class="text-slate-500">Los docentes conservan la consulta de sus PDFs y retroalimentación.</span></span></label>
        <label class="flex items-start gap-3"><input type="radio" name="mode" value="scheduled" checked={mode === 'scheduled'} /><span><strong>Ventana programada</strong><br /><span class="text-slate-500">Se abre exactamente al inicio y se cierra exactamente al final.</span></span></label>
      </div></fieldset>
      <div id="scheduled-fields" class={`grid gap-4 rounded-xl border border-slate-200 p-4 sm:grid-cols-2 ${mode === 'scheduled' ? '' : 'hidden'}`}>
        <label class="text-sm font-medium text-slate-700">Inicio<input name="opens_at" type="datetime-local" value={formatCancunDateTimeLocal(window?.opens_at)} class="mt-1 w-full rounded-xl border border-slate-200 px-3 py-2" /></label>
        <label class="text-sm font-medium text-slate-700">Cierre<input name="closes_at" type="datetime-local" value={formatCancunDateTimeLocal(window?.closes_at)} class="mt-1 w-full rounded-xl border border-slate-200 px-3 py-2" /></label>
        <p class="sm:col-span-2 text-xs text-slate-500">Las fechas se interpretan siempre en America/Cancun, sin usar la zona horaria del navegador.</p>
      </div>
      <p id="planning-window-error" class="hidden rounded-xl border border-red-200 bg-red-50 p-3 text-sm text-red-800" role="alert"></p>
      <p id="planning-window-success" class="hidden rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-800" role="status"></p>
      <button class="rounded-xl bg-tup px-5 py-2.5 text-sm font-semibold text-white">Guardar acceso</button>
    </form> : <p class="rounded-2xl bg-white p-6 text-sm text-slate-500 shadow-tarjeta">No hay cuatrimestres disponibles.</p>}
  </section>
</LayoutAdmin>

<script is:inline>
  var form = document.getElementById('planning-window-form');
  if (form) {
    var scheduled = document.getElementById('scheduled-fields'); var error = document.getElementById('planning-window-error'); var success = document.getElementById('planning-window-success');
    function updateScheduled() { scheduled.classList.toggle('hidden', !form.querySelector('input[name="mode"]:checked[value="scheduled"]')); }
    form.querySelectorAll('input[name="mode"]').forEach(function(input) { input.addEventListener('change', updateScheduled); });
    form.addEventListener('submit', async function(event) { event.preventDefault(); error.classList.add('hidden'); success.classList.add('hidden'); var data = new FormData(form); var response = await fetch('/api/admin/planeaciones/acceso', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ cuatrimestre_id: Number(data.get('cuatrimestre_id')), mode: data.get('mode'), opens_at: data.get('opens_at'), closes_at: data.get('closes_at') }) }); var result = await response.json().catch(function() { return {}; }); if (!response.ok) { error.textContent = result.error || 'No fue posible guardar la configuración.'; error.classList.remove('hidden'); return; } success.textContent = 'La configuración de acceso fue guardada.'; success.classList.remove('hidden'); });
  }
</script>
