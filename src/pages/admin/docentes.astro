---
import LayoutAdmin from '../../layouts/LayoutAdmin.astro';
import { obtenerDocentes } from '../../services/docentes';
import { obtenerClienteSuperbase } from '../../lib/supabaseClient';

const busqueda = Astro.url.searchParams.get('q') || '';
const cliente = obtenerClienteSuperbase();
const todos = await obtenerDocentes();
// Solo mostrar docentes que tienen al menos 1 grupo asignado
const { data: docsConGrupo } = await cliente.from('grupos').select('docente_id');
const docsActivos = new Set((docsConGrupo || []).map(g => g.docente_id));
const docentes = todos.filter(d => docsActivos.has(d.id));
const docentesFiltrados = busqueda
  ? docentes.filter(d => `${d.nombre} ${d.apellidos}`.toLowerCase().includes(busqueda.toLowerCase()) || d.email.toLowerCase().includes(busqueda.toLowerCase()) || (d.num_empleado || '').toLowerCase().includes(busqueda.toLowerCase()))
  : docentes;

const ids = docentes.map(d => d.id);

// Batch queries — una sola llamada por tipo de dato
const [{ data: calData }, { data: obsData }, { data: coordData }, { data: planData }, { data: diagData }, { data: eeData }] = await Promise.all([
  cliente.from('calificacion_final_docente').select('*').in('docente_id', ids).order('id', { ascending: false }),
  cliente.from('observaciones').select('docente_id, cco1,cco2,cco3,cco4,cco5,cco6,cco7,cme1,cme2,cme3,cme4,cme5,cme6,cme7,cme8,cme9,ccom1,ccom2,ccom3,ccom4,cso1,cso2,cso3,cso4,cge1,cge2,cge3,cge4,cge5,cge6,cge7,caf1,caf2,ctepe1,ctepe2,ctepe3,ctepe4,ctepe5,ctepe6,ctepe7,cno1,cno2,cno3,cno4,cno5').in('docente_id', ids).order('id', { ascending: false }),
  cliente.from('evaluacion_coordinacion').select('docente_id,score_normalizado').in('docente_id', ids).order('id', { ascending: false }),
  cliente.from('planeaciones').select('docente_id,puntaje_promedio').in('docente_id', ids).eq('estado', 'Aprobado').order('fecha_evaluacion', { ascending: false }),
  cliente.from('autodiagnosticos').select('docente_id,puntaje_total').in('docente_id', ids).order('id', { ascending: false }),
  cliente.from('encuesta_estudiantil').select('*').in('docente_id', ids).order('id', { ascending: false }),
]);

// Índices para búsqueda rápida
const calMap = new Map(); for (const c of (calData || [])) calMap.set(c.docente_id, c);
const obsMap = new Map(); for (const o of (obsData || [])) if (!obsMap.has(o.docente_id)) obsMap.set(o.docente_id, o);
const coordMap = new Map(); for (const c of (coordData || [])) if (!coordMap.has(c.docente_id)) coordMap.set(c.docente_id, c);
const planMap = new Map(); for (const p of (planData || [])) if (!planMap.has(p.docente_id)) planMap.set(p.docente_id, p);
const diagMap = new Map(); for (const d of (diagData || [])) if (!diagMap.has(d.docente_id)) diagMap.set(d.docente_id, d);
const eeMap = new Map(); for (const e of (eeData || [])) if (!eeMap.has(e.docente_id)) eeMap.set(e.docente_id, e);

function calcObs(obs: any): number {
  const r = [obs.cco1,obs.cco2,obs.cco3,obs.cco4,obs.cco5,obs.cco6,obs.cco7,obs.cme1,obs.cme2,obs.cme3,obs.cme4,obs.cme5,obs.cme6,obs.cme7,obs.cme8,obs.cme9,obs.ccom1,obs.ccom2,obs.ccom3,obs.ccom4,obs.cso1,obs.cso2,obs.cso3,obs.cso4,obs.cge1,obs.cge2,obs.cge3,obs.cge4,obs.cge5,obs.cge6,obs.cge7,obs.caf1,obs.caf2,obs.ctepe1,obs.ctepe2,obs.ctepe3,obs.ctepe4,obs.ctepe5,obs.ctepe6,obs.ctepe7,obs.cno1,obs.cno2,obs.cno3,obs.cno4,obs.cno5].filter(v=>v);
  if (r.length===0) return 0; return Math.round((r.reduce((a,b)=>a+b,0)/(r.length*5))*100);
}
function calcEE(ee: any): number {
  const todos = [ee.asi1,ee.asi2,ee.asi3,ee.asi4,ee.asi5,ee.org1,ee.org2,ee.org3,ee.org4,ee.org5,ee.act1,ee.act2,ee.act3,ee.act4,ee.act5,ee.ens1,ee.ens2,ee.ens3,ee.ens4,ee.ens5,ee.ens6,ee.dom1,ee.dom2,ee.dom3,ee.dom4,ee.dom5,ee.eva1,ee.eva2,ee.eva3,ee.eva4,ee.eva5,ee.com1,ee.com2,ee.com3,ee.com4,ee.com5,ee.ges1,ee.ges2,ee.ges3,ee.ges4,ee.ges5,ee.tec1,ee.tec2,ee.tec3,ee.tec4,ee.tec5,ee.sat1,ee.sat2,ee.sat3,ee.sat4,ee.sat5].filter(v=>v) as number[];
  if(todos.length===0)return 0; return Math.round((todos.reduce((a,b)=>a+b,0)/todos.length/5)*100);
}
function fmt(n: number|null|undefined): string { return n != null ? Math.round(n).toString() : '—'; }
function colorScore(n: number|null|undefined): string { if (!n) return 'text-slate-400'; if (n >= 80) return 'text-emerald-600'; if (n >= 60) return 'text-amber-600'; return 'text-red-600'; }
function cat360(p: number|null|undefined): string { if (!p) return '—'; if (p>=90) return 'Sobresaliente'; if (p>=80) return 'Distinguido'; if (p>=70) return 'Bueno'; if (p>=60) return 'Aprobado'; if (p>=50) return 'A mejorar'; return 'Insuficiente'; }

const filas = docentes.map(d => {
  const cal = calMap.get(d.id);
  const obs = obsMap.get(d.id);
  const coord = coordMap.get(d.id);
  const plan = planMap.get(d.id);
  const diag = diagMap.get(d.id);
  const ee = eeMap.get(d.id);
  const promObs = obs ? calcObs(obs) : 0;
  const promCoord = coord?.score_normalizado ? Math.round(coord.score_normalizado) : 0;
  const promPlan = plan?.puntaje_promedio || 0;
  const promAuto = diag?.puntaje_total ? Math.round((diag.puntaje_total/120)*100) : 0;
  const promEst = ee ? calcEE(ee) : 0;
  const pesos = [0.35,0.20,0.15,0.25,0.05];
  const disponibles = [promEst, promCoord, promPlan, promObs, promAuto];
  let final360 = 0; for (let i=0;i<5;i++) if (disponibles[i]) final360 += disponibles[i]*pesos[i];
  return { ...d, promObs, promCoord, promPlan, promAuto, promEst, final360: final360||null, cat360: cat360(Math.round(final360)) };
});

// Grupos por docente (para expandir)
const { data: gruposData } = await cliente.from('grupos').select('id,clave,docente_id,asignatura_id,modalidad,turno_grupo').in('docente_id', ids);
const grupoMap = new Map<number, any[]>(); for (const g of (gruposData || [])) { if (!grupoMap.has(g.docente_id)) grupoMap.set(g.docente_id, []); grupoMap.get(g.docente_id)!.push(g); }
const { data: asigData } = await cliente.from('asignaturas').select('id,nombre');
const asigMap = new Map<number, string>(); for (const a of (asigData || [])) asigMap.set(a.id, a.nombre);
---

<LayoutAdmin titulo="Docentes — Admin">
  <div class="animate-flotar-entrada">
    <div class="flex items-center justify-between mb-6"><h1 class="text-3xl font-bold text-tup">Docentes</h1><span class="text-sm text-slate-400">{filas.length} docentes</span></div>
    <div class="bg-white rounded-2xl p-4 shadow-tarjeta mb-6">
      <form method="GET" class="flex gap-3">
        <input type="text" name="q" value={busqueda} placeholder="Buscar por nombre, email o empleado..." class="flex-1 rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:ring-2 focus:ring-tup focus:outline-none" />
        <button type="submit" class="px-4 py-2.5 rounded-xl bg-tup text-white text-sm font-medium">Buscar</button>
        {busqueda && (<a href="/admin/docentes" class="px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-500">Limpiar</a>)}
      </form>
    </div>
    <div class="bg-white rounded-2xl shadow-tarjeta overflow-hidden overflow-x-auto">
      {filas.length === 0 ? (<div class="p-12 text-center text-slate-400">No se encontraron docentes.</div>) : (
        <table class="w-full text-[11px] whitespace-nowrap">
          <thead><tr class="bg-slate-50 border-b">
            <th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Nombre</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Email</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Campus</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Turno</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Modalidad</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Materias</th>
            <th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Cat. 360</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Final</th>
            <th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Est.</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Obs.</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Coord.</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Plan.</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Auto.</th>
          </tr></thead>
          <tbody class="divide-y">{filas.map(f => {
            const grupos = grupoMap.get(f.id) || [];
            const tieneMaterias = grupos.length > 0;
            return (
              <tr class="hover:bg-slate-50">
                <td class="px-2 py-2 text-center font-medium">{f.nombre} {f.apellidos}</td>
                <td class="px-2 py-2 text-center text-slate-600 text-[10px]">{f.email}</td>
                <td class="px-2 py-2 text-center">{f.campus || '—'}</td>
                <td class="px-2 py-2 text-center">{f.turno || '—'}</td>
                <td class="px-2 py-2 text-center">{f.modalidad || '—'}</td>
                <td class="px-2 py-2 text-center">
                  {tieneMaterias ? (
                    <button class="btn-ver-materias px-2 py-0.5 rounded-lg bg-tup/10 text-tup text-[10px] font-medium hover:bg-tup/20" data-docente-id={f.id} data-nombre={`${f.nombre} ${f.apellidos}`}>📊 Ver</button>
                  ) : (
                    <span class="text-[10px] text-slate-300">Sin materias</span>
                  )}
                </td>
                <td class="px-2 py-2 text-center"><span class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-slate-100">{f.cat360}</span></td>
                <td class="px-2 py-2 text-center font-bold {colorScore(f.final360)}">{fmt(f.final360)}</td>
                <td class="px-2 py-2 text-center {colorScore(f.promEst)}">{fmt(f.promEst)}</td>
                <td class="px-2 py-2 text-center {colorScore(f.promObs)}">{fmt(f.promObs)}</td>
                <td class="px-2 py-2 text-center {colorScore(f.promCoord)}">{fmt(f.promCoord)}</td>
                <td class="px-2 py-2 text-center {colorScore(f.promPlan)}">{fmt(f.promPlan)}</td>
                <td class="px-2 py-2 text-center {colorScore(f.promAuto)}">{fmt(f.promAuto)}</td>
              </tr>
            );
          })}</tbody>
        </table>
      )}
    </div>
  </div>

  <!-- Modal de materias -->
  <div id="modal-materias" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 backdrop-blur-sm" onclick="if(event.target===this)this.classList.add('hidden')">
    <div class="bg-white rounded-3xl p-6 shadow-modal max-w-2xl w-full mx-4 max-h-[80vh] overflow-auto animate-flotar-entrada">
      <div class="flex items-center justify-between mb-4">
        <h3 id="modal-titulo" class="text-lg font-bold text-tup"></h3>
        <button onclick="document.getElementById('modal-materias').classList.add('hidden')" class="text-slate-400 hover:text-slate-600 text-xl">&times;</button>
      </div>
      <div id="modal-contenido"></div>
    </div>
  </div>
</LayoutAdmin>

<script is:inline define:vars={{ gruposJson: JSON.stringify(Array.from(grupoMap.entries()).map(([k,v]) => [k, v])), asigJson: JSON.stringify(Object.fromEntries(asigMap)) }}>
  var gruposData = JSON.parse(gruposJson);
  var asigData = JSON.parse(asigJson);
  var grupoMap2 = new Map(gruposData);

  function verMaterias(docenteId, nombreDocente) {
    var grupos = grupoMap2.get(docenteId) || [];

    document.getElementById('modal-titulo').textContent = 'Materias — ' + nombreDocente;
    var html = '<table class="w-full text-xs"><thead><tr class="bg-slate-100"><th class="text-center px-2 py-2">Materia</th><th class="text-center px-2 py-2">Modalidad</th><th class="text-center px-2 py-2">Turno</th></tr></thead><tbody>';
    grupos.forEach(function(g) {
      html += '<tr><td class="text-center px-2 py-2 font-medium">' + (asigData[g.asignatura_id] || g.clave) + '</td><td class="text-center px-2 py-2">' + (g.modalidad || '—') + '</td><td class="text-center px-2 py-2">' + (g.turno_grupo || '—') + '</td></tr>';
    });
    html += '</tbody></table>';
    document.getElementById('modal-contenido').innerHTML = html;
    document.getElementById('modal-materias').classList.remove('hidden');
    document.getElementById('modal-materias').classList.add('flex');
  }

  // Asignar eventos a los botones después de cargar
  document.querySelectorAll('.btn-ver-materias').forEach(function(btn) {
    btn.addEventListener('click', function() {
      verMaterias(parseInt(this.dataset.docenteId), this.dataset.nombre);
    });
  });
</script>
