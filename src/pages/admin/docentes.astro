---
import LayoutAdmin from '../../layouts/LayoutAdmin.astro';
import { obtenerDocentes } from '../../services/docentes';
import { obtenerClienteSuperbase } from '../../lib/supabaseClient';

const busqueda = Astro.url.searchParams.get('q') || '';
const cliente = obtenerClienteSuperbase();
const todos = await obtenerDocentes();
const [{ data: eeIds }, { data: adIds }, { data: obsIds }, { data: coordIds }, { data: planIds }] = await Promise.all([cliente.from('encuesta_estudiantil').select('docente_id').limit(10000), cliente.from('autodiagnosticos').select('docente_id').limit(10000), cliente.from('observaciones').select('docente_id').limit(10000), cliente.from('evaluacion_coordinacion').select('docente_id').limit(10000), cliente.from('planeaciones').select('docente_id').limit(10000)]);
const docsEvaluados = new Set([...(eeIds||[]),...(adIds||[]),...(obsIds||[]),...(coordIds||[]),...(planIds||[])].map(e=>e.docente_id));
const docentes = todos.filter(d => docsEvaluados.has(d.id));
const docentesFiltrados = busqueda
  ? docentes.filter(d => `${d.nombre} ${d.apellidos}`.toLowerCase().includes(busqueda.toLowerCase()) || d.apellidos.toLowerCase().includes(busqueda.toLowerCase()) || d.email.toLowerCase().includes(busqueda.toLowerCase()))
  : docentes;

const ids = docentesFiltrados.map(d => d.id);

// Batch queries — generales
const [{ data: coordData }, { data: diagData }, { data: eeData }] = await Promise.all([
  cliente.from('evaluacion_coordinacion').select('docente_id,score_normalizado').in('docente_id', ids).order('id', { ascending: false }),
  cliente.from('autodiagnosticos').select('docente_id,puntaje_total').in('docente_id', ids).order('id', { ascending: false }),
  cliente.from('encuesta_estudiantil').select('docente_id,asignatura_id,score_normalizado').in('docente_id', ids).order('id', { ascending: false }),
]);

const coordMap = new Map(); for (const c of (coordData || [])) if (!coordMap.has(c.docente_id)) coordMap.set(c.docente_id, c);
const diagMap = new Map(); for (const d of (diagData || [])) if (!diagMap.has(d.docente_id)) diagMap.set(d.docente_id, d);

// Per-materia: Map<docente_id, Map<asignatura_id, score>>
const eePorDocente = new Map<number, Map<number, number>>();
for (const e of (eeData || [])) {
  if (!eePorDocente.has(e.docente_id)) eePorDocente.set(e.docente_id, new Map());
  eePorDocente.get(e.docente_id)!.set(e.asignatura_id, e.score_normalizado);
}

// Observaciones por docente+asignatura
const { data: obsData } = await cliente.from('observaciones').select('docente_id,asignatura_id,cco1,cco2,cco3,cco4,cco5,cco6,cco7,cme1,cme2,cme3,cme4,cme5,cme6,cme7,cme8,cme9,ccom1,ccom2,ccom3,ccom4,cso1,cso2,cso3,cso4,cge1,cge2,cge3,cge4,cge5,cge6,cge7,caf1,caf2,ctepe1,ctepe2,ctepe3,ctepe4,ctepe5,ctepe6,ctepe7,cno1,cno2,cno3,cno4,cno5').in('docente_id', ids);
// Observaciones por docente (general, no por materia)
const obsPorDocente = new Map<number, number>();
for (const o of (obsData || [])) {
  const r = [o.cco1,o.cco2,o.cco3,o.cco4,o.cco5,o.cco6,o.cco7,o.cme1,o.cme2,o.cme3,o.cme4,o.cme5,o.cme6,o.cme7,o.cme8,o.cme9,o.ccom1,o.ccom2,o.ccom3,o.ccom4,o.cso1,o.cso2,o.cso3,o.cso4,o.cge1,o.cge2,o.cge3,o.cge4,o.cge5,o.cge6,o.cge7,o.caf1,o.caf2,o.ctepe1,o.ctepe2,o.ctepe3,o.ctepe4,o.ctepe5,o.ctepe6,o.ctepe7,o.cno1,o.cno2,o.cno3,o.cno4,o.cno5].filter(v=>v);
  if (r.length === 0) continue;
  const prom = Math.round((r.reduce((a,b)=>a+b,0)/(r.length*5))*100);
  if (!obsPorDocente.has(o.docente_id)) obsPorDocente.set(o.docente_id, prom);
}

// Grupos deduplicados por docente+asignatura+clave (colapsa inserts repetidos, preserva grupos distintos)
const { data: gruposData } = await cliente.from('grupos').select('docente_id,asignatura_id,modalidad,clave').in('docente_id', ids);
const grupoMap = new Map<number, { asignatura_id: number; modalidad: string; clave_grupo: string }[]>();
const seenGrupos = new Set<string>();
for (const g of (gruposData || [])) {
  const key = `${g.docente_id}|${g.asignatura_id}|${g.clave}`;
  if (seenGrupos.has(key)) continue;
  seenGrupos.add(key);
  if (!grupoMap.has(g.docente_id)) grupoMap.set(g.docente_id, []);
  grupoMap.get(g.docente_id)!.push({ asignatura_id: g.asignatura_id, modalidad: g.modalidad || '—', clave_grupo: g.clave || '—' });
}
const { data: asigData } = await cliente.from('asignaturas').select('id,clave,nombre');
const asigMap = new Map<number, {clave:string;nombre:string}>(); for (const a of (asigData || [])) asigMap.set(a.id, a);

// Planeaciones por docente+asignatura
const { data: planData } = await cliente.from('planeaciones').select('docente_id,asignatura_id,puntaje_promedio').in('docente_id', ids).eq('estado', 'Aprobado').order('fecha_evaluacion', { ascending: false });
const planPorDocente = new Map<number, Map<number, number>>();
for (const p of (planData || [])) {
  if (!planPorDocente.has(p.docente_id)) planPorDocente.set(p.docente_id, new Map());
  if (!planPorDocente.get(p.docente_id)!.has(p.asignatura_id)) planPorDocente.get(p.docente_id)!.set(p.asignatura_id, p.puntaje_promedio);
}

function fmt(n: number|null|undefined): string { return n != null ? Math.round(n).toString() : '—'; }
function colorScore(n: number|null|undefined): string { if (!n) return ''; if (n >= 80) return 'text-emerald-600'; if (n >= 60) return 'text-amber-600'; return 'text-red-600'; }
function cat360(p: number|null|undefined): string { if (!p) return '—'; if (p>=90) return 'Sobresaliente'; if (p>=80) return 'Distinguido'; if (p>=70) return 'Bueno'; if (p>=60) return 'Aprobado'; if (p>=50) return 'A mejorar'; return 'Insuficiente'; }

// Fila principal — promedio general de todas las materias
const filas = docentesFiltrados.map(d => {
  const coord = coordMap.get(d.id);
  const diag = diagMap.get(d.id);
  const eeMap = eePorDocente.get(d.id);
  const obsDoc = obsPorDocente.get(d.id);
  const planMap2 = planPorDocente.get(d.id);
  
  // Promedios generales de todas las materias
  let sumEst = 0, sumPlan = 0, count = 0;
  const grupos = grupoMap.get(d.id) || [];
  for (const g of grupos) {
    const est = eeMap?.get(g.asignatura_id);
    const obs = obsDoc;
    const plan = planMap2?.get(g.asignatura_id);
    if (est || plan) count++;
    if (est) sumEst += est;
    if (plan) sumPlan += plan;
  }
  const promEst = count > 0 ? Math.round(sumEst / count) : 0;
  const promObs = obsDoc || 0;
  const promPlan = count > 0 ? Math.round(sumPlan / count) : 0;
  const promCoord = coord?.score_normalizado ? Math.round(coord.score_normalizado) : 0;
  const promAuto = diag?.puntaje_total ? Math.round((diag.puntaje_total/120)*100) : 0;
  const pesos = [0.35,0.20,0.15,0.25,0.05];
  const disponibles = [promEst, promCoord, promPlan, promObs, promAuto];
  let final360 = 0; for (let i=0;i<5;i++) if (disponibles[i]) final360 += disponibles[i]*pesos[i];
  return { ...d, promObs, promCoord, promPlan, promAuto, promEst, final360: final360||null, cat360: cat360(Math.round(final360)) };
});
---

<LayoutAdmin titulo="Docentes — Admin">
  <div class="animate-flotar-entrada">
    <div class="flex items-center justify-between mb-6"><h1 class="text-3xl font-bold text-tup">Docentes</h1><span class="text-sm ">{filas.length} docentes</span></div>
    <div class="bg-white rounded-2xl p-4 shadow-tarjeta mb-6">
      <form method="GET" class="flex gap-3">
        <input type="text" name="q" value={busqueda} placeholder="Buscar por nombre o email..." class="flex-1 rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:ring-2 focus:ring-tup focus:outline-none" />
        <button type="submit" class="px-4 py-2.5 rounded-xl bg-tup text-white text-sm font-medium">Buscar</button>
        {busqueda && (<a href="/admin/docentes" class="px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-500">Limpiar</a>)}
      </form>
    </div>
    <div class="bg-white rounded-2xl shadow-tarjeta overflow-hidden overflow-x-auto">
      {filas.length === 0 ? (<div class="p-12 text-center ">No se encontraron docentes.</div>) : (
        <table class="w-full text-[11px] whitespace-nowrap">
          <thead><tr class="bg-slate-50 border-b">
            <th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Nombre</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Email</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Campus</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Modalidad</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Materias</th>
            <th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Cat. 360</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Final</th>
            <th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Est.</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Obs.</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Coord.</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Plan.</th><th class="text-center px-2 py-2 text-xs uppercase text-slate-600">Auto.</th>
          </tr></thead>
          <tbody class="divide-y">{filas.map(f => {
            const grupos = grupoMap.get(f.id) || [];
            const tieneMaterias = grupos.length > 0;
            return (
              <tr class="hover:bg-slate-50">
                <td class="px-2 py-2 text-center font-medium">{f.nombre.toUpperCase()} {f.apellidos.toUpperCase()}</td>
                <td class="px-2 py-2 text-center text-slate-600 text-[10px]">{f.email}</td>
                <td class="px-2 py-2 text-center">{f.campus || '—'}</td>
                <td class="px-2 py-2 text-center">{f.modalidad || '—'}</td>
                <td class="px-2 py-2 text-center">
                  {tieneMaterias ? (
                    <button class="btn-ver-materias px-2 py-0.5 rounded-lg bg-tup/10 text-tup text-[10px] font-medium hover:bg-tup/20" data-docente-id={f.id} data-nombre={`${f.nombre} ${f.apellidos}`}>📊 Ver</button>
                  ) : (
                    <span class="text-[10px] text-slate-300">Sin materias</span>
                  )}
                </td>
                <td class="px-2 py-2 text-center"><span class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-slate-100">{f.cat360}</span></td>
                <td class="px-2 py-2 text-center font-bold {colorScore(f.final360)}">{fmt(f.final360)}</td>
                <td class="px-2 py-2 text-center {colorScore(f.promEst)}">{fmt(f.promEst)}</td>
                <td class="px-2 py-2 text-center {colorScore(f.promObs)}">{fmt(f.promObs)}</td>
                <td class="px-2 py-2 text-center {colorScore(f.promCoord)}">{fmt(f.promCoord)}</td>
                <td class="px-2 py-2 text-center {colorScore(f.promPlan)}">{fmt(f.promPlan)}</td>
                <td class="px-2 py-2 text-center {colorScore(f.promAuto)}">{fmt(f.promAuto)}</td>
              </tr>
            );
          })}</tbody>
        </table>
      )}
    </div>
  </div>

  <div id="modal-materias" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 backdrop-blur-sm" onclick="if(event.target===this)this.classList.add('hidden')">
    <div class="bg-white rounded-3xl p-6 shadow-modal max-w-4xl w-full mx-4 max-h-[80vh] overflow-auto animate-flotar-entrada">
      <div class="flex items-center justify-between mb-4"><h3 id="modal-titulo" class="text-lg font-bold text-tup"></h3><button onclick="document.getElementById('modal-materias').classList.add('hidden')" class="text-slate-400 hover:text-slate-600 text-xl">&times;</button></div>
      <div id="modal-contenido"></div>
    </div>
  </div>
</LayoutAdmin>

<script is:inline define:vars={{
  gruposJson: JSON.stringify(Array.from(grupoMap.entries()).map(([k,v]) => [k, v])),
  asigJson: JSON.stringify(Object.fromEntries(asigMap)),
  eeJson: JSON.stringify(Array.from(eePorDocente.entries()).map(([k,v]) => [k, Array.from(v.entries())])),
  obsJson: JSON.stringify(Array.from(obsPorDocente.entries())),
  planJson: JSON.stringify(Array.from(planPorDocente.entries()).map(([k,v]) => [k, Array.from(v.entries())])),
  coordJson: JSON.stringify(Array.from(coordMap.entries()).map(([k,v]) => [k, v.score_normalizado])),
  diagJson: JSON.stringify(Array.from(diagMap.entries()).map(([k,v]) => [k, v.puntaje_total]))
}}>
  var gruposData = JSON.parse(gruposJson);
  var asigData = JSON.parse(asigJson);
  var eeData2 = JSON.parse(eeJson);
  var obsData2 = JSON.parse(obsJson);
  var planData2 = JSON.parse(planJson);
  var coordData2 = JSON.parse(coordJson);
  var diagData2 = JSON.parse(diagJson);
  // Reconstruir Maps externos e internos (Map<K, Map<K,V>>)
  var grupoMap2 = new Map(gruposData);
  var eeMap2 = new Map(eeData2.map(function(e){return [e[0], new Map(e[1])];}));
  var obsMap2 = new Map(obsData2);
  var planMap2 = new Map(planData2.map(function(e){return [e[0], new Map(e[1])];}));
  var coordMap2 = new Map(coordData2);
  var diagMap2 = new Map(diagData2);

  function fmt(n){ return n != null ? Math.round(n) : '—'; }

  function verMaterias(docenteId, nombreDocente) {
    var grupos = grupoMap2.get(docenteId) || [];
    var eeDoc = eeMap2.get(docenteId);
    var obsScore = obsMap2.get(docenteId);
    var planDoc = planMap2.get(docenteId);
    var coordScore = coordMap2.get(docenteId);
    var diagScore = diagMap2.get(docenteId);
    var promCoord = coordScore ? Math.round(coordScore) : 0;
    var promAuto = diagScore ? Math.round((diagScore/120)*100) : 0;

    document.getElementById('modal-titulo').textContent = 'Materias — ' + nombreDocente;
    var html = '<table class="w-full text-[11px]"><thead><tr class="bg-slate-100"><th class="text-center px-1 py-1">Clave</th><th class="text-center px-1 py-1">Materia</th><th class="text-center px-1 py-1">Mod.</th><th class="text-center px-1 py-1">Grupos</th><th class="text-center px-1 py-1">Est.</th><th class="text-center px-1 py-1">Obs.</th><th class="text-center px-1 py-1">Plan.</th><th class="text-center px-1 py-1">Coord.</th><th class="text-center px-1 py-1">Auto.</th></tr></thead><tbody>';
    grupos.forEach(function(g) {
      var a = asigData[g.asignatura_id] || {clave: '—', nombre: '—'};
      var eeScore = eeDoc ? eeDoc.get(g.asignatura_id) : null;
      var planScore = planDoc ? planDoc.get(g.asignatura_id) : null;
      html += '<tr><td class="text-center px-1 py-1">'+a.clave+'</td><td class="text-center px-1 py-1 font-medium">'+a.nombre+'</td><td class="text-center px-1 py-1">'+(g.modalidad||'—')+'</td><td class="text-center px-1 py-1 text-[10px] text-slate-600">'+g.clave_grupo+'</td><td class="text-center px-1 py-1">'+fmt(eeScore!=null?Math.round(eeScore):null)+'</td><td class="text-center px-1 py-1">'+fmt(obsScore)+'</td><td class="text-center px-1 py-1">'+fmt(planScore)+'</td><td class="text-center px-1 py-1">'+fmt(promCoord||null)+'</td><td class="text-center px-1 py-1">'+fmt(promAuto||null)+'</td></tr>';
    });
    html += '</tbody></table>';
    document.getElementById('modal-contenido').innerHTML = html;
    document.getElementById('modal-materias').classList.remove('hidden');
    document.getElementById('modal-materias').classList.add('flex');
  }

  document.querySelectorAll('.btn-ver-materias').forEach(function(btn) {
    btn.addEventListener('click', function() {
      verMaterias(parseInt(this.dataset.docenteId), this.dataset.nombre);
    });
  });
</script>
