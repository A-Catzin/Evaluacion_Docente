---
import LayoutAdmin from '../../layouts/LayoutAdmin.astro';
import { requireRole } from '../../lib/auth';

interface AuditCompletionSummaryRow {
  docente_id: number;
  docente_nombre: string;
  asignatura_id: number;
  asignatura_nombre: string;
  grupo_id: number;
  grupo_clave: string;
  completed_count: number;
  latest_completed_at: string | null;
}

const auth = await requireRole(Astro.cookies, ['superadmin']);
const { data: cycles, error: cyclesError } = await auth.client
  .from('cuatrimestres')
  .select('id,clave,activo')
  .order('id', { ascending: false });
if (cyclesError) throw cyclesError;
const cycleList = cycles || [];
const requestedCycle = Number.parseInt(Astro.url.searchParams.get('cuatrimestre') || '', 10);
const cookieCycle = Number.parseInt(Astro.cookies.get('cuatrimestre_sel')?.value || '', 10);
const cuatrimestreId = cycleList.some((cycle) => cycle.id === requestedCycle)
  ? requestedCycle
  : cycleList.find((cycle) => cycle.activo)?.id || (cycleList.some((cycle) => cycle.id === cookieCycle) ? cookieCycle : 0);
if (Astro.url.searchParams.has('cuatrimestre') && cuatrimestreId) {
  Astro.cookies.set('cuatrimestre_sel', String(cuatrimestreId), { path: '/', maxAge: 60 * 60 * 24 * 30 });
}
const { data, error } = cuatrimestreId
  ? await auth.client.rpc('audit_completion_summary', { p_cuatrimestre_id: cuatrimestreId })
  : { data: [], error: null };
if (error) throw error;
const rows = (data || []) as AuditCompletionSummaryRow[];
const formatDate = (value: string | null) => value
  ? new Intl.DateTimeFormat('es-MX', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(value))
  : 'Sin fecha registrada';
---

<LayoutAdmin titulo="Entregas estudiantiles — Admin">
  <section class="animate-flotar-entrada mx-auto max-w-7xl">
    <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
      <div>
        <h1 class="text-3xl font-bold text-tup">Entregas de evaluación estudiantil</h1>
        <p class="mt-1 text-sm text-slate-500">Auditoría agregada por docente, asignatura y grupo. No muestra estudiantes, respuestas ni comentarios.</p>
      </div>
      <form method="GET">
        <label class="block text-xs font-semibold text-slate-500 mb-1" for="cuatrimestre">Ciclo</label>
        <select id="cuatrimestre" name="cuatrimestre" class="rounded-xl border border-slate-200 px-3 py-2 text-sm" onchange="this.form.submit()">
          {cycleList.map((cycle) => <option value={cycle.id} selected={cycle.id === cuatrimestreId}>{cycle.clave}</option>)}
        </select>
      </form>
    </div>
    {rows.length === 0 ? (
      <div class="rounded-2xl bg-white p-12 text-center text-slate-500 shadow-tarjeta">No hay entregas completadas para este ciclo.</div>
    ) : (
      <div class="overflow-x-auto rounded-2xl bg-white shadow-tarjeta">
        <table class="w-full min-w-[760px] text-sm">
          <thead><tr class="border-b bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500"><th class="px-4 py-3">Docente</th><th class="px-4 py-3">Asignatura</th><th class="px-4 py-3">Grupo</th><th class="px-4 py-3 text-right">Entregas completadas</th><th class="px-4 py-3">Última entrega</th></tr></thead>
          <tbody class="divide-y divide-slate-100">
            {rows.map((row) => <tr class="hover:bg-slate-50"><td class="px-4 py-3 font-medium text-slate-800">{row.docente_nombre}</td><td class="px-4 py-3 text-slate-700">{row.asignatura_nombre}</td><td class="px-4 py-3 text-slate-700">{row.grupo_clave}</td><td class="px-4 py-3 text-right font-semibold text-tup">{row.completed_count}</td><td class="px-4 py-3 text-slate-600">{formatDate(row.latest_completed_at)}</td></tr>)}
          </tbody>
        </table>
      </div>
    )}
  </section>
</LayoutAdmin>
