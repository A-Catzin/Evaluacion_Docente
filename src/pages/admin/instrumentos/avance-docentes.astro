---
import LayoutAdmin from '../../../layouts/LayoutAdmin.astro';
import { requireRole } from '../../../lib/auth';
import { formatPersonName } from '../../../lib/personName';
import {
  buildTeacherProgress, fetchTeacherProgress, filterTeacherProgress, parseTeacherProgressFilters,
  summarizeTeacherProgress, TEACHER_PROGRESS_STATES, type TeacherProgress,
} from '../../../lib/studentSurveyTeacherProgress';
import InactiveBadge from '../../../components/admin/InactiveBadge.astro';

const auth = await requireRole(Astro.cookies, ['superadmin']);
Astro.response.headers.set('Cache-Control', 'private, no-store');
const { data: cycles, error: cyclesError } = await auth.client
  .from('cuatrimestres')
  .select('id,clave,activo')
  .order('id', { ascending: false });
if (cyclesError) throw cyclesError;
const cycleList = cycles || [];
const requestedCycle = Number.parseInt(Astro.url.searchParams.get('cuatrimestre') || '', 10);
const cookieCycle = Number.parseInt(Astro.cookies.get('cuatrimestre_sel')?.value || '', 10);
const cuatrimestreId = (cycleList.find((c) => c.id === requestedCycle) || cycleList.find((c) => c.id === cookieCycle)
  || cycleList.find((c) => c.activo) || cycleList[0])?.id || 0;
if (Astro.url.searchParams.has('cuatrimestre') && cuatrimestreId) {
  Astro.cookies.set('cuatrimestre_sel', String(cuatrimestreId), { path: '/', maxAge: 60 * 60 * 24 * 30 });
}

const filters = parseTeacherProgressFilters(Astro.url.searchParams);
let allTeachers: TeacherProgress[] = [];
let loadError = false;
try {
  if (cuatrimestreId) allTeachers = buildTeacherProgress(await fetchTeacherProgress(auth.client, cuatrimestreId));
} catch (error) {
  loadError = true;
  console.error('[admin teacher survey progress] load failed', { message: error instanceof Error ? error.message : 'unknown' });
}
const teachers = filterTeacherProgress(allTeachers, filters);
const summary = summarizeTeacherProgress(allTeachers);

const pct = (value: number) => `${value.toLocaleString('es-MX', { maximumFractionDigits: 1 })}%`;
const barColor = (value: number) => (value >= 80 ? 'bg-emerald-500' : value >= 40 ? 'bg-amber-500' : 'bg-red-500');
---

<LayoutAdmin titulo="Avance por docente — Encuesta estudiantil">
  <section class="animate-flotar-entrada mx-auto max-w-5xl space-y-6">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold text-tup">Avance de encuesta por docente</h1>
        <p class="mt-1 text-sm text-slate-500">Cuántos estudiantes ya evaluaron a cada docente, y el detalle por materia. Solo muestra el estado de entrega, nunca respuestas.</p>
        <a href={`/admin/instrumentos/pendientes-estudiantes?cuatrimestre=${cuatrimestreId}`} class="mt-2 inline-block text-sm font-semibold text-tup hover:underline">Ver estudiantes pendientes →</a>
      </div>
      <form method="GET">
        <label class="block text-xs font-semibold text-slate-500 mb-1" for="cuatrimestre">Ciclo</label>
        <select id="cuatrimestre" name="cuatrimestre" class="rounded-xl border border-slate-200 px-3 py-2 text-sm" onchange="this.form.submit()">
          {cycleList.map((cycle) => <option value={cycle.id} selected={cycle.id === cuatrimestreId}>{cycle.clave}</option>)}
        </select>
      </form>
    </div>

    {loadError ? (
      <div role="alert" class="rounded-2xl bg-red-50 p-6 text-sm text-red-800">No se pudo cargar el avance. Verifica que la migración 125 esté aplicada e intenta nuevamente.</div>
    ) : (
      <>
        <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
          <div class="rounded-2xl bg-white p-5 shadow-tarjeta">
            <p class="text-xs font-semibold uppercase text-slate-500">Avance general</p>
            <p class="mt-1 text-2xl font-bold text-tup">{pct(summary.progress)}</p>
            <p class="text-xs text-slate-500">{summary.answered.toLocaleString('es-MX')} de {summary.eligible.toLocaleString('es-MX')} encuestas</p>
          </div>
          <div class="rounded-2xl bg-white p-5 shadow-tarjeta">
            <p class="text-xs font-semibold uppercase text-slate-500">Docentes</p>
            <p class="mt-1 text-2xl font-bold text-slate-800">{summary.teachers.toLocaleString('es-MX')}</p>
            <p class="text-xs text-slate-500">con estudiantes asignados</p>
          </div>
          <div class="rounded-2xl bg-white p-5 shadow-tarjeta">
            <p class="text-xs font-semibold uppercase text-slate-500">Sin respuestas</p>
            <p class="mt-1 text-2xl font-bold text-red-600">{summary.withoutResponses.toLocaleString('es-MX')}</p>
            <p class="text-xs text-slate-500">nadie les ha contestado</p>
          </div>
          <div class="rounded-2xl bg-white p-5 shadow-tarjeta">
            <p class="text-xs font-semibold uppercase text-slate-500">Completos</p>
            <p class="mt-1 text-2xl font-bold text-emerald-600">{summary.complete.toLocaleString('es-MX')}</p>
            <p class="text-xs text-slate-500">todos sus estudiantes respondieron</p>
          </div>
        </div>

        <form method="GET" class="grid gap-3 rounded-2xl bg-white p-5 shadow-tarjeta sm:grid-cols-3">
          <input type="hidden" name="cuatrimestre" value={cuatrimestreId} />
          <label class="text-sm text-slate-600">Buscar
            <input name="q" value={filters.q} maxlength="100" placeholder="Docente o materia" class="mt-1 block w-full rounded-xl border border-slate-200 p-2" />
          </label>
          <label class="text-sm text-slate-600">Estado
            <select name="estado" class="mt-1 block w-full rounded-xl border border-slate-200 p-2">
              {Object.entries(TEACHER_PROGRESS_STATES).map(([value, label]) => <option value={value} selected={value === filters.state}>{label}</option>)}
            </select>
          </label>
          <div class="flex items-end">
            <button type="submit" class="rounded-xl bg-tup px-4 py-2 font-semibold text-white">Filtrar</button>
          </div>
        </form>

        <p class="text-sm text-slate-500" role="status">{teachers.length.toLocaleString('es-MX')} docente(s), de menor a mayor avance</p>

        {teachers.length === 0 ? (
          <div class="rounded-2xl bg-white p-12 text-center text-slate-500 shadow-tarjeta">No hay docentes con estos filtros.</div>
        ) : (
          <div class="space-y-3">
            {teachers.map((teacher) => (
              <details class="group rounded-2xl bg-white shadow-tarjeta">
                <summary class="flex cursor-pointer list-none items-center gap-4 p-4 [&::-webkit-details-marker]:hidden">
                  <div class="min-w-0 flex-1">
                    <p class="flex flex-wrap items-center gap-2 font-semibold text-slate-800">
                      <span class="truncate">{formatPersonName(teacher.name)}</span>
                      {!teacher.active && <InactiveBadge />}
                    </p>
                    <div class="mt-2 h-2.5 w-full overflow-hidden rounded-full bg-slate-100" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow={Math.round(teacher.progress)} aria-label={`Avance de ${teacher.name}`}>
                      <div class={`h-full rounded-full ${barColor(teacher.progress)}`} style={`width:${Math.min(100, teacher.progress)}%`}></div>
                    </div>
                  </div>
                  <div class="shrink-0 text-right">
                    <p class="text-lg font-bold text-slate-800">{pct(teacher.progress)}</p>
                    <p class="text-xs text-slate-500">{teacher.answered} de {teacher.eligible}</p>
                  </div>
                  <span class="shrink-0 text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true">▾</span>
                </summary>
                <ul class="space-y-3 border-t border-slate-100 px-4 py-4">
                  {teacher.subjects.map((subject) => (
                    <li>
                      <div class="flex flex-wrap items-baseline justify-between gap-2 text-sm">
                        <p class="font-medium text-slate-700">{subject.materia}
                          <span class="ml-1 text-xs font-normal text-slate-400">{subject.groups.join(' · ')}</span>
                        </p>
                        <p class="text-slate-600"><span class="font-semibold">{subject.answered}</span> de {subject.eligible} estudiantes · {pct(subject.progress)}</p>
                      </div>
                      <div class="mt-1 h-2 w-full overflow-hidden rounded-full bg-slate-100" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow={Math.round(subject.progress)} aria-label={`Avance de ${subject.materia}`}>
                        <div class={`h-full rounded-full ${barColor(subject.progress)}`} style={`width:${Math.min(100, subject.progress)}%`}></div>
                      </div>
                    </li>
                  ))}
                </ul>
              </details>
            ))}
          </div>
        )}
      </>
    )}
  </section>
</LayoutAdmin>
