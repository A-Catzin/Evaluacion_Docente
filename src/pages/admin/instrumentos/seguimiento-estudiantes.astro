---
import LayoutAdmin from '../../../layouts/LayoutAdmin.astro';
import { requireRole } from '../../../lib/auth';
import { dbAdmin } from '../../../lib/db';
import { obtenerCuatrimestreActivo, obtenerCuatrimestres } from '../../../services/catalogos';

await requireRole(Astro.cookies, ['superadmin']);
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
const client = dbAdmin();
let cycles: Awaited<ReturnType<typeof obtenerCuatrimestres>> = [];
let active: Awaited<ReturnType<typeof obtenerCuatrimestreActivo>> = null;
let catalogError = false;
try {
  [active, cycles] = await Promise.all([obtenerCuatrimestreActivo(client), obtenerCuatrimestres(client)]);
} catch {
  catalogError = true;
}
const cycleIds = cycles.map(c => c.id);
const selected = [Number(Astro.url.searchParams.get('cuatrimestre')), Number(Astro.cookies.get('cuatrimestre_sel')?.value), active?.id, cycles[0]?.id]
  .find(id => typeof id === 'number' && cycleIds.includes(id)) || 0;
---
<LayoutAdmin titulo="Comentarios estudiantiles — Seguimiento de instrumentos">
  <section class="max-w-6xl mx-auto space-y-6">
    <header>
      <h1 class="text-3xl font-bold text-tup">Comentarios estudiantiles</h1>
      <p class="text-slate-600">Consulta exclusiva para superadmin. El texto original puede identificar a quien lo escribió aunque no se muestren identificadores. Trátalo como información confidencial.</p>
      <p class="mt-2 text-slate-600">Elige el estado de cada comentario y pulsa <strong>Guardar cambios</strong>. Solo los <strong>Validados</strong> los puede ver el docente; <strong>Pendiente</strong>, <strong>No autorizado</strong> y <strong>Sin aporte</strong> (comentarios que no aportan nada) no se muestran.</p>
    </header>
    {catalogError && <p role="alert">No se pudieron cargar los ciclos. Intenta nuevamente.</p>}
    <form id="comment-filters" method="POST" action="/api/admin/instrumentos/comentarios-estudiantiles" autocomplete="off" class="bg-white rounded-2xl p-5 grid gap-3 sm:grid-cols-2">
      <label>Ciclo<select name="cuatrimestreId" required class="block w-full border rounded-xl p-2">
        {cycles.map(c => <option value={c.id} selected={c.id === selected}>{c.clave} {c.nombre}</option>)}
      </select></label>
      <label>Buscar texto original (mínimo 2 caracteres)<input name="keyword" maxlength="100" class="block w-full border rounded-xl p-2" /></label>
      <label>Docente<input name="docente" maxlength="100" class="block w-full border rounded-xl p-2" /></label>
      <label>Grupo<input name="grupo" maxlength="100" class="block w-full border rounded-xl p-2" /></label>
      <label>Estado<select name="estado" class="block w-full border rounded-xl p-2">
        <option value="todos">Todos</option>
        <option value="pendientes" selected>Pendientes de validar</option>
        <option value="validados">Validados</option>
        <option value="no_autorizados">No autorizados</option>
        <option value="sin_aporte">Sin aporte</option>
      </select></label>
      <button type="submit" disabled={catalogError || !selected} class="rounded-xl bg-tup text-white px-4 py-2">Buscar</button>
    </form>
    <div id="comment-downloads" class="flex flex-wrap items-center gap-2 rounded-2xl bg-white p-4">
      <span class="text-sm font-medium text-slate-700">Descargar CSV del ciclo:</span>
      <a data-download="pendientes" class="rounded-lg border border-amber-300 px-3 py-1.5 text-sm font-medium text-amber-800 hover:bg-amber-50" href="#">Pendientes</a>
      <a data-download="validados" class="rounded-lg border border-emerald-300 px-3 py-1.5 text-sm font-medium text-emerald-800 hover:bg-emerald-50" href="#">Validados</a>
      <a data-download="no_autorizados" class="rounded-lg border border-red-300 px-3 py-1.5 text-sm font-medium text-red-800 hover:bg-red-50" href="#">No autorizados</a>
      <a data-download="sin_aporte" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50" href="#">Sin aporte</a>
      <a data-download="todos" class="rounded-lg bg-tup px-3 py-1.5 text-sm font-medium text-white" href="#">Todos los comentarios</a>
    </div>
    <noscript><p role="alert">Esta consulta requiere JavaScript para enviar filtros en JSON por POST. No envíes comentarios por la dirección URL.</p></noscript>
    <p id="comment-status" role="status" aria-live="polite">Preparando consulta…</p>
    <p id="comment-save-status" role="status" aria-live="polite" class="text-sm"></p>
    <div id="comment-results" class="space-y-4"></div>
    <div id="comment-actions" class="hidden sticky bottom-4 z-10 flex flex-wrap items-center gap-3 rounded-2xl bg-white p-4 shadow-tarjeta ring-1 ring-slate-200">
      <span class="text-sm font-medium text-slate-700">Marcar toda la página como:</span>
      <button type="button" data-bulk="validado" class="rounded-lg border border-emerald-300 px-3 py-1.5 text-sm font-medium text-emerald-800 hover:bg-emerald-50">Validado</button>
      <button type="button" data-bulk="no_autorizado" class="rounded-lg border border-red-300 px-3 py-1.5 text-sm font-medium text-red-800 hover:bg-red-50">No autorizado</button>
      <button type="button" data-bulk="sin_aporte" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">Sin aporte</button>
      <button type="button" data-bulk="pendiente" class="rounded-lg border border-amber-300 px-3 py-1.5 text-sm font-medium text-amber-800 hover:bg-amber-50">Pendiente</button>
      <span id="comment-selected" class="text-sm text-slate-500"></span>
      <button id="comment-validate" type="button" class="ml-auto rounded-xl bg-tup px-4 py-2 font-semibold text-white disabled:opacity-50">Guardar cambios</button>
    </div>
    <nav aria-label="Paginación de comentarios" class="flex gap-4">
      <button id="comment-prev" type="button" disabled class="rounded-xl border p-2 disabled:opacity-50">← Anterior</button>
      <button id="comment-next" type="button" disabled class="rounded-xl border p-2 disabled:opacity-50">Siguiente →</button>
    </nav>
  </section>
</LayoutAdmin>
<script>
  import { groupComments, type StudentComment } from '../../../lib/adminStudentCommentView';

  const form = document.querySelector<HTMLFormElement>('#comment-filters')!;
  const results = document.querySelector<HTMLElement>('#comment-results')!;
  const status = document.querySelector<HTMLElement>('#comment-status')!;
  const prev = document.querySelector<HTMLButtonElement>('#comment-prev')!;
  const next = document.querySelector<HTMLButtonElement>('#comment-next')!;
  const actions = document.querySelector<HTMLElement>('#comment-actions')!;
  const selectedLabel = document.querySelector<HTMLElement>('#comment-selected')!;
  const validateButton = document.querySelector<HTMLButtonElement>('#comment-validate')!;
  const saveStatus = document.querySelector<HTMLElement>('#comment-save-status')!;
  let page = 1;
  let total = 0;
  let sequence = 0;
  let controller: AbortController | undefined;
  let filters: { cuatrimestreId: number; keyword: string; docente: string; grupo: string; estado: string } | undefined;
  // Validation state as loaded, to send only the decisions that changed.
  type Review = 'pendiente' | 'validado' | 'no_autorizado' | 'sin_aporte';
  let loadedState = new Map<number, Review>();

  function cards(): HTMLElement[] {
    return [...results.querySelectorAll<HTMLElement>('[data-comment-id]')];
  }

  function currentReview(card: HTMLElement): Review {
    const picked = card.querySelector<HTMLInputElement>('input[type="radio"]:checked');
    return (picked?.value as Review | undefined) ?? 'pendiente';
  }

  function updateSelection(): void {
    const all = cards();
    const changes = all.filter(card => currentReview(card) !== loadedState.get(Number(card.dataset.commentId))).length;
    selectedLabel.textContent = `${all.length} comentario(s) en esta página · ${changes} cambio(s) sin guardar`;
    validateButton.disabled = changes === 0;
  }

  function details(label: string, className: string): { outer: HTMLDetailsElement; body: HTMLDivElement } {
    const outer = document.createElement('details');
    outer.className = className;
    outer.open = true;
    const summary = document.createElement('summary');
    summary.className = 'cursor-pointer font-semibold p-4';
    summary.textContent = label;
    const body = document.createElement('div');
    body.className = 'space-y-3 p-4 border-t';
    outer.append(summary, body);
    return { outer, body };
  }

  function render(rows: StudentComment[], current: number, count: number): void {
    results.replaceChildren();
    for (const teacher of groupComments(rows)) {
      const teacherNode = details(teacher.docente, 'bg-white rounded-2xl shadow-tarjeta');
      for (const group of teacher.groups) {
        const groupNode = details(group.grupo, 'bg-slate-50 rounded-xl');
        for (const comment of group.comments) {
          const card = document.createElement('div');
          card.className = 'flex flex-col gap-3 rounded-xl border bg-white p-4 sm:flex-row sm:items-start';
          card.dataset.commentId = String(comment.id);
          const options = document.createElement('div');
          options.className = 'flex flex-shrink-0 flex-col gap-1 text-sm';
          options.setAttribute('role', 'radiogroup');
          options.setAttribute('aria-label', 'Estado del comentario');
          for (const [value, label] of [['validado', 'Validado'], ['no_autorizado', 'No autorizado'], ['sin_aporte', 'Sin aporte'], ['pendiente', 'Pendiente']] as const) {
            const option = document.createElement('label');
            option.className = 'flex cursor-pointer items-center gap-2';
            const radio = document.createElement('input');
            radio.type = 'radio';
            radio.name = `review-${comment.id}`;
            radio.value = value;
            radio.checked = comment.estado === value;
            radio.className = 'h-4 w-4 accent-tup';
            radio.addEventListener('change', updateSelection);
            option.append(radio, document.createTextNode(label));
            options.append(option);
          }
          const content = document.createElement('div');
          content.className = 'min-w-0 flex-1';
          const text = document.createElement('p');
          text.className = 'whitespace-pre-wrap break-words';
          text.textContent = comment.comentario;
          const badge = document.createElement('span');
          const badgeStyle = {
            validado: ['bg-emerald-100 text-emerald-800', 'Validado · visible para el docente'],
            no_autorizado: ['bg-red-100 text-red-800', 'No autorizado · no visible para el docente'],
            sin_aporte: ['bg-slate-200 text-slate-700', 'Sin aporte · no visible para el docente'],
            pendiente: ['bg-amber-100 text-amber-800', 'Pendiente · no visible para el docente'],
          }[comment.estado];
          badge.className = `mt-2 inline-block rounded-full px-2 py-0.5 text-xs font-semibold ${badgeStyle[0]}`;
          badge.textContent = badgeStyle[1];
          content.append(text, badge);
          card.append(options, content);
          groupNode.body.append(card);
        }
        teacherNode.body.append(groupNode.outer);
      }
      results.append(teacherNode.outer);
    }
    status.textContent = rows.length
      ? `${rows.length} comentario(s) en esta página · Página ${current} de ${Math.max(1, Math.ceil(count / 20))}.`
      : `No hay comentarios en esta página. Página ${current} de ${Math.max(1, Math.ceil(count / 20))}.`;
    prev.disabled = current <= 1;
    next.disabled = current * 20 >= count || current >= 10000;
    loadedState = new Map(rows.map(row => [row.id, row.estado]));
    actions.classList.toggle('hidden', rows.length === 0);
    updateSelection();
  }

  async function load(requestedPage: number): Promise<void> {
    if (!filters) return;
    controller?.abort();
    controller = new AbortController();
    const requestId = ++sequence;
    prev.disabled = next.disabled = true;
    results.replaceChildren();
    actions.classList.add('hidden');
    status.textContent = 'Cargando comentarios…';
    try {
      const response = await fetch('/api/admin/instrumentos/comentarios-estudiantiles', {
        method: 'POST', credentials: 'same-origin', cache: 'no-store',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...filters, page: requestedPage }), signal: controller.signal,
      });
      if (!response.ok) throw new Error('request');
      const data: unknown = await response.json();
      if (!data || typeof data !== 'object') throw new Error('response');
      const result = data as { comentarios?: unknown; total?: unknown; page?: unknown };
      if (!Array.isArray(result.comentarios) || typeof result.total !== 'number' || result.page !== requestedPage ||
          !Number.isSafeInteger(result.total) || result.total < 0 || result.comentarios.length > 20 ||
          !result.comentarios.every((row: unknown) => {
            if (!row || typeof row !== 'object') return false;
            const c = row as Record<string, unknown>;
            return Number.isSafeInteger(c.id) && Number.isSafeInteger(c.docenteId) && Number.isSafeInteger(c.grupoId) &&
              typeof c.docente === 'string' && typeof c.grupo === 'string' && typeof c.comentario === 'string' &&
              typeof c.validado === 'boolean' && (c.estado === 'pendiente' || c.estado === 'validado' || c.estado === 'no_autorizado' || c.estado === 'sin_aporte');
          })) throw new Error('response');
      if (requestId !== sequence) return;
      page = requestedPage;
      total = result.total;
      render(result.comentarios as StudentComment[], page, total);
    } catch {
      if (requestId !== sequence) return;
      status.textContent = 'No se pudieron cargar los comentarios. Intenta nuevamente.';
      prev.disabled = next.disabled = true;
    }
  }

  // Downloads follow the selected cycle; they ignore the text filters and the page.
  const downloads = [...document.querySelectorAll<HTMLAnchorElement>('[data-download]')];
  function updateDownloads(): void {
    const cycle = Number(new FormData(form).get('cuatrimestreId'));
    for (const link of downloads) {
      link.href = `/api/admin/instrumentos/comentarios-estudiantiles.csv?cuatrimestre=${cycle}&estado=${link.dataset.download}`;
      link.setAttribute('download', '');
    }
  }
  form.querySelector('select[name="cuatrimestreId"]')?.addEventListener('change', updateDownloads);
  updateDownloads();

  form.addEventListener('submit', event => {
    event.preventDefault();
    const data = new FormData(form);
    const keyword = String(data.get('keyword') || '').trim();
    if (keyword.length === 1) {
      controller?.abort();
      ++sequence;
      filters = undefined;
      page = 1;
      total = 0;
      results.replaceChildren();
      prev.disabled = next.disabled = true;
      status.textContent = 'Escribe al menos 2 caracteres para buscar texto.';
      return;
    }
    filters = { cuatrimestreId: Number(data.get('cuatrimestreId')), keyword,
      docente: String(data.get('docente') || '').trim(), grupo: String(data.get('grupo') || '').trim(),
      estado: String(data.get('estado') || 'todos') };
    saveStatus.textContent = '';
    void load(1);
  });
  actions.querySelectorAll<HTMLButtonElement>('[data-bulk]').forEach(button => {
    button.addEventListener('click', () => {
      for (const card of cards()) {
        const radio = card.querySelector<HTMLInputElement>(`input[type="radio"][value="${button.dataset.bulk}"]`);
        if (radio) radio.checked = true;
      }
      updateSelection();
    });
  });

  validateButton.addEventListener('click', async () => {
    if (!filters) return;
    const changed = cards()
      .map(card => ({ id: Number(card.dataset.commentId), review: currentReview(card) }))
      .filter(item => item.review !== loadedState.get(item.id));
    const ids = (review: Review) => changed.filter(item => item.review === review).map(item => item.id);
    const validar = ids('validado');
    const rechazar = ids('no_autorizado');
    const sinAporte = ids('sin_aporte');
    const quitar = ids('pendiente');
    if (!validar.length && !rechazar.length && !sinAporte.length && !quitar.length) return;
    validateButton.disabled = true;
    saveStatus.className = 'text-sm text-slate-600';
    saveStatus.textContent = 'Guardando cambios…';
    try {
      const response = await fetch('/api/admin/instrumentos/comentarios-estudiantiles', {
        method: 'PATCH', credentials: 'same-origin', cache: 'no-store',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ cuatrimestreId: filters.cuatrimestreId, validar, quitar, rechazar, sinAporte }),
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error('save');
      const result = data as { validados?: number; retirados?: number; no_autorizados?: number; sin_aporte?: number };
      saveStatus.className = 'text-sm text-emerald-700';
      saveStatus.textContent = `Listo: ${result.validados ?? 0} validado(s), ${result.no_autorizados ?? 0} no autorizado(s), ${result.sin_aporte ?? 0} sin aporte y ${result.retirados ?? 0} devuelto(s) a pendiente.`;
      await load(page);
      // With a state filter the saved comments leave the list; step back if this page emptied.
      if (page > 1 && (page - 1) * 20 >= total) await load(page - 1);
    } catch {
      saveStatus.className = 'text-sm text-red-700';
      saveStatus.textContent = 'No se pudieron guardar los cambios. Intenta nuevamente.';
      updateSelection();
    }
  });

  prev.addEventListener('click', () => { if (page > 1) void load(page - 1); });
  next.addEventListener('click', () => { if (page * 20 < total && page < 10000) void load(page + 1); });
  if (form.querySelector('select')?.value) form.requestSubmit();
  else status.textContent = 'No hay ciclos disponibles para consultar.';
</script>
