---
import LayoutDocente from '../../layouts/LayoutDocente.astro';
import { requireRole } from '../../lib/auth';

type TeacherActivity = {
  occurred_at: string;
  instrument: string;
};

const params = Astro.url.searchParams;
const isoDate = (value: string | null, end = false) => /^\d{4}-\d{2}-\d{2}$/.test(value || '')
  ? `${value}${end ? 'T23:59:59.999Z' : 'T00:00:00.000Z'}`
  : null;
const from = params.get('desde') || '';
const to = params.get('hasta') || '';
let events: TeacherActivity[] = [];
let errorMessage = '';
try {
  const auth = await requireRole(Astro.cookies, ['docente']);
  const { data, error } = await auth.client.rpc('audit_list_my_activity', {
    p_from: isoDate(from), p_to: isoDate(to, true), p_limit: 100,
  });
  if (error) throw error;
  events = (data || []) as TeacherActivity[];
} catch (error) {
  errorMessage = 'No se pudo consultar tu actividad. Intenta nuevamente más tarde.';
}

const formatDate = (value: string) => new Intl.DateTimeFormat('es-MX', {
  dateStyle: 'medium', timeStyle: 'short', timeZone: 'America/Cancun',
}).format(new Date(value));
---

<LayoutDocente titulo="Mi actividad — Docente">
  <div class="animate-flotar-entrada max-w-4xl mx-auto">
    <div class="mb-6">
      <h1 class="text-3xl font-bold text-slate-800 mb-2">Mi actividad</h1>
      <p class="text-slate-500">Consulta las actividades que has completado.</p>
    </div>

    {errorMessage ? (
      <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">{errorMessage}</div>
    ) : events.length === 0 ? (
      <div class="rounded-2xl bg-white p-12 text-center shadow-tarjeta">
        <p class="font-medium text-slate-700">Aún no tienes actividades registradas.</p>
        <p class="mt-1 text-sm text-slate-400">Las actividades completadas aparecerán aquí.</p>
      </div>
    ) : (
      <div class="overflow-x-auto rounded-2xl bg-white shadow-tarjeta">
        <table class="w-full min-w-[560px] text-sm">
          <thead>
            <tr class="border-b bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
              <th class="px-5 py-3">Fecha</th>
              <th class="px-5 py-3">Actividad</th>
              <th class="px-5 py-3">Estado</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {events.map((event) => (
              <tr class="hover:bg-slate-50">
                <td class="whitespace-nowrap px-5 py-4 text-slate-600">{formatDate(event.occurred_at)}</td>
                <td class="px-5 py-4 font-medium text-slate-700">{event.instrument}</td>
                <td class="px-5 py-4"><span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700">Completado</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</LayoutDocente>
