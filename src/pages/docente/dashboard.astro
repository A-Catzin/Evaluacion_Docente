---
import LayoutDocente from '../../layouts/LayoutDocente.astro';
import { obtenerCuatrimestreActivo } from '../../services/catalogos';
import { obtenerClienteSuperbase } from '../../lib/supabaseClient';

const token = Astro.cookies.get('sb-access-token')?.value;
const refresh = Astro.cookies.get('sb-refresh-token')?.value;
if (!token || !refresh) return Astro.redirect('/auth');

const cl = obtenerClienteSuperbase();
const { data: sesion } = await cl.auth.setSession({ access_token: token, refresh_token: refresh });
if (!sesion.user) return Astro.redirect('/auth');

const { data: usuario } = await cl.from('usuarios').select('entidad_id,email').eq('id', sesion.user.id).maybeSingle();
let docenteId = usuario?.entidad_id;
let docenteEmail = usuario?.email || '';

// Buscar todos los docentes que corresponden a este usuario (por entidad_id, email, y nombre)
let docenteIdsSet = new Set<number>();
if (docenteId) {
  docenteIdsSet.add(docenteId);
  // Obtener nombre del docente vinculado para buscar coincidencias por nombre
  const { data: miDoc } = await cl.from('docentes').select('nombre,apellidos').eq('id', docenteId).maybeSingle();
  if (miDoc?.nombre && miDoc?.apellidos) {
    const { data: mismosNombres } = await cl.from('docentes').select('id').eq('nombre', miDoc.nombre).eq('apellidos', miDoc.apellidos);
    (mismosNombres||[]).forEach(d => docenteIdsSet.add(d.id));
  }
}
if (docenteEmail) {
  const { data: docsMatch } = await cl.from('docentes').select('id').eq('email', docenteEmail);
  (docsMatch||[]).forEach(d => docenteIdsSet.add(d.id));
}
const docenteIds: number[] = [...docenteIdsSet];

const cuatrimestre = await obtenerCuatrimestreActivo();

let scores = { promEst: 0, promCoord: 0, promPlan: 0, promObs: 0, promAuto: 0, final360: null as number|null, cat360: 'No iniciado', instrumentos: 0 };
let nombreDocente = '';
let diagInfo: any = null;
let eeComentarios: string[] = [];
let coordInfo: any = null;
let planFeedback: any[] = [];
let obsInfo: any = null;

if (docenteIds.length > 0) {
  const { data: doc } = await cl.from('docentes').select('nombre,apellidos').eq('id', docenteIds[0]).maybeSingle();
  if (doc) nombreDocente = `${doc.nombre.toUpperCase()} ${doc.apellidos.toUpperCase()}`;

  const [{ data: eeData }, { data: coordData }, { data: planData }, { data: obsData }, { data: diagData }, { data: matData }] = await Promise.all([
    cl.from('encuesta_estudiantil').select('score_normalizado,comentarios').in('docente_id', docenteIds),
    cl.from('evaluacion_coordinacion').select('score_normalizado,categoria,comentarios,puntos_obtenidos').in('docente_id', docenteIds).order('id', { ascending: false }).limit(1),
    cl.from('planeaciones').select('puntaje_promedio,comentario_retroalimentacion,estado,observaciones_generales,evaluacion_detalle').in('docente_id', docenteIds).order('fecha_subida', { ascending: false }),
    cl.from('observaciones').select('id,docente_id,cco1,cco2,cco3,cco4,cco5,cco6,cco7,cme1,cme2,cme3,cme4,cme5,cme6,cme7,cme8,cme9,ccom1,ccom2,ccom3,ccom4,cso1,cso2,cso3,cso4,cge1,cge2,cge3,cge4,cge5,cge6,cge7,caf1,caf2,ctepe1,ctepe2,ctepe3,ctepe4,ctepe5,ctepe6,ctepe7,cno1,cno2,cno3,cno4,cno5,comentario_evaluador,comentario_docente,obs_cognitivas,obs_metacognitivas,obs_comunicativas,obs_sociales,obs_gestion,obs_afectivas,obs_tecno,obs_normativa,fecha_observacion').in('docente_id', docenteIds),
    cl.from('autodiagnosticos').select('*').in('docente_id', docenteIds).order('id', { ascending: false }).limit(1),
    cl.from('grupos').select('asignatura_id').in('docente_id', docenteIds),
  ]);

  // Feedback
  eeComentarios = (eeData||[]).filter(e=>e.comentarios).map(e=>e.comentarios);
  coordInfo = coordData?.[0] || null;
  planFeedback = (planData||[]).filter(p=>p.comentario_retroalimentacion || p.observaciones_generales || p.evaluacion_detalle);
  obsInfo = obsData?.[0] || null;
  diagInfo = diagData?.[0] || null;

  // EE promedio
  const eeScores = (eeData||[]).map(e=>e.score_normalizado).filter(v=>v);
  scores.promEst = eeScores.length ? Math.round(eeScores.reduce((a,b)=>a+b,0)/eeScores.length) : 0;

  // Coord
  scores.promCoord = coordData?.[0]?.score_normalizado ? Math.round(coordData[0].score_normalizado) : 0;

  // Plan promedio
  const planScores = (planData||[]).map(p=>p.puntaje_promedio).filter(v=>v);
  scores.promPlan = planScores.length ? Math.round(planScores.reduce((a,b)=>a+b,0)/planScores.length) : 0;

  // Obs promedio
  const obsScores: number[] = [];
  for (const o of (obsData||[])) {
    const r = [o.cco1,o.cco2,o.cco3,o.cco4,o.cco5,o.cco6,o.cco7,o.cme1,o.cme2,o.cme3,o.cme4,o.cme5,o.cme6,o.cme7,o.cme8,o.cme9,o.ccom1,o.ccom2,o.ccom3,o.ccom4,o.cso1,o.cso2,o.cso3,o.cso4,o.cge1,o.cge2,o.cge3,o.cge4,o.cge5,o.cge6,o.cge7,o.caf1,o.caf2,o.ctepe1,o.ctepe2,o.ctepe3,o.ctepe4,o.ctepe5,o.ctepe6,o.ctepe7,o.cno1,o.cno2,o.cno3,o.cno4,o.cno5].filter(v=>v);
    if (r.length) obsScores.push(Math.round((r.reduce((a,b)=>a+b,0)/(r.length*5))*100));
  }
  scores.promObs = obsScores.length ? Math.round(obsScores.reduce((a,b)=>a+b,0)/obsScores.length) : 0;

  // Auto
  scores.promAuto = diagData?.[0]?.puntaje_total ? Math.round((diagData[0].puntaje_total/120)*100) : 0;

  // Final 360
  const disp = [scores.promEst, scores.promCoord, scores.promPlan, scores.promObs, scores.promAuto];
  const pesos = [0.35,0.20,0.15,0.25,0.05];
  let fin = 0; for (let i=0;i<5;i++) if (disp[i]) fin += disp[i]*pesos[i];
  scores.final360 = fin || null;
  scores.instrumentos = disp.filter(v=>v>0).length;
  scores.cat360 = scores.instrumentos===5 ? (fin>=90?'Sobresaliente':fin>=80?'Distinguido':fin>=70?'Bueno':fin>=60?'Aprobado':fin>=50?'A mejorar':'Insuficiente') : fin>0 ? 'Parcial' : 'No iniciado';
}

function fmt(n:number|null|undefined):string{return n!=null ? Math.round(n).toString() : '—';}
function colorN(n:number|null|undefined):string{return !n?'':n>=80?'text-emerald-600':n>=60?'text-amber-600':'text-red-600';}
---

<LayoutDocente titulo="Mi Evaluación — Docente">
  <div class="animate-flotar-entrada">
    <div class="flex items-center justify-between mb-6">
      <div><h1 class="text-3xl font-bold text-tup">Mi Evaluación 360°</h1><p class="text-slate-500">{nombreDocente}</p></div>
      <span class="text-xs ">{cuatrimestre?.nombre || ''}</span>
    </div>

    {docenteIds.length === 0 ? (
      <div class="bg-white rounded-2xl p-6 shadow-tarjeta text-center ">Completa tu autodiagnóstico para ver tus resultados.</div>
    ) : (
      <>
        <!-- KPIs -->
        <div class="grid grid-cols-2 lg:grid-cols-5 gap-4 mb-8">
          <div class="bg-white rounded-2xl p-4 shadow-tarjeta text-center">
            <p class="text-xs text-slate-400 uppercase">Estudiantil</p>
            <p class={`text-2xl font-bold mt-1 ${colorN(scores.promEst)}`}>{fmt(scores.promEst)}</p>
          </div>
          <div class="bg-white rounded-2xl p-4 shadow-tarjeta text-center">
            <p class="text-xs text-slate-400 uppercase">Coordinación</p>
            <p class={`text-2xl font-bold mt-1 ${colorN(scores.promCoord)}`}>{fmt(scores.promCoord)}</p>
          </div>
          <div class="bg-white rounded-2xl p-4 shadow-tarjeta text-center">
            <p class="text-xs text-slate-400 uppercase">Planeación</p>
            <p class={`text-2xl font-bold mt-1 ${colorN(scores.promPlan)}`}>{fmt(scores.promPlan)}</p>
          </div>
          <div class="bg-white rounded-2xl p-4 shadow-tarjeta text-center">
            <p class="text-xs text-slate-400 uppercase">Observación</p>
            <p class={`text-2xl font-bold mt-1 ${colorN(scores.promObs)}`}>{fmt(scores.promObs)}</p>
          </div>
          <div class="bg-white rounded-2xl p-4 shadow-tarjeta text-center">
            <p class="text-xs text-slate-400 uppercase">Autodiagnóstico</p>
            <p class={`text-2xl font-bold mt-1 ${colorN(scores.promAuto)}`}>{fmt(scores.promAuto)}</p>
          </div>
        </div>

        <!-- Gráfico + Final -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
          <div class="lg:col-span-2 bg-white rounded-2xl p-6 shadow-tarjeta">
            <h3 class="text-sm font-semibold text-slate-700 mb-4">Mis Scores por Instrumento</h3>
            <div style="max-height:220px"><canvas id="chart-docente" style="max-height:220px"></canvas></div>
          </div>
          <div class="bg-white rounded-2xl p-6 shadow-tarjeta flex flex-col items-center justify-center text-center">
            <p class="text-xs text-slate-400 uppercase mb-2">Calificación Final</p>
            <p class="text-5xl font-bold text-tup">{fmt(scores.final360)}</p>
            <span class="px-2 py-1 rounded text-xs font-medium bg-slate-100 mt-2">{scores.cat360}</span>
            <p class="text-xs text-slate-400 mt-3">{scores.instrumentos}/5 instrumentos</p>
          </div>
        </div>
      </>
    )}

    <!-- Retroalimentación -->
    {docenteIds.length > 0 && (
      <div class="mb-8">
        <h2 class="text-lg font-bold text-slate-700 mb-4">📋 Retroalimentación de tus Evaluaciones</h2>
        <div class="space-y-4">
          <!-- Autodiagnóstico -->
          {diagInfo && (
            <details class="bg-white rounded-2xl shadow-tarjeta group overflow-hidden" open>
              <summary class="font-semibold text-tup cursor-pointer list-none flex items-center justify-between px-5 py-4 hover:bg-slate-50 transition-colors">
                <div class="flex items-center gap-3">
                  <span class="w-10 h-10 rounded-xl bg-purple-100 flex items-center justify-center text-lg">🧪</span>
                  <div><p class="text-sm">Autodiagnóstico Docente</p><p class="text-xs text-slate-400 font-normal">{diagInfo.nivel_desempeno || 'Completado'}</p></div>
                </div>
                <span class="text-xs text-slate-400 group-open:hidden">▼</span><span class="text-xs text-slate-400 hidden group-open:inline">▲</span>
              </summary>
              <div class="px-5 pb-5 space-y-4 border-t border-slate-100 pt-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div class="bg-gradient-to-br from-purple-50 to-purple-100/50 rounded-xl p-4 text-center">
                    <p class="text-xs text-purple-500 uppercase font-medium">Nivel de Desempeño</p>
                    <p class="text-2xl font-bold text-purple-700 mt-1">{diagInfo.nivel_desempeno || '—'}</p>
                  </div>
                  <div class="bg-gradient-to-br from-slate-50 to-slate-100/50 rounded-xl p-4 text-center">
                    <p class="text-xs text-slate-500 uppercase font-medium">Puntaje Total</p>
                    <p class="text-2xl font-bold text-slate-700 mt-1">{Math.round((diagInfo.puntaje_total||0)/120*100)}%</p>
                  </div>
                </div>
                {diagInfo.comentarios && (
                  <div class="bg-slate-50 rounded-xl p-4 border border-slate-100">
                    <p class="text-xs font-medium text-slate-400 uppercase mb-1">Reflexión Personal</p>
                    <p class="text-sm text-slate-600 italic">"{diagInfo.comentarios}"</p>
                  </div>
                )}
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2">
                  {[diagInfo.r1,diagInfo.r2,diagInfo.r3,diagInfo.r4,diagInfo.r5,diagInfo.r6,diagInfo.r7,diagInfo.r8,diagInfo.r9,diagInfo.r10,diagInfo.r11,diagInfo.r12,diagInfo.r13,diagInfo.r14,diagInfo.r15,diagInfo.r16,diagInfo.r17,diagInfo.r18,diagInfo.r19,diagInfo.r20,diagInfo.r21,diagInfo.r22,diagInfo.r23,diagInfo.r24].map((v,i)=>(
                    <div class={`rounded-lg px-3 py-2 text-xs font-medium text-center ${v>=4?'bg-emerald-50 text-emerald-700':v>=3?'bg-amber-50 text-amber-700':v>=1?'bg-red-50 text-red-600':'bg-slate-50 text-slate-400'}`}>
                      P{i+1}: {v||'—'}
                    </div>
                  ))}
                </div>
              </div>
            </details>
          )}
          <!-- Coordinación -->
          {coordInfo && (
            <details class="bg-white rounded-2xl shadow-tarjeta group overflow-hidden">
              <summary class="font-semibold text-tup cursor-pointer list-none flex items-center justify-between px-5 py-4 hover:bg-slate-50 transition-colors">
                <div class="flex items-center gap-3">
                  <span class="w-10 h-10 rounded-xl bg-blue-100 flex items-center justify-center text-lg">📋</span>
                  <div><p class="text-sm">Coordinación Académica</p><p class="text-xs text-slate-400 font-normal">{coordInfo.categoria || 'Evaluado'}</p></div>
                </div>
                <span class="text-xs text-slate-400 group-open:hidden">▼</span><span class="text-xs text-slate-400 hidden group-open:inline">▲</span>
              </summary>
              <div class="px-5 pb-5 space-y-4 border-t border-slate-100 pt-4">
                <div class="grid grid-cols-2 gap-4">
                  <div class="bg-gradient-to-br from-blue-50 to-blue-100/50 rounded-xl p-4 text-center">
                    <p class="text-xs text-blue-500 uppercase font-medium">Categoría</p>
                    <p class="text-xl font-bold text-blue-700 mt-1">{coordInfo.categoria || '—'}</p>
                  </div>
                  <div class="bg-gradient-to-br from-slate-50 to-slate-100/50 rounded-xl p-4 text-center">
                    <p class="text-xs text-slate-500 uppercase font-medium">Puntuación</p>
                    <p class="text-xl font-bold text-slate-700 mt-1">{coordInfo.puntos_obtenidos || '—'}<span class="text-sm font-normal text-slate-400">/75</span></p>
                  </div>
                </div>
                {coordInfo.comentarios && (
                  <div class="bg-slate-50 rounded-xl p-4 border border-slate-100">
                    <p class="text-xs font-medium text-slate-400 uppercase mb-1">Observaciones</p>
                    <p class="text-sm text-slate-600 italic">"{coordInfo.comentarios}"</p>
                  </div>
                )}
              </div>
            </details>
          )}
          <!-- Observación -->
          {obsInfo && (
            <details class="bg-white rounded-2xl shadow-tarjeta group overflow-hidden" open>
              <summary class="font-semibold text-tup cursor-pointer list-none flex items-center justify-between px-5 py-4 hover:bg-slate-50 transition-colors">
                <div class="flex items-center gap-3">
                  <span class="w-10 h-10 rounded-xl bg-teal-100 flex items-center justify-center text-lg">👁️</span>
                  <div><p class="text-sm">Observación de Clase</p><p class="text-xs text-slate-400 font-normal">{obsInfo.fecha_observacion || ''}</p></div>
                </div>
                <span class="text-xs text-slate-400 group-open:hidden">▼</span><span class="text-xs text-slate-400 hidden group-open:inline">▲</span>
              </summary>
              <div class="px-5 pb-5 space-y-4 border-t border-slate-100 pt-4">
                {obsInfo.comentario_evaluador && (
                  <div class="bg-slate-50 rounded-xl p-4 border border-slate-100">
                    <p class="text-xs font-medium text-slate-400 uppercase mb-1">Comentario del Evaluador</p>
                    <p class="text-sm text-slate-600 italic">"{obsInfo.comentario_evaluador}"</p>
                  </div>
                )}
                {obsInfo.comentario_docente && (
                  <div class="bg-slate-50 rounded-xl p-4 border border-slate-100">
                    <p class="text-xs font-medium text-slate-400 uppercase mb-1">Comentario del Docente</p>
                    <p class="text-sm text-slate-600 italic">"{obsInfo.comentario_docente}"</p>
                  </div>
                )}
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                  {(()=>{
                    const sections = [
                      {label:'🧠 Cognitiva',keys:['cco1','cco2','cco3','cco4','cco5','cco6','cco7']},
                      {label:'🔄 Metacognitiva',keys:['cme1','cme2','cme3','cme4','cme5','cme6','cme7','cme8','cme9']},
                      {label:'💬 Comunicativa',keys:['ccom1','ccom2','ccom3','ccom4']},
                      {label:'👥 Social',keys:['cso1','cso2','cso3','cso4']},
                      {label:'📊 Gestión',keys:['cge1','cge2','cge3','cge4','cge5','cge6','cge7']},
                      {label:'❤️ Afectiva',keys:['caf1','caf2']},
                      {label:'💻 Tecno-pedagógica',keys:['ctepe1','ctepe2','ctepe3','ctepe4','ctepe5','ctepe6','ctepe7']},
                      {label:'📏 Normativa',keys:['cno1','cno2','cno3','cno4','cno5']}
                    ];
                    return sections.map(s => {
                      const vals = s.keys.map(k => obsInfo[k]).filter(v=>v!=null);
                      if (vals.length===0) return null;
                      return <div class="bg-slate-50 rounded-lg px-3 py-2 text-center"><p class="text-xs text-slate-400">{s.label}</p><p class="text-sm font-medium text-slate-700">{vals.join(' · ')}</p></div>;
                    });
                  })()}
                </div>
                <div class="grid grid-cols-1 gap-1 text-xs text-slate-500">
                  {obsInfo.obs_cognitivas && <span><b>🧠 Cognitiva:</b> {obsInfo.obs_cognitivas}</span>}
                  {obsInfo.obs_metacognitivas && <span><b>🔄 Metacognitiva:</b> {obsInfo.obs_metacognitivas}</span>}
                  {obsInfo.obs_comunicativas && <span><b>💬 Comunicativa:</b> {obsInfo.obs_comunicativas}</span>}
                  {obsInfo.obs_sociales && <span><b>👥 Social:</b> {obsInfo.obs_sociales}</span>}
                  {obsInfo.obs_gestion && <span><b>📊 Gestión:</b> {obsInfo.obs_gestion}</span>}
                  {obsInfo.obs_afectivas && <span><b>❤️ Afectiva:</b> {obsInfo.obs_afectivas}</span>}
                  {obsInfo.obs_tecno && <span><b>💻 Tecno-pedagógica:</b> {obsInfo.obs_tecno}</span>}
                  {obsInfo.obs_normativa && <span><b>📏 Normativa:</b> {obsInfo.obs_normativa}</span>}
                </div>
              </div>
            </details>
          )}
          <!-- Planeación -->
          {planFeedback.length > 0 && (
            <details class="bg-white rounded-2xl shadow-tarjeta group overflow-hidden">
              <summary class="font-semibold text-tup cursor-pointer list-none flex items-center justify-between px-5 py-4 hover:bg-slate-50 transition-colors">
                <div class="flex items-center gap-3">
                  <span class="w-10 h-10 rounded-xl bg-amber-100 flex items-center justify-center text-lg">📄</span>
                  <div><p class="text-sm">Planeación Didáctica</p><p class="text-xs text-slate-400 font-normal">{planFeedback.length} evaluación{planFeedback.length>1?'es':''}</p></div>
                </div>
                <span class="text-xs text-slate-400 group-open:hidden">▼</span><span class="text-xs text-slate-400 hidden group-open:inline">▲</span>
              </summary>
              <div class="px-5 pb-5 space-y-4 border-t border-slate-100 pt-4">
                {planFeedback.map((p,i)=>(
                  <div class="bg-slate-50 rounded-xl p-4 border border-slate-100">
                    <div class="flex items-center justify-between mb-3">
                      <p class="text-sm font-medium text-slate-700">Evaluación #{i+1}</p>
                      <span class={`px-2.5 py-1 rounded-lg text-xs font-medium ${p.estado==='Aprobado'?'bg-emerald-100 text-emerald-700':p.estado==='Corrección'?'bg-red-100 text-red-600':'bg-amber-100 text-amber-700'}`}>{p.estado||'Pendiente'}</span>
                    </div>
                    <div class="grid grid-cols-2 gap-3 mb-3">
                      <div class="bg-white rounded-lg p-3 text-center"><p class="text-xs text-slate-400">Puntaje</p><p class="text-lg font-bold text-slate-700">{p.puntaje_promedio ? Math.round(p.puntaje_promedio)+'%' : '—'}</p></div>
                    </div>
                    {p.comentario_retroalimentacion && (
                      <div class="bg-white rounded-lg p-3 border border-slate-200">
                        <p class="text-xs font-medium text-slate-400 uppercase mb-1">Retroalimentación</p>
                        <p class="text-sm text-slate-600 italic">"{p.comentario_retroalimentacion}"</p>
                      </div>
                    )}
                    {p.observaciones_generales && (
                      <div class="bg-white rounded-lg p-3 border border-slate-200 mt-2">
                        <p class="text-xs font-medium text-slate-400 uppercase mb-1">Observaciones</p>
                        <p class="text-sm text-slate-600">{p.observaciones_generales}</p>
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </details>
          )}
          <!-- Encuesta -->
          {eeComentarios.length > 0 && (
            <details class="bg-white rounded-2xl shadow-tarjeta group overflow-hidden">
              <summary class="font-semibold text-tup cursor-pointer list-none flex items-center justify-between px-5 py-4 hover:bg-slate-50 transition-colors">
                <div class="flex items-center gap-3">
                  <span class="w-10 h-10 rounded-xl bg-emerald-100 flex items-center justify-center text-lg">📝</span>
                  <div><p class="text-sm">Encuesta Estudiantil</p><p class="text-xs text-slate-400 font-normal">{eeComentarios.length} comentario{eeComentarios.length>1?'s':''}</p></div>
                </div>
                <span class="text-xs text-slate-400 group-open:hidden">▼</span><span class="text-xs text-slate-400 hidden group-open:inline">▲</span>
              </summary>
              <div class="px-5 pb-5 space-y-2 border-t border-slate-100 pt-4">
                <div class="bg-slate-50 rounded-xl p-4 max-h-60 overflow-y-auto space-y-3">
                  {eeComentarios.map((c,i)=>(
                    <div class="flex gap-3">
                      <span class="w-8 h-8 rounded-full bg-emerald-100 flex items-center justify-center text-xs font-bold text-emerald-600 flex-shrink-0">{i+1}</span>
                      <p class="text-sm text-slate-600 italic pt-1">"{c}"</p>
                    </div>
                  ))}
                </div>
              </div>
            </details>
          )}

    <!-- Accesos rápidos -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
