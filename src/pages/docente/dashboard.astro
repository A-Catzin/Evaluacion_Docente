                {summary.items.map((item, i) => (
                  <div class="flex items-center justify-between gap-3 bg-white rounded-lg px-3 py-2">
                    <p class="text-xs text-slate-600 flex-1">{i + 1}. {item.text}</p>
                    <span class="px-2 py-0.5 rounded-md text-xs font-bold flex-shrink-0 bg-indigo-100 text-indigo-700">{formatScore(item.average)} / 5</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </details>
      ))}
    </div>

    <div class="mb-8">
      <div class="bg-gradient-to-br from-white to-slate-50 rounded-3xl shadow-tarjeta border border-tup/10 p-6 ring-1 ring-slate-100">
        <div class="flex items-start justify-between gap-4 flex-wrap mb-5 pb-4 border-b border-slate-200/70">
          <div>
            <p class="text-xs uppercase tracking-[0.25em] text-tup font-semibold">Retroalimentación administrativa</p>
            <h2 class="text-2xl font-bold text-slate-800 mt-1">Áreas de mejora y comentarios del equipo académico</h2>
          </div>
          {feedback360 && (
            <div class="text-right rounded-2xl bg-white px-4 py-3 shadow-sm border border-slate-100">
              <p class="text-xs text-slate-400">Ciclo</p>
              <p class="text-sm font-semibold text-slate-700">{cuatrimestres.find(c => c.id === feedback360.cuatrimestre_id)?.clave || '—'}</p>
            </div>
          )}
        </div>

        {!feedback360 ? (
          <div class="rounded-2xl border border-dashed border-slate-200 p-6 text-center text-slate-400 bg-white/70">
            Aún no tienes retroalimentación administrativa para este ciclo.
          </div>
        ) : (
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
            <div class="rounded-2xl bg-white p-5 border border-emerald-100 shadow-sm">
              <div class="flex items-center gap-2 mb-3">
                <span class="w-8 h-8 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center text-sm">💬</span>
