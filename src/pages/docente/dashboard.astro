---
import LayoutDocente from '../../layouts/LayoutDocente.astro';
import { obtenerCuatrimestreActivo, obtenerCuatrimestres } from '../../services/catalogos';
import { obtenerClienteSuperbase } from '../../lib/supabaseClient';

const token = Astro.cookies.get('sb-access-token')?.value;
const refresh = Astro.cookies.get('sb-refresh-token')?.value;
if (!token || !refresh) return Astro.redirect('/auth');

const cl = obtenerClienteSuperbase();
const cuatrimestreActivo = await obtenerCuatrimestreActivo();
const cuatrimestres = await obtenerCuatrimestres();
const cuatrimestreId = parseInt(Astro.url.searchParams.get('cuatrimestre') || '') || cuatrimestreActivo?.id || 0;
const { data: sesion } = await cl.auth.setSession({ access_token: token, refresh_token: refresh });
if (!sesion.user) return Astro.redirect('/auth');

const { data: usuario } = await cl.from('usuarios').select('entidad_id,email').eq('id', sesion.user.id).maybeSingle();
let docenteId = usuario?.entidad_id;
let docenteEmail = usuario?.email || '';

// Buscar todos los docentes que corresponden a este usuario (por entidad_id, email, y nombre)
let docenteIdsSet = new Set<number>();
if (docenteId) {
  docenteIdsSet.add(docenteId);
  // Obtener nombre del docente vinculado para buscar coincidencias por nombre
  const { data: miDoc } = await cl.from('docentes').select('nombre,apellidos').eq('id', docenteId).maybeSingle();
  if (miDoc?.nombre && miDoc?.apellidos) {
    const { data: mismosNombres } = await cl.from('docentes').select('id').eq('nombre', miDoc.nombre).eq('apellidos', miDoc.apellidos);
    (mismosNombres||[]).forEach(d => docenteIdsSet.add(d.id));
  }
}
if (docenteEmail) {
  const { data: docsMatch } = await cl.from('docentes').select('id').eq('email', docenteEmail);
  (docsMatch||[]).forEach(d => docenteIdsSet.add(d.id));
}
const docenteIds: number[] = [...docenteIdsSet];

const cuatrimestre = await obtenerCuatrimestreActivo();

let scores = { promEst: 0, promCoord: 0, promPlan: 0, promObs: 0, promAuto: 0, final360: null as number|null, cat360: 'No iniciado', instrumentos: 0 };
let nombreDocente = '';
let diagInfo: any = null;
let eeComentarios: string[] = [];
let coordInfo: any = null;
let planFeedback: any[] = [];
let obsInfo: any = null;
let eeInfo: any = null;

// Cargar textos de preguntas desde BD (editables via /admin/instrumentos)
const { data: preguntasAD } = await cl.from('instrumento_preguntas').select('texto').eq('instrumento','autodiagnostico').eq('activa',true).order('orden');
const diagPreguntas = (preguntasAD||[]).map(p=>p.texto);
const { data: preguntasCoord } = await cl.from('instrumento_preguntas').select('texto,seccion').eq('instrumento','coordinacion').eq('activa',true).order('orden');
const { data: preguntasObs } = await cl.from('instrumento_preguntas').select('texto,seccion').eq('instrumento','observacion').eq('activa',true).order('orden');
const obsSecciones = [
  {icon:'🧠',label:'A. Cognitivas',keys:['cco1','cco2','cco3','cco4','cco5','cco6','cco7'],items:[]},
  {icon:'🔄',label:'B. Metacognitivas',keys:['cme1','cme2','cme3','cme4','cme5','cme6','cme7','cme8','cme9'],items:[]},
  {icon:'💬',label:'C. Comunicativas',keys:['ccom1','ccom2','ccom3','ccom4'],items:[]},
  {icon:'👥',label:'D. Sociales',keys:['cso1','cso2','cso3','cso4'],items:[]},
  {icon:'📊',label:'E. Gestión de la Enseñanza',keys:['cge1','cge2','cge3','cge4','cge5','cge6','cge7'],items:[]},
  {icon:'❤️',label:'F. Afectivas',keys:['caf1','caf2'],items:[]},
  {icon:'💻',label:'G. Tecno-Pedagógicas',keys:['ctepe1','ctepe2','ctepe3','ctepe4','ctepe5','ctepe6','ctepe7'],items:[]},
  {icon:'📏',label:'H. Normativa',keys:['cno1','cno2','cno3','cno4','cno5'],items:[]}
];
const secObsMap = {};
(preguntasObs||[]).forEach(p=>{const s=p.seccion||'';if(!secObsMap[s])secObsMap[s]=[];secObsMap[s].push(p.texto);});
// Mapear letras de seccion DB (A,B,C...) a prefijos de keys (cco,cme,ccom...)
const obsLetraPrefijo = {A:'cco',B:'cme',C:'ccom',D:'cso',E:'cge',F:'caf',G:'ctepe',H:'cno'};
obsSecciones.forEach(s=>{
  const p = s.keys[0].replace(/[0-9]/g,'');
  const letra = Object.entries(obsLetraPrefijo).find(([,v])=>v===p)?.[0];
  s.items = secObsMap[letra||p] || s.items;
});

// Cargar categorias de planeacion desde BD
const { data: planCats } = await cl.from('instrumento_preguntas').select('*').eq('instrumento','planeacion').eq('tipo_respuesta','categoria').eq('activa',true).order('orden');
const planeacionCats = (planCats||[]).map(c => ({ id: c.seccion, label: `${c.orden}. ${c.texto}` }));
const coordSecciones = [
  {icon:'📋',label:'A. Cumplimiento Académico',keys:['a1','a2','a3'],items:[]},
  {icon:'📊',label:'B. Gestión y Organización',keys:['b1','b2','b3'],items:[]},
  {icon:'💬',label:'C. Desempeño Profesional y Comunicación',keys:['c1','c2','c3'],items:[]},
  {icon:'💡',label:'D. Innovación y Mejora Continua',keys:['d1','d2','d3'],items:[]},
  {icon:'🏛️',label:'E. Compromiso Institucional y Ética',keys:['e1','e2','e3'],items:[]}
];
const secCoordMap = {};
(preguntasCoord||[]).forEach(p=>{const s=p.seccion||'';if(!secCoordMap[s])secCoordMap[s]=[];secCoordMap[s].push(p.texto);});
coordSecciones.forEach(s=>{s.items = secCoordMap[s.keys[0].replace(/[0-9]/g,'').toUpperCase()] || s.items;});
const eeCategorias = ['Asistencia','Organización','Actitud','Enseñanza','Dominio','Evaluación','Comunicación','Gestión','Tecnología','Satisfacción'];
const eeCatKeys = ['prom_asistencia','prom_organizacion','prom_actitud','prom_ensenanza','prom_dominio','prom_evaluacion','prom_comunicacion','prom_gestion','prom_tecnologia','prom_satisfaccion'];

if (docenteIds.length > 0) {
  const { data: doc } = await cl.from('docentes').select('nombre,apellidos').eq('id', docenteIds[0]).maybeSingle();
  if (doc) nombreDocente = `${doc.nombre.toUpperCase()} ${doc.apellidos.toUpperCase()}`;

  const [{ data: eeData }, { data: coordData }, { data: planData }, { data: obsData }, { data: diagData }, { data: matData }] = await Promise.all([
    cl.from('encuesta_estudiantil').select('score_normalizado,comentarios,prom_asistencia,prom_organizacion,prom_actitud,prom_ensenanza,prom_dominio,prom_evaluacion,prom_comunicacion,prom_gestion,prom_tecnologia,prom_satisfaccion,promedio_general').in('docente_id', docenteIds).eq('cuatrimestre_id', cuatrimestreId),
    cl.from('evaluacion_coordinacion').select('score_normalizado,categoria,comentarios,puntos_obtenidos,a1,a2,a3,b1,b2,b3,c1,c2,c3,d1,d2,d3,e1,e2,e3').in('docente_id', docenteIds).eq('cuatrimestre_id', cuatrimestreId).order('id', { ascending: false }).limit(1),
    cl.from('planeaciones').select('puntaje_promedio,comentario_retroalimentacion,estado,observaciones_generales,evaluacion_detalle').in('docente_id', docenteIds).eq('cuatrimestre_id', cuatrimestreId).order('fecha_subida', { ascending: false }),
    cl.from('observaciones').select('id,docente_id,cco1,cco2,cco3,cco4,cco5,cco6,cco7,cme1,cme2,cme3,cme4,cme5,cme6,cme7,cme8,cme9,ccom1,ccom2,ccom3,ccom4,cso1,cso2,cso3,cso4,cge1,cge2,cge3,cge4,cge5,cge6,cge7,caf1,caf2,ctepe1,ctepe2,ctepe3,ctepe4,ctepe5,ctepe6,ctepe7,cno1,cno2,cno3,cno4,cno5,comentario_evaluador,comentario_docente,obs_cognitivas,obs_metacognitivas,obs_comunicativas,obs_sociales,obs_gestion,obs_afectivas,obs_tecno,obs_normativa,fecha_observacion').in('docente_id', docenteIds).eq('cuatrimestre_id', cuatrimestreId),
    cl.from('autodiagnosticos').select('*').in('docente_id', docenteIds).eq('cuatrimestre_id', cuatrimestreId).order('id', { ascending: false }).limit(1),
    cl.from('grupos').select('asignatura_id').in('docente_id', docenteIds),
  ]);

  // Feedback
  eeComentarios = (eeData||[]).filter(e=>e.comentarios).map(e=>e.comentarios);
  coordInfo = coordData?.[0] || null;
  planFeedback = (planData||[]).filter(p=>p.comentario_retroalimentacion || p.observaciones_generales || p.evaluacion_detalle);
  obsInfo = obsData?.[0] || null;
  diagInfo = diagData?.[0] || null;
  // Datos de encuesta para feedback
  eeInfo = eeData?.[0] || null;

  // EE promedio
  const eeScores = (eeData||[]).map(e=>e.score_normalizado).filter(v=>v);
  scores.promEst = eeScores.length ? Math.round(eeScores.reduce((a,b)=>a+b,0)/eeScores.length) : 0;

  // Coord
  scores.promCoord = coordData?.[0]?.score_normalizado ? Math.round(coordData[0].score_normalizado) : 0;

  // Plan promedio
  const planScores = (planData||[]).map(p=>p.puntaje_promedio).filter(v=>v);
  scores.promPlan = planScores.length ? Math.round(planScores.reduce((a,b)=>a+b,0)/planScores.length) : 0;

  // Obs promedio
  const obsScores: number[] = [];
  for (const o of (obsData||[])) {
    const r = [o.cco1,o.cco2,o.cco3,o.cco4,o.cco5,o.cco6,o.cco7,o.cme1,o.cme2,o.cme3,o.cme4,o.cme5,o.cme6,o.cme7,o.cme8,o.cme9,o.ccom1,o.ccom2,o.ccom3,o.ccom4,o.cso1,o.cso2,o.cso3,o.cso4,o.cge1,o.cge2,o.cge3,o.cge4,o.cge5,o.cge6,o.cge7,o.caf1,o.caf2,o.ctepe1,o.ctepe2,o.ctepe3,o.ctepe4,o.ctepe5,o.ctepe6,o.ctepe7,o.cno1,o.cno2,o.cno3,o.cno4,o.cno5].filter(v=>v);
    if (r.length) obsScores.push(Math.round((r.reduce((a,b)=>a+b,0)/(r.length*5))*100));
  }
  scores.promObs = obsScores.length ? Math.round(obsScores.reduce((a,b)=>a+b,0)/obsScores.length) : 0;

  // Auto
  scores.promAuto = diagData?.[0]?.puntaje_total ? Math.round((diagData[0].puntaje_total/120)*100) : 0;

  // Final 360
  const disp = [scores.promEst, scores.promCoord, scores.promPlan, scores.promObs, scores.promAuto];
  const pesos = [0.35,0.20,0.15,0.25,0.05];
  let fin = 0; for (let i=0;i<5;i++) if (disp[i]) fin += disp[i]*pesos[i];
  scores.final360 = fin || null;
  scores.instrumentos = disp.filter(v=>v>0).length;
  scores.cat360 = scores.instrumentos===5 ? (fin>=90?'Sobresaliente':fin>=80?'Distinguido':fin>=70?'Bueno':fin>=60?'Aprobado':fin>=50?'A mejorar':'Insuficiente') : fin>0 ? 'Parcial' : 'No iniciado';
}

function fmt(n:number|null|undefined):string{return n!=null ? Math.round(n).toString() : '—';}
function colorN(n:number|null|undefined):string{return !n?'':n>=80?'text-emerald-600':n>=60?'text-amber-600':'text-red-600';}
---

<LayoutDocente titulo="Mi Evaluación — Docente">
  <div class="animate-flotar-entrada">
    <div class="flex items-center justify-between mb-6">
    <div class="flex items-center justify-between mb-6">
      <div><h1 class="text-3xl font-bold text-tup">Mi Evaluación 360°</h1><p class="text-slate-500">{nombreDocente}</p></div>
      <form method="GET" class="flex items-center gap-2">
        <select name="cuatrimestre" class="rounded-xl border border-slate-200 px-3 py-2 text-sm" onchange="this.form.submit()">
          {cuatrimestres.map(c => (<option value={c.id} selected={c.id === cuatrimestreId}>{c.clave} {c.nombre||''}</option>))}
        </select>
      </form>
    </div>
    </div>

    {docenteIds.length === 0 ? (
      <div class="bg-white rounded-2xl p-6 shadow-tarjeta text-center ">Completa tu autodiagnóstico para ver tus resultados.</div>
    ) : (
      <>
        <!-- KPIs -->
        <div class="grid grid-cols-2 lg:grid-cols-5 gap-4 mb-8">
          <div class="bg-white rounded-2xl p-4 shadow-tarjeta text-center">
            <p class="text-xs text-slate-400 uppercase">Estudiantil</p>
            <p class={`text-2xl font-bold mt-1 ${colorN(scores.promEst)}`}>{fmt(scores.promEst)}</p>
          </div>
          <div class="bg-white rounded-2xl p-4 shadow-tarjeta text-center">
            <p class="text-xs text-slate-400 uppercase">Coordinación</p>
            <p class={`text-2xl font-bold mt-1 ${colorN(scores.promCoord)}`}>{fmt(scores.promCoord)}</p>
          </div>
          <div class="bg-white rounded-2xl p-4 shadow-tarjeta text-center">
            <p class="text-xs text-slate-400 uppercase">Planeación</p>
            <p class={`text-2xl font-bold mt-1 ${colorN(scores.promPlan)}`}>{fmt(scores.promPlan)}</p>
          </div>
          <div class="bg-white rounded-2xl p-4 shadow-tarjeta text-center">
            <p class="text-xs text-slate-400 uppercase">Observación</p>
            <p class={`text-2xl font-bold mt-1 ${colorN(scores.promObs)}`}>{fmt(scores.promObs)}</p>
          </div>
          <div class="bg-white rounded-2xl p-4 shadow-tarjeta text-center">
            <p class="text-xs text-slate-400 uppercase">Autodiagnóstico</p>
            <p class={`text-2xl font-bold mt-1 ${colorN(scores.promAuto)}`}>{fmt(scores.promAuto)}</p>
          </div>
        </div>

        <!-- Gráfico + Final -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
          <div class="lg:col-span-2 bg-white rounded-2xl p-6 shadow-tarjeta">
            <h3 class="text-sm font-semibold text-slate-700 mb-4">Mis Scores por Instrumento</h3>
            <div style="max-height:220px"><canvas id="chart-docente" style="max-height:220px"></canvas></div>
          </div>
          <div class="bg-white rounded-2xl p-6 shadow-tarjeta flex flex-col items-center justify-center text-center">
            <p class="text-xs text-slate-400 uppercase mb-2">Calificación Final</p>
            <p class="text-5xl font-bold text-tup">{fmt(scores.final360)}</p>
            <span class="px-2 py-1 rounded text-xs font-medium bg-slate-100 mt-2">{scores.cat360}</span>
            <p class="text-xs text-slate-400 mt-3">{scores.instrumentos}/5 instrumentos</p>
          </div>
        </div>
      </>
    )}

    <!-- Retroalimentación -->
    {docenteIds.length > 0 && (
      <div class="mb-8">
        <h2 class="text-lg font-bold text-slate-700 mb-4">📋 Retroalimentación de tus Evaluaciones</h2>
        <div class="space-y-4">

          {diagInfo && (
            <details class="bg-white rounded-2xl shadow-tarjeta group overflow-hidden" open>
              <summary class="font-semibold text-tup cursor-pointer list-none flex items-center justify-between px-5 py-4 hover:bg-slate-50">
                <div class="flex items-center gap-3"><span class="w-10 h-10 rounded-xl bg-purple-100 flex items-center justify-center text-lg">🧪</span><div><p class="text-sm">Autodiagnóstico Docente</p><p class="text-xs text-slate-400 font-normal">{diagInfo.nivel_desempeno || 'Completado'}</p></div></div>
                <span class="text-xs text-slate-400 group-open:hidden">▼</span><span class="text-xs text-slate-400 hidden group-open:inline">▲</span>
              </summary>
              <div class="px-5 pb-5 space-y-4 border-t border-slate-100 pt-4">
                <div class="grid grid-cols-2 gap-4">
                  <div class="bg-gradient-to-br from-purple-50 to-purple-100/50 rounded-xl p-4 text-center"><p class="text-xs text-purple-500 uppercase font-medium">Nivel</p><p class="text-2xl font-bold text-purple-700 mt-1">{diagInfo.nivel_desempeno || '—'}</p></div>
                  <div class="bg-gradient-to-br from-slate-50 to-slate-100/50 rounded-xl p-4 text-center"><p class="text-xs text-slate-500 uppercase font-medium">Puntaje</p><p class="text-2xl font-bold text-slate-700 mt-1">{Math.round((diagInfo.puntaje_total||0)/120*100)}%</p></div>
                </div>
                {diagInfo.comentarios && <div class="bg-slate-50 rounded-xl p-4 border border-slate-100"><p class="text-xs font-medium text-slate-400 uppercase mb-1">Reflexión Personal</p><p class="text-sm text-slate-600 italic">"{diagInfo.comentarios}"</p></div>}
                <div class="bg-slate-50 rounded-xl p-4 space-y-2">
                  {Array.from({length:24},(_,i)=>diagInfo["r"+(i+1)]).map((v,i)=>(<div class="flex items-center justify-between gap-3 bg-white rounded-lg px-3 py-2"><p class="text-xs text-slate-600 flex-1">{diagPreguntas[i]}</p><span class={"px-2 py-0.5 rounded-md text-xs font-bold flex-shrink-0 "+(v>=4?"bg-emerald-100 text-emerald-700":v>=3?"bg-amber-100 text-amber-700":v>=1?"bg-red-50 text-red-600":"bg-slate-100 text-slate-400")}>{v||'—'}</span></div>))}
                </div>
              </div>
            </details>
          )}

          {coordInfo && (
            <details class="bg-white rounded-2xl shadow-tarjeta group overflow-hidden">
              <summary class="font-semibold text-tup cursor-pointer list-none flex items-center justify-between px-5 py-4 hover:bg-slate-50">
                <div class="flex items-center gap-3"><span class="w-10 h-10 rounded-xl bg-blue-100 flex items-center justify-center text-lg">📋</span><div><p class="text-sm">Coordinación Académica</p><p class="text-xs text-slate-400 font-normal">{coordInfo.categoria || 'Evaluado'}</p></div></div>
                <span class="text-xs text-slate-400 group-open:hidden">▼</span><span class="text-xs text-slate-400 hidden group-open:inline">▲</span>
              </summary>
              <div class="px-5 pb-5 space-y-4 border-t border-slate-100 pt-4">
                <div class="grid grid-cols-2 gap-4">
                  <div class="bg-gradient-to-br from-blue-50 to-blue-100/50 rounded-xl p-4 text-center"><p class="text-xs text-blue-500 uppercase font-medium">Categoría</p><p class="text-xl font-bold text-blue-700 mt-1">{coordInfo.categoria || '—'}</p></div>
                  <div class="bg-gradient-to-br from-slate-50 to-slate-100/50 rounded-xl p-4 text-center"><p class="text-xs text-slate-500 uppercase font-medium">Puntuación</p><p class="text-xl font-bold text-slate-700 mt-1">{coordInfo.puntos_obtenidos || '—'}<span class="text-sm font-normal text-slate-400">/75</span></p></div>
                </div>
                {coordInfo.comentarios && <div class="bg-slate-50 rounded-xl p-4 border border-slate-100"><p class="text-xs font-medium text-slate-400 uppercase mb-1">Observaciones</p><p class="text-sm text-slate-600 italic">"{coordInfo.comentarios}"</p></div>}
                {coordSecciones.map(sec => {
                  const pares = sec.keys.map((k,i) => ({ texto: sec.items[i], score: coordInfo[k] })).filter(p => p.score != null);
                  if (pares.length === 0) return <></>;
                  return <div class="bg-slate-50 rounded-xl p-4"><p class="text-xs font-semibold text-slate-500 uppercase mb-2">{sec.icon} {sec.label}</p><div class="space-y-2">{pares.map((p,i) => <div class="flex items-center justify-between gap-3 bg-white rounded-lg px-3 py-2"><p class="text-xs text-slate-600 flex-1">{p.texto}</p><span class={"px-2 py-0.5 rounded-md text-xs font-bold flex-shrink-0 "+(p.score>=4?"bg-emerald-100 text-emerald-700":p.score>=3?"bg-amber-100 text-amber-700":"bg-red-50 text-red-600")}>{p.score}</span></div>)}</div></div>;
                })}
              </div>
            </details>
          )}

          {obsInfo && (
            <details class="bg-white rounded-2xl shadow-tarjeta group overflow-hidden" open>
              <summary class="font-semibold text-tup cursor-pointer list-none flex items-center justify-between px-5 py-4 hover:bg-slate-50">
                <div class="flex items-center gap-3"><span class="w-10 h-10 rounded-xl bg-teal-100 flex items-center justify-center text-lg">👁️</span><div><p class="text-sm">Observación de Clase</p></div></div>
                <span class="text-xs text-slate-400 group-open:hidden">▼</span><span class="text-xs text-slate-400 hidden group-open:inline">▲</span>
              </summary>
              <div class="px-5 pb-5 space-y-3 border-t border-slate-100 pt-4">
                {obsInfo.comentario_evaluador && <div class="bg-slate-50 rounded-xl p-4 border border-slate-100"><p class="text-xs font-medium text-slate-400 uppercase mb-1">Comentario del Evaluador</p><p class="text-sm text-slate-600 italic">"{obsInfo.comentario_evaluador}"</p></div>}
                {obsInfo.comentario_docente && <div class="bg-slate-50 rounded-xl p-4 border border-slate-100"><p class="text-xs font-medium text-slate-400 uppercase mb-1">Comentario del Docente</p><p class="text-sm text-slate-600 italic">"{obsInfo.comentario_docente}"</p></div>}
                {obsSecciones.map(sec => {
                  const pares = sec.keys.map((k,i) => ({ texto: sec.items[i], score: obsInfo[k] })).filter(p => p.score != null);
                  if (pares.length === 0) return <></>;
                  return <div class="bg-slate-50 rounded-xl p-4"><p class="text-xs font-semibold text-slate-500 uppercase mb-2">{sec.icon} {sec.label}</p><div class="space-y-2">{pares.map(p => <div class="flex items-center justify-between gap-3 bg-white rounded-lg px-3 py-2"><p class="text-xs text-slate-600 flex-1">{p.texto}</p><span class={"px-2 py-0.5 rounded-md text-xs font-bold flex-shrink-0 "+(p.score>=4?"bg-emerald-100 text-emerald-700":p.score>=3?"bg-amber-100 text-amber-700":"bg-red-50 text-red-600")}>{p.score}</span></div>)}</div></div>;
                })}
              </div>
            </details>
          )}

          {planFeedback.length > 0 && (
            <details class="bg-white rounded-2xl shadow-tarjeta group overflow-hidden">
              <summary class="font-semibold text-tup cursor-pointer list-none flex items-center justify-between px-5 py-4 hover:bg-slate-50">
                <div class="flex items-center gap-3"><span class="w-10 h-10 rounded-xl bg-amber-100 flex items-center justify-center text-lg">📄</span><div><p class="text-sm">Planeación Didáctica</p><p class="text-xs text-slate-400 font-normal">{planFeedback.length} evaluación{planFeedback.length>1?'es':''}</p></div></div>
                <span class="text-xs text-slate-400 group-open:hidden">▼</span><span class="text-xs text-slate-400 hidden group-open:inline">▲</span>
              </summary>
              <div class="px-5 pb-5 space-y-4 border-t border-slate-100 pt-4">
                {planFeedback.map((p,i)=>(
                  <div class="bg-slate-50 rounded-xl p-4 border border-slate-100">
                    <div class="flex items-center justify-between mb-3"><p class="text-sm font-medium text-slate-700">Evaluación #{i+1}</p><span class={"px-2.5 py-1 rounded-lg text-xs font-medium "+(p.estado==='Aprobado'?'bg-emerald-100 text-emerald-700':p.estado==='Corrección'?'bg-red-100 text-red-600':'bg-amber-100 text-amber-700')}>{p.estado||'Pendiente'}</span></div>
                    <div class="grid grid-cols-1 gap-3 mb-3"><div class="bg-white rounded-lg p-3 text-center"><p class="text-xs text-slate-400">Puntaje</p><p class="text-lg font-bold text-slate-700">{p.puntaje_promedio ? Math.round(p.puntaje_promedio)+'%' : '—'}</p></div></div>
                    {p.evaluacion_detalle && <div class="space-y-2 mt-2">{planeacionCats.map(cat => { const det = (p.evaluacion_detalle||{})[cat.id]; if (!det) return <></>; const scoreMap = {2:'Satisfactorio',1:'Suficiente',0:'Insuficiente',na:'No aplica'}; return <div class="flex items-center justify-between gap-3 bg-white rounded-lg px-3 py-2"><p class="text-xs text-slate-600 flex-1">{cat.label}</p><span class={"px-2 py-0.5 rounded-md text-xs font-bold flex-shrink-0 "+(det.score==='2'||det.score===2?'bg-emerald-100 text-emerald-700':det.score==='1'||det.score===1?'bg-amber-100 text-amber-700':det.score==='na'?'bg-slate-100 text-slate-500':'bg-red-50 text-red-600')}>{scoreMap[String(det.score)]||det.score}</span></div>; })}</div>}
                    {p.comentario_retroalimentacion && <div class="bg-white rounded-lg p-3 border border-slate-200 mt-2"><p class="text-xs font-medium text-slate-400 uppercase mb-1">Retroalimentación</p><p class="text-sm text-slate-600 italic">"{p.comentario_retroalimentacion}"</p></div>}
                    {p.observaciones_generales && <div class="bg-white rounded-lg p-3 border border-slate-200 mt-2"><p class="text-xs font-medium text-slate-400 uppercase mb-1">Observaciones</p><p class="text-sm text-slate-600">{p.observaciones_generales}</p></div>}
                  </div>
                ))}
              </div>
            </details>
          )}

          {eeComentarios.length > 0 && (
            <details class="bg-white rounded-2xl shadow-tarjeta group overflow-hidden">
              <summary class="font-semibold text-tup cursor-pointer list-none flex items-center justify-between px-5 py-4 hover:bg-slate-50">
                <div class="flex items-center gap-3"><span class="w-10 h-10 rounded-xl bg-emerald-100 flex items-center justify-center text-lg">📝</span><div><p class="text-sm">Encuesta Estudiantil</p><p class="text-xs text-slate-400 font-normal">{eeComentarios.length} comentario{eeComentarios.length>1?'s':''}</p></div></div>
                <span class="text-xs text-slate-400 group-open:hidden">▼</span><span class="text-xs text-slate-400 hidden group-open:inline">▲</span>
              </summary>
              <div class="px-5 pb-5 space-y-3 border-t border-slate-100 pt-4">
                {eeInfo && <div class="bg-slate-50 rounded-xl p-4"><p class="text-xs font-semibold text-slate-500 uppercase mb-2">📊 Promedios por Categoría</p><div class="space-y-2">{eeCategorias.map((cat,i)=>{const v=eeInfo[eeCatKeys[i]];return v!=null?<div class="flex items-center justify-between gap-3 bg-white rounded-lg px-3 py-2"><p class="text-xs text-slate-600">{cat}</p><span class="px-2 py-0.5 rounded-md text-xs font-bold bg-emerald-100 text-emerald-700">{typeof v==='number'?v.toFixed(1):v}</span></div>:<></>;})}</div></div>}
                <div class="bg-slate-50 rounded-xl p-4 space-y-3">
                  <p class="text-xs font-semibold text-slate-500 uppercase">💬 Comentarios de Estudiantes</p>
                  {eeComentarios.map((c,i)=>(<div class="flex gap-3"><span class="w-8 h-8 rounded-full bg-emerald-100 flex items-center justify-center text-xs font-bold text-emerald-600 flex-shrink-0">{i+1}</span><p class="text-sm text-slate-600 italic pt-1">"{c}"</p></div>))}
                </div>
              </div>
            </details>
          )}

        </div>
      </div>
    )}
    <!-- Accesos rápidos -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <a href={`/docente/autodiagnostico?cuatrimestre=${cuatrimestreId}`} class="bg-white rounded-2xl p-5 shadow-tarjeta hover:shadow-tarjeta-hover transition-all text-center">
        <p class="text-lg font-semibold text-tup">🧪 Autodiagnóstico</p>
        <p class="text-sm text-slate-500 mt-1">24 reactivos de auto-evaluación</p>
      </a>
      <a href={`/docente/planeaciones?cuatrimestre=${cuatrimestreId}`} class="bg-white rounded-2xl p-5 shadow-tarjeta hover:shadow-tarjeta-hover transition-all text-center">
        <p class="text-lg font-semibold text-tup">📄 Planeaciones</p>
        <p class="text-sm text-slate-500 mt-1">Sube tus planeaciones didácticas</p>
      </a>
    </div>
  </div>
</LayoutDocente>

<script is:inline define:vars={{
  chartJson: JSON.stringify([scores.promEst, scores.promCoord, scores.promPlan, scores.promObs, scores.promAuto]),
}}>
  function initChart() {
    if (typeof Chart === 'undefined') {
      var s = document.createElement('script');
      s.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js';
      s.onload = drawChart;
      document.head.appendChild(s);
    } else { drawChart(); }
  }
  function drawChart() {
    var data = JSON.parse(chartJson);
    var ctx = document.getElementById('chart-docente');
    if (!ctx) return;
    new Chart(ctx, {
      type: 'bar',
      data: {
        labels: ['Est.','Coord.','Plan.','Obs.','Auto.'],
        datasets: [{ data: data, backgroundColor: ['#22c55e','#3b82f6','#a855f7','#f59e0b','#f97316'], borderRadius: 6, borderWidth: 0 }]
      },
      options: {
        responsive: true, maintainAspectRatio: true,
        scales: { y: { beginAtZero: true, max: 100, grid: { color: 'rgba(148,163,184,0.1)' }, ticks: { font: { size: 10 } } }, x: { ticks: { font: { size: 9 } } } },
        plugins: { legend: { display: false } }
      }
    });
  }
  initChart();
</script>
