                    <article class="rounded-2xl bg-amber-50 border border-amber-100 p-4 shadow-sm">
                      <p class="text-[11px] uppercase tracking-wider text-amber-500 mb-2">Área {item.id}</p>
                      <p class="text-sm text-slate-700 leading-relaxed whitespace-pre-line">{item.text}</p>
                    </article>
