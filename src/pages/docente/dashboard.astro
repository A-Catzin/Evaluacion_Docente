    </div>

    <!-- Retroalimentación -->
    {docenteIds.length > 0 && (
      <div class="mb-8">
        <h2 class="text-lg font-bold text-slate-700 mb-4">📋 Retroalimentación de tus Evaluaciones</h2>
        <div class="space-y-4">

          {diagInfo && (
            <details class="bg-white rounded-2xl shadow-tarjeta group overflow-hidden">
              <summary class="font-semibold text-tup cursor-pointer list-none flex items-center justify-between px-5 py-4 hover:bg-slate-50">
                <div class="flex items-center gap-3"><span class="w-10 h-10 rounded-xl bg-purple-100 flex items-center justify-center text-lg">🧪</span><div><p class="text-sm">Autodiagnóstico Docente</p><p class="text-xs text-slate-400 font-normal">{diagInfo.nivel_desempeno || 'Completado'}</p></div></div>
                <span class="text-xs text-slate-400 group-open:hidden">▼</span><span class="text-xs text-slate-400 hidden group-open:inline">▲</span>
              </summary>
              <div class="px-5 pb-5 space-y-4 border-t border-slate-100 pt-4">
                <div class="grid grid-cols-2 gap-4">
                  <div class="bg-gradient-to-br from-purple-50 to-purple-100/50 rounded-xl p-4 text-center"><p class="text-xs text-purple-500 uppercase font-medium">Nivel</p><p class="text-2xl font-bold text-purple-700 mt-1">{diagInfo.nivel_desempeno || '—'}</p></div>
                  <div class="bg-gradient-to-br from-slate-50 to-slate-100/50 rounded-xl p-4 text-center"><p class="text-xs text-slate-500 uppercase font-medium">Puntaje</p><p class="text-2xl font-bold text-slate-700 mt-1">{pctRaw((diagInfo.puntaje_total||0)/120*100, (diagInfo.puntaje_total||0)/5, 24)}</p></div>
                </div>
                {diagInfo.comentarios && <div class="bg-slate-50 rounded-xl p-4 border border-slate-100"><p class="text-xs font-medium text-slate-400 uppercase mb-1">Reflexión Personal</p><p class="text-sm text-slate-600 italic">"{diagInfo.comentarios}"</p></div>}
                <div class="bg-slate-50 rounded-xl p-4 space-y-2">
                  {Array.from({length:24},(_,i)=>diagInfo["r"+(i+1)]).map((v,i)=>(<div class="flex items-center justify-between gap-3 bg-white rounded-lg px-3 py-2"><p class="text-xs text-slate-600 flex-1">{diagPreguntas[i]}</p><span class={"px-2 py-0.5 rounded-md text-xs font-bold flex-shrink-0 "+(v>=4?"bg-emerald-100 text-emerald-700":v>=3?"bg-amber-100 text-amber-700":v>=1?"bg-red-50 text-red-600":"bg-slate-100 text-slate-400")}>{v||'—'}</span></div>))}
                </div>
              </div>
            </details>
          )}

          {coordInfo && (
            <details class="bg-white rounded-2xl shadow-tarjeta group overflow-hidden">
              <summary class="font-semibold text-tup cursor-pointer list-none flex items-center justify-between px-5 py-4 hover:bg-slate-50">
                <div class="flex items-center gap-3"><span class="w-10 h-10 rounded-xl bg-blue-100 flex items-center justify-center text-lg">📋</span><div><p class="text-sm">Coordinación Académica</p><p class="text-xs text-slate-400 font-normal">{coordInfo.categoria || 'Evaluado'}</p></div></div>
                <span class="text-xs text-slate-400 group-open:hidden">▼</span><span class="text-xs text-slate-400 hidden group-open:inline">▲</span>
              </summary>
              <div class="px-5 pb-5 space-y-4 border-t border-slate-100 pt-4">
                <div class="grid grid-cols-2 gap-4">
                  <div class="bg-gradient-to-br from-blue-50 to-blue-100/50 rounded-xl p-4 text-center"><p class="text-xs text-blue-500 uppercase font-medium">Categoría</p><p class="text-xl font-bold text-blue-700 mt-1">{coordInfo.categoria || '—'}</p></div>
                  <div class="bg-gradient-to-br from-slate-50 to-slate-100/50 rounded-xl p-4 text-center"><p class="text-xs text-slate-500 uppercase font-medium">Puntuación</p><p class="text-xl font-bold text-slate-700 mt-1">{pctRaw((coordInfo.puntos_obtenidos||0)/75*100, (coordInfo.puntos_obtenidos||0)/5, 15)}</p></div>
                </div>
                {coordInfo.comentarios && <div class="bg-slate-50 rounded-xl p-4 border border-slate-100"><p class="text-xs font-medium text-slate-400 uppercase mb-1">Observaciones</p><p class="text-sm text-slate-600 italic">"{coordInfo.comentarios}"</p></div>}
                {coordSecciones.map(sec => {
                  const pares = sec.keys.map((k,i) => ({ texto: sec.items[i], score: coordInfo[k] })).filter(p => p.score != null);
                  if (pares.length === 0) return <></>;
                  return <div class="bg-slate-50 rounded-xl p-4"><p class="text-xs font-semibold text-slate-500 uppercase mb-2">{sec.icon} {sec.label}</p><div class="space-y-2">{pares.map((p,i) => <div class="flex items-center justify-between gap-3 bg-white rounded-lg px-3 py-2"><p class="text-xs text-slate-600 flex-1">{p.texto}</p><span class={"px-2 py-0.5 rounded-md text-xs font-bold flex-shrink-0 "+(p.score>=4?"bg-emerald-100 text-emerald-700":p.score>=3?"bg-amber-100 text-amber-700":"bg-red-50 text-red-600")}>{p.score}</span></div>)}</div></div>;
                })}
              </div>
            </details>
          )}

              {versionedObsFeedback.map((entry, index) => {
                const submission: any = entry.submission;
                const snapshot: any = submission.definition_snapshot || {};
                const metadata: any = submission.metadata || {};
                const sections: any[] = Array.isArray(snapshot.sections) ? snapshot.sections : [];
                const comments = [
                  ['Fortalezas', metadata.strengths],
                  ['Área prioritaria de mejora', metadata.priority_area],
                  ['Recomendación', metadata.recommendation],
                  ['Observaciones generales', metadata.general_observations],
                ].filter(([, text]) => typeof text === 'string' && text.trim());
                return (
                <details class="bg-white rounded-2xl shadow-tarjeta group overflow-hidden">
                  <summary class="font-semibold text-tup cursor-pointer list-none flex items-center justify-between px-5 py-4 hover:bg-slate-50">
                    <div class="flex items-center gap-3"><span class="w-10 h-10 rounded-xl bg-teal-100 flex items-center justify-center text-lg">👁️</span><div><p class="text-sm">{snapshot.title || 'Observación de Clase'}</p><p class="text-xs text-slate-400 font-normal">{versionedObservationScore(submission)} · {versionedObservationStatus(submission.validity_status)}</p></div></div>
                    <span class="text-xs text-slate-400 group-open:hidden">▼</span><span class="text-xs text-slate-400 hidden group-open:inline">▲</span>
                  </summary>
                  <div class="px-5 pb-5 space-y-4 border-t border-slate-100 pt-4">
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                      <div class="bg-gradient-to-br from-teal-50 to-teal-100/50 rounded-xl p-4 text-center"><p class="text-xs text-teal-500 uppercase font-medium">Puntaje</p><p class="text-xl font-bold text-teal-700 mt-1">{versionedObservationScore(submission)}</p></div>
                      <div class="bg-slate-50 rounded-xl p-4"><p class="text-xs text-slate-400">Versión</p><p class="text-sm font-medium text-slate-700">{snapshot.version || '—'}</p></div>
                      <div class="bg-slate-50 rounded-xl p-4"><p class="text-xs text-slate-400">Evaluada</p><p class="text-sm font-medium text-slate-700">{fmtDate(submission.submitted_at)}</p></div>
                      <div class="bg-slate-50 rounded-xl p-4"><p class="text-xs text-slate-400">Reactivos</p><p class="text-sm font-medium text-slate-700">{submission.applicable_item_count ?? '—'} · N/A: {submission.na_count ?? 0}</p></div>
                    </div>
                    <div class="grid grid-cols-2 md:grid-cols-3 gap-2 text-xs text-slate-600"><div><span class="text-slate-400">Grupo:</span> {submission.grupo || '—'}</div><div><span class="text-slate-400">Instrumento:</span> {snapshot.definition_code || '—'}</div><div><span class="text-slate-400">Estado:</span> {versionedObservationStatus(submission.validity_status)}</div></div>
                    {sections.map((section: any) => {
                      const items = Array.isArray(section.items) ? section.items : [];
                      const renderedItems = items.filter((item: any) => entry.answersByItem[item.id]);
                      if (renderedItems.length === 0 && !entry.evidenceBySection[section.id]) return <></>;
                      return <div class="bg-slate-50 rounded-xl p-4"><p class="text-xs font-semibold text-slate-500 uppercase mb-2">{section.title || section.code || 'Sección'}</p><div class="space-y-2">{renderedItems.map((item: any) => { const answer = entry.answersByItem[item.id]; return <div class="flex items-center justify-between gap-3 bg-white rounded-lg px-3 py-2"><p class="text-xs text-slate-600 flex-1">{item.code ? `${item.code}. ` : ''}{item.label || item.texto}</p><span class="px-2 py-0.5 rounded-md text-xs font-bold flex-shrink-0 bg-teal-100 text-teal-700">{versionedObservationAnswerLabel(answer, snapshot)}</span></div>; })}</div>{entry.evidenceBySection[section.id] && <p class="mt-3 pt-3 border-t border-slate-200 text-xs text-slate-600 whitespace-pre-line"><span class="font-medium text-slate-400">Evidencia / comentario de sección:</span> {entry.evidenceBySection[section.id]}</p>}</div>;
                    })}
                    {comments.length > 0 && <div class="space-y-3">{comments.map(([label, text]) => <div class="bg-white rounded-lg p-3 border border-slate-200"><p class="text-xs font-medium text-slate-400 uppercase mb-1">{label}</p><p class="text-sm text-slate-600 whitespace-pre-line">{text as string}</p></div>)}</div>}
                  </div>
                </details>
                );
              })}

              {obsInfo && (() => {
                let obsTotal = 0, obsScored = 0;
            for (const sec of obsSecciones) {
              for (const k of sec.keys) {
                const v = obsInfo[k];
                if (v != null && v !== 0) { obsTotal += v; obsScored++; }
              }
            }
            const obsPct = obsScored > 0 ? Math.round(obsTotal / (obsScored * 5) * 100) : null;
            return (
            <details class="bg-white rounded-2xl shadow-tarjeta group overflow-hidden">
              <summary class="font-semibold text-tup cursor-pointer list-none flex items-center justify-between px-5 py-4 hover:bg-slate-50">
                <div class="flex items-center gap-3"><span class="w-10 h-10 rounded-xl bg-teal-100 flex items-center justify-center text-lg">👁️</span><div><p class="text-sm">Observación de Clase</p><p class="text-xs text-slate-400 font-normal">{obsPct != null ? `${obsPct}% (${Math.round(obsTotal/5)}/${obsScored})` : obsScored > 0 ? `${obsScored} ítems` : 'Sin evaluar'}</p></div></div>
                <span class="text-xs text-slate-400 group-open:hidden">▼</span><span class="text-xs text-slate-400 hidden group-open:inline">▲</span>
              </summary>
              <div class="px-5 pb-5 space-y-3 border-t border-slate-100 pt-4">
                {obsInfo.comentario_evaluador && <div class="bg-slate-50 rounded-xl p-4 border border-slate-100"><p class="text-xs font-medium text-slate-400 uppercase mb-1">Comentario del Evaluador</p><p class="text-sm text-slate-600 italic">"{obsInfo.comentario_evaluador}"</p></div>}
                {obsInfo.comentario_docente && <div class="bg-slate-50 rounded-xl p-4 border border-slate-100"><p class="text-xs font-medium text-slate-400 uppercase mb-1">Comentario del Docente</p><p class="text-sm text-slate-600 italic">"{obsInfo.comentario_docente}"</p></div>}
                {obsSecciones.map(sec => {
                  const pares = sec.keys.map((k,i) => ({ texto: sec.items[i], score: obsInfo[k] })).filter(p => p.score != null);
                  if (pares.length === 0) return <></>;
                  return <div class="bg-slate-50 rounded-xl p-4"><p class="text-xs font-semibold text-slate-500 uppercase mb-2">{sec.icon} {sec.label}</p><div class="space-y-2">{pares.map(p => <div class="flex items-center justify-between gap-3 bg-white rounded-lg px-3 py-2"><p class="text-xs text-slate-600 flex-1">{p.texto}</p><span class={"px-2 py-0.5 rounded-md text-xs font-bold flex-shrink-0 "+(p.score>=4?"bg-emerald-100 text-emerald-700":p.score>=3?"bg-amber-100 text-amber-700":p.score===0?"bg-slate-100 text-slate-500":"bg-red-50 text-red-600")}>{p.score===0?'N/A':p.score}</span></div>)}</div></div>;
                })}
              </div>
            </details>
            );
          })()}

          {planFeedback.length > 0 && (
            <details class="bg-white rounded-2xl shadow-tarjeta group overflow-hidden">
              <summary class="font-semibold text-tup cursor-pointer list-none flex items-center justify-between px-5 py-4 hover:bg-slate-50">
                <div class="flex items-center gap-3"><span class="w-10 h-10 rounded-xl bg-amber-100 flex items-center justify-center text-lg">📄</span><div><p class="text-sm">Planeación Didáctica</p><p class="text-xs text-slate-400 font-normal">{planFeedback.length} evaluación{planFeedback.length>1?'es':''}</p></div></div>
                <span class="text-xs text-slate-400 group-open:hidden">▼</span><span class="text-xs text-slate-400 hidden group-open:inline">▲</span>
              </summary>
              <div class="px-5 pb-5 space-y-4 border-t border-slate-100 pt-4">
                {planFeedback.map((p,i)=>(
                  <div class="bg-slate-50 rounded-xl p-4 border border-slate-100">
                    <div class="flex items-center justify-between mb-3"><div><p class="text-sm font-medium text-slate-700">{p.asignaturas?.nombre || 'Planeación'}{p.grupo ? ` · Grupo ${p.grupo}` : ''}</p><p class="text-xs text-slate-400">Evaluación #{i+1}</p></div><span class={"px-2.5 py-1 rounded-lg text-xs font-medium "+(p.estado==='Aprobado'?'bg-emerald-100 text-emerald-700':p.estado==='Corrección'?'bg-red-100 text-red-600':'bg-amber-100 text-amber-700')}>{p.estado||'Pendiente'}</span></div>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-3"><div class="bg-white rounded-lg p-3 text-center"><p class="text-xs text-slate-400">Puntaje</p><p class="text-lg font-bold text-slate-700">{planningScoreLabel(p.puntaje_promedio, p.evaluacion_detalle)}</p></div><div class="bg-white rounded-lg p-3"><p class="text-xs text-slate-400">Subida</p><p class="text-xs font-medium text-slate-700">{fmtDate(p.first_teacher_submitted_at || p.fecha_subida)}</p></div><div class="bg-white rounded-lg p-3"><p class="text-xs text-slate-400">Evaluada</p><p class="text-xs font-medium text-slate-700">{fmtDate(p.fecha_evaluacion)}</p></div><div class="bg-white rounded-lg p-3"><p class="text-xs text-slate-400">Archivo</p>{p.url_pdf ? <a href={p.url_pdf} target="_blank" rel="noreferrer" class="text-xs font-medium text-tup hover:underline">{p.nombre_archivo || 'Ver PDF'}</a> : <p class="text-xs text-slate-400">—</p>}</div></div><div class="grid grid-cols-2 md:grid-cols-4 gap-2 mb-3 text-xs text-slate-600"><div><span class="text-slate-400">Modalidad:</span> {p.modalidad || '—'}</div><div><span class="text-slate-400">Proyecto:</span> {p.proyecto ? 'Sí' : 'No'}</div><div><span class="text-slate-400">Laboratorio:</span> {p.laboratorio || '—'}</div><div><span class="text-slate-400">Visitas:</span> {p.visitas || '—'}</div></div><div class="mb-3 text-xs text-slate-600"><span class="text-slate-400">Grupos cubiertos:</span> {(p.grupos_cubiertos || [p.grupo]).filter(Boolean).join(' · ') || '—'}</div>
                    {p.estado === 'Corrección' && <div class="bg-red-50 rounded-lg p-3 border border-red-200 mt-2"><p class="text-xs font-medium text-red-700 uppercase mb-1">Motivo de corrección</p><p class="text-sm text-red-800 whitespace-pre-line">{p.comentario_retroalimentacion || 'No se registró un motivo de corrección.'}</p></div>}
                    {p.evaluacion_detalle && <div class="space-y-3 mt-2">{planeacionCats.map(cat => { const det = ((p.evaluacion_detalle||{})[cat.id] || undefined) as PlanningDetail | undefined; if (!det || det.score === 'na') return <></>; const mini = planningMiniFeedback(cat, det); return <div class="bg-white rounded-lg px-3 py-3"><div class="flex items-center justify-between gap-3"><p class="text-xs font-semibold text-slate-700 flex-1">{cat.label}</p><span class={"px-2 py-0.5 rounded-md text-xs font-bold flex-shrink-0 "+(det.score==='2'||det.score===2?'bg-emerald-100 text-emerald-700':det.score==='1'||det.score===1?'bg-amber-100 text-amber-700':det.score==='na'?'bg-slate-100 text-slate-500':'bg-red-50 text-red-600')}>{planeacionScoreMap[String(det.score)]||det.score}</span></div>{mini.length > 0 && <ul class="mt-2 space-y-1 pl-4 list-disc">{mini.map(text => <li class="text-xs text-slate-600 leading-relaxed">{text}</li>)}</ul>}{det.otros && <p class="mt-2 pt-2 border-t border-slate-100 text-xs text-slate-600"><span class="font-medium text-slate-400">Comentario adicional:</span> {det.otros}</p>}</div>; })}{planningNaCount(p.evaluacion_detalle) > 0 && <p class="text-xs text-slate-500">{planningNaCount(p.evaluacion_detalle)} de {planeacionCats.length} criterios marcados como “No aplica”.</p>}</div>}
                    {p.estado !== 'Corrección' && p.comentario_retroalimentacion && <div class="bg-white rounded-lg p-3 border border-slate-200 mt-2"><p class="text-xs font-medium text-slate-400 uppercase mb-1">Retroalimentación</p><p class="text-sm text-slate-600 italic">"{p.comentario_retroalimentacion}"</p></div>}
                    {(p.comentario_docente || p.observaciones_generales) && <div class="space-y-2 mt-2">{p.comentario_docente && <div class="bg-white rounded-lg p-3 border border-slate-200"><p class="text-xs font-medium text-slate-400 uppercase mb-1">Comentario del docente</p><p class="text-sm text-slate-600 whitespace-pre-line">{p.comentario_docente}</p></div>}{p.observaciones_generales && <div class="bg-white rounded-lg p-3 border border-slate-200"><p class="text-xs font-medium text-slate-400 uppercase mb-1">Observaciones generales</p><p class="text-sm text-slate-600 whitespace-pre-line">{p.observaciones_generales}</p></div>}</div>}
                  </div>
                ))}
              </div>
            </details>
          )}

        </div>
      </div>
    )}
    <!-- Accesos rápidos -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <a href={`/docente/autodiagnostico?cuatrimestre=${cuatrimestreId}`} class="bg-white rounded-2xl p-5 shadow-tarjeta hover:shadow-tarjeta-hover transition-all text-center">
        <p class="text-lg font-semibold text-tup">🧪 Autodiagnóstico</p>
        <p class="text-sm text-slate-500 mt-1">24 reactivos de auto-evaluación</p>
      </a>
      <a href={`/docente/planeaciones?cuatrimestre=${cuatrimestreId}`} class="bg-white rounded-2xl p-5 shadow-tarjeta hover:shadow-tarjeta-hover transition-all text-center">
        <p class="text-lg font-semibold text-tup">📄 Planeaciones</p>
        <p class="text-sm text-slate-500 mt-1">Sube tus planeaciones didácticas</p>
      </a>
    </div>
  </div>
</LayoutDocente>

<script>
  import Chart from 'chart.js/auto';
  document.addEventListener('DOMContentLoaded', () => {
    const canvas = document.getElementById('chart-docente');
    if (!(canvas instanceof HTMLCanvasElement)) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const data = JSON.parse(canvas.dataset.chart || '[]');
    new Chart(ctx, {
      type: 'bar',
      data: {
        labels: ['Est.','Coord.','Plan.','Obs.','Auto.'],
        datasets: [{ data, backgroundColor: ['#22c55e','#3b82f6','#a855f7','#f59e0b','#f97316'], borderRadius: 6, borderWidth: 0 }]
      },
      options: {
        responsive: true, maintainAspectRatio: true,
        scales: { y: { beginAtZero: true, max: 100, grid: { color: 'rgba(148,163,184,0.1)' }, ticks: { font: { size: 10 } } }, x: { ticks: { font: { size: 9 } } } },
        plugins: { legend: { display: false }, tooltip: { callbacks: { label: function(context) { return Number(context.raw).toFixed(1); } } } }
      }
    });
  });
</script>
