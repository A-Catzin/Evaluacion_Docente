              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {feedbackCards(feedback360.feedback_text).length === 0 ? (
                  <div class="rounded-2xl border border-dashed border-slate-200 p-4 text-sm text-slate-400 sm:col-span-2">—</div>
