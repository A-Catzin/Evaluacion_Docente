            <div class="flex items-center gap-3"><span class="w-10 h-10 rounded-xl bg-indigo-100 flex items-center justify-center text-lg">🎓</span><div><p class="text-sm">{summary.title}</p><p class="text-xs text-slate-400 font-normal">{formatScore(summary.score)}% · {summary.responses} respuesta(s)</p></div></div>
            <span class="text-xs text-slate-400 group-open:hidden">▼</span><span class="text-xs text-slate-400 hidden group-open:inline">▲</span>
          </summary>
          <div class="px-5 pb-5 space-y-4 border-t border-slate-100 pt-4">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
              <div class="bg-gradient-to-br from-indigo-50 to-indigo-100/50 rounded-xl p-4 text-center"><p class="text-xs text-indigo-500 uppercase font-medium">Puntaje</p><p class="text-xl font-bold text-indigo-700 mt-1">{formatScore(summary.score)}%</p></div>
              <div class="bg-slate-50 rounded-xl p-4"><p class="text-xs text-slate-400">Versión</p><p class="text-sm font-medium text-slate-700">{summary.instrument === 'general-19' ? 'v2' : 'V1.1'}</p></div>
              <div class="bg-slate-50 rounded-xl p-4"><p class="text-xs text-slate-400">Respuestas</p><p class="text-sm font-medium text-slate-700">{summary.responses}</p></div>
              <div class="bg-slate-50 rounded-xl p-4"><p class="text-xs text-slate-400">Reactivos</p><p class="text-sm font-medium text-slate-700">{summary.items.length} · Escala 1–5</p></div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-xs text-slate-600"><div><span class="text-slate-400">Instrumento:</span> {summary.code}</div><div><span class="text-slate-400">Grupos:</span> todos (resultado general)</div></div>
