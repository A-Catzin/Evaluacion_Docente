---
import LayoutDocente from '../../layouts/LayoutDocente.astro';
import { obtenerCuatrimestreActivo, obtenerCuatrimestres } from '../../services/catalogos';
import { db, dbAdmin } from '../../lib/db';
import { buildVersionedObservationFeedback } from '../../lib/versionedObservationFeedback';
import { obtenerCalificacionDocente } from '../../services/calificaciones';
import { formatScore } from '../../services/scoring';
import { buildStudentSurveySummaries, type StudentSurveySummary } from '../../lib/studentSurveyQuestions';

const token = Astro.cookies.get('sb-access-token')?.value;
const refresh = Astro.cookies.get('sb-refresh-token')?.value;
if (!token || !refresh) return Astro.redirect('/auth');

const cl = db();
const { data: sesion } = await cl.auth.setSession({ access_token: token, refresh_token: refresh });
if (!sesion.user) return Astro.redirect('/auth');

const cuatrimestreActivo = await obtenerCuatrimestreActivo(cl);
const cuatrimestres = await obtenerCuatrimestres(cl);
const cuatrimestreIdParam = Astro.url.searchParams.get('cuatrimestre');
const cuatrimestreIdCookie = Astro.cookies.get('cuatrimestre_sel')?.value;
const cuatrimestreFallback = cuatrimestres[0];
const cuatrimestreId = [
  parseInt(cuatrimestreIdParam || ''),
  cuatrimestreActivo?.id,
  parseInt(cuatrimestreIdCookie || ''),
  cuatrimestreFallback?.id,
].find((id): id is number => Number.isInteger(id) && cuatrimestres.some(c => c.id === id)) || 0;

// Persistir seleccion en cookie para otras paginas
if (cuatrimestreId) {
  Astro.cookies.set('cuatrimestre_sel', String(cuatrimestreId), { path: '/', maxAge: 60*60*24*30 });
}
const { data: usuario } = await cl.from('usuarios').select('entidad_id,email').eq('id', sesion.user.id).maybeSingle();
let docenteId = usuario?.entidad_id;
let docenteEmail = usuario?.email || '';

// Buscar todos los docentes que corresponden a este usuario (por entidad_id, email, y nombre)
let docenteIdsSet = new Set<number>();
// Identity-linked records are safe for the service-role versioned read.
// Name matches remain available only for the legacy dashboard fallback.
let docenteIdsAutorizadosSet = new Set<number>();
if (docenteId) {
  docenteIdsSet.add(docenteId);
  docenteIdsAutorizadosSet.add(docenteId);
  // Obtener nombre del docente vinculado para buscar coincidencias por nombre
  const { data: miDoc } = await cl.from('docentes').select('nombre,apellidos').eq('id', docenteId).maybeSingle();
  if (miDoc?.nombre && miDoc?.apellidos) {
    const { data: mismosNombres } = await cl.from('docentes').select('id').eq('nombre', miDoc.nombre).eq('apellidos', miDoc.apellidos);
    (mismosNombres||[]).forEach(d => docenteIdsSet.add(d.id));
  }
}
if (docenteEmail) {
  const { data: docsMatch } = await cl.from('docentes').select('id').eq('email', docenteEmail);
  (docsMatch||[]).forEach(d => {
docenteIdsSet.add(d.id);
docenteIdsAutorizadosSet.add(d.id);
  });
}
const docenteIds: number[] = [...docenteIdsSet];
const docenteIdsAutorizados: number[] = [...docenteIdsAutorizadosSet];

// Calificación final precalculada para el docente principal y el ciclo activo.
const docenteIdParaScore = docenteId || docenteIds[0] || null;
const calificacionFinal = docenteIdParaScore && cuatrimestreId > 0
  ? await obtenerCalificacionDocente(cl, docenteIdParaScore, cuatrimestreId)
  : null;

let scores = { promEst: undefined as number | undefined, promCoord: undefined as number | undefined, promPlan: undefined as number | undefined, promObs: undefined as number | undefined, promAuto: undefined as number | undefined, final360: null as number|null, cat360: 'No iniciado', instrumentos: 0, instrumentosEsperados: 5 };
if (calificacionFinal) {
  scores.promEst = calificacionFinal.score_encuesta_estudiantil ?? undefined;
  scores.promCoord = calificacionFinal.score_coordinacion ?? undefined;
  scores.promPlan = calificacionFinal.score_planeacion ?? undefined;
  scores.promObs = calificacionFinal.score_observacion ?? undefined;
  scores.promAuto = calificacionFinal.score_autoevaluacion ?? undefined;
  scores.final360 = calificacionFinal.calificacion_final;
  scores.cat360 = calificacionFinal.categoria_final;
  scores.instrumentos = calificacionFinal.num_instrumentos_completados;
  scores.instrumentosEsperados = calificacionFinal.num_instrumentos_esperados;
}
let nombreDocente = '';
let diagInfo: any = null;
let coordInfo: any = null;
let planFeedback: any[] = [];
let obsInfo: any = null;
let versionedObsFeedback: ReturnType<typeof buildVersionedObservationFeedback> = [];
let feedback360: any = null;

// Cargar textos de preguntas desde BD (editables via /admin/instrumentos)
const { data: preguntasAD } = await cl.from('instrumento_preguntas').select('texto').eq('instrumento','autodiagnostico').eq('activa',true).order('orden');
const diagPreguntas = (preguntasAD||[]).map(p=>p.texto);
const { data: preguntasCoord } = await cl.from('instrumento_preguntas').select('texto,seccion').eq('instrumento','coordinacion').eq('activa',true).order('orden');
const { data: preguntasObs } = await cl.from('instrumento_preguntas').select('texto,seccion').eq('instrumento','observacion').eq('activa',true).order('orden');
type Section = { icon: string; label: string; keys: string[]; items: string[] };

const obsSecciones: Section[] = [
  {icon:'🧠',label:'A. Cognitivas',keys:['cco1','cco2','cco3','cco4','cco5','cco6','cco7'],items:[]},
  {icon:'🔄',label:'B. Metacognitivas',keys:['cme1','cme2','cme3','cme4','cme5','cme6','cme7','cme8','cme9'],items:[]},
  {icon:'💬',label:'C. Comunicativas',keys:['ccom1','ccom2','ccom3','ccom4'],items:[]},
  {icon:'👥',label:'D. Sociales',keys:['cso1','cso2','cso3','cso4'],items:[]},
  {icon:'📊',label:'E. Gestión de la Enseñanza',keys:['cge1','cge2','cge3','cge4','cge5','cge6','cge7'],items:[]},
  {icon:'❤️',label:'F. Afectivas',keys:['caf1','caf2'],items:[]},
  {icon:'💻',label:'G. Tecno-Pedagógicas',keys:['ctepe1','ctepe2','ctepe3','ctepe4','ctepe5','ctepe6','ctepe7'],items:[]},
  {icon:'📏',label:'H. Normativa',keys:['cno1','cno2','cno3','cno4','cno5'],items:[]}
];
const secObsMap: Record<string, string[]> = {};
(preguntasObs||[]).forEach(p=>{const s=p.seccion||'';if(!secObsMap[s])secObsMap[s]=[];secObsMap[s].push(p.texto);});
// Mapear letras de seccion DB (A,B,C...) a prefijos de keys (cco,cme,ccom...)
const obsLetraPrefijo = {A:'cco',B:'cme',C:'ccom',D:'cso',E:'cge',F:'caf',G:'ctepe',H:'cno'};
obsSecciones.forEach(s=>{
  const p = s.keys[0].replace(/[0-9]/g,'');
  const letra = Object.entries(obsLetraPrefijo).find(([,v])=>v===p)?.[0];
  s.items = secObsMap[letra||p] || s.items;
});

// Cargar categorias de planeacion desde BD
const { data: planCats } = await cl.from('instrumento_preguntas').select('*').eq('instrumento','planeacion').eq('tipo_respuesta','categoria').eq('activa',true).order('orden');
type PlanningCategory = { id: string; label: string; options: Record<string, unknown> };
type PlanningDetail = { score?: string | number; obs?: unknown; otros?: string | null };
const planeacionCats: PlanningCategory[] = (planCats||[]).map(c => ({ id: c.seccion, label: `${c.orden}. ${c.texto}`, options: (c.opciones || {}) as Record<string, unknown> }));
const coordSecciones: Section[] = [
  {icon:'📋',label:'A. Cumplimiento Académico',keys:['a1','a2','a3'],items:[]},
  {icon:'📊',label:'B. Gestión y Organización',keys:['b1','b2','b3'],items:[]},
  {icon:'💬',label:'C. Desempeño Profesional y Comunicación',keys:['c1','c2','c3'],items:[]},
  {icon:'💡',label:'D. Innovación y Mejora Continua',keys:['d1','d2','d3'],items:[]},
  {icon:'🏛️',label:'E. Compromiso Institucional y Ética',keys:['e1','e2','e3'],items:[]}
];
const secCoordMap: Record<string, string[]> = {};
(preguntasCoord||[]).forEach(p=>{const s=p.seccion||'';if(!secCoordMap[s])secCoordMap[s]=[];secCoordMap[s].push(p.texto);});
coordSecciones.forEach(s=>{s.items = secCoordMap[s.keys[0].replace(/[0-9]/g,'').toUpperCase()] || s.items;});
const planeacionScoreMap: Record<string, string> = { '2': 'Satisfactorio', '1': 'Suficiente', '0': 'Insuficiente', na: 'No aplica' };

// Anonymous by design: validated comment text only, and survey results aggregated per
// instrument across all groups. Both RPCs resolve the teacher from the session.
let comentariosEstudiantes: string[] = [];
let evaluacionEstudiantil: StudentSurveySummary[] = [];
if (cuatrimestreId) {
  const [comentariosResult, evaluacionResult] = await Promise.all([
    cl.rpc('obtener_comentarios_estudiantiles_validados', { p_cuatrimestre_id: cuatrimestreId }),
    cl.rpc('obtener_evaluacion_estudiantil_docente', { p_cuatrimestre_id: cuatrimestreId }),
  ]);
  if (comentariosResult.error) {
    console.error('[teacher dashboard] validated student comments unavailable', { code: comentariosResult.error.code });
  } else {
    comentariosEstudiantes = ((comentariosResult.data || []) as { comentario: string }[]).map((row) => row.comentario);
  }
  if (evaluacionResult.error) {
    console.error('[teacher dashboard] student survey summary unavailable', { code: evaluacionResult.error.code });
  } else {
    evaluacionEstudiantil = buildStudentSurveySummaries(evaluacionResult.data || []);
  }
}

if (docenteIds.length > 0) {
  const { data: doc } = await cl.from('docentes').select('nombre,apellidos').eq('id', docenteIds[0]).maybeSingle();
  if (doc) nombreDocente = `${doc.nombre.toUpperCase()} ${doc.apellidos.toUpperCase()}`;

  const [{ data: coordData }, { data: planData }, { data: obsData }, { data: diagData }] = await Promise.all([
    cl.from('evaluacion_coordinacion').select('score_normalizado,categoria,comentarios,puntos_obtenidos,a1,a2,a3,b1,b2,b3,c1,c2,c3,d1,d2,d3,e1,e2,e3').in('docente_id', docenteIds).eq('cuatrimestre_id', cuatrimestreId).order('id', { ascending: false }).limit(1),
    cl.from('planeaciones').select('puntaje_promedio,comentario_docente,comentario_retroalimentacion,estado,observaciones_generales,evaluacion_detalle,grupo,grupos_cubiertos,modalidad,proyecto,laboratorio,visitas,url_pdf,nombre_archivo,fecha_subida,fecha_evaluacion,first_teacher_submitted_at,latest_teacher_submitted_at,asignaturas(nombre)').in('docente_id', docenteIds).eq('cuatrimestre_id', cuatrimestreId).in('estado', ['Aprobado', 'Corrección']).order('fecha_subida', { ascending: false }),
    cl.from('observaciones').select('id,docente_id,cco1,cco2,cco3,cco4,cco5,cco6,cco7,cme1,cme2,cme3,cme4,cme5,cme6,cme7,cme8,cme9,ccom1,ccom2,ccom3,ccom4,cso1,cso2,cso3,cso4,cge1,cge2,cge3,cge4,cge5,cge6,caf1,caf2,ctepe1,ctepe2,ctepe3,ctepe4,ctepe5,ctepe6,ctepe7,cno1,cno2,cno3,cno4,cno5,comentario_evaluador,comentario_docente,obs_cognitivas,obs_metacognitivas,obs_comunicativas,obs_sociales,obs_gestion,obs_afectivas,obs_tecno,obs_normativa,fecha_observacion').in('docente_id', docenteIds).eq('cuatrimestre_id', cuatrimestreId).order('fecha_observacion', { ascending: false }).order('id', { ascending: false }),
    cl.from('autodiagnosticos').select('*').in('docente_id', docenteIds).eq('cuatrimestre_id', cuatrimestreId).order('id', { ascending: false }).limit(1),
  ]);

  // Feedback
  coordInfo = coordData?.[0] || null;
  planFeedback = planData || [];
  // Some historical aggregate rows do not carry the planning score even
  // though the teacher has an approved planning record. Use that record as
  // the dashboard chart source without changing the persisted final score.
  if (scores.promPlan == null) {
    const approvedPlanningScores = planFeedback
      .filter((plan) => plan.estado === 'Aprobado' && plan.puntaje_promedio != null)
      .map((plan) => Number(plan.puntaje_promedio))
      .filter((score) => Number.isFinite(score));
    if (approvedPlanningScores.length > 0) {
      scores.promPlan = approvedPlanningScores.reduce((sum, score) => sum + score, 0) / approvedPlanningScores.length;
    }
  }
      obsInfo = obsData?.[0] || null;

      // Versioned observations are the source of truth for the current instrument.
      // Use the admin read path only after the session has resolved the teacher IDs,
      // so the server never exposes another teacher's submissions.
      const versionedClient = dbAdmin();
      const { data: versionedSubmissions } = await versionedClient
        .from('instrument_submissions')
        .select('id,docente_id,cuatrimestre_id,purpose,validity_status,raw_score,normalized_score,na_count,applicable_item_count,definition_snapshot,metadata,submitted_at,asignatura_id,grupo,submitted_by,revision_kind,supersedes_submission_id')
        .in('docente_id', docenteIdsAutorizados)
        .eq('cuatrimestre_id', cuatrimestreId)
        .eq('purpose', 'observation')
        .order('submitted_at', { ascending: false });

      if (versionedSubmissions && versionedSubmissions.length > 0) {
        const submissionIds = versionedSubmissions.map((submission) => submission.id);
        const [{ data: versionedAnswers }, { data: versionedEvidence }] = await Promise.all([
          versionedClient
            .from('instrument_answers')
            .select('submission_id,item_id,numeric_value,is_na,na_reason')
            .in('submission_id', submissionIds),
          versionedClient
            .from('instrument_evidence')
            .select('submission_id,section_id,evidence')
            .in('submission_id', submissionIds),
        ]);
        versionedObsFeedback = buildVersionedObservationFeedback(
          versionedSubmissions,
          versionedAnswers || [],
          versionedEvidence || [],
        );
      }

      diagInfo = diagData?.[0] || null;
    
      const feedbackDocenteId = docenteId || docenteIds[0] || null;
  if (feedbackDocenteId) {
    const { data: feedbackActual } = await cl
      .from('docente_360_feedback')
      .select('docente_id,cuatrimestre_id,feedback_text,improvement_areas,created_at,updated_at')
      .eq('docente_id', feedbackDocenteId)
      .eq('cuatrimestre_id', cuatrimestreId)
      .maybeSingle();

    if (feedbackActual) {
      feedback360 = feedbackActual;
    } else {
      const { data: feedbackUltima } = await cl
        .from('docente_360_feedback')
        .select('docente_id,cuatrimestre_id,feedback_text,improvement_areas,created_at,updated_at')
        .eq('docente_id', feedbackDocenteId)
        .order('updated_at', { ascending: false })
        .limit(1)
        .maybeSingle();

      feedback360 = feedbackUltima || null;
    }
  }

}

function fmt(n:number|null|undefined):string{return formatScore(n);}
function colorN(n:number|null|undefined):string{return !n?'':n>=80?'text-emerald-600':n>=60?'text-amber-600':'text-red-600';}
function pctRaw(pct:number|null|undefined, raw:number|null|undefined, total:number):string {
  if (pct == null || raw == null) return '—';
  return `${Math.round(pct)}% (${Math.round(raw)}/${total})`;
}
function fmtDate(value: string | null | undefined): string {
  if (!value) return '—';
  return new Intl.DateTimeFormat('es-MX', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(value));
}
function versionedObservationScore(submission: any): string {
  if (submission.normalized_score != null) return `${formatScore(Number(submission.normalized_score))}%`;
  if (submission.raw_score != null) return formatScore(Number(submission.raw_score));
  return '—';
}
function versionedObservationAnswerLabel(answer: any, snapshot: any): string {
  if (!answer) return '—';
  if (answer.is_na) return answer.na_reason ? `N/A: ${answer.na_reason}` : 'N/A';
  const labels = snapshot?.scale?.labels || {};
  return labels[String(answer.numeric_value)] ? `${answer.numeric_value} — ${labels[String(answer.numeric_value)]}` : String(answer.numeric_value ?? '—');
}
function versionedObservationStatus(status: string | null | undefined): string {
  return status === 'valid' ? 'Válida' : status === 'invalid_excessive_na' ? 'Inválida por exceso de N/A' : status || '—';
}
function splitFeedback(text: string | null | undefined): string[] {
  return String(text ?? '')
    .split(/\n|\|/)
    .map((item) => item.trim())
    .filter(Boolean);
}
function feedbackCards(text: string | null | undefined) {
  return splitFeedback(text).map((item, index) => ({ id: index + 1, text: item }));
}
function planningPoints(detail: unknown): { sum: number; max: number; na: number } {
  const entries = Object.values((detail || {}) as Record<string, { score?: unknown }>);
  let sum = 0, max = 0, na = 0;
  for (const entry of entries) {
    const score = String(entry?.score ?? '');
    if (score === 'na') { na += 1; continue; }
    const value = Number.parseInt(score, 10);
    if (!Number.isFinite(value)) continue;
    sum += value;
    max += 2;
  }
  return { sum, max, na };
}
function planningNaCount(detail: unknown): number {
  return planningPoints(detail).na;
}
function planningScoreLabel(score: number | null | undefined, detail: unknown): string {
  const { sum, max } = planningPoints(detail);
  if (!max) return '—';
  return score != null ? `${formatScore(score)}% (${sum}/${max})` : `${sum}/${max}`;
}
function planningMiniFeedback(category: PlanningCategory, detail: PlanningDetail | undefined): string[] {
  if (!detail || detail.score == null || !Array.isArray(detail.obs)) return [];
  const catalog = category.options[`obs${String(detail.score)}`];
  if (!Array.isArray(catalog)) return [];
  return (detail.obs as unknown[])
    .map((index) => catalog[Number(index)])
    .filter((text): text is string => typeof text === 'string' && text.trim().length > 0);
}
---

<LayoutDocente titulo="Mi Evaluación — Docente">
  <div class="animate-flotar-entrada">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
      <div><h1 class="text-3xl font-bold text-tup">Mi Evaluación 360°</h1><p class="text-slate-500">{nombreDocente}</p></div>
      <form method="GET" class="flex items-center gap-2">
        <select name="cuatrimestre" class="rounded-xl border border-slate-200 px-3 py-2 text-sm" onchange="this.form.submit()">
          {cuatrimestres.map(c => (<option value={c.id} selected={c.id === cuatrimestreId}>{c.nombre}</option>))}
        </select>
      </form>
    </div>

    {docenteIds.length === 0 ? (
      <div class="bg-white rounded-2xl p-6 shadow-tarjeta text-center">Completa tu autodiagnóstico para ver tus resultados.</div>
    ) : (
      <>
        <!-- KPIs -->
        <div class="grid grid-cols-2 lg:grid-cols-5 gap-4 mb-8">
          <div class="bg-white rounded-2xl p-4 shadow-tarjeta text-center">
            <p class="text-xs text-slate-400 uppercase">Estudiantil</p>
            <p class={`text-2xl font-bold mt-1 ${colorN(scores.promEst)}`}>{fmt(scores.promEst)}</p>
          </div>
          <div class="bg-white rounded-2xl p-4 shadow-tarjeta text-center">
            <p class="text-xs text-slate-400 uppercase">Coordinación</p>
            <p class={`text-2xl font-bold mt-1 ${colorN(scores.promCoord)}`}>{fmt(scores.promCoord)}</p>
          </div>
          <div class="bg-white rounded-2xl p-4 shadow-tarjeta text-center">
            <p class="text-xs text-slate-400 uppercase">Planeación</p>
            <p class={`text-2xl font-bold mt-1 ${colorN(scores.promPlan)}`}>{fmt(scores.promPlan)}</p>
          </div>
          <div class="bg-white rounded-2xl p-4 shadow-tarjeta text-center">
            <p class="text-xs text-slate-400 uppercase">Observación</p>
            <p class={`text-2xl font-bold mt-1 ${colorN(scores.promObs)}`}>{fmt(scores.promObs)}</p>
          </div>
          <div class="bg-white rounded-2xl p-4 shadow-tarjeta text-center">
            <p class="text-xs text-slate-400 uppercase">Autodiagnóstico</p>
            <p class={`text-2xl font-bold mt-1 ${colorN(scores.promAuto)}`}>{fmt(scores.promAuto)}</p>
          </div>
        </div>

        <!-- Gráfico + Final -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
          <div class="lg:col-span-2 bg-white rounded-2xl p-6 shadow-tarjeta">
            <h3 class="text-sm font-semibold text-slate-700 mb-4">Mis Scores por Instrumento</h3>
            <div style="max-height:220px"><canvas id="chart-docente" data-chart={JSON.stringify([scores.promEst ?? null, scores.promCoord ?? null, scores.promPlan ?? null, scores.promObs ?? null, scores.promAuto ?? null])} style="max-height:220px"></canvas></div>
            <div class="grid grid-cols-2 sm:grid-cols-5 gap-2 mt-4 text-center">
              <div><p class="text-[10px] text-slate-400">Estudiantil</p><p class="text-xs font-semibold text-emerald-600">{fmt(scores.promEst)}</p></div>
              <div><p class="text-[10px] text-slate-400">Coordinación</p><p class="text-xs font-semibold text-blue-600">{fmt(scores.promCoord)}</p></div>
              <div><p class="text-[10px] text-slate-400">Planeación</p><p class="text-xs font-semibold text-purple-600">{fmt(scores.promPlan)}</p></div>
              <div><p class="text-[10px] text-slate-400">Observación</p><p class="text-xs font-semibold text-amber-600">{fmt(scores.promObs)}</p></div>
              <div><p class="text-[10px] text-slate-400">Autodiagnóstico</p><p class="text-xs font-semibold text-orange-600">{fmt(scores.promAuto)}</p></div>
            </div>
          </div>
          <div class="bg-white rounded-2xl p-6 shadow-tarjeta flex flex-col items-center justify-center text-center">
            <p class="text-xs text-slate-400 uppercase mb-2">Calificación Final</p>
            <p class="text-5xl font-bold text-tup">{fmt(scores.final360)}</p>
            <span class="px-2 py-1 rounded text-xs font-medium bg-slate-100 mt-2">{scores.cat360}</span>
            <p class="text-xs text-slate-400 mt-3">{scores.instrumentos}/{scores.instrumentosEsperados} instrumentos aplicables</p>
          </div>
        </div>
      </>
    )}

    <div class="mb-8">
      <details class="bg-white rounded-3xl shadow-tarjeta border border-tup/10 group overflow-hidden">
        <summary class="cursor-pointer list-none flex items-center justify-between gap-4 p-6 hover:bg-slate-50">
          <div>
            <p class="text-xs uppercase tracking-[0.25em] text-tup font-semibold">Encuesta estudiantil</p>
            <h2 class="text-2xl font-bold text-slate-800 mt-1">Comentarios de tus estudiantes</h2>
            <p class="text-sm text-slate-500 mt-1">{comentariosEstudiantes.length} comentario(s) anónimo(s) revisado(s) por el equipo académico.</p>
          </div>
          <span class="text-xs text-slate-400 group-open:hidden">▼</span><span class="text-xs text-slate-400 hidden group-open:inline">▲</span>
        </summary>
        <div class="px-6 pb-6 pt-4 border-t border-slate-200/70">
          {comentariosEstudiantes.length === 0 ? (
