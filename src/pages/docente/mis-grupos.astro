---
import LayoutDocente from '../../layouts/LayoutDocente.astro';
import { obtenerClienteSuperbase } from '../../lib/supabaseClient';
import { obtenerCuatrimestreActivo, obtenerCuatrimestres } from '../../services/catalogos';

const token = Astro.cookies.get('sb-access-token')?.value;
const refresh = Astro.cookies.get('sb-refresh-token')?.value;
if (!token || !refresh) return Astro.redirect('/auth');
const cl = obtenerClienteSuperbase();
const { data: s } = await cl.auth.setSession({ access_token: token, refresh_token: refresh });
if (!s.user) return Astro.redirect('/auth');
const { data: usuario } = await cl.from('usuarios').select('entidad_id,email').eq('id', s.user.id).maybeSingle();
let entidadId = usuario?.entidad_id;
if (!entidadId && usuario?.email) { const { data: doc } = await cl.from('docentes').select('id').eq('email', usuario.email).maybeSingle(); if (doc) entidadId = doc.id; }
if (!entidadId) return Astro.redirect('/docente/dashboard');

const cuatrimestreActivo = await obtenerCuatrimestreActivo();
const cuatrimestres = await obtenerCuatrimestres();
const cuatrimestreIdCookie = Astro.cookies.get('cuatrimestre_sel')?.value;
const cuatrimestreIdParam = Astro.url.searchParams.get('cuatrimestre');
const cuatrimestreId = parseInt(cuatrimestreIdParam || cuatrimestreIdCookie || '') || cuatrimestreActivo?.id || 0;

// Grupos del docente con asignatura + cuatrimestre
const { data: grupos } = await cl.from('grupos').select('id,clave,modalidad,asignatura_id,cuatrimestre_id, cuatrimestres(clave)').eq('docente_id', entidadId).eq('cuatrimestre_id', cuatrimestreId).order('clave');
const asigIds = [...new Set((grupos||[]).map(g=>g.asignatura_id))];
const { data: asigs } = asigIds.length>0 ? await cl.from('asignaturas').select('id,nombre').in('id', asigIds) : {data:[]};
const asigMap = new Map<number,string>(); (asigs||[]).forEach(a=>asigMap.set(a.id, a.nombre));

const { data: docente } = await cl.from('docentes').select('nombre,apellidos').eq('id', entidadId).maybeSingle();
---

<LayoutDocente titulo="Mis Grupos — Docente">
  <div class="animate-flotar-entrada max-w-4xl mx-auto">
    <div class="flex items-center justify-between mb-6">
      <div><h1 class="text-3xl font-bold text-tup">Mis Grupos</h1><p class="text-slate-500">{docente?.nombre?.toUpperCase()} {docente?.apellidos?.toUpperCase()}</p></div>
      <form method="GET" class="flex items-center gap-2">
        <select name="cuatrimestre" class="rounded-xl border border-slate-200 px-3 py-2 text-sm" onchange="this.form.submit()">
          {cuatrimestres.map(c => (<option value={c.id} selected={c.id===cuatrimestreId}>{c.clave}</option>))}
        </select>
      </form>
    </div>

    {(grupos||[]).length === 0 ? (
      <div class="bg-white rounded-2xl p-12 text-center text-slate-400 shadow-tarjeta">No tienes grupos asignados en este cuatrimestre.</div>
    ) : (
      <div class="bg-white rounded-2xl shadow-tarjeta overflow-hidden">
        <table class="w-full text-sm">
          <thead><tr class="bg-slate-50 border-b">
            <th class="text-left px-4 py-3 text-xs uppercase">Asignatura</th>
            <th class="text-left px-4 py-3 text-xs uppercase">Grupo</th>
            <th class="text-center px-4 py-3 text-xs uppercase">Modalidad</th>
            <th class="text-center px-4 py-3 text-xs uppercase">Cuatrimestre</th>
          </tr></thead>
          <tbody class="divide-y">{(grupos||[]).map(g => {
            const cuatri = (g as any).cuatrimestres as {clave?:string} | null;
            return <tr class="hover:bg-slate-50">
              <td class="px-4 py-3 font-medium text-xs">{asigMap.get(g.asignatura_id) || '—'}</td>
              <td class="px-4 py-3 text-xs">{g.clave}</td>
              <td class="px-4 py-3 text-center text-xs">{g.modalidad || '—'}</td>
              <td class="px-4 py-3 text-center"><span class="text-xs bg-slate-100 px-2 py-0.5 rounded">{cuatri?.clave || ''}</span></td>
            </tr>;
          })}</tbody>
        </table>
      </div>
    )}
  </div>
</LayoutDocente>
