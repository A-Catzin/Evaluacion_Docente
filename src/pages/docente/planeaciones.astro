---
import LayoutDocente from '../../layouts/LayoutDocente.astro';
import { obtenerClienteSuperbase } from '../../lib/supabaseClient';
import { obtenerCuatrimestreActivo, obtenerCuatrimestres } from '../../services/catalogos';

const token = Astro.cookies.get('sb-access-token')?.value;
const refresh = Astro.cookies.get('sb-refresh-token')?.value;
if (!token || !refresh) return Astro.redirect('/auth');
const cl = obtenerClienteSuperbase();
const { data: sesion } = await cl.auth.setSession({ access_token: token, refresh_token: refresh });
if (!sesion.user) return Astro.redirect('/auth');
const { data: usuario } = await cl.from('usuarios').select('entidad_id,rol,email').eq('id', sesion.user.id).maybeSingle();
if (!usuario || usuario.rol !== 'docente') return Astro.redirect('/docente/dashboard');

// Si no tiene entidad_id, buscar por email
let entidadId = usuario.entidad_id;
if (!entidadId && usuario.email) {
  const { data: doc } = await cl.from('docentes').select('id').eq('email', usuario.email).maybeSingle();
  if (doc) entidadId = doc.id;
}
if (!entidadId) return Astro.redirect('/docente/dashboard');

const cuatrimestreActivo = await obtenerCuatrimestreActivo();
const cuatrimestres = await obtenerCuatrimestres();
const cuatrimestreIdParam = Astro.url.searchParams.get('cuatrimestre');
const cuatrimestreId = parseInt(cuatrimestreIdParam || '') || cuatrimestreActivo?.id || 0;
const cuatrimestre = cuatrimestres.find(c=>c.id===cuatrimestreId) || cuatrimestreActivo;
// Materias asignadas al docente via grupos
const { data: gruposDocente } = await cl.from('grupos').select('id,clave,asignatura_id,modalidad').eq('docente_id', entidadId);
const materiasIds = [...new Set((gruposDocente||[]).map(g => g.asignatura_id))];
const { data: misAsignaturas } = materiasIds.length > 0 ? await cl.from('asignaturas').select('id,clave,nombre').in('id', materiasIds).order('nombre') : { data: [] };
const { data: docente } = await cl.from('docentes').select('campus,turno').eq('id', entidadId).maybeSingle();
const { data: planeacionesRaw } = await cl.from('planeaciones').select('*, asignaturas!inner(nombre)').eq('docente_id', entidadId).eq('cuatrimestre_id', cuatrimestreId).order('fecha_subida', { ascending: false });

// Filtrar materias que ya tienen planeacion APROBADA (correcciones si se pueden reenviar)
const materiasBloqueadas = new Set((planeacionesRaw||[]).filter(p => (p as any).estado === 'Aprobado' || (p as any).estado === 'Pendiente').map(p => (p as any).asignatura_id as number));
const materiasDisponibles = (misAsignaturas||[]).filter(a => !materiasBloqueadas.has(a.id));

// Materias en correccion (se pueden reenviar)
const materiasCorreccion = new Map<number, number>(); // asignatura_id → planeacion_id
(planeacionesRaw||[]).filter(p => (p as any).estado === 'Corrección').forEach(p => materiasCorreccion.set((p as any).asignatura_id, (p as any).id));

interface PlaneacionItem { id: number; asignatura: string; grupo: string; estado: string; puntaje: number | null; url: string; }
const planeaciones: PlaneacionItem[] = [];
for (const p of (planeacionesRaw || [])) {
  const pdfUrl = (p as Record<string,unknown>).url_pdf as string;
  let urlFirmada = pdfUrl;
  try {
    const path = pdfUrl.split('/planeaciones/')[1];
    if (path) {
      const { data } = await cl.storage.from('planeaciones').createSignedUrl(path, 3600);
      if (data?.signedUrl) urlFirmada = data.signedUrl;
    }
  } catch {}
  planeaciones.push({
    id: (p as Record<string,unknown>).id as number,
    asignatura: ((p as Record<string,unknown>).asignaturas as {nombre:string})?.nombre || String((p as Record<string,unknown>).asignatura_id),
    grupo: (p as Record<string,unknown>).grupo as string,
    estado: (p as Record<string,unknown>).estado as string,
    puntaje: (p as Record<string,unknown>).puntaje_promedio as number | null,
    url: urlFirmada
  });
}
---

<LayoutDocente titulo="Mis Planeaciones">
  <div class="animate-flotar-entrada max-w-4xl mx-auto">
    <h1 class="text-3xl font-bold text-tup mb-2">Buzón de entrega Planeación Docente {cuatrimestre?.clave || ''}</h1>
    <p class="text-slate-500 mb-6">{cuatrimestre?.nombre || 'Sin cuatrimestre activo'}</p>

    <!-- Leyenda -->
    <div class="bg-white rounded-2xl p-6 shadow-tarjeta mb-8 text-sm text-slate-600 leading-relaxed space-y-3">
      <p class="font-medium text-tup">Estimado(a) docente:</p>
      <p>Una vez que haya cursado y acreditado el curso en Moodle <strong>"Formación Docente I"</strong>, en el cual se encuentra integrado el proceso para el uso del nuevo formato de Planeación Didáctica correspondiente al ciclo 26-2, deberá haber elaborado las planeaciones didácticas de cada una de las asignaturas y grupos a su cargo.</p>
      <p>Le invitamos a realizar el registro y la carga de sus planeaciones didácticas en este buzón electrónico, correspondiente al periodo académico vigente <strong>{cuatrimestre?.clave || 'actual'}</strong>. Este espacio ha sido habilitado para centralizar, resguardar y dar seguimiento institucional a las planeaciones, como parte del proceso de aseguramiento de la calidad educativa y del <strong>Sistema de Evaluación del Desempeño Docente 360</strong>.</p>
      <p>Es importante considerar que el registro y el proceso de envío deberán realizarse de manera individual por cada planeación, ya que el sistema se encuentra estructurado para recepcionar una planeación por registro. En el caso de asignaturas que se impartan a dos o más grupos, aun cuando el contenido sea el mismo, deberá elaborarse y enviarse una planeación didáctica por cada grupo.</p>
      <p>Cada archivo deberá corresponder claramente a la asignatura, grupo, modalidad y ciclo académico, a fin de garantizar el orden, la trazabilidad y la correcta validación académica.</p>
      <div class="bg-slate-50 rounded-xl p-4 text-xs font-mono">
        <p class="font-medium mb-1">Nomenclatura estandarizada:</p>
        <code>Asignatura_Grupo_Modalidad_ApellidoDocente_{cuatrimestre?.clave || 'XX-X'}.pdf</code>
        <p class="mt-1 ">Ejemplo: <code>Fundamentos_Enfermeria_3A_Escolarizada_Perez_{cuatrimestre?.clave || 'XX-X'}.pdf</code></p>
      </div>
      <p>Por favor, asegúrese de completar correctamente la información solicitada y de adjuntar el archivo correspondiente conforme a los lineamientos establecidos.</p>
      <p class="font-medium text-slate-500">Agradecemos su colaboración, responsabilidad académica y compromiso con la mejora continua y la calidad educativa institucional.</p>
    </div>

    <!-- Correcciones pendientes -->
    {materiasCorreccion.size > 0 && (
      <div class="bg-red-50 rounded-2xl p-5 border border-red-200 mb-6">
        <h3 class="font-bold text-red-700 mb-3">⚠️ Planeaciones que requieren corrección</h3>
        <p class="text-sm text-red-600 mb-4">El coordinador solicitó cambios en las siguientes materias. Corregí y volvé a subir el archivo.</p>
        <div class="space-y-2">
          {[...materiasCorreccion.entries()].map(([asigId, planId]) => {
            const asig = (misAsignaturas||[]).find(a => a.id === asigId);
            return <div class="flex items-center justify-between bg-white rounded-lg px-4 py-3"><span class="text-sm font-medium text-slate-700">{asig?.nombre || asigId}</span><button class="btn-corregir px-4 py-1.5 rounded-lg bg-red-600 text-white text-xs font-medium hover:bg-red-700" data-plan-id={planId} data-asig-id={asigId}>📤 Reenviar</button></div>;
          })}
        </div>
      </div>
    )}

    <!-- Formulario de subida -->
    <div class="bg-white rounded-2xl p-6 shadow-tarjeta mb-8">
      <h2 class="text-lg font-bold text-tup mb-4">Subir Nueva Planeación</h2>
      {materiasDisponibles.length === 0 && materiasCorreccion.size === 0 ? (
        <p class="text-sm text-slate-400">Ya subiste planeación para todas tus materias. 🎉</p>
      ) : (
      <form id="form-subir" class="space-y-4">
        <input type="hidden" id="plan_id" value="" />
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div><label class="block text-sm font-medium text-slate-700 mb-1">Asignatura *</label><select id="asignatura_id" required class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm"><option value="">Seleccionar...</option>{materiasDisponibles?.map(a => (<option value={a.id}>{a.nombre}</option>))}</select></div>
          <div><label class="block text-sm font-medium text-slate-700 mb-1">Grupo *</label><select id="grupo" required class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm"><option value="">Primero selecciona la materia</option></select></div>
          <div><label class="block text-sm font-medium text-slate-700 mb-1">Modalidad</label><select id="modalidad" class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm"><option>Escolarizada</option><option>Ejecutiva</option><option>Virtual</option></select></div>
          <div><label class="block text-sm font-medium text-slate-700 mb-1">Archivo PDF *</label><input type="file" id="archivo" accept=".pdf" required class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm file:mr-3 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-tup file:text-white" /></div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div><label class="block text-sm font-medium text-slate-700 mb-1">¿Se genera proyecto en la asignatura?</label><select id="proyecto" class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm"><option value="false">No</option><option value="true">Sí</option></select></div>
          <div><label class="block text-sm font-medium text-slate-700 mb-1">¿Integras uso de laboratorio en la planeación Docente?</label><select id="laboratorio" class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm"><option>No aplica</option><option value="Si">Sí</option><option>No</option></select></div>
          <div><label class="block text-sm font-medium text-slate-700 mb-1">¿Integra visitas acádemicas ... empresariales/institucionales, congresos/ foros etc?</label><select id="visitas" class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm"><option>No aplica</option><option value="Si">Sí</option><option>No</option></select></div>
        </div>
        <textarea id="comentario" placeholder="Comentario (opcional)" rows={2} class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm resize-none"></textarea>
        <button type="submit" class="w-full bg-tup text-white font-semibold py-3 rounded-xl hover:bg-tup/90">Subir Planeación</button>
      </form>
      )}
    </div>

    <!-- Lista -->
    <div class="bg-white rounded-2xl shadow-tarjeta overflow-hidden">
      <div class="px-6 py-4 border-b"><h2 class="font-semibold text-slate-700">Planeaciones Enviadas ({planeaciones.length})</h2></div>
      {planeaciones.length === 0 ? (
        <div class="p-12 text-center ">No has subido planeaciones todavía.</div>
      ) : (
        <table class="w-full text-sm"><thead><tr class="bg-slate-50 border-b"><th class="text-left px-4 py-3 text-xs uppercase">Asignatura</th><th class="text-left px-4 py-3 text-xs uppercase">Grupo</th><th class="text-center px-4 py-3 text-xs uppercase">Estado</th><th class="text-center px-4 py-3 text-xs uppercase">Puntaje</th><th class="text-right px-4 py-3 text-xs uppercase">PDF</th></tr></thead>
        <tbody class="divide-y">{planeaciones.map(p => (<tr class="hover:bg-slate-50"><td class="px-4 py-3">{p.asignatura}</td><td class="px-4 py-3">{p.grupo}</td><td class="px-4 py-3 text-center"><span class={`px-2 py-0.5 rounded-lg text-xs font-medium ${p.estado==='Aprobado'?'bg-emerald-50 text-emerald-700':p.estado==='Corrección'?'bg-red-50 text-red-700':'bg-amber-50 text-amber-700'}`}>{p.estado}</span></td><td class="px-4 py-3 text-center font-bold">{p.puntaje ? Math.round(p.puntaje)+'%' : '—'}</td><td class="px-4 py-3 text-right"><a href={p.url} target="_blank" class="text-tup text-xs hover:underline">Ver PDF</a></td></tr>))}</tbody></table>
      )}
    </div>
    <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 hidden px-6 py-3 rounded-xl text-sm font-medium shadow-modal"></div>
  </div>
</LayoutDocente>

<script is:inline define:vars={{ docenteId: entidadId, cuatrimestreId: cuatrimestre?.id, campus: docente?.campus || '', turno: docente?.turno || '', gruposJson: JSON.stringify(gruposDocente || []), correccionesJson: JSON.stringify([...materiasCorreccion.entries()]), cuatrimestreClave: cuatrimestre?.clave || 'XX' }}>
  var gruposData = JSON.parse(gruposJson);
  var correccionesData = new Map(JSON.parse(correccionesJson));
  document.getElementById("asignatura_id").addEventListener("change", actualizarGrupos);
  function toast(m,e){var t=document.getElementById('toast');t.textContent=m;t.className='fixed bottom-6 left-1/2 -translate-x-1/2 z-50 px-6 py-3 rounded-xl text-sm font-medium shadow-modal '+(e?'bg-red-600 text-white':'bg-emerald-600 text-white');t.classList.remove('hidden');setTimeout(function(){t.classList.add('hidden')},4000)}
  
  // Botones Reenviar
  document.querySelectorAll('.btn-corregir').forEach(function(btn){
    btn.addEventListener('click', function(){
      var planId = this.dataset.planId;
      var asigId = this.dataset.asigId;
      document.getElementById('plan_id').value = planId;
      document.getElementById('asignatura_id').value = asigId;
      actualizarGrupos();
      // Seleccionar el grupo de la planeacion original
      var grupos = gruposData.filter(function(g){ return g.asignatura_id === parseInt(asigId); });
      if (grupos.length > 0) setTimeout(function(){ document.getElementById('grupo').value = grupos[0].clave || ''; }, 100);
      document.getElementById('form-subir').scrollIntoView({behavior:'smooth'});
      var submitBtn = document.querySelector('#form-subir button[type="submit"]');
      submitBtn.textContent = 'Reenviar Corrección';
    });
  });
  
  function actualizarGrupos(){
    var asigId = parseInt(document.getElementById('asignatura_id').value);
    var sel = document.getElementById('grupo');
    sel.innerHTML = '<option value="">Seleccionar...</option>';
    if (!asigId) return;
    var matches = gruposData.filter(function(g){ return g.asignatura_id === asigId; });
    matches.forEach(function(g){ var o = document.createElement('option'); o.value = g.clave || g.id; o.textContent = g.clave || ('Grupo '+g.id); sel.appendChild(o); });
  }
  
  document.getElementById('form-subir').addEventListener('submit',async function(e){
    e.preventDefault();var btn=this.querySelector('button[type="submit"]');btn.disabled=true;btn.textContent='Subiendo...';
    var file=document.getElementById('archivo').files[0];
    if(!file){toast('Selecciona un archivo PDF',true);btn.disabled=false;btn.textContent='Subir Planeación';return}
    var asig=document.getElementById('asignatura_id');var grupo=document.getElementById('grupo').value;
    if(!asig.value||!grupo){toast('Selecciona asignatura y grupo',true);btn.disabled=false;btn.textContent='Subir Planeación';return}
    var asigNombre=asig.options[asig.selectedIndex].text.replace(/\s+/g,'_');var nombreArchivo=asigNombre+'_'+grupo+'_doc_'+cuatrimestreClave+'.pdf';
    try{
      var path=cuatrimestreId+'/'+docenteId+'/'+Date.now()+'_'+file.name.replace(/[^a-zA-Z0-9_.-]/g,'_').replace(/\s+/g,'_');
      var formData=new FormData();
      formData.append('file',file); formData.append('path',path);
      formData.append('cuatrimestre_id',cuatrimestreId); formData.append('asignatura_id',asig.value);
      var planId = document.getElementById('plan_id').value;
      if (planId) formData.append('plan_id', planId);
      formData.append('grupo',grupo); formData.append('modalidad',document.getElementById('modalidad').value);
      formData.append('proyecto',document.getElementById('proyecto').value==='true'?'true':'false');
      formData.append('laboratorio',document.getElementById('laboratorio').value);
      formData.append('visitas',document.getElementById('visitas').value);
      formData.append('comentario',document.getElementById('comentario').value.trim()||'');
      formData.append('campus',campus); formData.append('turno',turno); formData.append('nombre',nombreArchivo);
      var uploadRes=await fetch('/api/docente/subir-archivo',{method:'POST',body:formData});
      if(!uploadRes.ok){var errData=await uploadRes.json().catch(function(){return{}});toast('Error: '+(errData.error||errData.message||uploadRes.status),true);btn.disabled=false;btn.textContent='Subir Planeación';return}
      toast('¡Planeación subida exitosamente!',false);setTimeout(function(){location.reload()},1000);
    }catch(err){toast('Error: '+err.message,true);btn.disabled=false;btn.textContent='Subir Planeación'}
  });
</script>
