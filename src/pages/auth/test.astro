---
import Layout from '../../layouts/Layout.astro';
---
<Layout titulo="Test — Login Rápido" modoEnfoque={true}>
  <div class="flex flex-col items-center justify-center min-h-[80vh] gap-6">
    <div class="bg-white rounded-3xl p-8 shadow-modal max-w-sm w-full text-center">
      <h1 class="text-2xl font-bold text-tup mb-2">🧪 Modo Test</h1>
      <p class="text-sm text-slate-400 mb-8">Selecciona un rol para iniciar sesión</p>
      <div class="space-y-3">
        <button id="btn-admin" class="w-full px-6 py-4 rounded-2xl bg-purple-600 text-white font-bold text-lg hover:bg-purple-700 transition-colors shadow-tarjeta">🔑 Admin</button>
        <button id="btn-coord" class="w-full px-6 py-4 rounded-2xl bg-blue-600 text-white font-bold text-lg hover:bg-blue-700 transition-colors shadow-tarjeta">📋 Coordinador</button>
        <button id="btn-doc" class="w-full px-6 py-4 rounded-2xl bg-emerald-600 text-white font-bold text-lg hover:bg-emerald-700 transition-colors shadow-tarjeta">👨‍🏫 Docente</button>
        <button id="btn-est" class="w-full px-6 py-4 rounded-2xl bg-slate-600 text-white font-bold text-lg hover:bg-slate-700 transition-colors shadow-tarjeta">🎒 Estudiante</button>
      </div>
      <p class="text-xs text-slate-300 mt-6">⚠️ Solo para pruebas. No usar en producción.</p>
    </div>
  </div>
</Layout>

<script>
  async function login(rol, email, nombre) {
    var res = await fetch('/api/auth/test-login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ rol, email, nombre }) });
    if (res.ok) {
      var dash = rol === 'superadmin' ? '/admin/dashboard' : rol === 'coordinador' ? '/coordinador/dashboard' : rol === 'docente' ? '/docente/dashboard' : '/estudiante/dashboard';
      window.location.href = dash;
    } else { alert('Error al iniciar sesión de prueba'); }
  }
  document.getElementById('btn-admin').addEventListener('click', function(){ login('superadmin','admin@test.local','Admin Test') });
  document.getElementById('btn-coord').addEventListener('click', function(){ login('coordinador','coord@test.local','Coord Test') });
  document.getElementById('btn-doc').addEventListener('click', function(){ login('docente','docente@test.local','Docente Test') });
  document.getElementById('btn-est').addEventListener('click', function(){ login('estudiante','est@test.local','Estudiante Test') });
</script>
