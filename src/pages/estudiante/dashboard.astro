---
import LayoutEstudiante from '../../layouts/LayoutEstudiante.astro';
import { obtenerClienteSuperbase } from '../../lib/supabaseClient';
import { obtenerCuatrimestreActivo } from '../../services/catalogos';

import { obtenerSesion } from '../../lib/sesion';

const sesion = await obtenerSesion(Astro);
if (!sesion || sesion.rol !== 'estudiante' || !sesion.entidad_id) return Astro.redirect('/auth');
const estudianteId = sesion.entidad_id;
const cl = obtenerClienteSuperbase();

const cuatrimestre = await obtenerCuatrimestreActivo();

// Obtener grupos del estudiante con docentes
const { data: inscripciones } = await cl.from('inscripciones').select('grupo_id').eq('estudiante_id', estudianteId).eq('cuatrimestre_id', cuatrimestre?.id);
const gruposIds = (inscripciones || []).map(i => i.grupo_id);

let pendientes: { grupo_id: number; grupo: string; docente: string; docente_id: number; asignatura: string; yaRespondio: boolean }[] = [];
let completadas: typeof pendientes = [];

if (gruposIds.length > 0) {
  const { data: grupos } = await cl.from('grupos').select('id,clave,docente_id,asignatura_id').in('id', gruposIds);
  for (const g of (grupos || [])) {
    const { data: doc } = await cl.from('docentes').select('nombre,apellidos').eq('id', g.docente_id).maybeSingle();
    const { data: asig } = await cl.from('asignaturas').select('nombre').eq('id', g.asignatura_id).maybeSingle();
    const { data: ctrl } = await cl.from('encuesta_control_envio').select('id').eq('estudiante_id', estudianteId).eq('grupo_id', g.id).eq('cuatrimestre_id', cuatrimestre?.id).maybeSingle();
    const item = { grupo_id: g.id, grupo: g.clave, docente: doc ? doc.nombre + ' ' + doc.apellidos : '—', docente_id: g.docente_id || 0, asignatura: asig?.nombre || '—', yaRespondio: !!ctrl };
    if (ctrl) completadas.push(item); else pendientes.push(item);
  }
}
---

<LayoutEstudiante titulo="Mis Encuestas">
  <div class="animate-flotar-entrada w-full max-w-lg mx-auto">
    <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-modal">
      <h1 class="text-2xl font-bold text-tup text-center mb-2">Mis Encuestas</h1>
      <p class="text-slate-500 text-sm text-center mb-6">{cuatrimestre?.nombre || ''}</p>

      {pendientes.length === 0 && completadas.length === 0 ? (
        <div class="bg-slate-50 rounded-xl p-4 text-sm text-slate-400 text-center">No tienes docentes asignados para evaluar.</div>
      ) : (
        <>
          {pendientes.length > 0 && (
            <div class="mb-6">
              <p class="text-xs font-semibold text-amber-600 uppercase mb-3">Pendientes ({pendientes.length})</p>
              <div class="space-y-3">
                {pendientes.map(p => (
                  <a href={`/estudiante/encuesta/${p.grupo_id}`} class="block bg-amber-50 rounded-xl p-4 border border-amber-100 hover:bg-amber-100 transition-colors">
                    <p class="font-medium text-slate-800">{p.docente}</p>
                    <p class="text-xs text-slate-500">{p.asignatura} · Grupo {p.grupo}</p>
                    <p class="text-xs text-amber-600 font-medium mt-2">Iniciar encuesta →</p>
                  </a>
                ))}
              </div>
            </div>
          )}
          {completadas.length > 0 && (
            <div>
              <p class="text-xs font-semibold text-emerald-600 uppercase mb-3">Completadas ({completadas.length})</p>
              <div class="space-y-2">
                {completadas.map(c => (
                  <div class="bg-emerald-50/50 rounded-xl p-3 border border-emerald-100 opacity-70">
                    <p class="text-sm font-medium text-slate-600">{c.docente}</p>
                    <p class="text-xs text-slate-400">{c.asignatura} · Grupo {c.grupo} · ✅ Completada</p>
                  </div>
                ))}
              </div>
            </div>
          )}
        </>
      )}
    </div>
  </div>
</LayoutEstudiante>
