---
import LayoutEstudiante from '../../layouts/LayoutEstudiante.astro';
import { crearClienteConSesion } from '../../lib/supabaseClient';
import { getCurrentStudentEvaluations, type StudentEvaluations } from '../../lib/studentEvaluations';

const accessToken = Astro.cookies.get('sb-access-token')?.value;
if (!accessToken) return Astro.redirect('/auth');

let evaluations: StudentEvaluations = { cycle: null, evaluations: [] };
let loadError = false;

try {
  const client = crearClienteConSesion(accessToken);
  const { data, error } = await client.auth.getUser(accessToken);
  if (error || !data.user) return Astro.redirect('/auth');
  evaluations = await getCurrentStudentEvaluations(client);
} catch (error) {
  console.error('[student dashboard] unable to load evaluations', {
    message: error instanceof Error ? error.message : 'unknown error',
  });
  loadError = true;
}
---

<LayoutEstudiante titulo="Evaluación docente — Estudiante">
  <section class="animate-flotar-entrada py-6 sm:py-10">
    <p class="text-sm font-semibold text-tup uppercase tracking-wide">Portal estudiantil</p>
    <h1 class="mt-2 text-3xl sm:text-4xl font-bold text-slate-800">Mis evaluaciones docentes</h1>
    <p class="mt-3 max-w-2xl text-slate-600">Selecciona cada asignatura pendiente para registrar tu evaluación. Tus respuestas se registran de forma anónima.</p>

    {loadError ? (
      <div class="mt-8 rounded-2xl border border-red-200 bg-red-50 p-5 text-red-800" role="alert">
        No fue posible consultar tus evaluaciones. Actualiza la página o intenta nuevamente más tarde.
      </div>
    ) : !evaluations.cycle ? (
      <div class="mt-8 rounded-2xl border border-amber-200 bg-amber-50 p-6 shadow-tarjeta" role="status">
        <h2 class="text-lg font-semibold text-amber-900">Evaluaciones no disponibles</h2>
        <p class="mt-2 text-sm text-amber-800">No hay un ciclo activo para mostrar o recibir evaluaciones en este momento.</p>
      </div>
    ) : (
      <>
        <div class="mt-7 flex flex-wrap items-center justify-between gap-3 rounded-2xl bg-tup px-5 py-4 text-white shadow-tarjeta">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-white/70">Ciclo actual</p>
            <p class="mt-1 text-lg font-bold">{evaluations.cycle.key}</p>
          </div>
          <p class="max-w-md text-sm text-white/85">{evaluations.cycle.name}</p>
        </div>

        {evaluations.evaluations.length === 0 ? (
          <div class="mt-6 rounded-2xl bg-white p-8 text-center text-slate-600 shadow-tarjeta">
            No tienes asignaturas evaluables registradas en este ciclo.
          </div>
        ) : (
          <div class="mt-6 grid grid-cols-1 gap-4">
            {evaluations.evaluations.map((evaluation) => (
              <article class="rounded-2xl border border-slate-100 bg-white p-5 shadow-tarjeta sm:p-6">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                  <div>
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Docente</p>
                    <h2 class="mt-1 text-xl font-bold text-slate-800">{evaluation.teacherName}</h2>
                  </div>
                  <span class={`inline-flex w-fit rounded-full px-3 py-1 text-xs font-semibold ${evaluation.completed ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'}`}>
                    {evaluation.completed ? 'Completada' : 'Pendiente'}
                  </span>
                </div>

                <dl class="mt-5 grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
                  <div><dt class="text-slate-500">Asignatura</dt><dd class="mt-1 font-medium text-slate-800">{evaluation.subjectName}</dd><dd class="font-mono text-xs text-tup">{evaluation.subjectKey}</dd></div>
                  <div><dt class="text-slate-500">Grupo</dt><dd class="mt-1 font-medium text-slate-800">{evaluation.groupKey}</dd></div>
                  {evaluation.plan && <div><dt class="text-slate-500">Plan</dt><dd class="mt-1 font-medium text-slate-800">{evaluation.plan}</dd></div>}
                  {evaluation.modality && <div><dt class="text-slate-500">Modalidad</dt><dd class="mt-1 font-medium text-slate-800">{evaluation.modality}</dd></div>}
                </dl>

                {evaluation.completed ? (
                  <a href={`/estudiante/evaluar/${evaluation.groupId}`} class="mt-6 inline-flex items-center rounded-xl border border-emerald-200 px-4 py-2.5 text-sm font-semibold text-emerald-800 hover:bg-emerald-50">Ver estado</a>
                ) : (
                  <a href={`/estudiante/evaluar/${evaluation.groupId}`} class="mt-6 inline-flex items-center rounded-xl bg-tup px-4 py-2.5 text-sm font-semibold text-white hover:bg-tup-600">Realizar evaluación</a>
                )}
              </article>
            ))}
          </div>
        )}
      </>
    )}
  </section>
</LayoutEstudiante>
